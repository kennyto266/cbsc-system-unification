#!/usr/bin/env python3
"""Tier2 宏觀因子收集器 — 用 yfinance 攞免費跨市場因子"""
from __future__ import annotations
import logging
from pathlib import Path
from typing import Dict, Optional
import pandas as pd

try:
    import yfinance as yf
    _YF = True
except Exception:
    yf = None; _YF = False

ROOT = Path(__file__).parent.parent.parent
FACTORS_DIR = ROOT / "data" / "factors"

FACTORS = {
    "usdcnh": "CNY=X", "dxy": "DX-Y.NYB", "us_10y_yield": "^TNX",
    "vix": "^VIX", "gold": "GC=F", "copper": "HG=F",
    "a_shares": "000300.SS", "sp500": "^GSPC",
}
logger = logging.getLogger("cbsc_cli.factor_collector")

def _extract_close(df, symbol):
    if df is None or getattr(df, "empty", True): return None
    if isinstance(df.columns, pd.MultiIndex):
        if "Close" in df.columns.get_level_values(0):
            close = df["Close"]
            if isinstance(close, pd.DataFrame):
                close = close[symbol] if symbol in close.columns else close.iloc[:, 0]
            return close
    if "Close" in df.columns: return df["Close"]
    if "Adj Close" in df.columns: return df["Adj Close"]
    return None

def collect_factor(name, symbol, years=5):
    if not _YF: logger.error("yfinance 未安裝"); return False
    FACTORS_DIR.mkdir(parents=True, exist_ok=True)
    try:
        raw = yf.download(symbol, period=f"{years}y", progress=False, auto_adjust=True, threads=False)
    except Exception as e:
        logger.warning("因子 %s (%s) 下載失敗: %s", name, symbol, e); return False
    close = _extract_close(raw, symbol)
    if close is None or close.empty: logger.warning("因子 %s 無數據", name); return False
    out = pd.DataFrame({"date": close.index.normalize(), "close": pd.to_numeric(close, errors="coerce")}).set_index("date")
    out = out.dropna(subset=["close"])
    out = out[~out.index.duplicated(keep="last")]
    if out.empty: return False
    out["return"] = out["close"].pct_change()
    out.to_csv(FACTORS_DIR / f"{name}.csv", encoding="utf-8")
    logger.info("因子 %-12s (%-11s) %d 筆, %s ~ %s", name, symbol, len(out), out.index.min().date(), out.index.max().date())
    return True

def collect_all_factors(years=5):
    logger.info("開始收集 %d 個因子 (years=%d)", len(FACTORS), years)
    results = {}
    for name, symbol in FACTORS.items():
        ok = collect_factor(name, symbol, years=years)
        results[name] = ok
        print(f"  {'✅' if ok else '❌'} {name:<14} ({symbol})")
    succeeded = sum(results.values())
    print(f"\n✓ 收集完成: {succeeded}/{len(FACTORS)} 成功")
    return results

def load_factor(name):
    path = FACTORS_DIR / f"{name}.csv"
    if not path.exists(): raise FileNotFoundError(f"因子不存在: {path}")
    df = pd.read_csv(path, index_col="date", parse_dates=True)
    s = pd.to_numeric(df["close"], errors="coerce").dropna()
    s.name = name; return s.sort_index()

def load_all_factors():
    factors = {}
    for name in FACTORS:
        path = FACTORS_DIR / f"{name}.csv"
        if not path.exists(): continue
        try: factors[name] = load_factor(name)
        except Exception as e: logger.warning("載入 %s 失敗: %s", name, e)
    return factors

def main(args=None):
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    years = getattr(args, "years", 5) if args else 5
    collect_all_factors(years)

if __name__ == "__main__":
    main()
