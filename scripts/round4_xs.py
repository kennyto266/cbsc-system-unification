    vol_avg = vol_panel.rolling(lookback).mean()
    vol_rank_today = vol_panel.rolling(1).sum()
    # Rank volume spike cross-sectionally
    vol_ratio = vol_panel / vol_avg
    rank = vol_ratio.rank(axis=1, pct=True)
    all_entries = {stock: (rank[stock] > 0.8).shift(1).fillna(False) for stock in close_panel.columns}
    report(f'XS_vol {lookback}d top20%', compute_portfolio_from_entries(all_entries, hold=3))

