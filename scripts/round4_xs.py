# XS reversal: rank stocks by 5-day return, buy bottom 20%
for lookback in [3, 5, 10]:
    for pct in [0.2, 0.3]:
        ret_lookback = ret_panel.rolling(lookback).sum()
        # Cross-sectional rank each day
        rank = ret_lookback.rank(axis=1, pct=True)
        # Bottom pct = oversold
        all_entries = {}
        for stock in close_panel.columns:
            is_bottom = rank[stock] < pct
            all_entries[stock] = is_bottom.shift(1).fillna(False)
        report(f'XS_rev {lookback}d bot{pct:.0%}', compute_portfolio_from_entries(all_entries, hold=5))

print('\n' + '='*65)
print('XS2: Cross-Sectional Momentum (buy top-ranked)')
print('='*65)
for lookback in [5, 10, 20]:
