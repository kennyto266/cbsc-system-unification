for zw in [20, 40, 60]:
    for zt in [0.5, 1.0, 1.5, 2.0]:
        z = (sc_daily['net_buy'] - sc_daily['net_buy'].rolling(zw).mean()) / sc_daily['net_buy'].rolling(zw).std().replace(0, np.nan)
        all_entries = {}
        for stock in close_panel.columns:
            z_aligned = z.reindex(close_panel.index).ffill()
            all_entries[stock] = (z_aligned > zt).shift(1).fillna(False)
        result = compute_portfolio_from_entries(all_entries, hold=5)
        report(f'SC z>{zt} w{zw}', result)
