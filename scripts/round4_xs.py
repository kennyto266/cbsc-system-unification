        ret_lookback = ret_panel.rolling(lookback).sum()
        rank = ret_lookback.rank(axis=1, pct=True)
        is_top = rank > pct
        all_entries = {stock: is_top[stock].shift(1).fillna(False) for stock in close_panel.columns}
        report(f'XS_mom {lookback}d top{pct:.0%}', compute_portfolio_from_entries(all_entries, hold=5))

