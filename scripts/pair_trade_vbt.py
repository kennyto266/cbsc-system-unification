    # Top 15 按 Sharpe（只用有交易嘅）
    print(f"\n  Top {min(15, len(df_active))} Pair (按 Sharpe, rf={RF_RATE*100:.0f}%, 成本{TOTAL_ROUND_TRIP*100:.2f}%):")
    print(f"  {'#':<3} {'Pair':<22} {'Corr':>5} {'Sharpe':>7} {'AnnRet%':>8} {'MaxDD%':>7} "
          f"{'B&HRet%':>8} {'B&HSharpe':>9} {'Alpha%':>7} {'Beat':>5}")
    print(f"  {'-'*3} {'-'*22} {'-'*5} {'-'*7} {'-'*8} {'-'*7} {'-'*8} {'-'*9} {'-'*7} {'-'*5}")

    for idx in range(min(15, len(df_active))):
        r = df_active.iloc[idx]
        pair = "{}-{}".format(r['code_a'], r['code_b'])
        beat_v = bool(r.get('beat_bh'))
        beat = "Y" if beat_v else "N"
        bh_ret = float(r.get('bh_total_return_pct', 0) or 0)
        bh_sharpe_raw = r.get('bh_sharpe', 0)
        bh_sharpe = float(bh_sharpe_raw) if pd.notna(bh_sharpe_raw) and bh_sharpe_raw is not None else 0.0
        alpha = float(r.get('alpha_vs_bh_pct', 0) or 0)
        corr = float(r['correlation'])
        sharpe_raw = r.get('sharpe', 0)
        sharpe = float(sharpe_raw) if pd.notna(sharpe_raw) and sharpe_raw is not None else 0.0
        ann_ret = float(r.get('annual_return_pct', 0) or 0)
        max_dd_raw = r.get('max_drawdown_pct', 0)
        max_dd = float(max_dd_raw) if pd.notna(max_dd_raw) and max_dd_raw is not None else 0.0
        line = "  {:<3} {:<20} {:>5.2f} {:>7.2f} {:>7.1f}% {:>6.1f}% {:>7.1f}% {:>8.2f} {:>6.1f}% {:>4}".format(
            idx+1, pair, corr, sharpe, ann_ret, max_dd,
            bh_ret, bh_sharpe, alpha, beat)
        sys.stdout.write(line + "\n")
        sys.stdout.flush()

    # 統計摘要（只用有交易嘅 pair）
    n_total = len(df_active)
    n_beat = int(df_active['beat_bh'].sum()) if 'beat_bh' in df_active.columns else 0
    sharpe_series = df_active['sharpe'].dropna()
    bh_sharpe_series = df_active['bh_sharpe'].dropna()
    print(f"\n  📊 全部 {n_total} 個有交易 pair 統計:")
    print(f"     策略 Sharpe 中位數:   {sharpe_series.median():.2f}")
    print(f"     B&H Sharpe 中位數:    {bh_sharpe_series.median():.2f}")
    print(f"     策略 Sharpe > 1.0:    {(sharpe_series > 1.0).sum()} 個")
    print(f"     策略 Sharpe > 1.5:    {(sharpe_series > 1.5).sum()} 個")
    print(f"     策略 Sharpe > 2.0:    {(sharpe_series > 2.0).sum()} 個")
    print(f"     策略 平均 Max DD:     {df_active['max_drawdown_pct'].mean():.1f}%")
    print(f"     B&H 平均 Max DD:      {df_active['bh_max_drawdown_pct'].mean():.1f}%")
    print(f"     🏆 跑贏 B&H:          {n_beat}/{n_total} 個 ({n_beat/n_total*100:.0f}%)")
    print(f"     平均 Alpha (vs B&H):  {df_active['alpha_vs_bh_pct'].mean():+.1f}%")
    print(f"     Walk-forward 穩健:    {df_active['robust'].sum() if 'robust' in df_active.columns else 0} 個")

    # 最佳 pair 詳細（有交易嘅第一名）
    if len(df_active) > 0:
        best = df_active.iloc[0]
        print(f"\n  🥇 最佳 Pair: {best['code_a']} ↔ {best['code_b']}")
        print(f"     相關性:       {best['correlation']:.4f}")
        print(f"     Hedge ratio:  {best['hedge_ratio']:.4f}")
        sharpe_v = best['sharpe']
        print(f"     Sharpe:       {sharpe_v:.3f}" if pd.notna(sharpe_v) else "     Sharpe:       N/A")
        if pd.notna(best.get('sortino')):
            print(f"     Sortino:      {best['sortino']:.3f}")
        if pd.notna(best.get('calmar')):
            print(f"     Calmar:       {best['calmar']:.3f}")
        print(f"     年化回報:     {best['annual_return_pct']:.2f}%")
        print(f"     最大回撤:     {best['max_drawdown_pct']:.2f}%")
        print(f"     勝率:         {best['win_rate_pct']:.1f}%")
        print(f"     Profit Factor:{best['profit_factor']:.2f}")
        print(f"     交易次數:     {int(best['n_trades'])}")
        # Buy & Hold 對比
        bh_ret = best.get('bh_total_return_pct', 0) or 0
        bh_sh = best.get('bh_sharpe', 0) or 0
        bh_mdd = best.get('bh_max_drawdown_pct', 0) or 0
        bh_sh_s = f"{bh_sh:.3f}" if pd.notna(bh_sh) else "N/A"
        print(f"\n     📊 vs Buy & Hold (兩腿各50%):")
        print(f"        策略總回報:   {best['total_return_pct']:.2f}%  vs  B&H: {bh_ret:.2f}%")
        print(f"        策略 Sharpe:  {sharpe_v:.3f}  vs  B&H: {bh_sh_s}")
        print(f"        策略 Max DD:  {best['max_drawdown_pct']:.2f}%  vs  B&H: {bh_mdd:.2f}%")
        print(f"        Alpha:        {best.get('alpha_vs_bh_pct', 0):+.2f}%  ({'跑贏 ✓' if best.get('beat_bh') else '跑輸 ✗'})")
        if pd.notna(best.get('out_sample_sharpe')):
            print(f"     Walk-forward: IS={best['in_sample_sharpe']:.2f} → "
                  f"OOS={best['out_sample_sharpe']:.2f} "
                  f"({'穩健 ✓' if best.get('robust') else '過擬合 ✗'})")


def main():
    parser = argparse.ArgumentParser(description="HSI Pair Trade — VectorBT 專業版")
    parser.add_argument("--corr-only", action="store_true", help="只計相關性")
    parser.add_argument("--backtest-only", action="store_true", help="只回測（需有相關性結果）")
    parser.add_argument("--days", type=int, default=500, help="歷史天數")
    parser.add_argument("--max-pairs", type=int, default=50, help="最多測試 pair 數")
    args = parser.parse_args()

    print("=" * 70)
    print("🎯 恆指 Pair Trade — VectorBT 專業回測")
    print("=" * 70)
    print(f"時間:        {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"VectorBT:    {vbt.__version__}")
    print(f"交易成本:    {TOTAL_ROUND_TRIP*100:.2f}%/來回 (印花稅+佣金)")
    print(f"無風險利率:  {RF_RATE*100:.1f}%")

    # Step 1: 數據
    cache = DATA_DIR / "hsi_prices.pkl"
    prices = fetch_hsi_prices(days=args.days, cache_path=cache)

    # Step 2: 相關性
    pairs_df, _ = full_correlation_report(prices)
    high_corr = pairs_df[pairs_df["correlation"] >= 0.6]

    if args.corr_only:
        print(f"\n✅ 相關性分析完成。輸出目錄: {OUTPUT_DIR}")
        return

    # Step 3: VectorBT 回測
    results = run_all_backtests(prices, high_corr, max_pairs=args.max_pairs)
    print_professional_report(results)

    # 儲存
    results.to_csv(OUTPUT_DIR / "vbt_pair_trade_results.csv", index=False)
    top = results.head(15).to_dict("records")
    with open(OUTPUT_DIR / "vbt_pair_trade_top15.json", "w", encoding="utf-8") as f:
        json.dump(top, f, indent=2, ensure_ascii=False, default=str)

    print(f"\n✅ 全部完成")
    print(f"📁 輸出目錄: {OUTPUT_DIR}")
    print(f"   - correlation_matrix_full.csv (完整相關性矩陣)")
    print(f"   - correlation_all_pairs.csv (所有 pair 列表)")
    print(f"   - correlation_high_pairs.csv (高相關性 pair)")
    print(f"   - correlation_heatmap.png (熱力圖)")
    print(f"   - vbt_pair_trade_results.csv (VectorBT 回測結果)")
    print(f"   - vbt_pair_trade_top15.json (Top 15 詳細)")


if __name__ == "__main__":
    main()
