def _buy_hold_benchmark(prices, code_a, code_b, index):
    """計算 Buy & Hold 基準：兩腿各 50% 資金持有（dollar-neutral 起始）。

    用 VectorBT from_holding 計算，含手續費。
    返回同策略一致嘅指標格式，方便對比。
    """
    try:
        pa = prices[code_a].reindex(index).dropna()
        pb = prices[code_b].reindex(index).dropna()
        common_idx = pa.index.intersection(pb.index)
        pa = pa.reindex(common_idx)
        pb = pb.reindex(common_idx)
        if len(pa) < 2 or len(pb) < 2:
            return {"total_return_pct": 0, "annual_return_pct": 0,
                    "sharpe": 0, "max_drawdown_pct": 0}

        # 各 50% 資金 B&H
        init = 1_000_000
        half = init / 2
        shares_a = half / pa.iloc[0]
        shares_b = half / pb.iloc[0]
        value = shares_a * pa + shares_b * pb
        value = value.dropna()

        pf_bh = vbt.Portfolio.from_holding(
            value, init_cash=init, fees=FEE_PER_SIDE, freq="1D"
        )
        bh_ret = float(pf_bh.total_return())
        bh_ann = float(pf_bh.annualized_return())
        bh_sharpe = float(pf_bh.sharpe_ratio())
        bh_mdd = float(pf_bh.max_drawdown())

        # 調整 Sharpe 扣除 rf
        if bh_sharpe != 0 and bh_ann != 0:
            vol = bh_ann / bh_sharpe
            bh_sharpe = (bh_ann - RF_RATE) / vol if vol > 0 else bh_sharpe

        return {
            "total_return_pct": round(bh_ret * 100, 2),
            "annual_return_pct": round(bh_ann * 100, 2),
            "sharpe": round(bh_sharpe, 3),
            "max_drawdown_pct": round(bh_mdd * 100, 2),
        }
    except Exception:
        return {"total_return_pct": 0, "annual_return_pct": 0,
                "sharpe": 0, "max_drawdown_pct": 0}


def vbt_backtest_pair(prices, code_a, code_b):
    """用 VectorBT 回測單個 pair。

    策略：價差 z-score mean-reversion
    - z > ENTRY_Z: short spread (short A, long B)
    - z < -ENTRY_Z: long spread (long A, short B)
    - |z| < EXIT_Z: 平倉
    - |z| > STOP_Z: 止損

    VectorBT 處理：
    - Portfolio.from_signals 同時管理 long/short 兩腿
    - 自動計算 fees, slippage
    - 專業指標：sharpe, sortino, calmar, max_drawdown
    """
    a = np.log(prices[code_a])
    b = np.log(prices[code_b])
    common = pd.concat([a, b], axis=1, join="inner").dropna()
    n = len(common)
    if n < 20:  # 至少要 20 日先有意義
        return None

    # LOOKBACK 自適應：數據唔夠時縮短（至少 5 日）
    lookback = min(LOOKBACK, max(5, n // 3))

    a_v = common.iloc[:, 0]
    b_v = common.iloc[:, 1]

    # Hedge ratio (全域 OLS)
    from scipy import stats
    slope, intercept, _, _, _ = stats.linregress(b_v.values, a_v.values)
    spread = a_v - (intercept + slope * b_v)

    # Rolling z-score（用自適應 lookback）
    roll_mean = spread.rolling(lookback).mean()
    roll_std = spread.rolling(lookback).std().replace(0, np.nan)
    z = (spread - roll_mean) / roll_std

    # 構造 entries/exits 信號
    # position = 1 表示 long spread (long A, short B)
    # position = -1 表示 short spread (short A, long B)
    long_entries = z < -ENTRY_Z      # z 太低 → 買 spread
    long_exits = (z > -EXIT_Z) | (z < -STOP_Z)  # 回歸或止損
    short_entries = z > ENTRY_Z       # z 太高 → 賣 spread
    short_exits = (z < EXIT_Z) | (z > STOP_Z)

    # 兩腿價格（dollar-neutral: A 做多時 B 做空）
    # 用 spread 收益率作為 portfolio 的 price
    # 簡化：用 spread diff 作為 PnL 序列，VectorBT Portfolio 包裝
    spread_ret = spread.diff().fillna(0)

    # 用 Portfolio.from_signals 直接在 spread 收益上跑
    # 將 spread_ret 視為 "price"，position 乘以佢就係策略收益
    # 但 vbt 需要正向 price，我哋轉用累積 spread 作為 "price"
    spread_price = (1 + spread_ret).cumprod()

    try:
        pf = vbt.Portfolio.from_signals(
            close=spread_price,
            entries=long_entries,
            exits=long_exits,
            short_entries=short_entries,
            short_exits=short_exits,
            fees=FEE_PER_SIDE,         # 單邊手續費
            sl_stop=STOP_Z / 100,      # 止損 (近似)
            freq="1D",
            init_cash=1_000_000,       # 100 萬初始資金
            accumulate=False,
        )
    except Exception:
        return None

    # 專業指標（VectorBT 0.28 API）
    try:
        total_return = float(pf.total_return())
        ann_return = float(pf.annualized_return())
        # sharpe_ratio 在 vbt 0.28 不接受 rf_req，用默認（無風險利率=0）
        # 如需扣除 rf，從 annualized_return 手動扣
        sharpe = float(pf.sharpe_ratio())
        sortino = float(pf.sortino_ratio()) if hasattr(pf, "sortino_ratio") else None
        max_dd = float(pf.max_drawdown())
        calmar = float(pf.calmar_ratio()) if hasattr(pf, "calmar_ratio") else None
        # 手動調整 Sharpe 扣除無風險利率
        # Sharpe_rf = (ann_return - rf) / (ann_return / sharpe)  ← 簡化近似
        if sharpe != 0 and ann_return != 0:
            vol = ann_return / sharpe
            sharpe_adj = (ann_return - RF_RATE) / vol if vol > 0 else sharpe
        else:
            sharpe_adj = sharpe
        sharpe = sharpe_adj
    except Exception:
        return None

    # 交易統計
    try:
        trades = pf.trades.records_readable
        n_trades = len(trades)
        if n_trades > 0 and "PnL" in trades.columns:
            wins = (trades["PnL"] > 0).sum()
            win_rate = float(wins / n_trades)
            gross_profit = float(trades[trades["PnL"] > 0]["PnL"].sum())
            gross_loss = abs(float(trades[trades["PnL"] < 0]["PnL"].sum()))
            profit_factor = gross_profit / gross_loss if gross_loss > 0 else 99.0
        else:
            win_rate = 0
            profit_factor = 0
    except Exception:
        n_trades = 0
        win_rate = 0
        profit_factor = 0

    # Buy & Hold 對比基準（兩腿各 50% 持有，dollar-neutral 起始）
    bh_metrics = _buy_hold_benchmark(prices, code_a, code_b, common.index)

    return {
        "code_a": code_a,
        "code_b": code_b,
        "hedge_ratio": round(float(slope), 4),
        "total_return_pct": round(total_return * 100, 2),
        "annual_return_pct": round(ann_return * 100, 2),
        "sharpe": round(sharpe, 3),
        "sortino": round(sortino, 3) if sortino is not None else None,
        "max_drawdown_pct": round(max_dd * 100, 2),
        "calmar": round(calmar, 3) if calmar is not None else None,
        "n_trades": n_trades,
        "win_rate_pct": round(win_rate * 100, 1),
        "profit_factor": round(profit_factor, 2),
        "fee_cost_total": round(TOTAL_ROUND_TRIP * n_trades * 100, 2),
        # Buy & Hold 對比
        "bh_total_return_pct": bh_metrics["total_return_pct"],
        "bh_annual_return_pct": bh_metrics["annual_return_pct"],
        "bh_sharpe": bh_metrics["sharpe"],
        "bh_max_drawdown_pct": bh_metrics["max_drawdown_pct"],
        # 策略相對 B&H 嘅超額
        "alpha_vs_bh_pct": round(total_return * 100 - bh_metrics["total_return_pct"], 2),
        "sharpe_vs_bh": round(sharpe - bh_metrics["sharpe"], 3) if bh_metrics["sharpe"] is not None else None,
        "beat_bh": total_return * 100 > bh_metrics["total_return_pct"],
    }


def walk_forward_vbt(prices, code_a, code_b, train_ratio=0.7):
    """Walk-forward 驗證：樣本內調參，樣本外測試。"""
    a = prices[code_a]
    b = prices[code_b]
    common = pd.concat([a, b], axis=1, join="inner").dropna()
    n = len(common)
    split = int(n * train_ratio)

    train = common.iloc[:split]
    test = common.iloc[split:]

    if len(train) < 20 or len(test) < 10:
        return None

    train_res = vbt_backtest_pair(train, code_a, code_b)
    test_res = vbt_backtest_pair(test, code_a, code_b)

    if train_res is None or test_res is None:
        return None

    is_sharpe = train_res["sharpe"]
    oos_sharpe = test_res["sharpe"]
    degradation = is_sharpe - oos_sharpe
    robust = oos_sharpe > 0 and (oos_sharpe / max(is_sharpe, 0.01)) > 0.5

    return {
        "in_sample_sharpe": round(is_sharpe, 3),
        "out_sample_sharpe": round(oos_sharpe, 3),
        "sharpe_degradation": round(degradation, 3),
        "oos_return_pct": test_res["total_return_pct"],
        "oos_max_dd_pct": test_res["max_drawdown_pct"],
        "robust": robust,
    }


def run_all_backtests(prices, high_corr_pairs, max_pairs=50, walk_forward=True):
    """對所有高相關性 pair 跑 VectorBT 回測。"""
    print("\n" + "=" * 70)
    print(f"💰 Step 3: VectorBT Pair Trade 回測 (成本 {TOTAL_ROUND_TRIP*100:.2f}%/來回)")
    print("=" * 70)

    candidates = high_corr_pairs.head(max_pairs)
    print(f"\n  測試 {len(candidates)} 個高相關性 pair (VectorBT 向量化)...\n")

    results = []
    for i, (_, row) in enumerate(candidates.iterrows()):
        a, b = row["stock_a"], row["stock_b"]
        # 先做共整合檢定
        from scipy import stats as scs
        try:
            from statsmodels.tsa.stattools import adfuller
            ca = prices[a].dropna()
            cb = prices[b].dropna()
            common = pd.concat([ca, cb], axis=1, join="inner").dropna()
            if len(common) < 60:
                continue
            slope, intercept, _, _, _ = scs.linregress(common.iloc[:, 1], common.iloc[:, 0])
            resid = common.iloc[:, 0] - (intercept + slope * common.iloc[:, 1])
            adf_stat, p_value, *_ = adfuller(resid, maxlag=1)
            # 放寬至 p<0.20 (短數據共整合檢定 power 不足，但保留篩選)
            coint_p = p_value
            # 不再跳過，記錄 p 值供後續參考
        except Exception:
            continue

        # VectorBT 回測
        res = vbt_backtest_pair(prices, a, b)
        if res is None:
            continue
        res["correlation"] = round(float(row["correlation"]), 4)
        res["coint_p_value"] = round(float(coint_p), 4)

        # Walk-forward
        if walk_forward:
            wf = walk_forward_vbt(prices, a, b)
            if wf:
                res.update(wf)

        results.append(res)

        if (i + 1) % 10 == 0:
            print(f"  進度: {i+1}/{len(candidates)} (成功 {len(results)})")

    if not results:
        print("\n  ⚠️ 冇 pair 通過共整合檢定，放寬至直接回測所有高相關性 pair")
        for _, row in candidates.iterrows():
            a, b = row["stock_a"], row["stock_b"]
            res = vbt_backtest_pair(prices, a, b)
            if res is None:
                continue
            res["correlation"] = round(float(row["correlation"]), 4)
            res["coint_p_value"] = None
            if walk_forward:
                wf = walk_forward_vbt(prices, a, b)
                if wf:
                    res.update(wf)
            results.append(res)

    results_df = pd.DataFrame(results).sort_values("sharpe", ascending=False).reset_index(drop=True)

    print(f"\n  ✓ 成功回測 {len(results_df)} 個 pair")
    return results_df


