def fetch_hsi_prices(days=500, cache_path=None):
    """攞 HSI 成分股前復權日 K 線（富途 API）。"""
    import futu

    if cache_path and cache_path.exists():
        cached = pd.read_pickle(cache_path)
        # 只用最近 days 日
        cached = cached.tail(days)
        print(f"✓ 從 cache 載入: {cached.shape[0]} 日 × {cached.shape[1]} 股")
        return cached

    ctx = futu.OpenQuoteContext(host=FUTU_HOST, port=FUTU_PORT)
    try:
        ret, data = ctx.get_plate_stock("HK.800000")
        if ret != futu.RET_OK:
            raise RuntimeError(f"無法取得 HSI 成分股: {data}")

        stocks = []
        for _, row in data.iterrows():
            code = row.get("code", "")
            if code.startswith("HK.0") or code.startswith("HK.9"):
                stocks.append({"code": code, "name": row.get("stock_name", "")})
        print(f"✓ 取得 {len(stocks)} 隻 HSI 成分股")

        all_data = {}
        total = len(stocks)
        for i, s in enumerate(stocks):
            code = s["code"]
            try:
                result = ctx.request_history_kline(
                    code, ktype=futu.KLType.K_DAY,
                    autype=futu.AuType.QFQ, max_count=days,
                )
                if len(result) == 3:
                    ret, df, _ = result
                else:
                    ret, df = result
                if ret == futu.RET_OK and not df.empty:
                    ts = pd.to_datetime(df["time_key"])
                    all_data[code] = pd.Series(df["close"].values, index=ts, name=code)
            except Exception:
                pass
            if (i + 1) % 20 == 0 or i == total - 1:
                print(f"  K線進度: {i+1}/{total} ({len(all_data)} 有數據)")
            time.sleep(0.05)
    finally:
        ctx.close()

    prices = pd.DataFrame(all_data).sort_index().dropna(how="all")
    print(f"✓ {prices.shape[0]} 交易日 × {prices.shape[1]} 股票")
    if cache_path:
        prices.to_pickle(cache_path)
    return prices.tail(days)


