def full_correlation_report(prices):
    """計算完整相關性矩陣 + 所有 pair 排序列表 + heatmap。"""
    print("\n" + "=" * 70)
    print("📊 Step 2: 完整相關性分析（所有股票 pair）")
    print("=" * 70)

    returns = prices.pct_change().dropna()
    corr = returns.corr()
    n_stocks = len(corr)

    # 排除對角線的所有 pair
    mask = ~np.eye(n_stocks, dtype=bool)
    corr_stacked = corr.where(mask).stack()

    # 去重 (A,B) vs (B,A)
    pairs = []
    seen = set()
    for (a, b), val in corr_stacked.items():
        key = tuple(sorted([a, b]))
        if key not in seen:
            seen.add(key)
            pairs.append({
                "stock_a": a,
                "stock_b": b,
                "name_a": "",
                "name_b": "",
                "correlation": round(float(val), 4),
                "abs_corr": round(abs(float(val)), 4),
            })

    pairs_df = pd.DataFrame(pairs).sort_values("abs_corr", ascending=False).reset_index(drop=True)

    # 統計
    avg = pairs_df["correlation"].mean()
    med = pairs_df["correlation"].median()
    pos = (pairs_df["correlation"] > 0).sum()
    neg = (pairs_df["correlation"] < 0).sum()
    high = (pairs_df["correlation"] >= 0.6).sum()
    very_high = (pairs_df["correlation"] >= 0.8).sum()
    anti = (pairs_df["correlation"] <= -0.3).sum()

    print(f"\n  📈 統計概況 ({n_stocks} 股 × {len(pairs_df)} pair):")
    print(f"     平均相關係數:   {avg:+.4f}")
    print(f"     中位數:         {med:+.4f}")
    print(f"     正相關 pair:    {pos} ({pos/len(pairs_df)*100:.0f}%)")
    print(f"     負相關 pair:    {neg} ({neg/len(pairs_df)*100:.0f}%)")
    print(f"     高相關 (≥0.6):  {high} pair")
    print(f"     極高 (≥0.8):    {very_high} pair")
    print(f"     反向 (≤-0.3):   {anti} pair")

    print(f"\n  🔝 Top 20 最高相關性 pair:")
    print(f"     {'Stock A':<12} {'Stock B':<12} {'Corr':>8}")
    print(f"     {'-'*12} {'-'*12} {'-'*8}")
    for _, r in pairs_df.head(20).iterrows():
        print(f"     {r['stock_a']:<12} {r['stock_b']:<12} {r['correlation']:>+8.4f}")

    print(f"\n  🔻 Top 10 最低/反向相關性 pair:")
    for _, r in pairs_df.tail(10).iterrows():
        print(f"     {r['stock_a']:<12} {r['stock_b']:<12} {r['correlation']:>+8.4f}")

    # 儲存
    corr.to_csv(OUTPUT_DIR / "correlation_matrix_full.csv")
    pairs_df.to_csv(OUTPUT_DIR / "correlation_all_pairs.csv", index=False)
    pairs_df[pairs_df["correlation"] >= 0.6].to_csv(
        OUTPUT_DIR / "correlation_high_pairs.csv", index=False)
    print(f"\n  ✓ 已儲存:")
    print(f"     - correlation_matrix_full.csv ({n_stocks}×{n_stocks} 矩陣)")
    print(f"     - correlation_all_pairs.csv ({len(pairs_df)} pair 完整列表)")
    print(f"     - correlation_high_pairs.csv ({high} 個高相關性 pair)")

    # Heatmap (matplotlib)
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt

        fig, ax = plt.subplots(figsize=(14, 12))
        im = ax.imshow(corr.values, cmap="RdYlGn", vmin=-1, vmax=1, aspect="auto")
        ax.set_xticks(range(n_stocks))
        ax.set_yticks(range(n_stocks))
        labels = [c.replace("HK.", "") for c in corr.columns]
        ax.set_xticklabels(labels, rotation=90, fontsize=6)
        ax.set_yticklabels(labels, fontsize=6)
        ax.set_title("HSI Constituents Correlation Matrix", fontsize=14)
        plt.colorbar(im, ax=ax, label="Correlation")
        plt.tight_layout()
        plt.savefig(OUTPUT_DIR / "correlation_heatmap.png", dpi=150)
        plt.close()
        print(f"     - correlation_heatmap.png (視覺化熱力圖)")
    except Exception as e:
        print(f"     (heatmap 生成失敗: {e})")

    return pairs_df, corr


