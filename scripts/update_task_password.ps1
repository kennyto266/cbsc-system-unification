# ============================================================
#  CBSC_Daily_Update 排程任務 — 用新密碼安全重新註冊
#
#  用途：當你變更 Windows 登入密碼後，用此工具更新排程任務
#        所儲存的密碼（否則 16:15 後台執行會因密碼不符而失敗）。
#
#  特點：用 Get-Credential 彈窗輸入，密碼以星號遮蔽，
#        不會顯示在 console、不會寫入任何檔案、不會進入對話紀錄。
#
#  用法（雙擊 update_task_password.cmd 即可）：
#    powershell -ExecutionPolicy Bypass -File scripts\update_task_password.ps1
# ============================================================

$ErrorActionPreference = 'Stop'

$taskName = 'CBSC_Daily_Update'
$xmlPath  = Join-Path $PSScriptRoot 'cbsc_task.xml'

if (-not (Test-Path $xmlPath)) {
    throw "找不到任務定義檔：$xmlPath（請確認此腳本位於 scripts\ 目錄下）"
}

# 彈窗式密碼輸入 — 密碼全程遮蔽，不落明文
$cred = Get-Credential -UserName 'Penguin8n' -Message '輸入當前的 Windows 登入密碼（用於排程後台執行）。密碼不會被記錄。'
if (-not $cred -or [string]::IsNullOrEmpty($cred.GetNetworkCredential().Password)) {
    Write-Output '已取消。排程任務未變更。'
    exit 1
}

# 從 SecureString 取出明文（僅在記憶體中、用完即清）
$bstr  = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($cred.Password)
$plain = [Runtime.InteropServices.Marshal]::PtrToStringAuto($bstr)
[Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)

try {
    $xml = Get-Content $xmlPath -Raw | Out-String
    Register-ScheduledTask -TaskName $taskName -Xml $xml -User 'Penguin8n' -Password $plain -Force | Out-Null
}
finally {
    # 立即清除記憶體中的明文密碼
    $plain = $null
    [GC]::Collect()
}

Write-Output ''
Write-Output '============================================================'
Write-Output ('OK 排程任務 ' + $taskName + ' 已用新密碼重新註冊')
Write-Output '   LogonType: Password（無需登入即可 16:15 後台執行）'
Write-Output '============================================================'
Write-Output ''
Write-Output '下一步：建議立即測試一次以確認密碼正確（無需等到 16:15）：'
Write-Output '   powershell -Command "Start-ScheduledTask -TaskName CBSC_Daily_Update"'
Write-Output "   然後查看 data\daily_update.log 最後幾行是否出現 ✅"
