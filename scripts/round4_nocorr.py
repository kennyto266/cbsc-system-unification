# C1: Upper shadow rejection NO momentum (pure candlestick)
def uprej_nomom(close, df, shadow_mult=2.0, vol_mult=1.5):
    opn = df['open'].astype(float); high = df['high'].astype(float)
    vol = df['volume'].astype(float)
    body = (close - opn).abs()
    upper_shadow = (high - opn.clip(lower=close))
    rejection = upper_shadow > body * shadow_mult
    vol_spike = vol > vol.rolling(20).mean() * vol_mult
    return (rejection & vol_spike).shift(1).fillna(False)

# C2: Hammer NO momentum
def hammer_nomom(close, df, shadow_mult=2.0):
    opn = df['open'].astype(float); high = df['high'].astype(float); low = df['low'].astype(float)
    body = (close - opn).abs()
    lower_shadow = (opn.clip(upper=close) - low)
    avg_body = body.rolling(20).mean()
    hammer = (lower_shadow > body * shadow_mult) & (lower_shadow > avg_body)
    return hammer.shift(1).fillna(False)

# C3: Volume reversal — high volume + price drop → buy (exhaustion)
def vol_drop(close, df, vol_mult=1.5, drop=0.02):
    vol = df['volume'].astype(float)
    vol_spike = vol > vol.rolling(20).mean() * vol_mult
    price_drop = close.pct_change() < -drop
    return (vol_spike & price_drop).shift(1).fillna(False)

# C4: Intraday close strength NO momentum
def close_strong(close, df, thresh=0.8):
    high = df['high'].astype(float); low = df['low'].astype(float)
    rng = high - low
    close_pos = (close - low) / rng.replace(0, np.nan)
    return (close_pos > thresh).shift(1).fillna(False)

# C5: Doji NO momentum
def doji_nomom(close, df, body_r=0.3, vol_mult=1.3):
    opn = df['open'].astype(float); high = df['high'].astype(float); low = df['low'].astype(float)
    vol = df['volume'].astype(float)
    rng = high - low; body = (close - opn).abs()
    doji = body < rng * body_r
    vol_high = vol > vol.rolling(20).mean() * vol_mult
    return (doji & vol_high).shift(1).fillna(False)

# C6: 2-bar reversal (down bar followed by up bar)
def two_bar_rev(close, df):
    opn = df['open'].astype(float)
    bar1_down = close.shift(1) < opn.shift(1)
    bar2_up = close > opn
    return (bar1_down & bar2_up).shift(1).fillna(False)

# C7: Inside bar breakout (today's range inside yesterday's, breakout next)
def inside_break(close, df):
    high = df['high'].astype(float); low = df['low'].astype(float)
    inside = (high < high.shift(1)) & (low > low.shift(1))
    breakout = close > high.shift(1)
    return (inside.shift(1) & breakout).shift(1).fillna(False)

# C8: Wide range down + narrow range up (NR7 after WR)
def wr_nr(close, df):
    high = df['high'].astype(float); low = df['low'].astype(float)
    rng = high - low
    avg_rng = rng.rolling(20).mean()
    wide = rng.shift(1) > avg_rng.shift(1) * 1.5
    narrow = rng < avg_rng * 0.5
    return (wide & narrow).shift(1).fillna(False)

