def print_results_table(results, title=""):
    """打印結果表格。"""
    print("\n" + "=" * 95)
    print(title)
    print("=" * 95)

    if not results:
        print("  無結果")
        return

    df = pd.DataFrame(results)
    print("\n{:<4} {:<28} {:<12} {:>7} {:>8} {:>7} {:>5} {:>5} {:>5}".format(
        "#", "策略", "股票", "Sharpe", "AnnRet%", "MaxDD%", "Trd", "Win%", "PF"))
    print("-" * 95)
    for i, (_, r) in enumerate(df.iterrows(), 1):
        strat = str(r.get("strategy", ""))[:26]
        stock = str(r.get("stock", ""))[:10]
        print("{:<4} {:<28} {:<12} {:>7.2f} {:>7.1f}% {:>6.1f}% {:>5} {:>4.0f}% {:>5.2f}".format(
            i, strat, stock, r["sharpe"], r["annual_return_pct"],
            r["max_drawdown_pct"], r["n_trades"], r["win_rate_pct"], r["profit_factor"]))

    # 匯總
    print("\n📊 匯總:")
    print("   Sharpe 中位數: {:.2f}".format(df["sharpe"].median()))
    print("   Sharpe > 0:    {}/{}".format((df["sharpe"] > 0).sum(), len(df)))
    print("   Sharpe > 1:    {}/{}".format((df["sharpe"] > 1).sum(), len(df)))
    print("   平均年回報:    {:.1f}%".format(df["annual_return_pct"].mean()))
    print("   平均 MaxDD:    {:.1f}%".format(df["max_drawdown_pct"].mean()))


