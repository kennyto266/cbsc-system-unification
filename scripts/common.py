def load_prices(days=None):
    """載入 HSI 成分股價格。"""
    cache = DATA_DIR / "hsi_prices.pkl"
    if not cache.exists():
        raise FileNotFoundError("請先運行 pair_trade_vbt.py 建立 hsi_prices.pkl")
    prices = pd.read_pickle(cache)
    if days:
        prices = prices.tail(days)
    return prices


def load_returns(days=None):
    """載入收益率。"""
    prices = load_prices(days)
    return prices.pct_change().dropna()


