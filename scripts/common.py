def backtest_signals(close, entries, exits, short_entries=None, short_exits=None,
                     init_cash=100_000, fees=None, stock_code=None):
    """用 VectorBT 回測信號。

    委派到 trading_core.engine.backtest_signals() (2026-07 統一框架).
    修正: 用 trading_core 嘅正確 Sharpe 計算 (唔再用 vol=ann_ret/sharpe 反推).

    Args:
        close: 收盤價 Series.
        entries/exits: 進出場信號 Series (bool).
        short_entries/short_exits: 做空信號 (optional).
        init_cash: 初始資金.
        fees: 直接指定 per-side 成本 (向後兼容). 如果 None, 用 stock_code 判斷.
        stock_code: 股票代碼 (如 "HK.00700"), 用於 instrument-aware 成本判斷.
                    ETF (如 "HK.03066") 免印花稅 → 成本大降.

    Returns:
        vbt.Portfolio 或 None.
    """
    # 委派到 trading_core 引擎
    try:
        from trading_core.engine import backtest_signals as _tc_bs
        from trading_core.costs import get_market_for_code, get_per_side as _tc_gps
    except ImportError:
        # trading_core 唔喺 path — fallback 到本地實現 (安全降級)
        _tc_bs = None

    if _tc_bs is not None:
        # 決定 market + fees
        if fees is not None:
            # 舊調用方式: 直接傳入 fees
            return _tc_bs(close, entries, exits, short_entries, short_exits,
                          market="hk_stock", init_cash=init_cash, fees_override=fees)
        elif stock_code:
            market = get_market_for_code(stock_code)
            return _tc_bs(close, entries, exits, short_entries, short_exits,
                          market=market, init_cash=init_cash)
        else:
            # 無 stock_code 也無 fees — 用港股股票預設成本
            return _tc_bs(close, entries, exits, short_entries, short_exits,
                          market="hk_stock", init_cash=init_cash)
    # Fallback: trading_core 唔可用時嘅本地實現
    _fees = fees if fees is not None else FEE_PER_SIDE
    entries = entries.fillna(False)
    exits = exits.fillna(False)
    kwargs = dict(close=close, entries=entries, exits=exits, fees=_fees,
                  freq="1D", init_cash=init_cash)
    if short_entries is not None:
        kwargs["short_entries"] = short_entries.fillna(False)
        se = short_exits if short_exits is not None else exits
        kwargs["short_exits"] = se.fillna(False)
    try:
        return vbt.Portfolio.from_signals(**kwargs)
    except Exception:
        return None


def extract_metrics(pf, strategy_name, stock_code):
    """從 Portfolio 提取專業指標。

    委派到 trading_core.engine.extract_metrics() (2026-07 統一框架).
    修正: Sharpe 用 daily returns 直接計, 唔再用 vol=ann_ret/sharpe 反推.
    """
    if pf is None:
        return None
    # 委派到 trading_core (修正 Sharpe bug)
    try:
        from trading_core.engine import extract_metrics as _tc_em
        from trading_core.costs import get_market_for_code
        market = get_market_for_code(stock_code) if stock_code else "hk_stock"
        result = _tc_em(pf, strategy_name, stock_code, market=market)
        if result is not None:
            # 補充 trading_core 唔返回嘅 final_value (舊 API 兼容)
            try:
                result["final_value"] = round(float(pf.value().iloc[-1]), 0)
            except Exception:
                result["final_value"] = 0
            # trading_core 用 "asset" key, 舊代碼用 "stock" — 兼容
            result["stock"] = stock_code
            return result
    except ImportError:
        pass

    # Fallback: trading_core 唔可用時嘅本地實現 (保留舊邏輯, 但有已知 Sharpe bug)
    try:
        total_ret = float(pf.total_return())
        ann_ret = float(pf.annualized_return())
        sharpe = float(pf.sharpe_ratio())
        sortino = float(pf.sortino_ratio())
        max_dd = float(pf.max_drawdown())
        calmar = float(pf.calmar_ratio())
        trades = pf.trades.records_readable
        n_trades = len(trades)
        if n_trades > 0 and "PnL" in trades.columns:
            wins = (trades["PnL"] > 0).sum()
            win_rate = float(wins / n_trades)
            gp = float(trades[trades["PnL"] > 0]["PnL"].sum())
            gl = abs(float(trades[trades["PnL"] < 0]["PnL"].sum()))
            profit_factor = gp / gl if gl > 0 else 99.0
        else:
            win_rate = 0
            profit_factor = 0
        final_value = float(pf.value().iloc[-1])
        # Sharpe 扣 rf (注意: 呢個 fallback 仍有 vol=ann_ret/sharpe bug,
        # 但只在 trading_core 唔可用時先會執行)
        if sharpe != 0 and ann_ret != 0:
            vol = ann_ret / sharpe
            sharpe = (ann_ret - RF_RATE) / vol if vol > 0 else sharpe
        return {
            "strategy": strategy_name, "stock": stock_code,
            "final_value": round(final_value, 0),
            "total_return_pct": round(total_ret * 100, 2),
            "annual_return_pct": round(ann_ret * 100, 2),
            "sharpe": round(sharpe, 3), "sortino": round(sortino, 3),
            "max_drawdown_pct": round(max_dd * 100, 2),
            "calmar": round(calmar, 3), "n_trades": n_trades,
            "win_rate_pct": round(win_rate * 100, 1),
            "profit_factor": round(profit_factor, 2),
        }
    except Exception:
        return None


def buy_hold_benchmark(close, init_cash=100_000, fees=FEE_PER_SIDE):
    """Buy & Hold 基準。"""
    try:
        return vbt.Portfolio.from_holding(close, init_cash=init_cash, fees=fees, freq="1D")
    except Exception:
        return None


