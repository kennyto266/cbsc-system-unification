def compute_rsi(close, period=14):
    """RSI"""
    delta = close.diff()
    gain = delta.where(delta > 0, 0)
    loss = -delta.where(delta < 0, 0)
    avg_gain = gain.rolling(period).mean()
    avg_loss = loss.rolling(period).mean()
    rs = avg_gain / avg_loss.replace(0, np.nan)
    return 100 - (100 / (1 + rs))


def compute_atr(df, period=14):
    """ATR"""
    tr = pd.concat([
        df["high"] - df["low"],
        abs(df["high"] - df["close"].shift(1)),
        abs(df["low"] - df["close"].shift(1))
    ], axis=1).max(axis=1)
    return tr.rolling(period).mean()


def compute_zscore(series, window=250):
    """Z-Score"""
    return (series - series.rolling(window).mean()) / series.rolling(window).std().replace(0, np.nan)


def compute_efficiency_ratio(close, n=20):
    """Efficiency Ratio = 淨變動 / 總波動"""
    net_change = abs(close - close.shift(n))
    total_change = close.diff(1).abs().rolling(n).sum()
    return net_change / total_change.replace(0, np.nan)


def compute_sma(close, period):
    """Simple Moving Average"""
    return close.rolling(period).mean()


def compute_macd(close, fast=12, slow=26, signal=9):
    """MACD"""
    ema_fast = close.ewm(span=fast, adjust=False).mean()
    ema_slow = close.ewm(span=slow, adjust=False).mean()
    macd_line = ema_fast - ema_slow
    signal_line = macd_line.ewm(span=signal, adjust=False).mean()
    return macd_line, signal_line


def compute_volume_profile(close, volume, bins=50):
    """Volume Profile - 每日計算 Max Volume Price Level"""
    # 簡化：用 rolling window 計算
    window = 250
    mvpl_series = pd.Series(index=close.index, dtype=float)
    for i in range(window, len(close)):
        c = close.iloc[i-window:i]
        v = volume.iloc[i-window:i]
        price_bins = pd.cut(c, bins=bins)
        vp = pd.Series(v.values, index=price_bins).groupby(level=0).sum()
        if not vp.empty:
            mvpl_series.iloc[i] = vp.idxmax().mid
    return mvpl_series


def compute_channel_range(df, window=20):
    """區間幅度"""
    rolling_high = df["high"].rolling(window).max()
    rolling_low = df["low"].rolling(window).min()
    return (rolling_high - rolling_low) / df["close"], rolling_high, rolling_low


def find_pips(prices, order=5):
    """PIP (Perceptually Important Points) - 簡化版"""
    n = len(prices)
    if n < order + 2:
        return list(range(n))
    pips = [0, n - 1]
    for _ in range(order - 2):
        max_dist = 0
        max_idx = 0
        for i in range(1, n - 1):
            if i in pips:
                continue
            # 搵 i 屬於邊段
            pips_sorted = sorted(pips)
            for j in range(len(pips_sorted) - 1):
                if pips_sorted[j] < i < pips_sorted[j+1]:
                    # 計算到對角線距離
                    x1, y1 = pips_sorted[j], prices.iloc[pips_sorted[j]]
                    x2, y2 = pips_sorted[j+1], prices.iloc[pips_sorted[j+1]]
                    x0, y0 = i, prices.iloc[i]
                    # 點到線距離
                    if x2 - x1 != 0:
                        dist = abs((y2-y1)*x0 - (x2-x1)*y0 + x2*y1 - y2*x1) / np.sqrt((y2-y1)**2 + (x2-x1)**2)
                    else:
                        dist = abs(y0 - y1)
                    if dist > max_dist:
                        max_dist = dist
                        max_idx = i
                    break
        pips.append(max_idx)
    return sorted(pips)


def find_extrema(df, order=15, threshold_pct=0.10):
    """Extrema + Threshold 混合（瀨尿牛丸）

    修正 look-ahead bias: 原版用 highs.iloc[i-order:i+order+1] 包含未來 order 日,
    即係用未來數據判斷 i 係咪極值 (完美買底沽頂, Sharpe 虛高).
    修正版: 只向後睇 highs.iloc[i-order:i+1] (只到 i, 唔包未來),
    i 係過去 order 日窗口內既最高/最低點即為極值 (causal).
    """
    highs = df["high"]
    lows = df["low"]
    close = df["close"]
    n = len(df)
    is_maxima = pd.Series(False, index=df.index)
    is_minima = pd.Series(False, index=df.index)

    for i in range(order, n):
        # Extrema — 只用過去 order 日 (唔包未來), causal
        if highs.iloc[i] == highs.iloc[i-order:i+1].max():
            is_maxima.iloc[i] = True
        if lows.iloc[i] == lows.iloc[i-order:i+1].min():
            is_minima.iloc[i] = True
        # Threshold — 修正方向 (原版反轉: drop→應該 minima 買底, rise→應該 maxima 沽頂)
        window_close = close.iloc[max(0, i-order):i]
        if len(window_close) > 0:
            drop = (window_close.max() - close.iloc[i]) / window_close.max()
            rise = (close.iloc[i] - window_close.min()) / window_close.min() if window_close.min() > 0 else 0
            if drop > threshold_pct:
                is_minima.iloc[i] = True   # 跌得多 → 接近底 → 買入 (minima)
            if rise > threshold_pct:
                is_maxima.iloc[i] = True  # 升得多 → 接近頂 → 沽出 (maxima)
    return is_maxima, is_minima


def compute_sd_atr_spread(df, window=14):
    """SD - ATR Spread"""
    close = df["close"]
    pct_change = close.pct_change()
    sd = pct_change.rolling(window).std()
    atr = compute_atr(df, window)
    atr_pct = atr / close
    spread = sd - atr_pct
    return compute_zscore(spread, 250)


def compute_permutation_entropy(close, order=4, window=50, normalize=True):
    """Permutation Entropy"""
    patterns = list(permutations(range(order)))
    result = []
    values = close.values

    for i in range(window, len(values)):
        window_data = values[i-window:i]
        pe_values = []
        for j in range(len(window_data) - order + 1):
            segment = window_data[j:j+order]
            rank = tuple(np.argsort(np.argsort(segment)))
            pe_values.append(rank)

        counts = [pe_values.count(p) for p in patterns]
        total = sum(counts)
        if total == 0:
            result.append(np.nan)
            continue
        probs = np.array([c/total for c in counts if c > 0])
        pe = scipy_entropy(probs)
        if normalize:
            pe = pe / np.log(len(patterns))
        result.append(pe)

    return pd.Series(result, index=close.index[window:])


