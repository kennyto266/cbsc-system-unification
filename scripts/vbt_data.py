def _cache_gc():
    """清理 CACHE: 超過上限時移除最舊一半 entries (FIFO).
    簡單有效: 300 entries ≈ 100 隻股 × 3 個不同 date range, 正常唔會觸發.
    """
    if len(CACHE) > _CACHE_MAX:
        # 移除前半 (最舊既 entries)
        keys_to_remove = list(CACHE.keys())[: len(CACHE) // 2]
        for k in keys_to_remove:
            del CACHE[k]


