def load_stock_close(code: str):
    """讀 ohlcv_5y/{code}.csv 回 close Series. code 格式 'HK.00016'.

    [Bug D8 fix] Delegate to data_loader.load_stock_close (cached + .copy() protection).
    Falls back to local impl if data_loader unavailable.
    """
    try:
        from data_loader import load_stock_close as _dl_load
        result = _dl_load(code)
        return result.copy() if result is not None else None  # 防 cache mutation
    except ImportError:
        pass
    path = OHLCV_DIR / f"{code.replace('.', '_')}.csv"
    if not path.exists():
        return None
    try:
        df = pd.read_csv(path, parse_dates=["time_key"]).set_index("time_key").sort_index()
        return df["close"].astype(float)
    except Exception:
        return None


