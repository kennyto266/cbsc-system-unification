def load_leaderboard(min_sharpe: float = 1.0):
    """讀 param_sweep_all_results.csv, filter Sharpe>min_sharpe, 按降序."""
    if not SWEEP_CSV.exists():
        return pd.DataFrame()
    df = pd.read_csv(SWEEP_CSV)
    df = df.replace([float("inf"), -float("inf")], pd.NA).dropna(subset=["sharpe"])
    return df[df["sharpe"] > min_sharpe].sort_values("sharpe", ascending=False).reset_index(drop=True)


