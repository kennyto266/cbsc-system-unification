def _scan_factor_stocks():
    """掃描 ohlcv_5y/ 目錄, 回所有 HK_*.csv 對應既股票碼 (排序).

    排除 DEAD_STOCKS (已除牌/停更死股), 避免 live watchlist 撞板.
    """
    stocks = []
    if OHLCV_DIR.exists():
        for p in sorted(OHLCV_DIR.glob("HK_*.csv")):
            code = p.stem.replace("HK_", "HK.")
            if code in DEAD_STOCKS:
                continue
            stocks.append(code)
    return stocks

