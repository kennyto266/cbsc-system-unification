# VWAP vs close: when close >> vwap, strong; when close << vwap, weak
for stock in list(ohlcv_cache.keys())[:3]:
    df = ohlcv_cache[stock]
    typical = (df['high'] + df['low'] + df['close']) / 3
    vwap = (typical * df['volume']).rolling(20).sum() / df['volume'].rolling(20).sum()
    print(f'  {stock} sample: close={df["close"].iloc[-1]:.2f} vwap={vwap.iloc[-1]:.2f}')
    break

# VWAP divergence portfolio
all_rets = {}
for stock, df in ohlcv_cache.items():
    if len(df) < 400: continue
    close = df['close'].astype(float)
    typical = (df['high'].astype(float) + df['low'].astype(float) + close) / 3
    vol = df['volume'].astype(float)
    vwap = (typical * vol).rolling(10).sum() / vol.rolling(10).sum().replace(0, np.nan)
    div = (close - vwap) / vwap
    div_z = (div - div.rolling(60).mean()) / div.rolling(60).std().replace(0, np.nan)
    # Close well below VWAP → buy (reversion)
    entries = (div_z < -1.5).shift(1).fillna(False)
    ret1 = close.pct_change()
    pos = pd.Series(0, index=close.index); in_pos=False; dl=0
    for i in range(len(close)):
        if entries.iloc[i] and not in_pos: in_pos=True; dl=3
        pos.iloc[i]=1 if in_pos else 0
        if in_pos:
            dl-=1
            if dl<=0: in_pos=False
    all_rets[stock] = (pos.shift(1)*ret1).dropna()
if all_rets:
    daily = pd.DataFrame(all_rets).mean(axis=1, skipna=True)
    report('VWAP_revert_z<-1.5', daily)

