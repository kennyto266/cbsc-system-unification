def compute_union_returns():
    all_rets = {}
    for stock, df in ohlcv_cache.items():
        close = df['close'].astype(float)
        vol = df['volume'].astype(float)
        high = df['high'].astype(float)
        low = df['low'].astype(float)
        ret1 = close.pct_change()
        # A159
        ef = close.ewm(span=12,adjust=False).mean(); es = close.ewm(span=26,adjust=False).mean()
        m=ef-es; sg=m.ewm(span=9,adjust=False).mean(); h=m-sg
        e1=((h>0)&(h>h.shift(1))).shift(1).fillna(False)
        vs=(vol-vol.rolling(20).mean())/vol.rolling(20).std().replace(0,np.nan)
        e2=((vs>1.5)&(close.pct_change(5)>0)).shift(1).fillna(False)
        # A160
        sma100=close.rolling(100).mean(); dev=(close-sma100)/sma100
        z160=(dev-dev.rolling(120).mean())/dev.rolling(120).std().replace(0,np.nan)
        # A161
        tr=pd.concat([(high-low),(high-close.shift()).abs(),(low-close.shift()).abs()],axis=1).max(axis=1)
        atr=tr.rolling(14).mean(); ap=atr/close
        la=ap.rolling(60).rank(pct=True)<0.15; sma50=close.rolling(50).mean()
        # A162
        va=vix.reindex(close.index).ffill()
        z162=(va-va.rolling(90).mean())/va.rolling(90).std().replace(0,np.nan)
        # A163
        typical=(high+low+close)/3
        vwap=(typical*vol).rolling(10).sum()/vol.rolling(10).sum().replace(0,np.nan)
        dev2=(close-vwap)/vwap
        z163=(dev2-dev2.rolling(60).mean())/dev2.rolling(60).std().replace(0,np.nan)
        # Union position
        pos = pd.Series(False, index=close.index)
        for entries, hold in [
            ((e1&e2).fillna(False), 3),
            ((z160<-1.5).shift(1).fillna(False), 10),
            ((la&(close>sma50)).shift(1).fillna(False), 3),
            ((z162>2.0).shift(1).fillna(False), 5),
            ((z163<-2.0).shift(1).fillna(False), 5),
        ]:
            p2 = pd.Series(False, index=close.index)
            in_p=False; dl=0
            for i in range(len(close)):
                if entries.iloc[i] and not in_p: in_p=True; dl=hold
                p2.iloc[i]=in_p
                if in_p: dl-=1
                if dl<=0: in_p=False
            pos = pos | p2
        all_rets[stock] = pos.astype(float).shift(1) * ret1
    return pd.DataFrame(all_rets).mean(axis=1, skipna=True)

print('Computing Union returns...')
union_daily = compute_union_returns()

def calc_stats(rets, split=SPLIT):
    oos = rets[rets.index >= split].dropna()
    if len(oos) < 20 or oos.std() == 0: return 0, 0, 0
    sr = oos.mean()/oos.std()*np.sqrt(252)
    ret = (1+oos).cumprod().iloc[-1]-1
    dd = ((1+oos).cumprod()/(1+oos).cumprod().cummax()-1).min()
    return sr, ret, dd

def apply_filter(union_ret, filter_series):
    """Apply boolean filter (True=trade, False=cash). shift(1) to avoid look-ahead."""
    return union_ret * filter_series.shift(1).fillna(True).astype(float)

