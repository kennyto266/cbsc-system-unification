def load_factor(name):
    p = FAC / f'{name}.csv'
    if not p.exists(): return None
    df = pd.read_csv(p)
    dc = [c for c in df.columns if 'date' in c.lower() or c.lower() in ['time','ds']][0]
    df = df.set_index(pd.to_datetime(df[dc])).sort_index()
    for c in df.columns:
        if c != dc and df[c].dtype in [np.float64, np.int64, float, int]:
            return df[c].astype(float)
    return df.iloc[:,0].astype(float)

