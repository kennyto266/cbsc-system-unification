# ===== D29: Intraday — Close position in bar (high-close ratio) =====
print('\n--- D29: Intraday Close Strength ---')
for thresh in [0.7, 0.8, 0.9]:
    def entry(close, df, t=thresh):
        high = df['high'].astype(float)
        low = df['low'].astype(float)
        # Close in top t% of day's range = bullish
        rng = high - low
        close_pos = (close - low) / rng.replace(0, np.nan)
        strong = close_pos > t
        mom = close.pct_change(5) > 0
        return (strong & mom).shift(1).fillna(False)
    report(f'CloseTop{thresh:.0%}+mom', compute_portfolio(entry, hold=3))

# ===== D30: Hammer / Reversal candle (long lower shadow) =====
print('\n--- D30: Hammer Reversal ---')
for shadow_r in [1.5, 2.0, 3.0]:
    def entry(close, df, sr=shadow_r):
        opn = df['open'].astype(float)
        high = df['high'].astype(float)
        low = df['low'].astype(float)
        body = (close - opn).abs()
        lower_shadow = (opn.clip(upper=close) - low)
        avg_body = body.rolling(20).mean()
        # Lower shadow >> body = hammer
        hammer = (lower_shadow > body * sr) & (lower_shadow > avg_body)
        return hammer.shift(1).fillna(False)
    report(f'Hammer shadow×{shadow_r}', compute_portfolio(entry, hold=3))

# ===== D31: Upper shadow rejection (shooting star short-avoid → buy dip) =====
print('\n--- D31: Upper Shadow + Volume (institutional selling exhaustion) ---')
for sr in [2.0, 3.0]:
    def entry(close, df, s=sr):
        opn = df['open'].astype(float)
        high = df['high'].astype(float)
        low = df['low'].astype(float)
        vol = df['volume'].astype(float)
        body = (close - opn).abs()
        upper_shadow = (high - opn.clip(lower=close))
        rejection = upper_shadow > body * s
        vol_spike = vol > vol.rolling(20).mean() * 1.5
        # Big upper shadow + volume → selling exhaustion → buy
        return (rejection & vol_spike).shift(1).fillna(False)
    report(f'UpRej×{sr}+vol', compute_portfolio(entry, hold=3))

# ===== D32: Gap down + recovery (open low, close high) =====
print('\n--- D32: Gap Down Recovery ---')
for gd in [0.02, 0.03]:
    def entry(close, df, g=gd):
        opn = df['open'].astype(float)
        high = df['high'].astype(float)
        gap = opn / close.shift(1) - 1
        # Gap down > g% but close above open (recovery)
        recovered = close > opn
        return ((gap < -g) & recovered).shift(1).fillna(False)
    report(f'GapDown{gd:.0%}+recover', compute_portfolio(entry, hold=3))

# ===== D33: Calendar — pre-holiday effect (last 3 trading days before month-end) =====
