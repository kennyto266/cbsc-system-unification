def scrape_paper_ids(category, limit=15):
    """用 webclaw scrape ArXiv 類別頁, 拎論文 ID."""
    url = f"https://arxiv.org/list/{category}/recent"
    try:
        r = subprocess.run(
            [str(WEBCRAW), url, "--format", "text", "--only-main-content"],
            capture_output=True, text=True, timeout=30, env=ENV,
        )
        ids = []
        for line in r.stdout.split("\n"):
            # 格式: arXiv:2606.27335
            if "arXiv:" in line:
                for part in line.split():
                    if part.startswith("arXiv:") and len(part) > 10:
                        ids.append(part.replace("arXiv:", ""))
        return ids[:limit]
    except Exception as e:
        print(f"⚠️ scrape {category} 失敗: {e}", file=sys.stderr)
        return []


def extract_alpha(paper_id):
    """用 webclaw + GLM extract 論文, 判斷有冭 alpha (extract-json 快過 extract-prompt).

    cross-pollination context 放入 schema description (extract-json 會連 schema 一齊傳俾 LLM).
    """
    url = f"https://arxiv.org/abs/{paper_id}"
    # extract-json: schema description 帶 cross-pollination 提示 (比 extract-prompt 快 3-5x)
    schema = json.dumps({
        "title": f"string. 成功轉化案例參考: PIP(IEEE mining→背馡), Shannon(資訊論→再平衡), Permutation Entropy(物理→regime), Bayes(概率→濾網)",
        "field": "string",
        "applicable": "boolean. true=方法能轉化為交易策略,任何領域都得(數學/物理/CS/經濟)",
        "alpha_idea": "string. 點轉化為交易edge? 1-2句. 空=唔得",
        "data_needed": "string. 需要咩data",
        "direction": "string. long/short/long-short",
        "enhances_hkptrc": "string. 可強化邊個策略(Extrema/EfficiencyRatio/VolumeProfile/ZScore/PermutationEntropy/Bayes/Shannon/EquityCurve/CCASS/SEC13F/SD-ATR/藍籌領先). 空=唔適用",
        "source_analogy": "string. 同邊個轉化案例類似. 空=唔適用",
    }, ensure_ascii=False)
    try:
        r = subprocess.run(
            [str(WEBCRAW), url, "--extract-json", schema, "--only-main-content"],
            capture_output=True, text=True, timeout=60, env=ENV,
        )
        return json.loads(r.stdout.strip())
    except Exception as e:
        return {"title": f"err:{paper_id}", "applicable": False,
                "alpha_idea": "", "error": str(e)}


