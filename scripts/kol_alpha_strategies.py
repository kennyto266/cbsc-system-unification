# ALPHA-48｜流動性反轉 (Illiquidity Reversal) — SSRN 6630998
# ============================================================
def alpha_48(prices, stock, ret_window=5, illiq_window=20, z_window=252,
             threshold=1.0, holding=5):
    """流動性反轉: 低流動性 + 急跌 → 非信息性拋售 → 反轉.

    靈感: "Short-Term Reversal Persists Globally—If Properly Measured" (SSRN 6630998).
          原始反轉弱, 但「低流動性排序」既反轉顯著 — 因為低流動性股票既拋售
          係非信息性 (指數/資金流), 流動性提供者吸收後反彈.
    邏輯: 5日報酬 Z-score 極負 + 換手率低 (流動性差) → 做多反轉.
          5日報酬極正 + 流動性差 → 做空反轉.
    數據: 價格 + turnover (流動性指標).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + ret_window:
        return None
    ret_5d = close.pct_change(ret_window)
    ret_z = compute_zscore(ret_5d.dropna(), z_window)
    rz = ret_z.reindex(close.index).fillna(0)
    # 流動性: 換手率低 = 低流動性
    turnover = _load_ohlcv_column(stock, "turnover_rate")
    if turnover is not None:
        turnover = turnover.reindex(close.index).ffill()
        illiq_z = compute_zscore((-turnover).dropna(), z_window)  # 負 = 低換手 = 低流動
        iz = illiq_z.reindex(close.index).fillna(0)
        low_liq = (iz > 0).fillna(False)  # 高 Z (低換手) = 低流動性
    else:
        low_liq = pd.Series(True, index=close.index)  # fallback: 無 turnover 全部計
    # 急跌 + 低流動 → 做多反轉; 急升 + 低流動 → 做空反轉
    entries = ((rz < -threshold) & low_liq).fillna(False).shift(1).fillna(False)
    exits = (rz > 0).fillna(False).shift(1).fillna(False)
    se = ((rz > threshold) & low_liq).fillna(False).shift(1).fillna(False)
    sx = (rz < 0).fillna(False).shift(1).fillna(False)
    pf = backtest_signals(close, entries, exits, se, sx)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "48_流動性反轉", stock)


