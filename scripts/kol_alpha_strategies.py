def _forward_fill_fundamental(fund_df, field, daily_index, pub_lag_days=90):
    """將年度財報數據 forward-fill 到日線, 加公告滯後避免 look-ahead.

    fund_df[field] 係 annual period-end values. 一份年報最遲翌年 3 月底公告,
    所以「投資者喺 t 日見到」嘅最新一期 = period-end + pub_lag_days <= t.
    """
    if fund_df is None or field not in fund_df.columns:
        return None
    s = fund_df[field].dropna()
    if s.empty:
        return None
    # 公告可見日 = period_end + lag. 投資者喺呢日先知呢份報.
    visible = s.copy()
    visible.index = visible.index + pd.Timedelta(days=pub_lag_days)
    # reindex 到日線 + forward fill (財報數據階梯式: 公告後維持到下一份)
    daily = visible.reindex(daily_index, method="ffill")
    return daily


def _load_southbound_flow():
    """讀 sc_full.csv 南向港股通 net_buy (ALPHA-01/14/22 用)."""
    p = DATA_DIR / "stock_connect" / "sc_full.csv"
    if not p.exists():
        return None
    df = pd.read_csv(p)
    south = df[df["type_name"].isin(["南向_港股通滬", "南向_港股通深"])].copy()
    south["date"] = pd.to_datetime(south["date"])
    daily = south.groupby("date")["net_buy"].sum().sort_index()
    daily.name = "southbound_net_buy"
    return daily


def _build_factor_signal(factor_close, stock_close, entry_cond, exit_cond, holding=7,
                         direction="contrarian"):
    """通用: factor 條件觸發 → 做 stock, 持倉 holding 日 (或 exit_cond 觸發先平倉).

    修正: 原版忽略 exit_cond (死代碼). 新版: exit_cond 觸發 → 即時平倉 (優先過 holding).
    無 look-ahead (i+1 入場, exit_cond 用 bar i 數據, i+1 平倉).
    """
    common = factor_close.index.intersection(stock_close.index)
    if len(common) < 200:
        return None
    fc = factor_close.reindex(common).fillna(0)
    close = stock_close.reindex(common)
    n = len(fc)
    entries = np.zeros(n, dtype=bool)
    exits = np.zeros(n, dtype=bool)
    se = np.zeros(n, dtype=bool)
    sx = np.zeros(n, dtype=bool)
    ec = entry_cond.reindex(common).fillna(False).values
    xc = exit_cond.reindex(common).fillna(False).values
    for i in range(n - 1):
        if ec[i]:
            ei = min(i + 1 + holding, n - 1)  # 預設: holding 日後平倉
            # 但如果 exit_cond 喺持倉期間觸發, 提早平倉 (掃 i+2 到 ei, 最少持倉1日)
            for j in range(i + 2, ei):  # i+2 起 (最少持倉1日, 避免同bar exit)
                if j < n and xc[j]:
                    ei = j
                    break
            if direction == "contrarian":
                se[i + 1] = True; sx[ei] = True  # 反向 = 做空
            else:
                entries[i + 1] = True; exits[ei] = True
    if not entries.any() and not se.any():
        return None
    idx = common
    pf = backtest_signals(close,
                          pd.Series(entries, index=idx), pd.Series(exits, index=idx),
                          pd.Series(se, index=idx), pd.Series(sx, index=idx))
    # 0-trade guard: 如果 pf 冇交易 (同bar exit 全部被丟棄), 返 None
    if pf is None or pf.trades.count() == 0:
        return None
    return pf


# ============================================================
# ALPHA-01｜散客大戶背馡 (北水短長期背馡)
# ============================================================
def alpha_01(prices, stock, z_short_window=20, z_long_window=120,
             z_long_floor=0.0, z_short_ceiling=-1.0, div_threshold=0.8, holding=5):
    """北水短期暴跌(散客拋) + 長期仍正(大戶未走) → 反彈.

    修正: 原版 z_short/z_long 都用同一個 flow series → 高度相關, 永遠唔背馡.
    新版: z_short 用每日 net_buy (短期波動), z_long 用累積 net_buy (長期趨勢).
    咁短線暴跌但長線累積仍正 = 真正背馡. div_threshold 放寬到 1.2.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 250:
        return None
    flow = _load_southbound_flow()
    if flow is None or len(flow) < z_long_window * 3:
        return None
    flow = flow.reindex(close.index, method="ffill").dropna()
    if len(flow) < z_long_window * 3:
        return None
    # z_short = 每日 net_buy 既 Z (短期散客手影)
    z_short = compute_zscore(flow, z_short_window)
    # z_long = 累積 net_buy 既 Z (長期大戶趨勢, 用 cumsum 消除短期噪音)
    cum_flow = flow.cumsum()
    z_long = compute_zscore(cum_flow, z_long_window)
    divergence = z_long - z_short
    entry = (z_long > z_long_floor) & (z_short < z_short_ceiling) & (divergence > div_threshold)
    exit_c = divergence < 0
    pf = _build_factor_signal(flow, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "01_散客大戶背馡", stock)


# ============================================================
# ALPHA-02｜幣企持倉變化 = 系統性風險 (risk-off 濾網)
# ============================================================
def alpha_02(prices, stock, z_window=90, threshold=1.5, holding=7):
    """MSTR持倉增速Z>2.5 = risk_off (過度槓桿). 修正: risk_off 過後(Z回落)先做多.

    spec 係 risk FILTER (唔開好倉), 唔係 short. 做法: risk_off 結束 → risk_on → 做多.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 200:
        return None
    mstr = _load_factor_csv("mstr_btc")
    if mstr is None:
        return None
    mstr_ret = mstr.pct_change()
    mstr_z = compute_zscore(mstr_ret, z_window)
    mstr_z = mstr_z.reindex(close.index, method="ffill")
    # risk_off = Z>threshold (過度槓桿); risk_on = Z 回落到中性 (risk_off 結束 → 做多)
    entry = (mstr_z.shift(1) > threshold) & (mstr_z < threshold)  # risk_off 結束
    exit_c = mstr_z > threshold  # 再進入 risk_off → 平倉
    pf = _build_factor_signal(mstr, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "02_幣企持倉風控", stock)


