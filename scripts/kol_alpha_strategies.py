# ALPHA-21｜高波幅選股 (ATR/close universe filter)
# ============================================================
def alpha_21(prices, stock, atr_period=14, z_window=60, threshold=1.5, holding=7):
    """高波幅股 (ATR/close 高) + 均值回歸 (Z<-th 做多)."""
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 200:
        return None
    atr = close.diff().abs().rolling(atr_period).mean()
    vol_ratio = atr / close
    vol_z = compute_zscore(vol_ratio.dropna(), z_window)
    price_z = compute_zscore(close, z_window)
    # 高波幅 + 價格偏低 → 做多
    entry = (vol_z > 0) & (price_z < -threshold)
    exit_c = price_z > 0
    pf = _build_factor_signal(vol_ratio.dropna(), close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "21_高波幅選股", stock)


