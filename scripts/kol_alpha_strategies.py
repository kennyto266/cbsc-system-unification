# ALPHA-20｜轉角位偵測 (Extrema 聚焦, 歐陽一心)
# ============================================================
def alpha_20(prices, stock, order=10, threshold_pct=0.08, holding=5):
    """偵測轉角位 (minima 買, maxima 沽). 用 common.find_extrema."""
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < order * 4:
        return None
    df = pd.DataFrame({"close": close})
    atr = close.diff().abs().rolling(14).mean()
    df["high"] = close + atr * 0.5
    df["low"] = close - atr * 0.5
    is_max, is_min = find_extrema(df, order=order, threshold_pct=threshold_pct)
    # 修正 look-ahead consistency: find_extrema 用 bar i 數據判極值, 入場移到 i+1 (同其他 alpha 一致)
    entries = is_min.shift(1).fillna(False)
    exits = pd.Series(False, index=close.index)
    se = is_max.shift(1).fillna(False)
    sx = pd.Series(False, index=close.index)
    for i in range(len(close)):
        if is_min.iloc[i]:
            exits.iloc[min(i + 1 + holding, len(close) - 1)] = True
        if is_max.iloc[i]:
            sx.iloc[min(i + 1 + holding, len(close) - 1)] = True
    if not entries.any() and not se.any():
        return None
    pf = backtest_signals(close, entries, exits, se, sx)
    return extract_metrics(pf, "20_轉角位", stock) if pf else None


