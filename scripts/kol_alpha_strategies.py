# ALPHA-17｜沽空比率極端 = 軋空反轉 (數據不足, 用 prices 近似)
# ============================================================
def alpha_17(prices, stock, z_window=60, entry_z=2.0, holding=5):
    """沽空比率極端高 (降級: 用跌幅Z極端做恐慌代理) → 軋空反彈."""
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 200:
        return None
    # 降級: short_selling 只有40行, 用價格急跌Z做「恐慌/淡友擁擠」代理
    ret = close.pct_change()
    ret_z = compute_zscore(-ret, z_window)  # 負回報Z (跌得多=Z高)
    entry = ret_z > entry_z  # 急跌 = 淡友擁擠
    exit_c = ret_z < 0
    pf = _build_factor_signal((-ret).dropna(), close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "17_沽空軋空", stock)


