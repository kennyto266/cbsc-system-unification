# ALPHA-28｜跨資產動量 (錢琛 — 多資產輪動 alpha)
# ============================================================
def alpha_28(prices, stock, mom_window=20, holding=14):
    """跨資產動量: 港股 vs 黃金 vs 銅 vs A股 既相對強弱.

    靈感: 錢琛提倡跨資產配置. 當港股動量相對其他資產極弱 (Z<-1.5),
    但 macro 轉好 (DXY 跌) → 反轉做多 (均值回歸).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < mom_window + 50:
        return None
    hk_ret = close.pct_change(mom_window)

    # 相對動量: 港股 vs 多資產平均
    assets = ["gold", "copper", "a_shares", "sp500"]
    asset_rets = []
    for a in assets:
        f = _load_factor_csv(a)
        if f is None:
            continue
        f = f.reindex(close.index).ffill()
        asset_rets.append(f.pct_change(mom_window))
    if len(asset_rets) < 2:
        return None
    avg_asset = sum(asset_rets) / len(asset_rets)
    rel_mom = hk_ret - avg_asset

    # Z-score of relative momentum
    rel_z = compute_zscore(rel_mom.dropna(), 120)

    # 極端弱勢 + DXY 轉弱 = 反轉做多
    dxy = _load_factor_csv("dxy")
    if dxy is not None:
        dxy = dxy.reindex(close.index).ffill()
        dxy_down = dxy.pct_change(5) < 0
    else:
        dxy_down = pd.Series(True, index=close.index)

    entry = (rel_z < -1.5) & dxy_down.fillna(False)
    exit_c = rel_z > 0
    pf = _build_factor_signal(rel_mom, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "28_跨資產動量", stock)


