def alpha_76(prices, stock, leader="HK.00700", lag=2, order=15, threshold_pct=0.10, holding=5):
    """振盪相位耦合配對: leader Extrema→lag後follower跟. nlin.AO (alpha_49 variant)."""
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < order * 4 or stock == leader:
        return None
    leader_c = _load_peer_close(leader, close.index)
    if leader_c is None:
        return None
    ldf = pd.DataFrame({"close": leader_c})
    latr = leader_c.diff().abs().rolling(14).mean()
    ldf["high"] = leader_c + latr * 0.5
    ldf["low"] = leader_c - latr * 0.5
    l_max, l_min = find_extrema(ldf, order=order, threshold_pct=threshold_pct)
    entries = l_min.shift(lag).reindex(close.index).fillna(False).shift(1).fillna(False)
    se = l_max.shift(lag).reindex(close.index).fillna(False).shift(1).fillna(False)
    exits = pd.Series(False, index=close.index)
    sx = pd.Series(False, index=close.index)
    for i in range(len(close)):
        if entries.iloc[i]:
            exits.iloc[min(i + holding, len(close) - 1)] = True
        if se.iloc[i]:
            sx.iloc[min(i + holding, len(close) - 1)] = True
    if not entries.any() and not se.any():
        return None
    pf = backtest_signals(close, entries, exits, se, sx)
    return extract_metrics(pf, "76_相位耦合配對", stock) if pf and pf.trades.count() > 0 else None


