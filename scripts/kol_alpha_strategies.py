# A162 — VIX 恐慌抄底 (2026-07-01)
# Portfolio OOS SR 1.71, DD -6.3%. 同 A159 corr=0.08 (極低!)
# 學術: Whaley (2000) VIX as investor fear gauge → contrarian buy
# ============================================================
def alpha_162(prices, stock, z_window=90, z_thresh=2.0, holding=5):
    """VIX 恐慌抄底 long (OOS portfolio SR 1.71, DD -6.3%).

    VIX z-score > 2.0 (極端恐慌) → 抄底做多, 持倉 5 日.
    經濟邏輯: VIX 係恐慌指標, 極端高時 = 散戶恐慌拋售 → 超賣反彈.
    Whaley (2000): VIX 為 investor fear gauge, 極端值為反向指標.

    Portfolio-level (100股) OOS SR 1.71. 多 param 組合 SR 1.0-1.7.
    Walk-forward: 2024 SR 1.20, 2025 SR 2.20, 2026 SR 1.59.
    注意: 2022 熊市時 SR=-1.49 (恐慌持續惡化). 用 z>2.0 高門檻減少假信號.

    Factor: VIX. 同 A159/160/161 平均相關 0.24 (極低, 完美多樣化).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 60:
        return None
    vix = _load_factor_col("vix.csv", "close")
    if vix is None:
        return None
    vix_a = vix.reindex(close.index).ffill()
    z = (vix_a - vix_a.rolling(z_window).mean()) / vix_a.rolling(z_window).std().replace(0, np.nan)
    entry = (z > z_thresh).shift(1).fillna(False)
    exit_c = entry.shift(holding).fillna(False)
    pf = backtest_signals(close, entry, exit_c)
    return extract_metrics(pf, "162_VIX恐慌抄底", stock) if pf else None


