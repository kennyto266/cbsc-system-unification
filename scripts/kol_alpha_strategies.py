# ALPHA-42｜分析師分歧 (Analyst Disagreement 代理版)
# ============================================================
def alpha_42(prices, stock, z_window=120, threshold=2.0, holding=10):
    """分析師分歧代理: 波動率極高 = 分歧大 → 盈利後漂移更強.

    靈感: "Analysts Disagreement and Cross-Section Returns" — 分歧越大 PEAD 越強.
    邏輯: 波動率 (ATR/close) Z > 2 = 分歧極端 → 做多 (分歧大 = 不確定性高 = 之後驚喜大).
    數據: 價格波動率做分歧代理.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 50:
        return None
    # 波動率做分歧代理
    vol = close.pct_change().rolling(20).std()
    vol_z = compute_zscore(vol.dropna(), z_window)
    entry = vol_z > threshold
    exit_c = vol_z < 0
    pf = _build_factor_signal(vol, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "42_分歧溢價", stock)


