def alpha_161(prices, stock, atr_period=14, rank_window=60,
              rank_pct=0.15, sma_period=50, holding=3):
    """波幅收縮突破 long (OOS portfolio SR 1.58, DD -2.9%).

    ATR 處於 60 日低位 15% 分位 (波幅收縮) + 價格突破 SMA50 → 入場.
    經濟邏輯: 低波動蓄勢完畢 + 趨勢確認 = 高勝率突破 (VCP 理論).
    持倉 3 日 (短).

    Portfolio-level (100股) OOS SR 1.58. 24 個 param 組合全部 OOS SR 1.14-1.58.
    Walk-forward: 2020 SR 2.32, 2024 SR 1.68, 2025 SR 1.98.
    注意: 2021-2023 choppy market 時表現差 (典型 momentum 特性).

    純 OHLCV. 同 A159 (MACD momentum) corr ~0.49, 中等相關.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < rank_window + atr_period + 30:
        return None
    fname = stock.replace(".", "_")
    ohlcv_p = DATA_DIR / "ohlcv_5y" / f"{fname}.csv"
    if not ohlcv_p.exists():
        ohlcv_p = DATA_DIR / "ohlcv_10yr" / f"{fname}.csv"
    if not ohlcv_p.exists():
        return None
    try:
        df = pd.read_csv(ohlcv_p, parse_dates=["time_key"]).set_index("time_key").sort_index()
        high = df["high"].astype(float)
        low = df["low"].astype(float)
    except Exception:
        return None
    # ATR
    tr = pd.concat([(high - low),
                    (high - close.shift()).abs(),
                    (low - close.shift()).abs()], axis=1).max(axis=1)
    atr = tr.rolling(atr_period).mean()
    atr_pct = atr / close
    # 波幅收縮: ATR 在低位
    low_atr = atr_pct.rolling(rank_window).rank(pct=True) < rank_pct
    # 突破 SMA
    sma = close.rolling(sma_period).mean()
    breakout = close > sma
    entry = (low_atr & breakout).shift(1).fillna(False)
    exit_c = entry.shift(holding).fillna(False)
    pf = backtest_signals(close, entry, exit_c)
    return extract_metrics(pf, "161_波幅收縮突破", stock) if pf else None


