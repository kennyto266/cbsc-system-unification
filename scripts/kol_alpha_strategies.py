    return extract_metrics(pf, "03_平台幣強弱", stock)


# ============================================================
# ALPHA-04｜BTCD = Risk-on/Risk-off 濾網
# ============================================================
def alpha_04(prices, stock, sma=30, threshold=0.5, holding=7):
    """BTCD>SMA30 且月度升 = risk_off (資金集中BTC). 修正: risk_off 結束 → risk_on → 做多.

    spec 係 regime filter (risk_off 減倉, 唔係 short). 做法: risk_off 結束 → 做多.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 200:
        return None
    btcd = _load_factor_csv("btcd")
    if btcd is None:
        return None
    btcd_sma = compute_sma(btcd, sma)
    btcd_mom = btcd.pct_change(20)  # 月度變化
    risk_off = (btcd > btcd_sma) & (btcd_mom > threshold / 100)
    # risk_off 結束 (轉 risk_on) → 做多
    entry = risk_off.shift(1) & ~risk_off
    exit_c = risk_off  # 再進入 risk_off → 平倉
    pf = _build_factor_signal(btcd, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "04_BTCD_regime", stock)


