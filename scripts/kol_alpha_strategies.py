def _compute_regime(stock, prices, gate_file="discount_window.csv",
                    gate_col="discount_window_usage", gate_sma=70):
    """計算 regime: True = risk-ON (流動性寬鬆). 用 A131 gate signal (OOS-proven).
    返布林 Series (index = close 對齊), True = factor > SMA = risk-ON."""
    factor = _load_factor_col(gate_file, gate_col)
    if factor is None:
        return None
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    f = factor.reindex(close.index).ffill()
    fa = f.rolling(gate_sma).mean()
    regime = (f > fa).fillna(False)
    return regime


def regime_gated(alpha_id, prices, stock, gate_mode="suppress",
                 gate_file="discount_window.csv", gate_col="discount_window_usage",
                 gate_sma=70):
    """通用 regime gate wrapper.

    用 A131 貼現窗 regime 做 gate:
      risk-ON (factor>SMA)  → 啟用原 alpha
      risk-OFF              → suppress (唔開倉) 或 reverse (long→short)

    alpha_id: KOL_REGISTRY 內既 alpha ID (呼叫佢既 func).
    gate_mode: "suppress" (唔開倉) 或 "reverse" (反轉方向).
    返 metrics dict (同 extract_metrics 一致) 或 None.

    實現: monkey-patch backtest_signals 攔截 pf, 按 regime mask 過濾/反轉交易.
    """
    name, author, func, need = KOL_REGISTRY[alpha_id]
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < gate_sma + 50:
        return None
    regime = _compute_regime(stock, prices, gate_file, gate_col, gate_sma)
    if regime is None:
        return None

    # 攔截 backtest_signals: 根據 regime 過濾 entries
    orig_bs = backtest_signals
    captured = {"pf": None, "entries": None, "exits": None,
                "se": None, "sx": None, "close": None}

    def spy(close, entries, exits, se=None, sx=None, _c=captured):
        pf = orig_bs(close, entries, exits, se, sx)
        if pf is not None:
            _c["pf"] = pf
            _c["entries"] = entries
            _c["exits"] = exits
            _c["se"] = se
            _c["sx"] = sx
            _c["close"] = close
        return pf

    import kol_alpha_strategies as _self
    _self.backtest_signals = spy
    try:
        m = func(prices, stock)
    except Exception:
        m = None
    finally:
        _self.backtest_signals = orig_bs

    if m is None or captured["pf"] is None:
        return None

    entries = captured["entries"]
    exits = captured["exits"]
    se = captured["se"]
    sx = captured["sx"]
    base_close = captured["close"]

    # 統一 se/sx 為 False Series (有些 alpha 只用 long entries)
    false_series = pd.Series(False, index=base_close.index)
    if se is None:
        se = false_series.copy()
    if sx is None:
        sx = false_series.copy()

    # 對齊 regime 到 base_close
    reg_aligned = regime.reindex(base_close.index).fillna(False)
    reg_off = ~reg_aligned

    if gate_mode == "suppress":
        # risk-OFF 唔開新倉: mask 掉 risk-OFF 期既 long entries 同 short entries
        # (已開倉繼續到自然 exit)
        new_long_entries = entries & reg_aligned
        new_short_entries = se & reg_aligned
        if not new_long_entries.any() and not new_short_entries.any():
            return None
        pf_new = orig_bs(base_close, new_long_entries, exits,
                         new_short_entries, sx)
    else:  # reverse: risk-OFF 反轉方向 (long↔short)
        # risk-OFF 期 long entry → short entry; short entry → long entry
        new_long_entries = (entries & reg_aligned) | (se & reg_off)
        new_long_exits = (exits & reg_aligned) | (sx & reg_off)
        new_short_entries = (se & reg_aligned) | (entries & reg_off)
        new_short_exits = (sx & reg_aligned) | (exits & reg_off)
        if not new_long_entries.any() and not new_short_entries.any():
            return None
        pf_new = orig_bs(base_close, new_long_entries, new_long_exits,
                         new_short_entries, new_short_exits)
    if pf_new is None or pf_new.trades.count() == 0:
        return None
    return extract_metrics(pf_new, f"{alpha_id}g_{gate_mode}", stock)


