# --- Bayes 濾網增強 (4) ---

def alpha_50(prices, stock, windows=(5, 20, 60), z_window=120, threshold=1.5, holding=7):
    """多窗口分佈散度: 多窗口rolling分位數差異=regime shift→均值回歸. cs.IT.

    audit fix: 舊版聲稱 JS divergence 但實際只係 std² 差.
    新版: 用 rolling 分位數 (quantile) 差異做真正嘅分佈形狀散度.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 60:
        return None
    # rolling 分位數差: P90-P10 of each window's returns = 分佈寬度
    rets = [close.pct_change(w) for w in windows]
    iqrs = []
    for r in rets:
        q90 = r.rolling(z_window).quantile(0.9)
        q10 = r.rolling(z_window).quantile(0.1)
        iqrs.append((q90 - q10).abs())
    # 多窗口 IQR 嘅差異 = 分佈形狀散度
    div = sum((iqrs[i] - iqrs[j]).abs() for i in range(len(iqrs)) for j in range(i + 1, len(iqrs)))
    dz = compute_zscore(div.dropna(), z_window)
    entry = dz > threshold
    exit_c = dz < 0
    pf = _build_factor_signal(div.dropna(), close, entry, exit_c, holding, "contrarian")
    return extract_metrics(pf, "50_巧合散度", stock) if pf else None


def alpha_54(prices, stock, pred_window=5, z_window=120, threshold=2.0, holding=7):
    """不確定性量化濾網: rolling預測殘差方差大→縮減信號/反向. cs.LG."""
