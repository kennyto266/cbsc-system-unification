# ALPHA-43｜拓撲異常分數 (Topological Anomaly) — arXiv
# ============================================================
def alpha_43(prices, stock, lookback=20, z_window=120, threshold=1.0, holding=5):
    """拓撲異常: 價格行為偏離歷史模式 → 反轉.

    靈感: arXiv "Cross-Sectional Topological Anomaly Scores" — 拓撲學偵測結構異常.
    邏輯: 簡化版 — 用 return 分佈偏度做拓撲代理. 極端正偏度 = 彩票式 → 反轉.
    數據: 價格 (return rolling skewness).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + lookback:
        return None
    ret = close.pct_change()
    # Rolling skewness 做異常分數代理
    skew = ret.rolling(lookback).skew()
    skew_z = compute_zscore(skew.dropna(), z_window)
    skz = skew_z.reindex(close.index).fillna(0)
    se = (skz > threshold).fillna(False).shift(1).fillna(False)
    sx = (skz < 0).fillna(False).shift(1).fillna(False)
    entries = (skz < -threshold).fillna(False).shift(1).fillna(False)
    exits = (skz > 0).fillna(False).shift(1).fillna(False)
    pf = backtest_signals(close, entries, exits, se, sx)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "43_拓撲異常", stock)


