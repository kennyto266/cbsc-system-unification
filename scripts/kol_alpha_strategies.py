# ALPHA-84｜CCASS 南向持股集中度 (HKEX 獨有微觀結構)
# ============================================================
def alpha_84(prices, stock, z_window=120, threshold=1.0, holding=14,
             sb_high=20.0, sb_mid=5.0, conc_high=70.0):
    """CCASS 南向持股 + 集中度 confirm (v2 完善版).

    靈感: HKPTRC CCASS 持倉異動策略 — 中證登 (南向港股通) 持股比例高
          = 大陸資金重倉. 當股價回落但南向持股仍高 + 大戶集中 = 大戶未走 → 反彈.
    改善 (v2):
      - 分 3 層: 極高南向(SB>20%)+高集中(>70%) = 強信號做多
                 中等南向(5-20%) = 溫和做多
                 低南向(<5%) = 做空 (散戶主導)
      - 加集中度 confirm: 大戶集中度高嘅先信
    數據: CCASS 持股 (Playwright 爬取) + 價格.
    """
    # CCASS 數據審計: 只有單日快照 (2026-06-26), 被用於 2021-2026 全期回測 = 嚴重 look-ahead.
    # 標記為無效, 直到有歷史 CCASS 時間序列數據.
    return None
    # ============================================================
    # DEAD CODE BELOW — alpha_84 disabled (CCASS single-day snapshot
    # look-ahead bug). Kept for restoration once historical CCASS
    # time-series data is available. DO NOT delete.
    # ============================================================
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 20:
        return None
    sb_pct = _ccass_southbound_pct(stock)
    conc = _ccass_concentration(stock, top_n=5)
    if sb_pct is None or conc is None:
        return None
    # 價格 Z-score (20日回報)
    price_ret = close.pct_change(20)
    price_z = compute_zscore(price_ret.dropna(), z_window)
    pz = price_z.reindex(close.index).fillna(0)

    # 決定方向 + 嚴格度
    if sb_pct >= sb_high and conc >= conc_high:
        # Tier 1: 極高南向 + 高集中 = 大戶強力收集 → 弱勢做多 (用更低 threshold)
        entry = (pz < -0.5)
        exit_c = pz > 0
        direction = "follow"
    elif sb_pct >= sb_mid:
        # Tier 2: 中等南向 = 溫和做多
        entry = (pz < -threshold)
        exit_c = pz > 0
        direction = "follow"
    elif sb_pct < sb_mid:
        # Tier 3: 低南向 = 散戶主導, 做空
        entry = (pz > threshold)
        exit_c = pz < 0
        direction = "contrarian"
    else:
        return None

    pf = _build_factor_signal(pz.dropna(), close,
                              entry.reindex(pz.dropna().index).fillna(False),
                              exit_c.reindex(pz.dropna().index).fillna(False),
                              holding, direction)
    return extract_metrics(pf, "84_CCASS南向", stock) if pf else None


