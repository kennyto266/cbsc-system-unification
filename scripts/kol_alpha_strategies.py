# ALPHA-166｜復合低波動增強 (Composite Low-Volatility)
# ============================================================
# 2026-07. A164 純低波動嘅複合增強版: 每季 (60日) rebalance, 揀複合評分最高嘅 10 隻.
#
# 複合評分 (rank-based z-score, 同 alpha_xs_lowvol_vbt.py 一致):
#   score = 0.4*z(lowvol) + 0.3*z(liq) + 0.3*z(value)
#     lowvol = -vol60       (60日 realized vol 取負 → 高分 = 低波動)
#     liq    = log(mean dollar volume) rolling 60  (流動性)
#     value  = -mom250      (250日動量取負 → 高分 = 價值/逆勢)
#
# 同 A164 (純低波動, 月度 rebal) 分別:
#   1. 季度 rebalance (60日) → 交易成本更低, turnover 更低
#   2. 複合三因子 → 低波動 + 流動性 + 價值, 唔只單一維度
#   3. rank-based z-score → robust to outlier, 同 vbt 標準化版一致
_ALPHA166_CACHE = {}  # (vol_window, n_pick, w_lowvol, w_liq, w_value) -> {stock: (entries, exits)}


def _alpha166_load_closes_with_volume():
    """Load close + volume DataFrames for cross-sectional composite scoring.

    Returns (closes, volumes) — both date x stock, or (None, None) on failure.
    volume 用 turnover (成交額) 嘅代理, 若 turnover 缺失則 volume*close 估算 dollar volume.
    """
    ohlcv_dir = DATA_DIR / "ohlcv_5y"
    closes = {}
    vols = {}
    for p in sorted(ohlcv_dir.glob("HK_*.csv")):
        code = p.stem.replace("HK_", "HK.")
        try:
            df = pd.read_csv(p, parse_dates=["time_key"]).set_index("time_key").sort_index()
            closes[code] = pd.to_numeric(df["close"], errors="coerce")
            # dollar volume: turnover 優先, 否則 volume*close
            if "turnover" in df.columns:
                dv = pd.to_numeric(df["turnover"], errors="coerce")
            elif "volume" in df.columns:
                dv = pd.to_numeric(df["volume"], errors="coerce") * pd.to_numeric(df["close"], errors="coerce")
            else:
                continue
            vols[code] = dv
        except Exception:
            continue
    if not closes:
        return None, None
    c = pd.DataFrame(closes).sort_index()
    v = pd.DataFrame(vols, index=c.index).sort_index()
    return c, v


def _alpha166_rank_zscore(df):
    """Rank-based z-score (同 alpha_xs_lowvol_vbt.py 一致).
    每一列 (cross-section) 做 rank 後轉 z-score. NaN 保持 NaN."""
    ranked = df.rank(axis=1, pct=True)  # percentile rank 橫向
    # z-score: (pct - 0.5) / (1/sqrt(12)) ≈ standardized uniform
    # 用簡單標準化: (rank - mean) / std, 跨 column 每一列
    mean = ranked.mean(axis=1)
    std = ranked.std(axis=1).replace(0, np.nan)
    return ranked.sub(mean, axis=0).div(std, axis=0)


def _alpha166_build_signals(vol_window=60, n_pick=10, w_lowvol=0.4, w_liq=0.3, w_value=0.3):
    """Build per-stock entry/exit signals from composite low-vol ranking (季度 rebalance).
    Cached. Returns dict stock -> (entries, exits) boolean Series.
    Weights default to original 0.4/0.3/0.3 (rolled back from broken 0.6/0.2/0.2)."""
    key = (vol_window, n_pick, w_lowvol, w_liq, w_value)
    if key in _ALPHA166_CACHE:
        return _ALPHA166_CACHE[key]
    prices, dv = _alpha166_load_closes_with_volume()
    if prices is None:
        _ALPHA166_CACHE[key] = {}
        return {}
    ret = prices.pct_change()
    # 三個因子 raw (cross-section per row)
    lowvol = -ret.rolling(vol_window).std()                                   # 高 = 低波動
    liq = np.log1p(dv.rolling(vol_window).mean())                             # 高 = 高流動性
    value = -prices.pct_change(250)                                           # 高 = 低動量 = 價值
    # rank-based z-score (cross-sectional, per date)
    z_lowvol = _alpha166_rank_zscore(lowvol)
    z_liq = _alpha166_rank_zscore(liq)
    z_value = _alpha166_rank_zscore(value)
    # 複合評分 (原始權重 0.4/0.3/0.3, 可覆寫作參數搜索)
    score = w_lowvol * z_lowvol + w_liq * z_liq + w_value * z_value
    # rebalance 週期 = vol_window (回滾: 唔再硬編碼 90)
    rebal = vol_window
    pos = pd.DataFrame(0.0, index=prices.index, columns=prices.columns)
    held = set()
    for i in range(len(prices)):
        if i % rebal == 0 and i > 0:
            sc = score.iloc[i].dropna()
            if len(sc) >= n_pick:
                held = set(sc.nlargest(n_pick).index)
        if held:
            w = 1.0 / len(held)
            for s in held:
                pos.iloc[i][s] = w
    # per-stock entry/exit edges (position 0->w = entry, w->0 = exit)
    # .shift(1) T+1 延遲 (避免同日 signal+execution, 同 alpha_164 convention 一致)
    sig = {}
    for s in prices.columns:
        p = pos[s]
        in_pos = p > 0
        entries = (in_pos & ~in_pos.shift(1, fill_value=False)).shift(1).fillna(False)
        exits = (~in_pos & in_pos.shift(1, fill_value=False)).shift(1).fillna(False)
        if entries.any():
            sig[s] = (entries, exits)
    _ALPHA166_CACHE[key] = sig
    return sig


def alpha_166(prices, stock, vol_window=60, n_pick=10, w_lowvol=0.4, w_liq=0.3, w_value=0.3):
    """復合低波動增強 (季度 rebalance, 三因子複合評分).

    每 vol_window 個交易日 rebalance: 計 100 隻港股嘅複合評分
      score = 0.4*z(lowvol) + 0.3*z(liq) + 0.3*z(value)
      (rank-based z-score, 同 alpha_xs_lowvol_vbt.py 一致)
    揀最高 10 隻等權持倉.

    經濟邏輯: 低波動異常 + 流動性溢價 + 價值因子三重複合.
    季度 rebalance (vs A164 月度) 降交易成本, 複合因子 (vs A164 單一低波動) 提穩定性.
    rebal 週期 = vol_window (回滾硬編碼 90).
    """
    if stock not in prices.columns:
        return None
    sig = _alpha166_build_signals(vol_window, n_pick, w_lowvol, w_liq, w_value)
    if stock not in sig:
        return None
    close = prices[stock].dropna()
    if len(close) < 250:
        return None
    entries, exits = sig[stock]
    entries = entries.reindex(close.index).fillna(False)
    exits = exits.reindex(close.index).fillna(False)
    if not entries.any():
        return None
    pf = backtest_signals(close, entries, exits)
