def alpha_61(prices, stock, sym_window=20, z_window=120, threshold=1.5, holding=7):
    """敘事複雜度regime: return符號序列entropy高=regime shift. nlin.AO."""
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + sym_window:
        return None
    signs = np.sign(close.pct_change())
    # rolling Shannon entropy of sign sequence
    def _ent(s):
        vals = s.dropna()
        if len(vals) < 5:
            return np.nan
        p1 = (vals > 0).mean()
        if p1 == 0 or p1 == 1:
            return 0.0
        return -p1 * np.log2(p1) - (1 - p1) * np.log2(1 - p1)
    ent = signs.rolling(sym_window).apply(_ent, raw=False)
    ez = compute_zscore(ent.dropna(), z_window)
    entry = ez > threshold
    exit_c = ez < 0
    pf = _build_factor_signal(ent.dropna(), close, entry, exit_c, holding, "contrarian")
    return extract_metrics(pf, "61_敘事複雜度", stock) if pf else None


def alpha_70(prices, stock, drift_window=60, z_window=120, threshold=1.5, holding=7):
