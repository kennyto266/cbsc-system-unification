# A163 — VWAP 均值回歸 (2026-07-01)
# Portfolio OOS SR 1.23, DD -2.0%. 同 A159 corr=0.07 (極低!)
# 學術: VWAP reversion — institutional benchmark deviation
# ============================================================
def alpha_163(prices, stock, vwap_period=10, z_window=60, z_thresh=2.0, holding=5):
    """VWAP 均值回歸 long (OOS portfolio SR 1.23, DD -2.0%).

    價格低於 VWAP z < -2.0 → 超賣回歸做多, 持倉 5 日.
    VWAP = volume-weighted average price (10日均).
    經濟邏輯: 機構以 VWAP 為基準, 偏離極端時 mean-revert.

    Portfolio-level (100股) OOS SR 1.23, DD -2.0%.
    同 A159 corr=0.07, A161 corr=0.14 (極低相關, 完美多樣化).
    5-way combo (A159-163): OOS SR 2.01, DD -1.9%.

    純 OHLCV. 逆勢 reversion (同 A160 互補, 但用 VWAP 唔用 SMA).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + vwap_period + 30:
        return None
    fname = stock.replace(".", "_")
    ohlcv_p = DATA_DIR / "ohlcv_5y" / f"{fname}.csv"
    if not ohlcv_p.exists():
        ohlcv_p = DATA_DIR / "ohlcv_10yr" / f"{fname}.csv"
    if not ohlcv_p.exists():
        return None
    try:
        df = pd.read_csv(ohlcv_p, parse_dates=["time_key"]).set_index("time_key").sort_index()
        high = df["high"].astype(float)
        low = df["low"].astype(float)
        vol = df["volume"].astype(float)
    except Exception:
        return None
    typical = (high + low + close) / 3
    vwap = (typical * vol).rolling(vwap_period).sum() / vol.rolling(vwap_period).sum().replace(0, np.nan)
    dev = (close - vwap) / vwap
    z = (dev - dev.rolling(z_window).mean()) / dev.rolling(z_window).std().replace(0, np.nan)
    entry = (z < -z_thresh).shift(1).fillna(False)
    exit_c = entry.shift(holding).fillna(False)
    pf = backtest_signals(close, entry, exit_c)
    return extract_metrics(pf, "163_VWAP回歸", stock) if pf else None


