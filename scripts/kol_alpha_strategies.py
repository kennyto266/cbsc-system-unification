# ALPHA-18｜散戶反向情緒 (數據不足, 用 VIX 做散戶恐慌代理)
# ============================================================
def alpha_18(prices, stock, bull_ratio_high=2.5, bull_ratio_low=0.8, holding=5):
    """散戶情緒反向 — bull_bear_ratio 極端 (貪婪>2.5 做空, 恐懼<0.8 做多).

    修正: 原版用 VIX (同 ALPHA-12 重複). 新版用 sentiment_history.csv 既 bull_bear_ratio
    (真實散戶牛熊證/輪證買賣比). 散戶極度貪婪→做空, 極度恐懼→做多 (反向).
    注意: 數據只有33行 (6週), 數據少用直接 threshold + backtest_signals (唔經 _build_factor_signal).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 30:
        return None
    p = DATA_DIR / "sentiment" / "sentiment_history.csv"
    if not p.exists():
        return None
    sent = pd.read_csv(p, parse_dates=["date"])
    if len(sent) < 5 or "bull_bear_ratio" not in sent.columns:
        return None
    bbr = sent.set_index("date")["bull_bear_ratio"].sort_index()
    bbr = bbr.reindex(close.index, method="ffill").fillna(1.0)  # 缺值填中性 1.0
    if len(bbr) < 30:
        return None
    # 散戶極度恐懼 (bbr<0.8) → 反向做多; 極度貪婪 (bbr>2.5) → 做空
    # 修正 look-ahead consistency: bbr 用 bar i 數據, 入場移到 i+1
    entries = (bbr < bull_ratio_low).fillna(False).shift(1).fillna(False)
    exits = (bbr > 1.5).fillna(False).shift(1).fillna(False)
    se = (bbr > bull_ratio_high).fillna(False).shift(1).fillna(False)
    sx = (bbr < 1.5).fillna(False).shift(1).fillna(False)
    if not entries.any() and not se.any():
        return None
    pf = backtest_signals(close, entries, exits, se, sx)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "18_散戶情緒反向", stock)


# ============================================================
# ALPHA-19｜訊號融合 (多因子 Sharpe 加權綜合)
# ============================================================
def alpha_19(prices, stock, z_window=60, threshold=1.0, holding=7):
    """VIX + DXY + USDCNH 三因子 Z 融合 → 綜合分超 th → 做多.

    修正: 原版 threshold=1.5 太嚴 (1.3% bars 觸發). 放寬到 1.0 (4.1% 觸發).
    任2/3因子同向 (K-of-N 投票) 而非全部一致.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 200:
        return None
    factors = {}
    for name, direction_sign in [("vix", 1), ("dxy", -1), ("usdcnh", -1)]:
        f = _load_factor_csv(name)
        if f is None:
            continue
        f_ret = f.pct_change()
        f_z = compute_zscore(f_ret, z_window)
        factors[name] = f_z.reindex(close.index, method="ffill").fillna(0) * direction_sign
    if len(factors) < 2:
        return None
    composite = pd.concat(factors.values(), axis=1).mean(axis=1)
    # 放寬: threshold 1.0 + 任一因子 Z>1.5 (強信號)
    strong = pd.concat([abs(f) > 1.5 for f in factors.values()], axis=1).sum(axis=1) >= 1
    entry = (composite > threshold) & strong
    exit_c = composite < 0
    pf = _build_factor_signal(composite.dropna(), close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "19_訊號融合", stock)


