# ALPHA-49｜相位耦合轉角 (Phase Coupling Pivot) — ArXiv nlin.AO
# ============================================================
def alpha_49(prices, stock, leader="HK.00700", order=15, threshold_pct=0.10,
             lag_days=2, z_window=60, z_threshold=-0.5, holding=5):
    """相位耦合轉角: leader 股出現 Extrema 轉角 → lag_days 後 follower 跟隨.

    靈感: ArXiv nlin.AO 非線性動力學 — 將資產視為耦合振盪器, leader 股轉角
          會喺相位差 (lag) 後傳導到 follower. 強化 ALPHA-20 Extrema 轉角位.
    邏輯: 龍頭股 (預設騰訊00700) find_extrema 偵測 is_min → shift(lag_days)
          → 買入 follower (前提: follower 自己 Z-score < z_threshold, 確認弱勢反轉 setup).
          leader is_max → shift(lag_days) → 做空 follower.
    數據: leader + follower 既 close (ohlcv_5y 直接讀, 同 alpha_06 模式一致).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < order * 4:
        return None

    # 1. Load leader close (同 alpha_06 模式: 直接讀 ohlcv CSV)
    if stock == leader:
        return None  # 唔同自己耦合
    leader_p = DATA_DIR / "ohlcv_5y" / f"{leader.replace('.', '_')}.csv"
    if not leader_p.exists():
        leader_p = DATA_DIR / "ohlcv_10yr" / f"{leader.replace('.', '_')}.csv"
    if not leader_p.exists():
        return None
    leader_close = pd.read_csv(leader_p, parse_dates=["time_key"]).set_index("time_key")["close"]
    leader_close = leader_close.reindex(close.index).dropna()
    if len(leader_close) < order * 4:
        return None

    # 2. Leader Extrema (synthesize H/L from ATR, 同 alpha_20 一致)
    leader_df = pd.DataFrame({"close": leader_close})
    leader_atr = leader_close.diff().abs().rolling(14).mean()
    leader_df["high"] = leader_close + leader_atr * 0.5
    leader_df["low"] = leader_close - leader_atr * 0.5
    l_max, l_min = find_extrema(leader_df, order=order, threshold_pct=threshold_pct)

    # 3. Phase coupling: leader 轉角 shift lag_days → 預測 follower
    leader_lagged_min = l_min.shift(lag_days).fillna(False)
    leader_lagged_max = l_max.shift(lag_days).fillna(False)
    leader_lagged_min = leader_lagged_min.reindex(close.index).fillna(False)
    leader_lagged_max = leader_lagged_max.reindex(close.index).fillna(False)

    # 4. Follower confirm: Z-score 低 = follower 本身弱勢, 有反轉 setup
    follower_ret = close.pct_change(z_window)
    follower_z = compute_zscore(follower_ret.dropna(), z_window)
    fz = follower_z.reindex(close.index).fillna(0)
    confirm_long = fz < z_threshold    # follower 弱勢 → leader 轉角 confirm 反彈
    confirm_short = fz > -z_threshold  # follower 強勢 → leader 轉頂 confirm 回落

    # 5. 信號 (look-ahead convention: shift(1))
    entries = (leader_lagged_min & confirm_long).shift(1).fillna(False)
    se = (leader_lagged_max & confirm_short).shift(1).fillna(False)

    # 6. 出場: 持倉期 (同 alpha_20)
    exits = pd.Series(False, index=close.index)
    sx = pd.Series(False, index=close.index)
    for i in range(len(close)):
        if entries.iloc[i]:
            exits.iloc[min(i + holding, len(close) - 1)] = True
        if se.iloc[i]:
            sx.iloc[min(i + holding, len(close) - 1)] = True

    if not entries.any() and not se.any():
        return None
    pf = backtest_signals(close, entries, exits, se, sx)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "49_相位耦合轉角", stock)


