# ALPHA-16｜保力加通道「真正玩法」(BB squeeze breakout)
# ============================================================
def alpha_16(prices, stock, bb_period=20, bb_std=2.0, bw_window=100, squeeze_z=-2.0, holding=7):
    """BB bandwidth 收縮至極端窄 → 突破方向跟動量."""
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < bw_window + bb_period:
        return None
    sma = compute_sma(close, bb_period)
    std = close.rolling(bb_period).std()
    bandwidth = (2 * bb_std * std) / sma  # ponytail: inlined upper/lower
    bw_z = compute_zscore(bandwidth.dropna(), bw_window)
    bw_z = bw_z.reindex(close.index)
    # squeeze = bandwidth 極窄; breakout = squeeze 結束 + 突破中軌
    squeeze = bw_z < squeeze_z
    squeeze_end = squeeze.shift(1) & ~squeeze
    breakout_up = squeeze_end & (close > sma)
    breakout_down = squeeze_end & (close < sma)
    # 修正 look-ahead consistency: signal 用 bar i close, 入場移到 i+1 (同其他 alpha 一致)
    entries = breakout_up.fillna(False).shift(1).fillna(False)
    exits = (close < sma).fillna(False).shift(1).fillna(False)
    se = breakout_down.fillna(False).shift(1).fillna(False)
    sx = (close > sma).fillna(False).shift(1).fillna(False)
    if not entries.any() and not se.any():
        return None
    pf = backtest_signals(close, entries, exits, se, sx)
    return extract_metrics(pf, "16_BB真正玩法", stock) if pf else None


