def _load_ccass(stock):
    """讀 ccass/{stock}_ccass.csv 返 DataFrame.

    返回: DataFrame with [participant_id, participant_name, shares, pct_of_total].
    如果冇數據返 None (40/79 股有數據, 其餘 HKEX 限流未拉到).
    """
    code = stock.replace(".", "_")  # HK.00700 → HK_00700
    p = DATA_DIR / "ccass" / f"{code}_ccass.csv"
    if not p.exists():
        return None
    try:
        df = pd.read_csv(p)
        return df
    except Exception:
        return None


def _ccass_southbound_pct(stock):
    """計算個股南向 (中證登) 持股比例. 返 float 或 None."""
    df = _load_ccass(stock)
    if df is None:
        return None
    csdc = df[df["participant_name"].str.contains("CHINA SECURITIES DEPOSIT", case=False, na=False)]
    if csdc.empty:
        return 0.0
    return float(csdc["pct_of_total"].sum())


def _ccass_concentration(stock, top_n=5):
    """計算 Top N participant 持股集中度. 返 float 或 None."""
    df = _load_ccass(stock)
    if df is None:
        return None
    top = df.nlargest(top_n, "pct_of_total")
    return float(top["pct_of_total"].sum())


