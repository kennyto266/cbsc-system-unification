# --- Permutation Entropy 增強 (5) ---

def alpha_55(prices, stock, herd_window=20, z_window=120, threshold=1.2, holding=7):
    """羊群共識反轉: 極化度高但開始去極化→反向. physics.soc-ph.

    audit fix: 舊版 same_dir.abs() 退化成 binary flag. 冇量度極化.
    新版: 用連續同向日數比例做共識度 (|P(up)-P(down)| = 共識強度).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + herd_window:
        return None
    turnover = _load_ohlcv_column(stock, "turnover")
    if turnover is None:
        turnover = close.pct_change().abs() * close
    turnover = turnover.reindex(close.index).fillna(0)
    # 共識度 = |P(up) - P(down)| ∈ [0,1], 高=強共識 (羊群)
    up = (close.pct_change() > 0)
    consensus = (2 * up.rolling(herd_window).mean() - 1).abs()  # [0,1]
    # 成交放大: 高成交 + 高共識 = 羊群效應
    vol_ratio = turnover / turnover.rolling(herd_window).mean().replace(0, np.nan)
    herd = consensus * vol_ratio
    hz = compute_zscore(herd.dropna(), z_window)
    entry = hz > threshold  # 高羊群共識→反向做空
    exit_c = hz < 0
    pf = _build_factor_signal(herd.dropna(), close, entry, exit_c, holding, "contrarian")
    return extract_metrics(pf, "55_羊群共識", stock) if pf else None


def alpha_56(prices, stock, lag=5, z_window=120, threshold=1.0, holding=7):
    """高階因果洩漏: 多因子非線性Granger洩漏→反向. cs.IT."""
    if stock not in prices.columns:
