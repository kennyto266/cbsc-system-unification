# ALPHA-10｜DXY 反向領先
# ============================================================
def alpha_10(prices, stock, z_window=60, threshold=0.8, holding=7):
    """DXY 急跌 (Z<-th) → 美元弱 → 港股做多."""
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 200:
        return None
    dxy = _load_factor_csv("dxy")
    if dxy is None:
        return None
    # DXY 是美歐資產, 當日收盤在港股收盤後才產生 → 用昨日 DXY 預測今日港股
    dxy_ret = dxy.pct_change().shift(1)  # shift(1) 修復時區 look-ahead
    dxy_z = compute_zscore(dxy_ret, z_window)
    entry = dxy_z < -threshold  # DXY 急跌
    exit_c = dxy_z > 0
    pf = _build_factor_signal(dxy, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "10_DXY反向", stock)


