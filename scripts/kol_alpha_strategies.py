# ALPHA-176/177/178｜Regime-gated 低波動選股 (macro timing × cross-section)
# ============================================================
# 2026-07-09. 三個通過嚴格審計嘅策略: 宏觀 regime 擇時 × 橫截面低波動選股.
#
# 結構 (同 A164/166 嘅 cross-section ranking 一致, 加 regime gate):
#   1. _load_all_closes() 讀全部 102 股
#   2. timing signal (macro factor MA / z): 每日 regime on/off (boolean)
#   3. 低波動選股: vol = rets.rolling(60).std(), 每 rebal 日 nsmallest(10)
#   4. 權重矩陣 pos: regime on 時持有低波動 top10 等權, regime off 清倉
#   5. per-stock entry/exit edges (position 0->w / w->0), .shift(1) T+1
#
# Look-ahead 防護:
#   - 美歐因子 (GOLD/COPPER/DXY/USDCNH) reindex 到 HK 交易日後 .shift(1)
#     (佢哋發布同 HK 收盤唔同日, 用前一日信號避 look-ahead)
#   - 低波動排名用截至當日嘅 rolling, 但執行用 .shift(1) → T+1
#   - 同 A164/166 convention 一致
_ALPHA176_CACHE = {}  # (variant, vol_window, n_pick, rebal) -> {stock: (entries, exits)}


def _alpha176_align_factor(factor_series, prices_index):
    """將美歐因子 Series reindex 到 HK 交易日 index 並 .shift(1) 避 look-ahead.

    factor 發布日同 HK 收盤唔同 (美歐時區), 用前一日值避 look-ahead.
    返回對齊到 prices_index 嘅 Series (前一日 factor).
    """
    if factor_series is None:
        return None
    s = factor_series.dropna().sort_index()
    # 去重 (保留最後)
    s = s[~s.index.duplicated(keep="last")]
    # reindex: 對齊到 HK 交易日, ffill 填充非交易日缺口
    aligned = s.reindex(prices_index, method="ffill")
    # shift(1): 用前一日 factor 避 look-ahead (美歐時區滯後)
    return aligned.shift(1)


def _alpha176_build_lowvol_positions(prices, vol_window, n_pick, rebal):
    """構建低波動選股權重矩陣 (無 regime gate).
    返回 pos DataFrame (date x stock), regime on 時 top10 等權, 否則 0.
    呢個 helper 只負責選股, regime gate 喺 caller 度乘上去."""
    ret = prices.pct_change()
    vol = ret.rolling(vol_window).std()
    score = -vol  # 高分 = 低波動
    pos = pd.DataFrame(0.0, index=prices.index, columns=prices.columns)
    held = set()
    for i in range(len(prices)):
        if i % rebal == 0 and i > 0:
            sc = score.iloc[i].dropna()
            if len(sc) >= n_pick:
                held = set(sc.nlargest(n_pick).index)
        if held:
            w = 1.0 / len(held)
            for s in held:
                pos.iloc[i][s] = w
    return pos


def _alpha176_pos_to_edges(pos, prices):
    """權重矩陣 → per-stock entry/exit edges (同 A164/166 一致).
    position 0->w = entry, w->0 = exit.
    .shift(1) T+1 延遲 (避免同日 signal+execution).
    返回 dict stock -> (entries, exits) boolean Series."""
    sig = {}
    for s in prices.columns:
        p = pos[s]
        in_pos = p > 0
        entries = (in_pos & ~in_pos.shift(1, fill_value=False)).shift(1).fillna(False)
        exits = (~in_pos & in_pos.shift(1, fill_value=False)).shift(1).fillna(False)
        if entries.any():
            sig[s] = (entries, exits)
    return sig


def _alpha176_build_signals(variant="176", vol_window=60, n_pick=10, rebal=20):
    """Build regime-gated low-vol signals. variant = '176'/'177'/'178'.
    Cached. Returns dict stock -> (entries, exits) boolean Series."""
    key = (variant, vol_window, n_pick, rebal)
    if key in _ALPHA176_CACHE:
        return _ALPHA176_CACHE[key]
    prices = _load_all_closes()
    if prices is None:
        _ALPHA176_CACHE[key] = {}
        return {}

    # 1. 低波動選股權重矩陣
    pos = _alpha176_build_lowvol_positions(prices, vol_window, n_pick, rebal)

    # 2. Regime timing signal (boolean Series aligned to prices.index)
    idx = prices.index
    if variant == "176":
        # GOLD MA10 > MA120 (金價上升趨勢)
        gold = _load_factor_csv("gold")
        g = _alpha176_align_factor(gold, idx)
        timing = (g.rolling(10).mean() > g.rolling(120).mean()).fillna(False)
    elif variant == "177":
        # COPPER MA10 > MA90 OR HIBOR MA10 < MA90
        copper = _load_factor_csv("copper")
        hibor = _load_factor_csv("hibor")
        c = _alpha176_align_factor(copper, idx)
        h = _alpha176_align_factor(hibor, idx)
        cu_up = (c.rolling(10).mean() > c.rolling(90).mean()).fillna(False)
        hb_dn = (h.rolling(10).mean() < h.rolling(90).mean()).fillna(False)
        timing = (cu_up | hb_dn).fillna(False)
    elif variant == "178":
        # DXY 5日變化 z<-1 OR USDCNH 5日變化 z<-1 OR GOLD MA10>MA120
        dxy = _load_factor_csv("dxy")
        usdcnh = _load_factor_csv("usdcnh")
        gold = _load_factor_csv("gold")
        d = _alpha176_align_factor(dxy, idx)
        u = _alpha176_align_factor(usdcnh, idx)
        g = _alpha176_align_factor(gold, idx)
        d_ret = d.pct_change(5)
        u_ret = u.pct_change(5)
        d_z = (d_ret - d_ret.rolling(60).mean()) / d_ret.rolling(60).std().replace(0, np.nan)
        u_z = (u_ret - u_ret.rolling(60).mean()) / u_ret.rolling(60).std().replace(0, np.nan)
        dxy_drop = (d_z < -1).fillna(False)
        usdcnh_drop = (u_z < -1).fillna(False)
        gold_up = (g.rolling(10).mean() > g.rolling(120).mean()).fillna(False)
        timing = (dxy_drop | usdcnh_drop | gold_up).fillna(False)
    else:
        timing = pd.Series(True, index=idx)  # fallback: always on

    timing = timing.reindex(idx).fillna(False)

    # 3. 應用 regime gate: regime off 時清倉
    gated = pos.mul(timing.astype(float), axis=0)

    # 4. 權重矩陣 → per-stock entry/exit edges
    sig = _alpha176_pos_to_edges(gated, prices)
    _ALPHA176_CACHE[key] = sig
    return sig


def alpha_176(prices, stock, vol_window=60, n_pick=10, rebal=20):
    """GOLD MA + 低波動選股 (審計真實 SR IS=1.45 OOS=1.97 Return=126%).

    擇時: GOLD(金價) MA10 > MA120 (金價上升趨勢).
    選股: 102 股中 60 日波動率最低嘅 10 隻, 每 20 日 rebalance.
    regime off (金價下行) 時清倉避險.

    結構同 A164/166 (cross-section ranking), 加 GOLD regime gate.
    美歐因子 GOLD reindex + .shift(1) 避 look-ahead (金價美東時區滯後).
    """
    if stock not in prices.columns:
        return None
    sig = _alpha176_build_signals("176", vol_window, n_pick, rebal)
    if stock not in sig:
        return None
    close = prices[stock].dropna()
    if len(close) < 250:
        return None
    entries, exits = sig[stock]
    entries = entries.reindex(close.index).fillna(False)
    exits = exits.reindex(close.index).fillna(False)
    if not entries.any():
        return None
    pf = backtest_signals(close, entries, exits)
    return extract_metrics(pf, "176_GOLD低波動", stock) if pf else None


