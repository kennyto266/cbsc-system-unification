# ALPHA-13b｜貼現窗壓力 (錢琛 ALPHA-13 增強 — 加貼現窗數據)
# ============================================================
def alpha_13b(prices, stock, z_window=120, threshold=1.0, holding=10):
    """貼現窗壓力: HIBOR + 貼現窗使用量雙重流動性訊號.

    靈感: 錢琛 ALPHA-13 流動性壓力, 加強版用 HKMA 貼現窗使用量
    (銀行向 HKMA 借款 = 流動性真實緊張, 比 HIBOR 更直接).

    邏輯 (修復版, 數據確認方向):
      數據顯示: HIBOR 緊 (Z>1) 後 5 日平均回報 +0.42% (正!) = 超跌反彈買點.
      原假設「HIBOR 緊→做空」方向錯. 加貼現窗確認反而令信號模糊 (-0.06%).
      修正:
      - HIBOR Z > threshold = 流動性緊張 → 做多 (超跌反彈, mean reversion)
      - 貼現窗用量極端 (< -500) = 危機底, 額外加強做多訊號
      - 貼現窗數據缺失 → 純 HIBOR
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 50:
        return None
    hibor = _load_factor_csv("hibor")
    if hibor is None:
        return None
    hibor = hibor.reindex(close.index).ffill()
    hibor_z = compute_zscore(hibor, z_window)
    # HIBOR 緊 = 超跌反彈買點 (做多, 數據確認方向)
    tight = hibor_z > threshold
    # 貼現窗極端用量 = 危機底, 加強做多 (如果數據存在)
    dw = _load_factor_csv("discount_window")
    if dw is not None:
        dw = dw.reindex(close.index).ffill()
        dw_crisis = dw < -500  # 極端借用 = 危機 = 最佳買點
        # 兩者任一 = 做多 (緊張/危機 = 反彈買點)
        entry = tight | dw_crisis
    else:
        entry = tight
    exit_c = hibor_z < 0  # HIBOR 回落 = 反彈完成出場
    pf = _build_factor_signal(hibor, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "13b_流動性反彈", stock)


