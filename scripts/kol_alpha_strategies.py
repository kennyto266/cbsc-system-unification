# ALPHA-33｜節前效應 (Pre-holiday Effect) — 學術論文
# ============================================================
def alpha_33(prices, stock, holding=3):
    """節前效應: 假期前最後交易日買入, 節後賣出.

    靈感: 港股節前回報係平時 10 倍 (Quantpedia). 農曆新年/聖誕/復活節最強.
    邏輯: 投資者節前減倉避險 → 節前低吸 → 節後反彈.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 200:
        return None
    # 用日曆偵測假期: 連續 2+ 日冇交易 = 假期
    dates = close.index
    gaps = pd.Series(dates).diff().dt.days
    gaps.index = dates
    # 假期 = 下一個 gap > 3 日 (週末=2-3, 假期=4+)
    pre_holiday = (gaps.shift(-1) > 3).fillna(False)
    if not pre_holiday.any():
        return None
    entries = pre_holiday.shift(1).fillna(False)
    exits = pd.Series(False, index=close.index)
    for i in np.where(entries.values)[0]:
        exit_i = min(i + holding, len(close) - 1)
        exits.iloc[exit_i] = True
    pf = backtest_signals(close, entries, exits)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "33_節前效應", stock)


