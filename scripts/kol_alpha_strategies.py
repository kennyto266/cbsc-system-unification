# ALPHA-44｜隔夜-日內拉鋸 (Overnight-Intraday Tug of War) — Lou Polk Skouras JFE
# ============================================================
def alpha_44(prices, stock, lookback=20, z_window=252, threshold=1.0, holding=5):
    """隔夜-日內拉鋸: 日內強升 (機構沽) → 隔夜反轉 (散戶/流動性提供者買入).

    靈感: Lou, Polk & Skouras "A Tug of War: Overnight vs Intraday Expected
          Returns" (JFE 2019). 日內 (open→close) 同隔夜 (close→open) 報酬符號相反.
          HK 散戶密集 + 長午休, 隔夜-日內分歧特別強 (2024 paper 確認).
    邏輯: 日內報酬 (open→close) Z-score 極高 → 機構日內沽售壓力 → 隔夜反轉回升.
          即「日內升得勁 → 買入等隔夜反彈」.
    數據: open + close (從 OHLCV CSV 讀 open).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + lookback:
        return None
    open_s = _load_ohlcv_column(stock, "open")
    if open_s is None:
        return None
    open_s = open_s.reindex(close.index).dropna()
    common = close.index.intersection(open_s.index)
    if len(common) < z_window + lookback:
        return None
    close_c = close.reindex(common)
    open_c = open_s.reindex(common)
    # 日內報酬 = (close - open) / open
    intraday_ret = (close_c - open_c) / open_c
    intraday_z = compute_zscore(intraday_ret.dropna(), z_window)
    iz = intraday_z.reindex(close.index).fillna(0)
    # 日內極端高 → 買入 (隔夜反轉); 日內極端低 → 做空
    entries = (iz > threshold).fillna(False).shift(1).fillna(False)
    exits = (iz < 0).fillna(False).shift(1).fillna(False)
    se = (iz < -threshold).fillna(False).shift(1).fillna(False)
    sx = (iz > 0).fillna(False).shift(1).fillna(False)
    pf = backtest_signals(close, entries, exits, se, sx)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "44_隔夜日內拉鋸", stock)


