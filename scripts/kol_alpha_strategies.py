# ALPHA-45｜動態波動率縮放 (Dynamic Volatility Scaling) — Daniel Moskowitz NBER
# ============================================================
def alpha_45(prices, stock, mom_window=120, vol_window=60, vol_z_window=252,
             threshold=1.0, holding=21):
    """動態波動率縮放動量: 動量 + 高波動期反轉保護.

    靈感: Daniel & Moskowitz "Momentum Crashes" (NBER w20439) — 動量喺「恐慌期」
          (波動率暴升 + 市場急跌) 會暴力反轉. 動態縮放 (高波動減倉) Sharpe 提升一倍.
    邏輯: 基礎 = 中期動量 (close > SMA_mom). 但當實現波動率 Z > threshold
          (恐慌期), 唔信動量, 反而做反向 (反轉). 低波動正常動量, 高波動反轉.
    數據: 價格 (實現波動率 + 動量).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < vol_z_window + mom_window:
        return None
    ret = close.pct_change()
    # 實現波動率 (60日)
    realvol = ret.rolling(vol_window).std()
    vol_z = compute_zscore(realvol.dropna(), vol_z_window)
    vz = vol_z.reindex(close.index).fillna(0)
    # 中期動量: close > SMA(mom)
    sma = close.rolling(mom_window).mean()
    mom_up = (close > sma).fillna(False)
    # 恐慌期 (vol Z > threshold): 反轉; 正常期: 跟動量
    panic = (vz > threshold).fillna(False)
    # 正常期: 動量方向
    entries = (mom_up & ~panic).shift(1).fillna(False)
    exits = (~mom_up).shift(1).fillna(False)
    # 恐慌期: 反轉 (動量升 → 做空)
    se = (mom_up & panic).shift(1).fillna(False)
    sx = (~mom_up | ~panic).shift(1).fillna(False)
    pf = backtest_signals(close, entries, exits, se, sx)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "45_動態波動縮放", stock)


# ============================================================
# ALPHA-46｜資本利得懸念 (Capital Gains Overhang) — Frazzini NYU
# ============================================================
def alpha_46(prices, stock, cgo_window=120, z_window=252, threshold=1.0, holding=21):
    """資本利得懸念 (CGO): 持倉平均盈虧 → 處置效應 → drift.

    靈感: Frazzini "The Disposition Effect and Underreaction to News" (NYU).
          投資者「贏即沽, 輸即揸」(處置效應) → 好消息喺持倉虧損時反應不足 → drift.
    邏輯: CGO = (close - turnover-weighted avg purchase price) / price.
          CGO 極負 (持倉大幅虧損) → 散戶揸實唔肯止蝕 → 好消息 drift 更強 → 做多.
          CGO 極正 (持倉大賺) → 散戶急獲利 → 壞消息跌得更深 → 做空.
    數據: close + turnover (做成交量加權平均買入價).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + cgo_window:
        return None
    turnover = _load_ohlcv_column(stock, "turnover")
    if turnover is None:
        turnover = close.pct_change().abs() * close  # fallback: 價格代理
    turnover = turnover.reindex(close.index).fillna(0)
    # CGO 估算 (Frazzini): turnover-weighted reference price
    # RRef = sum(turnover_t * close_t) / sum(turnover_t) over cgo_window
    # CGO = (close - RRef) / close
    num = (turnover * close).rolling(cgo_window).sum()
    den = turnover.rolling(cgo_window).sum().replace(0, np.nan)
    ref_price = num / den
    cgo = (close - ref_price) / close
    cgo_z = compute_zscore(cgo.dropna(), z_window)
    cz = cgo_z.reindex(close.index).fillna(0)
    # CGO 極負 (虧損) → 做多; CGO 極正 (大賺) → 做空
    entries = (cz < -threshold).fillna(False).shift(1).fillna(False)
    exits = (cz > 0).fillna(False).shift(1).fillna(False)
    se = (cz > threshold).fillna(False).shift(1).fillna(False)
    sx = (cz < 0).fillna(False).shift(1).fillna(False)
    pf = backtest_signals(close, entries, exits, se, sx)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "46_資本利得懸念", stock)


