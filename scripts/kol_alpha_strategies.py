# ============================================================
# ALPHA-06｜集中度反轉 (頭部權重股動量領先)
# ============================================================
def alpha_06(prices, stock, top_n=5, z_window=60, threshold=1.2, holding=10):
    """頭部權重股(匯豐/騰訊等)動量Z>1.5 → 做多 (巨企領先指數)."""
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 200:
        return None
    # 用 ohlcv 頭部權重股做 leading (匯豐00005 + 騰訊00700 等)
    leading_stocks = ["HK.00005", "HK.00700", "HK.00939", "HK.01299", "HK.00016"]
    ohlcv_dir = DATA_DIR / "ohlcv_5y"
    leading_returns = []
    for code in leading_stocks:
        p = ohlcv_dir / f"{code.replace('.', '_')}.csv"
        if p.exists() and code != stock:
            lc = pd.read_csv(p, parse_dates=["time_key"]).set_index("time_key")["close"]
            leading_returns.append(lc.reindex(close.index).pct_change())
    if len(leading_returns) < 2:
        return None
    leading_mom = pd.concat(leading_returns, axis=1).mean(axis=1).rolling(z_window).mean()
    leading_z = compute_zscore(leading_mom.dropna(), z_window)
    leading_z = leading_z.reindex(close.index, method="ffill")
    entry = leading_z > threshold
    exit_c = leading_z < 0
    pf = _build_factor_signal(leading_mom.dropna(), close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "06_集中度反轉", stock)


# ============================================================
# ALPHA-07｜攻守兼備 (trend + mean-reversion 組合)
# ============================================================
def alpha_07(prices, stock, z_window=50, threshold=0.8, holding=7):
    """Trend(z>th) + MeanRev(z<-th) 組合, 等權 → 波幅中性."""
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 200:
        return None
    z = compute_zscore(close, z_window)
    # Trend leg: z>th 做多; MeanRev leg: z<-th 做多
    trend_entry = z > threshold
    mr_entry = z < -threshold
    # 組合: 任一觸發即做多 (攻守兼備)
    entry = trend_entry | mr_entry
    exit_c = (z > 0) & (z < threshold)  # 回到中性區
    pf = _build_factor_signal(z.dropna(), close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "07_攻守組合", stock)


