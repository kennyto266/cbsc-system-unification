    數據: CCASS Top 5 集中度 + 南向持股比例 + 價格.
    """
    # CCASS 數據審計: 同 alpha_84 一樣嘅單日快照 look-ahead bug.
    # alpha_84 已禁用, alpha_85 用相同嘅 _ccass_concentration / _ccass_southbound_pct helpers.
    # 標記為無效, 直到有歷史 CCASS 時間序列數據.
    return None
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 20:
        return None
    conc = _ccass_concentration(stock, top_n=5)
    sb_pct = _ccass_southbound_pct(stock)
    if conc is None or sb_pct is None:
        return None
    mom = close.pct_change(20)
    mom_z = compute_zscore(mom.dropna(), z_window)
    mz = mom_z.reindex(close.index).fillna(0)

    if conc > 70.0 and sb_pct > 10.0:
        # 中資大戶控制 + 動量 → 做多
        entry = mz > threshold
        exit_c = mz < 0
        direction = "follow"
    elif conc > 70.0 and sb_pct < 5.0:
        # 外資大戶控制 + 動量強 = 獲利回吐 → 做空
        entry = mz > threshold
        exit_c = mz < 0
        direction = "contrarian"
    else:
        return None
    pf = _build_factor_signal(mz.dropna(), close,
                              entry.reindex(mz.dropna().index).fillna(False),
                              exit_c.reindex(mz.dropna().index).fillna(False),
                              holding, direction)
    return extract_metrics(pf, "85_CCASS集中度", stock) if pf else None


