# ALPHA-38｜Google 搜尋熱度 (Attention Reversal) — Da, Engelberg, Gao
# ============================================================
def alpha_38(prices, stock, z_window=120, threshold=1.0, holding=7):
    """搜尋熱度反轉: 散戶注意力飆升 → 短期漲 → 之後反轉做空.

    靈感: Da, Engelberg, Gao "In Search of Attention" — Google SVI 預測散戶買入.
    邏輯: 散戶搜尋量極高 (Z>2) = 注意力高峰 = 資金湧入推高 → 之後回落.
    數據: 用成交量 Z 做搜尋熱度代理 (高量 = 高關注).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 50:
        return None
    # 成交量 proxy: 日回報絕對值 × 價格變動幅度
    attention = close.pct_change().abs() * close.pct_change().abs().rolling(5).mean()
    att_z = compute_zscore(attention.dropna(), z_window)
    # 注意力極高 → 做空 (散戶湧入後回落)
    short_entry = att_z > threshold
    short_exit = att_z < 0
    # 注意力極低 → 做多 (無人理 → 反而跑贏)
    long_entry = att_z < -threshold
    long_exit = att_z > -0.5
    se = short_entry.fillna(False).shift(1).fillna(False)
    sx = short_exit.fillna(False).shift(1).fillna(False)
    # 對齊到 close index
    att_aligned = att_z.reindex(close.index).fillna(0)
    entries = (att_aligned < -threshold).fillna(False).shift(1).fillna(False)
    exits = (att_aligned > -0.5).fillna(False).shift(1).fillna(False)
    se = (att_aligned > threshold).fillna(False).shift(1).fillna(False)
    sx = (att_aligned < 0).fillna(False).shift(1).fillna(False)
    pf = backtest_signals(close, entries, exits, se, sx)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "38_注意力反轉", stock)


