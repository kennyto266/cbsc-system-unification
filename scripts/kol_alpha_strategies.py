# ALPHA-14｜北水 × DXY 雙因子共振
# ============================================================
def alpha_14(prices, stock, nb_window=60, dxy_window=60, nb_threshold=2.0,
             dxy_threshold=-1.0, holding=5):
    """北水大買(Z>2) AND DXY回落(Z<-1) → 雙因子共振 → 強做多."""
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 200:
        return None
    flow = _load_southbound_flow()
    dxy = _load_factor_csv("dxy")
    if flow is None or dxy is None:
        return None
    flow = flow.reindex(close.index, method="ffill")
    dxy = dxy.reindex(close.index, method="ffill")
    nb_z = compute_zscore(flow, nb_window)
    dxy_ret = dxy.pct_change()
    dxy_z = compute_zscore(dxy_ret, dxy_window)
    # 雙因子共振
    entry = (nb_z > nb_threshold) & (dxy_z < dxy_threshold)
    exit_c = (nb_z < 0) | (dxy_z > 0)
    pf = _build_factor_signal(flow, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "14_北水DXY共振", stock)


