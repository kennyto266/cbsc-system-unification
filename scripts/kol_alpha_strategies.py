def _load_crypto_close(symbol):
    """讀 crypto_ohlcv/{symbol}.csv 返 close Series (BTC/ETH/SOL/XRP/BNB)."""
    p = DATA_DIR / "crypto_ohlcv" / f"{symbol}.csv"
    if not p.exists():
        return None
    try:
        df = pd.read_csv(p, parse_dates=["time_key"]).set_index("time_key")
        s = df["close"].sort_index().astype(float)
        # 統一 timezone: crypto 係 UTC, HK 冇 timezone → 去掉 UTC
        if s.index.tz is not None:
            s.index = s.index.tz_localize(None)
        return s
    except Exception:
        return None


def _load_crypto_funding(symbol):
    """讀 crypto_funding/{symbol}.csv 返 funding rate Series."""
    p = DATA_DIR / "crypto_funding" / f"{symbol}.csv"
    if not p.exists():
        return None
    try:
        df = pd.read_csv(p, parse_dates=["time_key"]).set_index("time_key") if "time_key" in pd.read_csv(p, nrows=0).columns else pd.read_csv(p, index_col=0, parse_dates=True)
        if df.index.tz is not None:
            df.index = df.index.tz_localize(None)
        for col in df.columns:
            if "funding" in col.lower() or "rate" in col.lower():
                return df[col].sort_index().astype(float)
        return df.iloc[:, 0].sort_index().astype(float)
    except Exception:
        return None


