# ALPHA-39｜社交情緒反向 (Sentiment Reversal) — 學術論文
# ============================================================
def alpha_39(prices, stock, z_window=60, threshold=1.0, holding=5):
    """情緒反轉: 市場情緒極端 → 反向操作.

    靈感: "Sentiment stocks" (ScienceDirect) — 正面情緒預測短期漲→之後反轉.
    邏輯: 用 VIX + 價格波幅做情緒代理. 情緒極端樂觀 (低VIX+高回報) → 做空.
    數據: VIX (已有) + 價格波幅.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 50:
        return None
    vix = _load_factor_csv("vix")
    if vix is None:
        return None
    vix = vix.reindex(close.index).ffill()
    ret = close.pct_change()
    # 情緒指標: 近期回報 / VIX (高回報 + 低VIX = 極度樂觀)
    sentiment = ret.rolling(5).mean() / vix.replace(0, np.nan) * 100
    sent_z = compute_zscore(sentiment.dropna(), z_window)
    # 對齊到 close
    sz = sent_z.reindex(close.index).fillna(0)
    se = (sz > threshold).fillna(False).shift(1).fillna(False)
    sx = (sz < 0).fillna(False).shift(1).fillna(False)
    entries = (sz < -threshold).fillna(False).shift(1).fillna(False)
    exits = (sz > -0.5).fillna(False).shift(1).fillna(False)
    pf = backtest_signals(close, entries, exits, se, sx)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "39_情緒反轉", stock)


