# --- Shannon's Demon 增強 (3) ---

def alpha_51(prices, stock, z_window=120, threshold=1.0, holding=10):
    """稀疏自編碼器因子: PCA降維→latent突變=regime. cs.LG (SAE simplified→PCA).

    audit fix: 用 expanding fit (只向後睇) 避免 look-ahead bias.
    舊版 PCA.fit_transform 用全樣本 → 未來數據洩漏.
    新版: 每 z_window 步重新 fit (expanding window), 只用歷史數據.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 50:
        return None
    # 構建多維特徵
    f1 = close.pct_change(5)
    f2 = close.pct_change(20)
    f3 = close.rolling(20).std()
    f4 = close.rolling(14).apply(lambda x: np.ptp(x) / np.mean(x) if np.mean(x) > 0 else 0)
    feats = pd.concat([f1, f2, f3, f4], axis=1).dropna()
    feats.columns = ['mom5', 'mom20', 'vol', 'range']
    if len(feats) < z_window * 2:
        return None
    try:
        from sklearn.decomposition import PCA
    except ImportError:
        # Fallback: 用 mom5 做 single factor (冇 PCA)
        pc1 = feats['mom5']
    else:
        # Expanding PCA: 每 z_window 步重新 fit (避免 look-ahead)
        pc1 = pd.Series(index=feats.index, dtype=float)
        step = z_window
        for i in range(z_window, len(feats), step):
            # 只用截至 i 嘅歷史數據 fit
            train = feats.iloc[:i].dropna()
            if len(train) < z_window:
                continue
            pca = PCA(n_components=1)
            pca.fit(train.values)
            # transform 下一個 window
            end = min(i + step, len(feats))
            pc1.iloc[i:end] = pca.transform(feats.iloc[i:end].values).flatten()
        pc1 = pc1.dropna()
    if len(pc1) < z_window:
        return None
    pz = compute_zscore(pc1, z_window)
    entry = pz > threshold
    exit_c = pz < 0
    pf = _build_factor_signal(pc1, close, entry, exit_c, holding, "follow")
    return extract_metrics(pf, "51_SAE因子", stock) if pf else None


