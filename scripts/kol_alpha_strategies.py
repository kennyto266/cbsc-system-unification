def alpha_93(prices, stock, z_window=120, threshold=1.5, holding=5):
    """隔夜-日內反轉分解: 隔夜大升 → 日內回落 (或反向).

    靈感: Lou-Polk-Skouras JFE — Overnight vs intraday returns have opposite signs.
          隔夜移動 = 散戶/消息驅動 → 日內被流動性提供者修正.
    邏輯: overnight return (open/prev_close - 1) Z > threshold = 隔夜大升
          → 日內反轉做空. Z < -threshold = 隔夜大跌 → 做多反彈.
    數據: OHLCV open + close (同 A44 但用分解邏輯).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 60:
        return None
    open_s = _load_ohlcv_column(stock, "open")
    if open_s is None:
        return None
    open_s = open_s.reindex(close.index).dropna()
    common = close.index.intersection(open_s.index)
    if len(common) < z_window + 60:
        return None
    close_c = close.reindex(common)
    open_c = open_s.reindex(common)
    # 隔夜 return = open[t] / close[t-1] - 1
    overnight = (open_c / close_c.shift(1) - 1)
    oz = compute_zscore(overnight.dropna(), z_window)
    oz = oz.reindex(close.index).fillna(0)
    # 隔夜大升 → 日內反轉做空; 隔夜大跌 → 做多
    se = (oz > threshold)
    sx = (oz < 0)
    entries = (oz < -threshold)
    exits = (oz > 0)
    pf = backtest_signals(close, entries.shift(1).fillna(False), exits.shift(1).fillna(False),
                          se.shift(1).fillna(False), sx.shift(1).fillna(False))
    if pf is None or pf.trades.count() == 0:
        return None
