# ALPHA-31｜不對稱短期反轉 — 港股過度反應
# ============================================================
def alpha_31(prices, stock, lookback=3, threshold=-0.03, holding=5):
    """不對稱短期反轉: 急跌後反彈 (35-45% reversal), 急升後反轉少.

    靈感: "Overreaction in the HK Stock Market" (ScienceDirect)
    + "Asian Stock Indices" (ResearchGate) — 港股暴跌後反轉 35-45%,
    但暴升後反轉少. → 只做跌後反彈 (做多), 唔做升後反轉.

    邏輯:
    - 過去3日累計跌 > 5% → 投資者過度恐慌 → 做多等反彈
    - 唔做空 (因為暴升後反轉唔夠, 風險高)
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 100:
        return None
    ret_3d = close.pct_change(lookback)

    # 急跌做多 (不對稱: 只做跌後反彈)
    entry = ret_3d < threshold
    exit_c = pd.Series(False, index=close.index)
    entry_indices = np.where(entry.values)[0]
    for i in entry_indices:
        exit_i = min(i + holding, len(close) - 1)
        exit_c.iloc[exit_i] = True

    if not entry.any():
        return None
    # 用 _build_factor_signal 統一框架
    pf = _build_factor_signal(ret_3d, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "31_不對稱反轉", stock)


