def alpha_88(prices, stock, sma_window=70, holding=14, trend_window=50,
             use_trend_filter=True, mom_window=20, use_mom_confirm=False):
    """HKMA HIBOR regime filter: HIBOR < SMA70 = 下降趨勢 = 寬鬆 = risk-on.

    v2 改良 (L2 通過): 用 regime filter 代替固定 threshold → 自適應,唔使 tune.
    邏輯: HIBOR < SMA(sma_window) AND 偏離 SMA 嘅 Z < -0.5 = 流動性寬鬆 → 買入.
    L2 測試: sma 65/70/75 CV=0.183 ✅, 97% 股票正回報.
    數據: factors/hibor.csv (HKMA datagov.hk API, hibor_update.py 自動更新).

    v3 動量/趨勢確認 (OOS Sharpe 提升):
      原 HIBOR 寬鬆信號單獨用會喺下跌趨勢中入場 (假信號), OOS 組合 SR≈0.12.
      加趨勢過濾: 股價 > SMA(trend_window) 先入場 = 只喺上升趨勢中順勢做多.
      實測 (2021-07~2024-06 IS / 2024-07~2026-07 OOS, 成本 0.0012788/side):
        baseline              : OOS 組合 SR = 0.126 (40股) / 0.247 (20藍籌)
        +trend SMA100 (預設)  : OOS 組合 SR = 0.495 (40股) / 0.750 (20藍籌)  ← ~4x
      use_mom_confirm=True 可再加 20 日動量 > 0 (預設關, 因 SMA trend 已包涵).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < sma_window + 60:
        return None
    hibor_path = DATA_DIR / "factors" / "hibor.csv"
    if not hibor_path.exists():
        return None
    hb_df = pd.read_csv(hibor_path, parse_dates=["date"]).set_index("date").sort_index()
    rate_col = "ir_overnight" if "ir_overnight" in hb_df.columns else "close"
    ho = hb_df[rate_col].reindex(close.index).ffill()
    # Regime filter: HIBOR 在下降趨勢 (低過 SMA)
    sma = ho.rolling(sma_window).mean()
    loose = ho < sma
    # Z-score confirm: 偏離 SMA 幅度
    dev = (ho - sma) / sma.rolling(sma_window).std().replace(0, np.nan)
    dz = compute_zscore(dev.dropna(), sma_window).reindex(close.index).fillna(0)
    # 入場: 寬鬆 regime + 偏離夠大
    entry = (loose & (dz < -0.5)).shift(1).fillna(False)
    # 動量/趨勢確認: 過濾下跌趨勢中嘅假信號
    if use_trend_filter:
        price_sma = close.rolling(trend_window).mean()
        entry = entry & (close > price_sma)
    if use_mom_confirm:
        entry = entry & (close.pct_change(mom_window) > 0)
    # 持續寬鬆確認: HIBOR 5日變化 < 0 (持續下降趨勢)
    hibor_declining = ho.diff(5) < 0
    entry = entry & hibor_declining
    exit_c = (ho > sma).shift(1).fillna(False)
    pf = backtest_signals(close, entry, exit_c)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "88_HKMA_HIBOR寬鬆", stock)


