# ALPHA-165｜Qlib LightGBM 橫截面選股 (qlib integration)
# ============================================================
# 由 qlib (Alpha158 + LightGBM) 訓練好嘅模型 export 嘅 predictions.csv 驅動.
# 每日 qlib 預測每隻股票嘅未來回報 score, 我哋揀 score 高嘅做 long.
#
# ⚠️ 設計說明:
# 嚴格橫截面選股需要同日全部股票 score 排名 (qlib TopkDropoutStrategy 度做咗).
# 呢度 alpha_165 係 vectorbt 對賬用嘅 per-stock 簡化版:
# 每隻股票用自己 60 日 score 分位做 entry (score 高於 80 分位 → long).
# 真正 cross-sectional ranking 喺 qlib backtester 度, 呢度只係獨立驗證.
_QLIB_PRED_CACHE = None  # module-level cache, 避免每次 call 都讀 CSV


def _load_qlib_predictions():
    """讀取 qlib export 嘅 predictions.csv, 返回 {stock: pd.Series(score)}.

    CSV 格式: date, stock, score
    返回 dict[str, pd.Series], key = 'HK.00005', value = score Series indexed by date.
    """
    global _QLIB_PRED_CACHE
    if _QLIB_PRED_CACHE is not None:
        return _QLIB_PRED_CACHE

    pred_path = Path(__file__).parent.parent / "data" / "qlib_signals" / "predictions.csv"
    if not pred_path.exists():
        return {}
    try:
        df = pd.read_csv(pred_path, parse_dates=["date"])
        result = {}
        for stock, grp in df.groupby("stock"):
            s = grp.set_index("date")["score"].sort_index()
            s = s[~s.index.duplicated(keep="last")]
            result[stock] = s
        _QLIB_PRED_CACHE = result
        return result
    except Exception:
        return {}


def alpha_165(prices, stock, score_window=30, entry_pct=0.65, exit_pct=0.5, holding=3):
    """Qlib LightGBM 橫截面選股 (Alpha158 + GBDT 預測分數驅動).

    讀取 qlib export 嘅 predictions.csv, 用每隻股票自己嘅 60 日 score 分位做 entry.
    score > 80 分位 → long; score < 50 分位 → exit (或持倉 holding 日).

    屬於 cross-sectional ML alpha 嘅 per-stock 對賬版本.
    真正 cross-sectional ranking (每日揀 top-K) 喺 qlib TopkDropoutStrategy 度.

    經濟邏輯: LightGBM 學習 158 個量價因子 → 未來 2 日回報嘅映射.
    高 score = 模型認為該股短期會跑贏.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 200:
        return None

    preds = _load_qlib_predictions()
    if stock not in preds:
        return None

    score = preds[stock].reindex(close.index).ffill()
    if len(score.dropna()) < score_window + 20:
        return None

    # Entry: score 喺自己 60 日窗口嘅 80 分位以上
    entry_threshold = score.rolling(score_window).quantile(entry_pct)
    entry_cond = score > entry_threshold

    # Exit: score 跌破 50 分位 (或持倉 holding 日)
    exit_threshold = score.rolling(score_window).quantile(exit_pct)
    exit_cond = score < exit_threshold

    pf = _build_factor_signal(score, close, entry_cond, exit_cond, holding, "follow")
    return extract_metrics(pf, "165_qlib_gbdt", stock) if pf else None


