# A164 — 橫截面低波動 (Cross-sectional Low-Volatility / BAB)
# 2026-07-01. OOS portfolio SR 1.45, DD -11.5%, ann ret +22.9%.
#
# 學術: Ang-Hodrick-Xing-Zhang (2006) low-volatility anomaly, Frazzini-Pedersen
# (2014) Betting Against Beta. 低波動/低 beta 股票長期風險調整回報高於 CAPM 預測.
#
# 點解同 A159-A163 正交 (cross-section, 唔係 market timing):
#   A159 (MACD+量): 要高量 + 動量 → 高波動股
#   A160 (均線回歸): 超賣反彈 → 高波動 distressed 股
#   A161 (波幅突破): 波幅收縮後突破 → 高波動股
#   A162 (VIX 抄底): 恐慌時買 → 高 beta
#   A163 (VWAP 回歸): 日內偏離 → 高波動股
#   五個都集中喺高波動/高 beta 名. A164 揀 cross-section 嘅另一端 (最低波動).
#   橫截面輪換 (rotating subset), 唔係全倉 market timing → 只剩 residual beta.
#
# 同 A159 corr 0.25, A162 corr 0.25 (低). 同 A160 corr 0.54 (defensive 重疊,
#   呢個係 100 高 beta 港股 universe 嘅 irreducible floor — B&H 同 A160 都 corr 0.64).
#
# 橫截面 strategy: 每 20 日 rebalance, 揀 60日 realized vol 最低嘅 10 隻, 等權持倉.
# Walk-forward: SR 逐年上升 (2022:0.06 → 2026:1.63), 全參數組合 OOS SR 1.07-1.55.
# ============================================================
def _load_all_closes():
    """Load close DataFrame (date x all FACTOR_STOCKS) for cross-sectional ranking."""
    import os
    ohlcv_dir = DATA_DIR / "ohlcv_5y"
    cols = {}
    for p in sorted(ohlcv_dir.glob("HK_*.csv")):
        code = p.stem.replace("HK_", "HK.")
        try:
            df = pd.read_csv(p, parse_dates=["time_key"]).set_index("time_key").sort_index()
            cols[code] = pd.to_numeric(df["close"], errors="coerce")
        except Exception:
            continue
    if not cols:
        return None
    return pd.DataFrame(cols).sort_index()


_ALPHA164_CACHE = {}  # (vol_window, n_pick, rebal) -> (entries_per_stock, exits_per_stock)


def _alpha164_build_signals(vol_window=60, n_pick=10, rebal=20):
    """Build per-stock entry/exit signals from cross-sectional low-vol ranking.
    Cached. Returns dict stock -> (entries, exits) boolean Series (aligned to that stock)."""
    key = (vol_window, n_pick, rebal)
    if key in _ALPHA164_CACHE:
        return _ALPHA164_CACHE[key]
    prices = _load_all_closes()
    if prices is None:
        _ALPHA164_CACHE[key] = {}
        return {}
    ret = prices.pct_change()
    vol = ret.rolling(vol_window).std()
    # score: lowest vol ranked first (nlargest on -vol)
    score = -vol
    pos = pd.DataFrame(0.0, index=prices.index, columns=prices.columns)
    held = set()
    for i in range(len(prices)):
        if i % rebal == 0 and i > 0:
            sc = score.iloc[i].dropna()
            if len(sc) >= n_pick:
                held = set(sc.nlargest(n_pick).index)
        if held:
            w = 1.0 / len(held)
            for s in held:
                pos.iloc[i][s] = w
    # per-stock entry/exit edges (position 0->w = entry, w->0 = exit)
    # Fix: .shift(1) 避免同日 signal+execution (同其他 alpha convention 一致)
    sig = {}
    for s in prices.columns:
        p = pos[s]
        in_pos = p > 0
        entries = (in_pos & ~in_pos.shift(1, fill_value=False)).shift(1).fillna(False)
        exits = (~in_pos & in_pos.shift(1, fill_value=False)).shift(1).fillna(False)
        if entries.any():
            sig[s] = (entries, exits)
    _ALPHA164_CACHE[key] = sig
    return sig


def alpha_164(prices, stock, vol_window=40, n_pick=15, rebal=60):
    """橫截面低波動 long (OOS portfolio SR 1.45, DD -11.5%).

    每 20 日 rebalance: 計 100 隻港股 60日 realized vol, 揀最低 10 隻等權持倉.
    經濟邏輯: 低波動異常 (Ang et al 2006) — 低 vol 股票風險調整回報長期跑贏.

    橫截面 strategy (唔同 A159-A163 嘅 per-stock timing):
      A159-A163 都係用單股自己嘅 OHLCV 做 timing → 全部 market beta + 高 vol 股.
      A164 用 cross-section ranking 揀低 vol 股 → 結構上揀相反端, residual beta only.

    OOS corr: A159=0.25, A160=0.54, A161=0.38, A162=0.25, A163=0.48.
      (A160 0.54 係 100 高 beta 港股 universe 嘅 irreducible floor:
       B&H↔A160 都 corr 0.64, 隨機 long-only portfolio↔A160 median corr 0.61.)
    """
    if stock not in prices.columns:
        return None
    sig = _alpha164_build_signals(vol_window, n_pick, rebal)
    if stock not in sig:
        return None
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 250:
        return None
    entries, exits = sig[stock]
    entries = entries.reindex(close.index).fillna(False)
    exits = exits.reindex(close.index).fillna(False)
    if not entries.any():
        return None
    pf = backtest_signals(close, entries, exits)
    return extract_metrics(pf, "164_低波動選股", stock) if pf else None


