# ALPHA-47｜美債息折現率 (US 10Y Discount Rate) — 宏觀文獻
# ============================================================
def alpha_47(prices, stock, yield_window=20, z_window=252, threshold=1.0, holding=10):
    """美債息折現率: 美息急變 → 港股反向 (USD-HKD 聯繫匯率傳導).

    靈感: 宏觀文獻 — 港元聯匯, 美息透過 peg 傳導. 美息急升 → 折現率高 →
          長久期成長股估值壓縮 → 跑輸. 美息跌 → 資金回流港股.
    邏輯: US 10Y 20日變動 Z-score. 美息急升 Z>threshold → 做空 (估值壓縮).
          美息急跌 Z<-threshold → 做多 (資金回流).
    數據: 價格 + factors/us_10y_yield.csv.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + yield_window:
        return None
    yld = _load_factor_csv("us_10y_yield")
    if yld is None:
        return None
    yld_chg = yld.pct_change(yield_window)
    yld_z = compute_zscore(yld_chg.dropna(), z_window)
    yz = yld_z.reindex(close.index).fillna(0)
    # 美息急跌 → 做多; 美息急升 → 做空
    entries = (yz < -threshold).fillna(False).shift(1).fillna(False)
    exits = (yz > 0).fillna(False).shift(1).fillna(False)
    se = (yz > threshold).fillna(False).shift(1).fillna(False)
    sx = (yz < 0).fillna(False).shift(1).fillna(False)
    pf = backtest_signals(close, entries, exits, se, sx)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "47_美息折現率", stock)


