# ALPHA-23｜Outlier Alpha — USDCNH regime-switching (錢琛《以 outlier 找出 alpha》)
# ============================================================
def alpha_23(prices, stock, z_window=250, factor_lag=5, outlier_z=2.0, holding=7):
    """Outlier alpha: USDCNH 正常 regime vs 極端 regime 相關性方向相反.

    靈感: 錢琛《以 outlier 找出 alpha》(2024-08-31) —「兩個 scatter, 大 cluster
    關係弱, 小 outlier cluster 關係強且方向不同 → 分開 monetise 兩個 regime」.

    探索分析數據支撐 (outlier_alpha_discovery.csv):
      USDCNH @ 8/10 藍籌有「方向反轉」現象 (HDBSCAN + IQR + Z-score 三方法確認).
      USDCNH @ HK.01211: 全局 corr≈0 (-0.036), 但 outlier cluster (30點) corr=-0.629.
      |z|>2.5 時相關性由 -0.07 翻轉為 +0.14.

    邏輯鏈:
      - 正常 regime (USDCNH 5日變動 |z|≤2): 人民幣正常波動, 港股輕微負相關
        (USD/CNH 升 → 中資股微跌). 做輕微反向: USDCNH 升 → 減倉.
      - 極端 regime (USDCNH 5日變動 |z|>2): 人民幣急貶/急升觸發資金避險/回流,
        相關性反轉. USDCNH 急升(貶)極端 → 反而見底反彈 (overshoot mean reversion).
        做反轉: USDCNH 急升極端 → 做多 (capture overshoot 反彈).

    無 look-ahead: factor Z 用 rolling window (bar i 只向後睇), 入場 i+1.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + factor_lag + 50:
        return None
    usdcnh = _load_factor_csv("usdcnh")
    if usdcnh is None:
        return None
    usdcnh = usdcnh.reindex(close.index).ffill()
    if len(usdcnh) < z_window + factor_lag:
        return None
    # X = USDCNH 5 日變動
    usdcnh_chg = usdcnh.pct_change(factor_lag)
    # rolling Z-score (causal, 只向後睇)
    roll_mean = usdcnh_chg.rolling(z_window).mean()
    roll_std = usdcnh_chg.rolling(z_window).std()
    z = (usdcnh_chg - roll_mean) / roll_std.replace(0, np.nan)

    # regime split
    is_outlier = z.abs() > outlier_z      # 極端 regime
    is_normal = z.abs() <= outlier_z      # 正常 regime

    # 正常 regime: USDCNH 升 → 輕微負相關 → 做空 (中資股受壓)
    # 極端 regime: USDCNH 急升(貶) overshoot → 反轉 → 做多 (mean reversion)
    # 入場條件:
    #   正常 regime: z > 1.0 (USDCNH 升, 輕微) → 做空 (contrarian, 中資股受壓)
    #   極端 regime: z > outlier_z (USDCNH 急升極端) → 做多 (overshoot 反彈)
    normal_short = is_normal & (z > 1.0)          # 正常 regime 做空
    outlier_long = is_outlier & (z > outlier_z)   # 極端 regime 做多 (反轉)
    # 出場: regime 改變 或 z 回歸中性
    exit_normal = z < 0.0     # USDCNH 升勢逆轉
    exit_outlier = z < outlier_z * 0.5  # 極端緩和

    # 合併: 做空信號 (正常 regime) + 做多信號 (極端 regime)
    entries = outlier_long.fillna(False)          # 做多
    exits = exit_outlier.fillna(False)
    se = normal_short.fillna(False)               # 做空
    sx = exit_normal.fillna(False)

    if not entries.any() and not se.any():
        return None
    # 用 backtest_signals (同 alpha_16/18/20 一致, shift(1) look-ahead consistency)
    entries = entries.shift(1).fillna(False)
    exits = exits.shift(1).fillna(False)
    se = se.shift(1).fillna(False)
    sx = sx.shift(1).fillna(False)
    pf = backtest_signals(close, entries, exits, se, sx)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "23_OutlierAlpha", stock)


