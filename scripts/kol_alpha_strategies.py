# ALPHA-86｜多因子組合 (19 ROBUST K-of-N 投票) — Multi-Factor Ensemble
# ============================================================
def alpha_86(prices, stock, k_threshold=5, holding=10):
    """多因子組合: 19個ROBUST alpha因子投票 → K-of-19共識 → 做多.

    靈感: Classic quant multi-factor ensemble — 獨立信號噪音互相抵消 → Sharpe提升.
    邏輯: 用每個ROBUST alpha嘅核心因子 (Z-score/threshold) 構建 long signal.
          當>=K個因子同時favorable → 買入. 共識瓦解 → 出場.
    技術: 唔用monkey-patch (同run_kol衝突), 直接重新計算每個因子.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 300:
        return None

    ret = close.pct_change()
    signals = {}

    # 用每個ROBUST alpha嘅核心因子構建 long-favorable signal
    # A9 美息risk_on: 連續息跌 →做多
    yld = _load_factor_csv("us_10y_yield")
    if yld is not None:
        yz9 = compute_zscore(yld.reindex(close.index).ffill().pct_change().dropna(), 60).reindex(close.index).fillna(0)
        signals[9] = (yz9 < -1.0).fillna(False)

    # A10 DXY反向: 美元跌 →做多
    dxy = _load_factor_csv("dxy")
    if dxy is not None:
        dz10 = compute_zscore(dxy.reindex(close.index).ffill().pct_change(20).dropna(), 120).reindex(close.index).fillna(0)
        signals[10] = (dz10 < -0.8).fillna(False)

    # A15 250線美息regime: close>SMA250 + 息跌
    sma250 = close.rolling(250).mean()
    signals[15] = ((close > sma250) & (yz9 < 0 if yld is not None else False)).fillna(False) if yld is not None else (close > sma250).fillna(False)

    # A17 沽空軋空: 急跌反彈
    rz17 = compute_zscore(ret.dropna(), 60).reindex(close.index).fillna(0)
    signals[17] = (rz17 < -0.8).fillna(False)

    # A21 高波幅選股: ATR高 + 價格弱
    atr = close.diff().abs().rolling(14).mean()
    signals[21] = (rz17 < -1.0).fillna(False)

    # A26 極強訊號融合: 多因子Z composite > 0
    vix = _load_factor_csv("vix")
    signals[26] = pd.Series(False, index=close.index)
    if vix is not None and dxy is not None:
        vz = compute_zscore(vix.reindex(close.index).ffill().dropna(), 120).reindex(close.index).fillna(0)
        composite = (-vz + -dz10) / 2
        signals[26] = (composite > 0.5).fillna(False)

    # A31 不對稱反轉: 急跌Z極端
    r5 = close.pct_change(5)
    rz31 = compute_zscore(r5.dropna(), 120).reindex(close.index).fillna(0)
    signals[31] = (rz31 < -1.0).fillna(False)

    # A36 動量生命週期: vol Z極端時反向
    vol36 = ret.rolling(20).std()
    vz36 = compute_zscore(vol36.dropna(), 120).reindex(close.index).fillna(0)
    signals[36] = (vz36 > 1.0).fillna(False)

    # A39 情緒反轉: 波動率Z極端
    signals[39] = (vz36 > 1.5).fillna(False)

    # A43 拓撲異常: skewness極端
    skew43 = ret.rolling(60).skew()
    sz43 = compute_zscore(skew43.dropna(), 120).reindex(close.index).fillna(0)
    signals[43] = (sz43 > 1.0).fillna(False)

    # A45 動態波動縮放: 正常跟動量,恐慌反向 (簡化: vol低+SMA上)
    sma120 = close.rolling(120).mean()
    signals[45] = ((close > sma120) & (vz36 < 1.0)).fillna(False)

    # A47 美息折現率: 息跌做多
    signals[47] = (yz9 < -1.0).fillna(False) if yld is not None else pd.Series(False, index=close.index)

    # A58 對抗壓力: 脆弱度 (簡化: vol stable)
    signals[58] = (vz36 < 0).fillna(False)

    # A62 核心邊緣: 跟leader
    leader = _load_peer_close("HK.00700", close.index)
    if leader is not None:
        corr62 = ret.rolling(60).corr(leader.pct_change())
        cz62 = compute_zscore(corr62.dropna(), 120).reindex(close.index).fillna(0)
        signals[62] = (cz62 > 0.6).fillna(False)
    else:
        signals[62] = pd.Series(False, index=close.index)

    # A66 空間集中: 成交集中低 (簡化: turnover CV低)
    turnover = _load_ohlcv_column(stock, "turnover")
    if turnover is not None:
        t = turnover.reindex(close.index).ffill()
        cv = t.rolling(50).std() / t.rolling(50).mean().replace(0, np.nan)
        cvz = compute_zscore(cv.dropna(), 120).reindex(close.index).fillna(0)
        signals[66] = (cvz < -1.0).fillna(False)
    else:
        signals[66] = pd.Series(False, index=close.index)

    # A69 因果發現: VIX滯後corr高
    signals[69] = pd.Series(False, index=close.index)
    if vix is not None:
        gc = ret.rolling(60).corr(vix.reindex(close.index).ffill().pct_change().shift(2))
        gz69 = compute_zscore(gc.dropna(), 120).reindex(close.index).fillna(0)
        signals[69] = (gz69 > 1.0).fillna(False)

    # A71 譜定價: vol of vol極端
    vov = vol36.pct_change(20).rolling(20).std()
    vovz = compute_zscore(vov.dropna(), 120).reindex(close.index).fillna(0)
    signals[71] = (vovz > 0.8).fillna(False)

    # A74 風險阻尼: return自相關高 (簡化: 用 momentum positive)
    mom74 = close.pct_change(20)
    mz74 = compute_zscore(mom74.dropna(), 120).reindex(close.index).fillna(0)
    signals[74] = (mz74 > 0.8).fillna(False)

    # A78 XMSE收縮: 預測誤差大 (簡化: 偏離SMA大)
    dev78 = (close - sma120) / sma120
    dz78 = compute_zscore(dev78.dropna(), 120).reindex(close.index).fillna(0)
    signals[78] = (dz78 < -1.0).fillna(False)

    # 構建 SR 加權投票矩陣 (v2: 唔再等權, 用每個 alpha 嘅 historical SR 加權)
    SR_W = {9:1.29,10:1.33,15:1.44,17:0.76,21:0.76,26:1.25,31:1.14,36:1.12,
            39:0.75,43:0.80,45:0.95,47:1.47,58:1.17,59:0.91,62:1.22,66:0.78,
            69:1.35,71:0.84,74:1.18,88:0.70}
    weighted = pd.DataFrame({k: v.astype(float) * SR_W.get(k, 1.0) for k, v in signals.items()})
    score = weighted.sum(axis=1)
    ensemble_entries = (score >= 2.0).shift(1).fillna(False)
    ensemble_exits = (score < 0.6).shift(1).fillna(False)
    if not ensemble_entries.any():
        return None
    pf = backtest_signals(close, ensemble_entries, ensemble_exits)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "86_多因子組合", stock)



