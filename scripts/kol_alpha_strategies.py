# ALPHA-36｜動量生命週期 (Momentum Life-cycle) — 學術論文
# ============================================================
def alpha_36(prices, stock, mom_window=20, vol_z_window=120, vol_threshold=1.5, holding=10):
    """動量生命週期: 低波動期跑動量, 高波動期關閉 (避崩盤).

    靈感: Momentum crash risk literature — 動量喺高波動期反轉.
    邏輯: VIX Z < 1.5 (平靜期) → 做動量 (近20日漲→繼續做多).
          VIX Z > 1.5 (恐慌期) → 平倉避崩盤.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < vol_z_window + 50:
        return None
    vix = _load_factor_csv("vix")
    if vix is None:
        return None
    vix = vix.reindex(close.index).ffill()
    vix_z = compute_zscore(vix, vol_z_window)
    # 動量信號
    mom = close.pct_change(mom_window)
    # 只喺低波動期入場
    calm = vix_z < vol_threshold
    entry = calm & (mom > 0.02)
    exit_c = (vix_z > vol_threshold) | (mom < -0.01)
    pf = _build_factor_signal(mom, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "36_動量生命週期", stock)


# ============================================================
# ALPHA-37｜深度反轉 (Deep Reversal) — ALPHA-31 進階版
# ============================================================
def alpha_37(prices, stock, lookback=3, threshold=-0.08, holding=5):
    """深度反轉: 只喺跌 > 8% 先做 (比 ALPHA-31 既 5% 更極端).

    靈感: 不對稱反轉進階版 — 越極端既跌 → 越強既反轉.
    邏輯: 3 日跌 > 8% = 恐慌拋售 → 過度反應 → 強烈反彈.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 100:
        return None
    ret_3d = close.pct_change(lookback)
    entry = ret_3d < threshold
    exit_c = pd.Series(False, index=close.index)
    for i in np.where(entry.values)[0]:
        exit_i = min(i + holding, len(close) - 1)
        exit_c.iloc[exit_i] = True
    if not entry.any():
        return None
    pf = _build_factor_signal(ret_3d, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "37_深度反轉", stock)


