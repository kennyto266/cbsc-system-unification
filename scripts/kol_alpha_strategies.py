def alpha_143(prices, stock, holding=7):
    """貼現窗壓力 short (Thesis-first, OOS +0.77 對 HSIF, hold=7).

    預檢: G1 二元active 24.2% PASS | G2 觸發 9.4% PASS | G3 IC=-0.035 同向 PASS
          G4 子期一致 [-0.019 -0.022 -0.056 +0.002] PASS
    OOS: IS -0.50, OOS +0.77 (hold=7 最佳).
    Thesis: 銀行借貼現窗=流動性壓力 → 利淡.
    關鍵 sign convention: discount_window_usage 全 ≤0 (HKMA 借錢記負資產),
    所以 'active' = (dw < 0), 唔係 (dw > 0). 呢個 sign 錯曾經令 A144 舊版全失效.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 200:
        return None
    factor = _load_factor_col("discount_window.csv", "discount_window_usage")
    if factor is None:
        return None
    f = factor.reindex(close.index).ffill().dropna()
    if len(f) < 120:
        return None
    # dw < 0 = active (借用中). entry: 壓力 rising edge; exit: 壓力消退
    active = (f < 0)
    entry = active & (~active.shift(1).fillna(False))     # 0→負 rising edge
    exit_c = (~active) & (active.shift(1).fillna(False))  # 負→0 消退
    pf = _build_factor_signal(f, close, entry.reindex(f.index).fillna(False),
                              exit_c.reindex(f.index).fillna(False), holding, "contrarian")
    return extract_metrics(pf, "143_貼現窗壓力short", stock) if pf else None


