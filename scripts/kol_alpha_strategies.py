def _load_composite(file_a, col_a, file_b, col_b, op="ratio"):
    """load 兩個 series 做 ratio 或 diff (cross-currency / yield slope)."""
    a = _load_factor_col(file_a, col_a)
    b = _load_factor_col(file_b, col_b)
    if a is None or b is None:
        return None
    common = a.index.intersection(b.index)
    a, b = a.reindex(common), b.reindex(common)
    if op == "ratio":
        return (a / b.replace(0, np.nan)).dropna()
    return (a - b).dropna()


