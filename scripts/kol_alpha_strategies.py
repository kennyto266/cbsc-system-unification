# ALPHA-26｜跨策略極強訊號融合 (蔡嘉民「高頻報價低頻交易」)
# ============================================================
def alpha_26(prices, stock, score_threshold=2.0, z_window=120, holding=10):
    """跨策略訊號融合: 多因子方向一致 → 加權評分入場.

    靈感: 蔡嘉民核心理念 #1「高頻報價, 低頻交易」— 等多個訊號方向一致先入場.

    邏輯 (修復版, 硬門檻改加權評分):
      - 5 個獨立因子 (VIX, DXY, USDCNH, US10Y, Gold) 各計 rolling Z-score
      - 每個因子貢獻連續分數 = -z (sign-corrected: 因子跌=利好→正分)
        唔係硬 0/1, 而係連續值, 方向一致就計分
      - composite = 全部因子分數加總
      - entry = composite > score_threshold (默認 3.0 = 平均每因子 z<-0.6 方向一致)
      - exit = composite < 0 (共識瓦解)
      - 呢個忠於「多訊號一致先入場」原意, 唔要求極端, 要求方向一致
    無 look-ahead: rolling Z + shift(1) 入場.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 50:
        return None
    vix = _load_factor_csv("vix"); dxy = _load_factor_csv("dxy")
    usdcnh = _load_factor_csv("usdcnh"); us10y = _load_factor_csv("us_10y_yield")
    gold = _load_factor_csv("gold")
    factors = {"vix": vix, "dxy": dxy, "usdcnh": usdcnh, "us10y": us10y, "gold": gold}
    if sum(1 for v in factors.values() if v is not None) < 3:
        return None
    # 每個因子 reindex + Z-score → 連續分數 (因子跌=利好→正分)
    composite = pd.Series(0.0, index=close.index)
    n_factors = 0
    for name, f in factors.items():
        if f is None:
            continue
        f = f.reindex(close.index).ffill()
        z = compute_zscore(f, z_window)
        # 統一方向: 因子跌 = 港股利好 → -z 為正分
        composite += (-z).fillna(0)
        n_factors += 1
    # 加權評分: composite > threshold = 多因子方向一致利好
    entry = composite > score_threshold
    exit_c = composite < 0
    if not entry.any():
        return None
    pf = _build_factor_signal(composite, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "26_訊號融合評分", stock)


