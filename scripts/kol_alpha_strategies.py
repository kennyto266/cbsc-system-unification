def _load_factor_col(file, col):
    """讀 factors/{file} 既指定 col, 自動偵測日期欄 (date/end_of_day/...).
    比 _load_hkma_factor 更 robust, 處理 end_of_day 命名."""
    p = DATA_DIR / "factors" / file
    if not p.exists():
        return None
    try:
        df = pd.read_csv(p)
        dc = None
        for c in df.columns:
            if c.lower() in ("date", "end_of_day", "datetime", "time", "time_key"):
                dc = c
                break
        if dc is None:
            dc = df.columns[0]
        if col not in df.columns:
            return None
        df[dc] = pd.to_datetime(df[dc], errors="coerce")
        df = df.dropna(subset=[dc, col]).sort_values(dc).drop_duplicates(subset=dc, keep="last")
        return pd.Series(df[col].astype(float).values, index=df[dc].values, name=col)
    except Exception:
        return None


def _regime_signal(close, factor, sma=70, holding=10, tag="regime", direction="follow"):
    """通用 regime 信號: factor > SMA = risk-on → 做多; < SMA = risk-off → 出場.
    OOS 掃描確認 regime logic 係呢批 macro factor 最有效既觸發方式."""
    f = factor.reindex(close.index).ffill().dropna()
    if len(f) < sma + 50:
        return None
    fa = f.rolling(sma).mean()
    entry = (f > fa)
    exit_c = (f < fa)
    pf = _build_factor_signal(f, close, entry.reindex(f.index).fillna(False),
                              exit_c.reindex(f.index).fillna(False), holding, direction)
    return pf


