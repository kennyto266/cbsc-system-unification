# ALPHA-40｜資產增長異常 (Asset Growth) — 學術論文 (真實財報版)
# ============================================================
def alpha_40(prices, stock, growth_window=60, z_window=252, threshold=1.0, holding=21):
    """資產增長異常: 真實 Total Assets 年增長率 (無財報時退回市值代理).

    靈感: Cooper, Gulen & Schill "Asset Growth and Stock Returns" (2008) —
          資產增長率高 → 過度投資 → 未來跑輸 (做空).
          資產增長率低/負 → 收縮增效 → 跑贏 (做多).
    邏輯: 用 yfinance 拉到嘅真實 annual Total Assets 計年增長率.
          無財報數據時退回舊版: 60 日市值變動做代理.
    數據: fundamentals/HK_{stock}_financials.csv → asset_growth (真實 ΔTA/TA).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + growth_window:
        return None

    # 優先: 真實財報 asset_growth
    fund = _load_fundamentals(stock)
    real_growth = None
    if fund is not None and "asset_growth" in fund.columns:
        # forward-fill 到日線 (公告後 90 日先可見, 避免 look-ahead)
        real_growth = _forward_fill_fundamental(fund, "asset_growth", close.index)

    if real_growth is not None and real_growth.dropna().shape[0] >= 3:
        # 真實財報版: asset_growth 本身已係 YoY% (跨年度), 直接做 Z-score
        growth_z = compute_zscore(real_growth.dropna(), z_window)
        gz = growth_z.reindex(close.index).fillna(0)
    else:
        # 代理版: 60 日市值變動
        mkt_cap_growth = close.pct_change(growth_window)
        growth_z = compute_zscore(mkt_cap_growth.dropna(), z_window)
        gz = growth_z.reindex(close.index).fillna(0)

    se = (gz > threshold).fillna(False).shift(1).fillna(False)
    sx = (gz < 0).fillna(False).shift(1).fillna(False)
    entries = (gz < -threshold).fillna(False).shift(1).fillna(False)
    exits = (gz > 0).fillna(False).shift(1).fillna(False)
    pf = backtest_signals(close, entries, exits, se, sx)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "40_資產增長", stock)


