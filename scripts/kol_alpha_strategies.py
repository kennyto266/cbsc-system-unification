# ALPHA-22｜三重跟大戶 (北水 + VIX + DXY 三確認)
# ============================================================
def alpha_22(prices, stock, nb_window=60, macro_window=60, threshold=1.5, holding=5):
    """北水大買 AND VIX恐慌 AND DXY跌 → 三重確認 → 最強做多."""
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 200:
        return None
    flow = _load_southbound_flow()
    vix = _load_factor_csv("vix")
    dxy = _load_factor_csv("dxy")
    if flow is None or vix is None or dxy is None:
        return None
    flow = flow.reindex(close.index, method="ffill")
    vix = vix.reindex(close.index, method="ffill")
    dxy = dxy.reindex(close.index, method="ffill")
    nb_z = compute_zscore(flow, nb_window)
    vix_z = compute_zscore(vix, macro_window)
    dxy_z = compute_zscore(dxy.pct_change(), macro_window)
    # 三重確認: 北水買 + VIX恐慌(回落預期) + DXY跌
    entry = (nb_z > threshold) & (vix_z > threshold) & (dxy_z < -threshold)
    exit_c = (nb_z < 0) | (vix_z < 0)
    pf = _build_factor_signal(flow, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "22_三重跟大戶", stock)


