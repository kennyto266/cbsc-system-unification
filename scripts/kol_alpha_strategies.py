# ALPHA-29｜隔夜跳空 (蔡嘉民 — 日內/隔夜策略)
# ============================================================
def alpha_29(prices, stock, gap_threshold=0.02, holding=3):
    """隔夜跳空: 連續下跌後跳空高開 → 反彈延續做多.

    靈感: 蔡嘉民講「低頻交易, 高頻報價」. 跳空高開 (gap up) 喺
    超跌股上 = 反彈信號. 用 open vs prev close 計 gap.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 100:
        return None

    # 單純用 close 模擬 gap (yfinance 冇 open)
    # gap proxy: 今日 return 由昨日低點反彈
    ret = close.pct_change()
    prev_ret = ret.shift(1)
    # 前日跌 + 今日跳空 (return > gap_threshold)
    gap_up = (prev_ret < -0.01) & (ret > gap_threshold)
    # 額外條件: 連續3日下跌
    down3 = (ret.shift(1) < 0) & (ret.shift(2) < 0) & (ret.shift(3) < 0)
    entry = gap_up & down3
    exit_c = pd.Series(False, index=close.index)
    for i in np.where(entry.values)[0]:
        exit_i = min(i + holding, len(close) - 1)
        exit_c.iloc[exit_i] = True
    if not entry.any():
        return None
    pf = _build_factor_signal(ret, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "29_隔夜跳空", stock)


