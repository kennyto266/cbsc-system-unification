# ALPHA-30｜MAX Effect (彩票效應) — Bali, Cakici, Whitelaw (JFE)
# ============================================================
def alpha_30(prices, stock, max_window=20, z_window=252, entry_z=1.0, holding=5):
    """MAX Effect: 過去20日最大單日升幅極高 → 散戶追入 → 做空/避開.

    靈感: Bali, Cakici, Whitelaw (2011, JFE) "Stocks as Lotteries"
    港股驗證: HK.00700 spread +1.62%, HK.02018 +0.99%, HK.00939 +0.81%

    邏輯: 散戶偏好彩票式回報 (單日爆升), 推高價格 → 之後回落.
    - MAX Z > 1.0 (近期爆升) → 做空 (散戶追入後回落)
    - MAX Z < -1.0 (近期平淡) → 做多 (無人理, 反而跑贏)
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 50:
        return None
    daily_ret = close.pct_change()
    max_ret = daily_ret.rolling(max_window).max()
    max_z = compute_zscore(max_ret.dropna(), z_window)

    # 做空高 MAX (散戶追入)
    short_entry = max_z > entry_z
    short_exit = max_z < 0
    # 做多低 MAX (無人理 → 反而跑贏)
    long_entry = max_z < -entry_z
    long_exit = max_z > -0.5

    se = short_entry.fillna(False).shift(1).fillna(False)
    sx = short_exit.fillna(False).shift(1).fillna(False)
    entries = long_entry.fillna(False).shift(1).fillna(False)
    exits = long_exit.fillna(False).shift(1).fillna(False)

    pf = backtest_signals(close, entries, exits, se, sx)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "30_MAX彩票效應", stock)


