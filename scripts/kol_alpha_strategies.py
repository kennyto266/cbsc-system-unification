def alpha_147(prices, stock, z_window=60, threshold=2.0, holding=10):
    """南北向背離 divergence long (OOS +1.90 對 HSIF, 權重股 7/10 正).

    預檢: G2 觸發 12.5% PASS | G3 IC=+0.139 同向 PASS
          G4 子期一致 [+0.214 +0.039 +0.234 +0.075] PASS (avg|IC|=0.140)
    OOS: IS +0.50, OOS +1.90 (hold=10).
    新訊號類型: DIVERGENCE — z(南向淨買) - z(北向淨買).
    經濟邏輯: 南向資金相對北向資金超強 = 內地資金偏好港股 → 做多.
    比單獨睇南向更穩定, 因為扣除咗整體兩地資金流動嘅 baseline.
    IC=+0.139 比南向單獨 (A144 IC=+0.113) 更高 → 背離比 level 更有預測力.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 60:
        return None
    south = _load_southbound_netbuy()
    north = _load_northbound_netbuy()
    if south is None or north is None:
        return None
    # 5日累計淨買 → 對齊股價 → z-score → 背離
    s5 = south.rolling(5).sum().reindex(close.index).ffill().dropna()
    n5 = north.rolling(5).sum().reindex(close.index).ffill().dropna()
    if len(s5) < z_window + 50 or len(n5) < z_window + 50:
        return None
    sz = (s5 - s5.rolling(z_window).mean()) / s5.rolling(z_window).std()
    nz = (n5 - n5.rolling(z_window).mean()) / n5.rolling(z_window).std()
    divergence = sz - nz
    entry = divergence > threshold   # 南向相對北向超強 → 做多
    exit_c = divergence < 0          # 背離消失
    pf = _build_factor_signal(divergence, close, entry.reindex(divergence.index).fillna(False),
                              exit_c.reindex(divergence.index).fillna(False), holding, "follow")
    return extract_metrics(pf, "147_南北向背離", stock) if pf else None


