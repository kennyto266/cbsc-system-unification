# A156 — Overnight Return Contrarian (2026-07-01)
# 學術論文: Lou-Polk-Skouras (JFE 2019) — overnight return 預測後續回報
# ============================================================
def alpha_156(prices, stock, z_window=60, threshold=2.5, holding=10):
    """隔夜回報反轉 long (OOS avg SR 0.47, 73% 正).

    Thesis (Lou-Polk-Skouras 2019): overnight return 極端時反轉.
    隔夜暴跌 (z < -2.5) → 抄底做多. 機構開低定價 → 散戶恐慌 → 超賣反彈.
    純 OHLCV 訊號, 唔依賴 macro factor, 同所有其他 alpha 低相關.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 60:
        return None
    # 需要 open 數據 — 從 ohlcv CSV 讀
    fname = stock.replace(".", "_")
    ohlcv_p = DATA_DIR / "ohlcv_5y" / f"{fname}.csv"
    if not ohlcv_p.exists():
        ohlcv_p = DATA_DIR / "ohlcv_10yr" / f"{fname}.csv"
    if not ohlcv_p.exists():
        return None
    try:
        df = pd.read_csv(ohlcv_p, parse_dates=["time_key"]).set_index("time_key").sort_index()
        opn = df["open"].astype(float)
    except Exception:
        return None
    # overnight return = open / prev_close - 1
    overnight = opn / close.shift(1) - 1
    z = (overnight - overnight.rolling(z_window).mean()) / overnight.rolling(z_window).std()
    entry = (z < -threshold).shift(1).fillna(False)  # 隔夜暴跌 → 抄底
    exit_c = entry.shift(holding).fillna(False)
    pf = backtest_signals(close, entry, exit_c)
    return extract_metrics(pf, "156_隔夜反轉", stock) if pf else None


