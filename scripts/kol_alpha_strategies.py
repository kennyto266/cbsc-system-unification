# ALPHA-34｜流動性溢價 (Liquidity Premium) — Lam & Tam JBF
# ============================================================
def alpha_34(prices, stock, vol_window=20, z_window=120, threshold=-1.5, holding=14):
    """流動性溢價: 成交量極低既股 (Z<-1.5) 長期跑贏.

    靈感: Lam & Tam (2011) JBF — 港股 illiquidity premium 文獻.
    邏輯: 低流動性 = 高風險 = 投資者要求補償 → 長期超額回報.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 50:
        return None
    # 成交量 proxy: 日回報絕對值 (Amihud illiquidity 簡化版)
    illiq = close.pct_change().abs()
    illiq_z = compute_zscore(illiq.dropna(), z_window)
    # 極低流動性 → 做多 (流動性溢價)
    entry = illiq_z < threshold
    exit_c = illiq_z > 0.5
    pf = _build_factor_signal(illiq, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "34_流動性溢價", stock)


