# ALPHA-09｜美息 → 港股 risk-on 濾網
# ============================================================
def alpha_09(prices, stock, roc_window=20, trend_days=5, holding=14):
    """美息動量: 連續 N 日息率回落 (risk-on) → 做多港股.

    修正: 原版 exit_c=yield_roc>0 觸發55% (息率升跌頻密) → 持倉1日即平.
    新版: 連續 trend_days 日息跌先入場, 連續 trend_days 日息升先出場.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 200:
        return None
    yield_s = _load_factor_csv("us_10y_yield")
    if yield_s is None:
        return None
    yield_roc = yield_s.pct_change(roc_window)
    # 連續性: 過去 N 日息率全部下跌 = risk_on
    falling = (yield_roc < 0).rolling(trend_days).sum() >= trend_days
    rising = (yield_roc > 0).rolling(trend_days).sum() >= trend_days
    entry = falling
    exit_c = rising
    pf = _build_factor_signal(yield_s, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "09_美息risk_on", stock)


