# ALPHA-35｜月初效應 (Turn-of-month) — 學術論文
# ============================================================
def alpha_35(prices, stock, holding=3):
    """月初效應: 每月最後交易日買入, 頭 3 日賣出.

    靈感: 港股 turn-of-month effect (學術文獻記錄).
    邏輯: 月初資金流入 (薪資/基金再平衡) → 月初回報顯著正.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 200:
        return None
    dates = pd.Series(close.index)
    months = dates.dt.to_period("M")
    # 每月最後一個交易日
    is_month_end = months != months.shift(-1)
    entries = is_month_end.values
    entries = pd.Series(entries, index=close.index).shift(1).fillna(False)
    exits = pd.Series(False, index=close.index)
    for i in np.where(entries.values)[0]:
        exit_i = min(i + holding, len(close) - 1)
        exits.iloc[exit_i] = True
    if not entries.any():
        return None
    pf = backtest_signals(close, entries, exits)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "35_月初效應", stock)


