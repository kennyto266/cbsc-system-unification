# A159 — MACD+量能三確認順勢 (2026-07-01)
# Portfolio OOS SR 1.32, DD -3.8%, 100股分散, 27 param 組合全 >1.2
# 學術: volume-price momentum confirmation (Chordia-Swaminathan 2000)
# ============================================================
def alpha_159(prices, stock, fast=12, slow=26, signal_p=9,
              vol_window=20, vol_z=1.5, mom_window=5, holding=3):
    """MACD+量能三確認順勢 long (OOS portfolio SR 1.32, DD -3.8%).

    三重確認順勢入場:
      1. MACD histogram > 0 且上升 (趨勢確認)
      2. 成交量 z-score > 1.5 (資金流入)
      3. 5日回報 > 0 (動量向上)
    三個條件同時成立 → entry, 持倉 3 日.

    Portfolio-level (100股 equal-weight) OOS SR 1.32, 單股 median 0.60.
    穩健性: 27 個參數組合全部 OOS SR 1.23-1.35.
    Walk-forward: 2024 SR 1.85, 2025 SR 1.17.

    純 OHLCV, 同 A157(單量能) 互補 — A159 加埋 MACD 趨勢確認.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 250:
        return None
    fname = stock.replace(".", "_")
    ohlcv_p = DATA_DIR / "ohlcv_5y" / f"{fname}.csv"
    if not ohlcv_p.exists():
        ohlcv_p = DATA_DIR / "ohlcv_10yr" / f"{fname}.csv"
    if not ohlcv_p.exists():
        return None
    try:
        df = pd.read_csv(ohlcv_p, parse_dates=["time_key"]).set_index("time_key").sort_index()
        vol = df["volume"].astype(float)
    except Exception:
        return None
    # 1. MACD histogram > 0 且上升
    ema_f = close.ewm(span=fast, adjust=False).mean()
    ema_s = close.ewm(span=slow, adjust=False).mean()
    macd = ema_f - ema_s
    sig = macd.ewm(span=signal_p, adjust=False).mean()
    hist = macd - sig
    macd_bull = (hist > 0) & (hist > hist.shift(1))
    # 2. 成交量 z-score
    vol_sma = vol.rolling(vol_window).mean()
    vol_std = vol.rolling(vol_window).std()
    vol_spike = (vol - vol_sma) / vol_std.replace(0, np.nan)
    # 3. 動量
    ret5 = close.pct_change(mom_window)
    entry = (macd_bull & (vol_spike > vol_z) & (ret5 > 0)).shift(1).fillna(False)
    exit_c = entry.shift(holding).fillna(False)
    pf = backtest_signals(close, entry, exit_c)
    return extract_metrics(pf, "159_MACD量能三確認", stock) if pf else None


