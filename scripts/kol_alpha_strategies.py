# ALPHA-41｜盈後漂移 PEAD (真實盈利確認版) — 學術論文
# ============================================================
def alpha_41(prices, stock, event_window=1, drift_window=10, threshold=0.03, holding=10):
    """PEAD: 單日暴升 + 真實盈利正增長 → 買入等漂移 (無財報時退回純價格版).

    靈感: Bernard & Thomas "Post-Earnings-Announcement Drift" (1989/1990) —
          業績超預期後股價慢慢漂移上升 (市場反應不足).
    邏輯: 真實版: 單日升 > 4% AND 該公司最近一期 net_income YoY 為正
          (確認升幅真係盈利驅動, 唔係炒作/消息噪音).
          代理版: 無財報時退回純單日升 > 4%.
    數據: fundamentals/HK_{stock}_financials.csv → earnings_growth (真實 ΔNI/NI).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < 200:
        return None
    ret = close.pct_change()
    # 單日升 > 4% = 事件 (盈利超預期代理)
    event = ret > threshold

    # 優先: 用真實 earnings_growth 過濾 (只信「盈利真係增長」既公司既暴升)
    fund = _load_fundamentals(stock)
    if fund is not None and "earnings_growth" in fund.columns:
        eg = _forward_fill_fundamental(fund, "earnings_growth", close.index)
        if eg is not None and eg.dropna().shape[0] >= 2:
            # earnings_growth > 0 = 盈利正增長 (真實盈利驚喜 confirm)
            profit_growing = (eg > 0).fillna(False)
            event = event & profit_growing  # 價格暴升 AND 盈利正增長

    # 事件後買入等漂移
    entry = event.fillna(False).shift(1).fillna(False)  # 事件翌日買入
    exit_c = pd.Series(False, index=close.index)
    for i in np.where(entry.values)[0]:
        exit_i = min(i + holding, len(close) - 1)
        exit_c.iloc[exit_i] = True
    if not entry.any():
        return None
    pf = backtest_signals(close, entry, exit_c)
    if pf is None or pf.trades.count() == 0:
        return None
    return extract_metrics(pf, "41_PEAD漂移", stock)


