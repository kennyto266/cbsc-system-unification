# ALPHA-24｜波動率突破 (蔡嘉民核心理念 #4 — 純 vol 交易)
# ============================================================
def alpha_24(prices, stock, atr_period=14, vol_window=60, breakout_window=20, hold=10):
    """波動率突破: vol 壓縮→擴張 regime transition = 趨勢啟動訊號.

    靈感: 蔡嘉民核心理念 #4「波動率交易」— vol regime 變化藴含趨勢資訊.

    邏輯 (修復版, 解決原版邏輯互斥):
      - ATR(14)/close = 近期波動率
      - vol_z = rolling Z-score (壓縮/擴張)
      - 偵測「壓縮→擴張」連續 transition (唔互斥):
        1. prev_squeeze: 過去 10 日內有 vol_z < -1 (曾壓縮)
        2. now_expanding: 當前 vol_z > 0 (已擴張)
        3. breakout: close > breakout_window 日 high (方向確認)
      - entry = 三者同時 → 做多 (壓縮後擴張 = 趨勢啟動)
      - exit: close < 10 日均線 (趨勢結束)
    無 look-ahead: rolling + shift(1) 入場.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < vol_window + breakout_window + 50:
        return None
    atr = close.diff().abs().rolling(atr_period).mean()
    vol_ratio = (atr / close).dropna()
    vol_z = compute_zscore(vol_ratio, vol_window)

    # 壓縮→擴張 transition (連續事件, 唔互斥)
    is_squeeze = (vol_z < -0.5)   # 放寬壓縮門檻 (-1→-0.5) 增加觸發
    prev_squeeze = is_squeeze.rolling(15).max().fillna(False).astype(bool)  # 過去15日曾壓縮
    now_expanding = (vol_z > 0).fillna(False)                               # 當前已擴張
    # 方向確認: close 突破近期 high
    recent_high = close.rolling(breakout_window).max().shift(1)  # shift(1) 唔含當日
    breakout = (close > recent_high).fillna(False)
    entry = prev_squeeze & now_expanding & breakout
    exit_c = (close < close.rolling(10).mean()).fillna(False)

    if not entry.any():
        return None
    pf = _build_factor_signal(vol_ratio, close, entry, exit_c, hold, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "24_波動率突破", stock)


# ============================================================
# ALPHA-25｜IQR denoise 強化 (錢琛 outlier 層次 1 — denoise)
# ============================================================
def alpha_25(prices, stock, z_window=120, iqr_mult=2.0, holding=10):
    """IQR denoise: 移除極端值後既 VIX 訊號更純.

    靈感: 錢琛《以 outlier 找出 alpha》層次 1 —「移除數據中既 outlier 去 denoise,
    提高指標準確度. 例如 funding rate 太高/低, 完全偏離均值, 未必適合做指標」.

    邏輯:
      - 拎 VIX (恐慌指數)
      - 用 IQR 法 clamp 極端值: 超過 Q3+2*IQR 既 clamp 返 upper bound
        (唔係移除, 係 winsorize — 保留時間點但壓低極端影響)
      - denoise 後既 VIX 做 Z-score, 高於 threshold = 恐慌 → 做多 (mean reversion)
      - 對比 ALPHA-12 (raw VIX): denoise 後 Z-score 更平穩, 減少極端 VIX spike 噪音
    無 look-ahead: rolling IQR + shift(1) 入場.
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 50:
        return None
    vix = _load_factor_csv("vix")
    if vix is None:
        return None
    vix = vix.reindex(close.index).ffill()
    # rolling IQR winsorize (denoise)
    q1 = vix.rolling(z_window, min_periods=30).quantile(0.25)
    q3 = vix.rolling(z_window, min_periods=30).quantile(0.75)
    iqr = q3 - q1
    upper = q3 + iqr_mult * iqr
    lower = q1 - iqr_mult * iqr
    vix_denoised = vix.clip(lower=lower, upper=upper)
    # denoise 後 Z-score
    vix_z = compute_zscore(vix_denoised.dropna(), z_window)
    # 恐慌 (denoised VIX 高) → 做多 (mean reversion)
    entry = vix_z > 1.0
    exit_c = vix_z < -0.5
    pf = _build_factor_signal(vix_denoised.dropna(), close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "25_IQR_Denoise", stock)


