# ALPHA-32｜殘差動量 (Residual Momentum) — 學術論文
# ============================================================
def alpha_32(prices, stock, mom_window=20, z_window=120, threshold=1.0, holding=21):
    """殘差動量: 用市場 beta 去除系統性風險, 剩低既純 alpha 動量.

    靈感: "Integrating Residual Momentum with Deviation Factor Models" (HK market)
    邏輯: 股票回報 - beta×市場回報 = 殘差. 殘差動量比原始動量更穩定 (去除 beta 噪音).
    """
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < z_window + 50:
        return None
    # 市場代理: 用 sp500 或 a_shares
    mkt = _load_factor_csv("sp500")
    if mkt is None:
        return None
    mkt = mkt.reindex(close.index).ffill()
    stock_ret = close.pct_change()
    mkt_ret = mkt.pct_change()
    # 簡化 beta: rolling 60 日 covariance / variance
    cov = stock_ret.rolling(60).cov(mkt_ret)
    var = mkt_ret.rolling(60).var()
    beta = cov / var.replace(0, np.nan)
    # 殘差回報 = 股票 - beta × 市場
    residual = stock_ret - beta * mkt_ret
    # 殘差動量
    res_mom = residual.rolling(mom_window).sum()
    res_z = compute_zscore(res_mom.dropna(), z_window)
    entry = res_z > threshold
    exit_c = res_z < 0
    pf = _build_factor_signal(res_mom, close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "32_殘差動量", stock)


