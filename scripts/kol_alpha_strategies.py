# ALPHA-15｜250 天線 + 美息 regime
# ============================================================
def alpha_15(prices, stock, sma_long=250, roc_window=20, holding=14):
    """close>SMA250 AND 美息ROC<0 → bull regime → 做多."""
    if stock not in prices.columns:
        return None
    close = prices[stock].dropna()
    if len(close) < sma_long + 50:
        return None
    yield_s = _load_factor_csv("us_10y_yield")
    if yield_s is None:
        return None
    yield_s = yield_s.reindex(close.index, method="ffill")
    sma = compute_sma(close, sma_long)
    yield_roc = yield_s.pct_change(roc_window)
    bull = (close > sma) & (yield_roc < 0)
    bear = (close < sma) & (yield_roc > 0)
    entry = bull
    exit_c = bear
    pf = _build_factor_signal(pd.Series(1, index=close.index), close, entry, exit_c, holding, "follow")
    if pf is None:
        return None
    return extract_metrics(pf, "15_250線美息regime", stock)


