#!/usr/bin/env python3
"""collect_southbound_sdw.py — T-sbag: HKEX SDW 南向持股日度 collector.

源頭 (2026-08-22 實證):
  https://www3.hkexnews.hk/sdw/search/mutualmarket.aspx?t=hk
  ASP.NET WebForms POST — txtShareholdingDate 格式必須 'YYYY/MM/DD' (有斜線!)
  __EVENTTARGET='' + btnSearch='Search'
  一次 POST 返成個 table (~950 股全部南向持股), 唔使逐股.
  官方: 數據由 2017-03-17 起, 只保留 12 個月窗口.
  假日會自動 fallback 前一個交易日 (顯示實際 date 喺 Shareholding Date).

輸出:
  data/new_sources/southbound_sdw_raw.csv   (date, stock_code, name, shares, pct)
  data/new_sources/southbound_sdw_ckpt.json (done_dates + 去重)
  51 股核心池過濾喺 build panel 時做 (raw 全留, 遲啲擴 universe 用得着).

用法:
  python scripts/collect_southbound_sdw.py                       # 增量: 由 ckpt 最後日到今日
  python scripts/collect_southbound_sdw.py --backfill            # 全量: 由 12 個月窗口最早日開始
  python scripts/collect_southbound_sdw.py --date 2026/08/14     # 單日補飛
"""
import argparse
import csv
import json
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import http.cookiejar
from datetime import datetime, timedelta
from pathlib import Path

BASE = Path(__file__).resolve().parent.parent
OUT_DIR = BASE / "data" / "new_sources"
OUT_DIR.mkdir(parents=True, exist_ok=True)
RAW = OUT_DIR / "southbound_sdw_raw.csv"
CKPT = OUT_DIR / "southbound_sdw_ckpt.json"

URL = "https://www3.hkexnews.hk/sdw/search/mutualmarket.aspx?t=hk"
UA = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"}
DELAY = 3.5          # 秒 — 一日一 POST, 禮貌間隔
FIRST_DATE = "2017/03/17"   # 官方最早
WINDOW_MONTHS = 12   # 官方保留窗口

ROW_RE = re.compile(
    r'mobile-list-body">\s*([0-9]{1,5})</div>\s*</td>\s*'
    r'<td class="col-stock-name">.*?mobile-list-body">([^<]*)</div>.*?'
    r'mobile-list-body">([0-9,]+)</div>.*?'
    r'mobile-list-body">([0-9.]+)%',
    re.S,
)
DATE_SHOWN_RE = re.compile(r"Shareholding Date:\s*([0-9/]+)")


def load_ckpt() -> dict:
    if CKPT.exists():
        try:
            ck = json.loads(CKPT.read_text(encoding="utf-8"))
            ck.setdefault("done_dates", {})
            ck.setdefault("fail_dates", {})
            return ck
        except Exception:
            pass
    return {"done_dates": {}, "fail_dates": {}}


def save_ckpt(ck: dict) -> None:
    CKPT.write_text(json.dumps(ck, ensure_ascii=False), encoding="utf-8")


def new_session():
    cj = http.cookiejar.CookieJar()
    opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(cj))
    opener.addheaders = list(UA.items())
    html = opener.open(URL, timeout=40).read().decode("utf-8", "ignore")
    def hid(name, src):
        m = re.search(
            r'<input type="hidden" name="' + name + r'"[^>]*value="([^"]*)"', src)
        return m.group(1) if m else ""
    return opener, {
        "vs": hid("__VIEWSTATE", html),
        "vsg": hid("__VIEWSTATEGENERATOR", html),
        "today": hid("today", html),
    }


def fetch_date(opener, st, date_slash: str):
    """POST 一日 → [(code5, name, shares, pct)] + 實際 shown date."""
    form = {
        "__EVENTTARGET": "", "__EVENTARGUMENT": "",
        "__VIEWSTATE": st["vs"], "__VIEWSTATEGENERATOR": st["vsg"],
        "today": st["today"], "sortBy": "stockcode", "sortDirection": "asc",
        "originalShareholdingDate": "", "alertMsg": "",
        "txtShareholdingDate": date_slash, "btnSearch": "Search",
    }
    data = urllib.parse.urlencode(form).encode()
    out = opener.open(urllib.request.Request(URL, data=data), timeout=60).read().decode("utf-8", "ignore")
    rows = ROW_RE.findall(out)
    shown = DATE_SHOWN_RE.search(out)
    return rows, (shown.group(1) if shown else date_slash)


def append_csv(rows, shown_iso: str, fh) -> int:
    n = 0
    for code, name, shares, pct in rows:
        fh.write(f"{shown_iso},{code},{name.strip()},{shares.replace(',','')},{pct}\n")
        n += 1
    return n


def trading_days_backward(start: datetime, end: datetime):
    d = start
    while d <= end:
        if d.weekday() < 5:
            yield d
        d += timedelta(days=1)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--backfill", action="store_true", help="由 12 個月窗口最早日開始")
    ap.add_argument("--date", type=str, default="", help="單日 (YYYY/MM/DD 或 YYYYMMDD)")
    ap.add_argument("--delay", type=float, default=DELAY)
    args = ap.parse_args()

    ck = load_ckpt()
    today = datetime.now()

    # ── 單日模式 ──
    if args.date:
        d = args.date.replace("-", "/")
        if "/" not in d:
            d = f"{d[:4]}/{d[4:6]}/{d[6:8]}"
        opener, st = new_session()
        rows, shown = fetch_date(opener, st, d)
        print(f"{d} → shown {shown}, {len(rows)} stocks")
        if rows:
            with RAW.open("a", encoding="utf-8", newline="") as fh:
                if RAW.stat().st_size == 0:
                    fh.write("date,stock_code,name,shares,pct\n")
                append_csv(rows, shown.replace("/", "-"), fh)
            ck["done_dates"][shown.replace("/", "-")] = len(rows)
            save_ckpt(ck)
        return 0

    # ── 增量 / backfill 範圍 ──
    if args.backfill:
        start = today - timedelta(days=int(30.4 * WINDOW_MONTHS) - 1)
    else:
        if ck["done_dates"]:
            last = max(ck["done_dates"])
            start = datetime.strptime(last, "%Y-%m-%d") + timedelta(days=1)
        else:
            start = today  # 冇 checkpoint 又唔 backfill → 只拎今日

    n_new, n_days, fails = 0, 0, 0
    opener, st = new_session()
    with RAW.open("a", encoding="utf-8", newline="") as fh:
        if not RAW.exists() or RAW.stat().st_size == 0:
            fh.write("date,stock_code,name,shares,pct\n")

        for d in trading_days_backward(start, today):
            ds = d.strftime("%Y/%m/%d")
            iso = d.strftime("%Y-%m-%d")
            if iso in ck["done_dates"]:
                continue
            if ck["fail_dates"].get(iso, 0) >= 3:
                continue
            try:
                rows, shown = fetch_date(opener, st, ds)
            except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError, OSError) as e:
                # session 好可能過期 — 開新
                print(f"  {iso} network: {e} — renew session")
                try:
                    opener, st = new_session()
                    rows, shown = fetch_date(opener, st, ds)
                except Exception as e2:
                    ck["fail_dates"][iso] = ck["fail_dates"].get(iso, 0) + 1
                    save_ckpt(ck)
                    fails += 1
                    print(f"  {iso} FAIL {e2}")
                    continue
            shown_iso = shown.replace("/", "-")
            if shown_iso != iso:
                # 假日 fallback — 標記假日done, 唔寫raw (避免同實際日重複)
                ck["done_dates"][iso] = 0
                ck["done_dates"][shown_iso] = len(rows) if rows else ck["done_dates"].get(shown_iso, 0)
                if rows and shown_iso not in {r.split(',')[0] for r in []}:
                    # 唔寫 — shown date 嗰日運行時會自己 fetch
                    pass
                save_ckpt(ckpt_write(ck))
                n_days += 1
                print(f"  {iso} holiday → {shown_iso} (skip)")
                continue
            if not rows:
                ck["fail_dates"][iso] = ck["fail_dates"].get(iso, 0) + 1
                save_ckpt(ck)
                fails += 1
                print(f"  {iso} 0 rows (fail #{ck['fail_dates'][iso]})")
                continue
            n = append_csv(rows, shown_iso, fh)
            fh.flush()
            ck["done_dates"][iso] = n
            save_ckpt(ck)
            n_new += n
            n_days += 1
            print(f"  {iso} ✓ {n} stocks (total +{n_new})")
            time.sleep(args.delay)

    print(f"\nDONE: {n_days} days, +{n_new} rows, {fails} fails → {RAW.name}")
    return 0


def ckpt_write(ck):
    return ck


if __name__ == "__main__":
    sys.exit(main())
