#!/usr/bin/env python3
"""us10y_update.py - Update US 10Y Treasury Yield via yfinance (^TNX).

Run daily to keep us_10y_yield.csv current.
"""
import yfinance as yf
import pandas as pd
from pathlib import Path

OUT = Path(__file__).resolve().parent.parent / "data" / "factors" / "us_10y_yield.csv"


def main():
    t = yf.Ticker("^TNX")
    # 用 start/end 避免 cache 問題
    df = t.history(start="2000-01-01", end="2030-12-31", interval="1d")
    new = pd.DataFrame({"date": df.index.strftime("%Y-%m-%d"), "close": df["Close"].values})
    new = new.sort_values("date").reset_index(drop=True)

    if OUT.exists():
        old = pd.read_csv(OUT)
        # merge: 新數據覆蓋舊 (用 date 做 key, new 優先)
        merged = pd.merge(old[["date", "close"]], new, on="date", how="outer", suffixes=("_old", "_new"))
        merged["close"] = merged["close_new"].fillna(merged["close_old"])
        combined = merged[["date", "close"]].sort_values("date").reset_index(drop=True)
    else:
        combined = new

    combined.to_csv(OUT, index=False)
    print(f"US10Y: {len(combined)} rows, last={combined.iloc[-1]['date']} yield={combined.iloc[-1]['close']:.2f}%")


if __name__ == "__main__":
    main()
