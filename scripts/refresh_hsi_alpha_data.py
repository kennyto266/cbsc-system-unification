#!/usr/bin/env python3
"""Daily refresh of HSI alpha data sources.

Fetches:
  1. HSI realized volatility + signals (9191 API) → hsi_rv.csv
  2. HSI futures open interest (9888 API) → hsi_futures_oi.csv

Usage:
  python3 refresh_hsi_alpha_data.py          # incremental (append new days)
  python3 refresh_hsi_alpha_data.py --full   # full re-download

Designed for cron: run daily after HK market close (17:00 HKT).
"""
import json
import sys
import urllib.request
from pathlib import Path

import pandas as pd

API_9191 = "http://18.180.162.113:9191"
API_9888 = "http://18.180.162.113:9888"
FACTORS_DIR = Path(__file__).resolve().parent.parent / "data" / "factors"


def fetch(url: str) -> dict:
    with urllib.request.urlopen(url, timeout=30) as resp:
        return json.loads(resp.read())


# ── HSI Realized Volatility (9191) ──────────────────────────────────────────

def fetch_hsi_rv(duration: int = 2000) -> pd.DataFrame:
    """Fetch HSI realized vol + technical signals from 9191 API."""
    data = fetch(f"{API_9191}/inst/getInstrumentSignal?symbol=%5EHSI&duration={duration}")["data"]

    cols = ["close", "vol_1m", "vol_3m", "vol_6m", "vol_1y",
            "drift_1m", "drift_3m", "drift_6m", "drift_1y",
            "z_score", "adx", "sma_50", "sma_200"]
    rows = {}
    for col in cols:
        for date_str, val in data.get(col, {}).items():
            d = pd.to_datetime(date_str).tz_localize(None).normalize()
            if d not in rows:
                rows[d] = {}
            rows[d][col] = val

    df = pd.DataFrame.from_dict(rows, orient="index").sort_index()
    df.index.name = "date"
    return df


def update_hsi_rv(full: bool = False):
    """Incremental update of hsi_rv.csv."""
    rv_path = FACTORS_DIR / "hsi_rv.csv"
    new_df = fetch_hsi_rv()

    if rv_path.exists() and not full:
        old_df = pd.read_csv(rv_path, index_col="date", parse_dates=True)
        combined = pd.concat([old_df, new_df])
        combined = combined[~combined.index.duplicated(keep="last")].sort_index()
    else:
        combined = new_df.sort_index()

    combined.to_csv(rv_path)
    n_new = len(combined) - (len(old_df) if rv_path.exists() and not full else 0)
    print(f"✅ hsi_rv.csv: {len(combined)} rows ({rv_path.index[0] if False else combined.index[0].date()} → {combined.index[-1].date()}), +{max(n_new,0)} new")
    return combined


# ── HSI Futures OI (9888) ───────────────────────────────────────────────────

def fetch_hsi_futures_oi() -> pd.DataFrame:
    """Fetch HSI futures open interest from 9888 API."""
    resp = fetch(f"{API_9888}/equity/HK/getHSIFutureOI")
    records = resp.get("data", [])
    if not records:
        print("⚠️  No futures OI data returned!")
        return pd.DataFrame()

    df = pd.DataFrame(records)
    df["date"] = pd.to_datetime(df["date"]).dt.tz_localize(None).dt.normalize()
    df = df.set_index("date").sort_index()
    return df


def update_hsi_futures_oi(full: bool = False):
    """Incremental update of hsi_futures_oi.csv."""
    oi_path = FACTORS_DIR / "hsi_futures_oi.csv"
    new_df = fetch_hsi_futures_oi()
    if new_df.empty:
        return None

    if oi_path.exists() and not full:
        old_df = pd.read_csv(oi_path, index_col="date", parse_dates=True)
        combined = pd.concat([old_df, new_df])
        combined = combined[~combined.index.duplicated(keep="last")].sort_index()
    else:
        combined = new_df.sort_index()

    combined.to_csv(oi_path)
    n_new = len(combined) - (len(old_df) if oi_path.exists() and not full else 0)
    print(f"✅ hsi_futures_oi.csv: {len(combined)} rows ({combined.index[0].date()} → {combined.index[-1].date()}), +{max(n_new,0)} new")
    return combined


# ── Main ────────────────────────────────────────────────────────────────────

if __name__ == "__main__":
    full = "--full" in sys.argv
    print(f"Refreshing HSI alpha data ({'full' if full else 'incremental'})...")
    print()

    try:
        update_hsi_rv(full=full)
    except Exception as e:
        print(f"❌ HSI RV refresh failed: {e}")

    try:
        update_hsi_futures_oi(full=full)
    except Exception as e:
        print(f"❌ HSI futures OI refresh failed: {e}")

    print("\nDone.")
