#!/usr/bin/env python3
"""collect_us_stocks.py — 拉美股日線 (Futu) for HK-US lead-lag 探索.

拉 dual-listed ADR + US indices + US megacap tech.
輸出: data/us_ohlcv/{code}_day.csv
"""
import sys, socket, subprocess, time
from io import StringIO
from pathlib import Path
import pandas as pd

ROOT = Path(__file__).resolve().parent.parent
OUT_DIR = ROOT / "data" / "us_ohlcv"
OUT_DIR.mkdir(parents=True, exist_ok=True)

# US universe: ADR pairs (同港股 dual-listed) + indices + megacap
US_STOCKS = {
    # ADR (港股 dual-listed)
    "US.BABA": "阿里巴巴 ADR", "US.JD": "京東 ADR", "US.PDD": "拼多多 ADR",
    "US.BIDU": "百度 ADR", "US.NTES": "網易 ADR", "US.TME": "騰訊音樂",
    "US.BILI": "嗶哩嗶哩", "US.LI": "理想汽車", "US.XPEV": "小鵬汽車",
    "US.NIO": "蔚來汽車", "US.YY": "歡聚集團", "US.VIPS": "唯品會",
    # US indices (市場情緒/風險偏好)
    "US.SPY": "S&P500 ETF", "US.QQQ": "Nasdaq100 ETF", "US.DIA": "道瓊斯 ETF",
    "US.IWM": "Russell2000 ETF",
    # US megacap tech (科技板塊風向)
    "US.AAPL": "蘋果", "US.MSFT": "微軟", "US.NVDA": "英偉達",
    "US.GOOG": "谷歌", "US.META": "Meta", "US.AMZN": "亞馬遜",
    "US.TSLA": "特斯拉", "US.AMD": "AMD",
    # semicon (亞洲半導體鏈)
    "US.AVGO": "博通", "US.INTC": "Intel", "US.QCOM": "高通",
    # 金融/周期
    "US.JPM": "摩根大通", "US.GS": "高盛",
}


def opend_alive(port=11111):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM); s.settimeout(4)
    try: s.connect(("127.0.0.1", port)); s.close(); return True
    except: return False


def fetch_us(code, max_count=2000, timeout=60):
    script = (
        "import logging; logging.disable(logging.CRITICAL)\n"
        "import pandas as pd\n"
        "from futu import OpenQuoteContext\n"
        f"q = OpenQuoteContext(host='127.0.0.1', port=11111)\n"
        "try:\n"
        f"    ret, df, _ = q.request_history_kline({code!r}, ktype='K_DAY', autype='qfq', max_count={max_count})\n"
        "    if ret != 0 or df is None or len(df) == 0:\n"
        "        import sys; sys.exit(1)\n"
        "    out = pd.DataFrame({\n"
        "        'date': df['time_key'],\n"
        "        'open': df['open'].astype(float), 'high': df['high'].astype(float),\n"
        "        'low': df['low'].astype(float), 'close': df['close'].astype(float),\n"
        "        'volume': df['volume'].astype(float),\n"
        "    })\n"
        f"    out.to_csv({str(OUT_DIR / (code.replace('.','_')+'_day.csv'))!r}, index=False)\n"
        "finally:\n"
        "    q.close()\n"
    )
    try:
        proc = subprocess.run([sys.executable, "-c", script],
                              capture_output=True, text=True, timeout=timeout)
        return proc.returncode == 0
    except subprocess.TimeoutExpired:
        return False
    except Exception:
        return False


def main():
    print(f"=== Futu US stock collector ({len(US_STOCKS)} codes) ===")
    print(f"OpenD: {'alive' if opend_alive() else 'DEAD'}")
    if not opend_alive():
        print("OpenD port 11111 not open"); return 1
    ok = 0
    for code, name in US_STOCKS.items():
        if fetch_us(code):
            df = pd.read_csv(OUT_DIR / f"{code.replace('.','_')}_day.csv")
            print(f"  ✅ {code} ({name}): {len(df)} bars, {df['date'].min()} ~ {df['date'].max()}")
            ok += 1
        else:
            print(f"  ❌ {code} ({name}): failed")
        time.sleep(0.4)
    print(f"\nDone: {ok}/{len(US_STOCKS)}")


if __name__ == "__main__":
    main()
