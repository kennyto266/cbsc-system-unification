#!/usr/bin/env python3
"""probe_sdw_range.py — 探測 per-stock searchsdw.aspx 有冇 2023 數據 + 結構 dump."""
import requests, re
from bs4 import BeautifulSoup

URL = "https://www3.hkexnews.hk/sdw/search/searchsdw.aspx"
s = requests.Session()
s.headers["User-Agent"] = "Mozilla/5.0"
r = s.get(URL, timeout=15)
soup = BeautifulSoup(r.text, "html.parser")
vs = soup.find("input", {"name": "__VIEWSTATE"})["value"]
vg = soup.find("input", {"name": "__VIEWSTATEGENERATOR"})["value"]

for date in ["2023/06/15", "2023/01/05"]:
    data = {"__EVENTTARGET": "btnSearch", "__EVENTARGUMENT": "", "__VIEWSTATE": vs,
            "__VIEWSTATEGENERATOR": vg, "txtStockCode": "00700",
            "txtShareholdingDate": date, "today": "20260823",
            "sortBy": "shareholding", "sortDirection": "desc",
            "originalShareholdingDate": "", "alertMsg": ""}
    r2 = s.post(URL, data=data, timeout=20)
    t = r2.text
    n_rows = len(re.findall(r'Participant ID', t))
    # grab first data row
    i = t.find("Participant ID")
    seg = re.sub(r"\s+", " ", t[i:i+2500]) if i > 0 else "(no table)"
    print("===", date, "len", len(t), "marker:", n_rows)
    print(seg[:1200])
    print()
