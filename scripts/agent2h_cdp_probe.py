#!/usr/bin/env python3
"""agent2-H 2026-08-24: headless Chrome CDP 開東財港股 F10 頁, 抓 datacenter reportName.

用法: python agent2h_cdp_probe.py <url> [<url>...]
"""
import json, sys, time, urllib.parse, urllib.request

import websocket

CDP = "http://127.0.0.1:9333"


def new_tab(url):
    req = urllib.request.Request(f"{CDP}/json/new?" + urllib.parse.urlencode({"url": url}),
                                 method="PUT")
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.loads(r.read())


def close_tab(tid):
    try:
        urllib.request.urlopen(f"{CDP}/json/close/{tid}", timeout=10).read()
    except Exception:
        pass


def probe(url, wait=8):
    tab = new_tab(url)
    ws = websocket.create_connection(tab["webSocketDebuggerUrl"], timeout=15)
    ws.send(json.dumps({"id": 1, "method": "Network.enable"}))
    hits = set()
    t0 = time.time()
    mid = 1
    while time.time() - t0 < wait:
        try:
            ws.settimeout(max(1, wait - (time.time() - t0)))
            msg = json.loads(ws.recv())
        except Exception:
            break
        if msg.get("method") == "Network.requestWillBeSent":
            u = msg["params"]["request"]["url"]
            if "reportName=" in u:
                import re
                hits.update(re.findall(r"reportName=([A-Z0-9_]+)", u))
                hits.update(re.findall(r"RPT_[A-Z0-9_]+", u))
    ws.close()
    close_tab(tab["id"])
    return sorted(hits)


if __name__ == "__main__":
    urls = sys.argv[1:]
    for u in urls:
        try:
            print(f"\n### {u}\n   {probe(u)}")
        except Exception as e:
            print(f"\n### {u}\n   ERR {e}")
