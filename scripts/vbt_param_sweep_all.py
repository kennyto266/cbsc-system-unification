    report_path = OUTPUT_DIR / "PARAM_SWEEP_FULL_REPORT.md"
    lines = [
        f"# 全參數掃描報告",
        f"",
        f"**生成時間**: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
        f"**總任務**: {total:,} | **有效結果**: {len(df):,}",
        f"**耗時**: {elapsed:.0f}秒 ({elapsed/60:.1f}分鐘) | **進程**: {n_workers}",
        f"**引擎**: VectorBT {vbt.__version__} + Joblib {n_workers} 核心並行",
        f"**成本**: {TOTAL_COST*100:.2f}%/來回（含滑點 {SLIPPAGE*100:.1f}%）",
        f"**無風險利率**: {RF_RATE*100:.0f}% | **Walk-forward**: 70/30",
        f"",
        f"## 匯總",
        f"",
        f"| 指標 | 數值 |",
        f"|------|------|",
        f"| Sharpe 中位數 | {df['sharpe'].median():.3f} |",
        f"| Sharpe > 0 | {(df['sharpe']>0).sum()}/{len(df)} ({(df['sharpe']>0).sum()/len(df)*100:.1f}%) |",
        f"| Sharpe > 0.5 | {(df['sharpe']>0.5).sum()} |",
        f"| Sharpe > 1.0 | {(df['sharpe']>1.0).sum()} |",
        f"| Walk-forward 穩健 | {df['robust'].sum()}/{len(df)} |",
        f"| 平均 Max DD | {df['max_drawdown_pct'].mean():.1f}% |",
        f"| 平均 PF | {df['profit_factor'].mean():.2f} |",
        f"",
        f"## 各因子最佳參數",
        f"",
        f"| 因子 | 最佳 Sharpe | N | threshold | holding | direction | 股票 | 年回報% | MaxDD% | PF | 勝率% | WF |",
        f"|------|-----------|---|-----------|---------|-----------|------|--------|-------|-----|-------|-----|",
    ]

    for factor in FACTORS:
        grp = df[df["factor"] == factor]
        if grp.empty:
            continue
        best = grp.iloc[0]
        wf = "✅" if best["robust"] else "❌"
        lines.append(f"| {factor} | {best['sharpe']:.2f} | {int(best['n_days'])} | {best['threshold']:.3f} | {int(best['holding'])} | {best['direction']} | {best['stock']} | {best['annual_return_pct']:.1f}% | {best['max_drawdown_pct']:.1f}% | {best['profit_factor']:.2f} | {best['win_rate_pct']:.0f}% | {wf} |")

    lines.extend([
        f"",
        f"## Top 30 組合",
        f"",
        f"| # | 因子 | 股票 | N | threshold | holding | direction | Sharpe | Sortino | Calmar | 年回報% | MaxDD% | PF | 勝率% | Alpha | OOS Sharpe | WF |",
        f"|---|------|------|---|-----------|---------|-----------|--------|---------|--------|---------|-------|-----|-------|-------|-----------|-----|",
    ])

    for i, (_, r) in enumerate(df.head(30).iterrows(), 1):
        wf = "✅" if r["robust"] else "❌"
        lines.append(f"| {i} | {r['factor']} | {r['stock']} | {int(r['n_days'])} | {r['threshold']:.3f} | {int(r['holding'])} | {r['direction']} | {r['sharpe']:.2f} | {r['sortino']:.2f} | {r['calmar']:.2f} | {r['annual_return_pct']:.1f}% | {r['max_drawdown_pct']:.1f}% | {r['profit_factor']:.2f} | {r['win_rate_pct']:.0f}% | {r['alpha']:+.2f} | {r['oos_sharpe']:.2f} | {wf} |")

    lines.extend([
        f"",
        f"## 完整結果",
        f"見 `param_sweep_all_results.csv`（{len(df)} 行）",
    ])

    with open(report_path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))
    print(f"✓ Report: {report_path.relative_to(ROOT)}")


if __name__ == "__main__":
    main()
