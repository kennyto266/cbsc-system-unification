#!/usr/bin/env python3
"""btcd_update.py - Update BTC-USD price data via yfinance.

Run daily to keep btcd.csv current.
"""
import yfinance as yf
import pandas as pd
from pathlib import Path

OUT = Path(__file__).resolve().parent.parent / "data" / "factors" / "btcd.csv"


def main():
    t = yf.Ticker("BTC-USD")
    df = t.history(period="max", interval="1d")
    new = pd.DataFrame({"date": df.index.strftime("%Y-%m-%d"), "close": df["Close"].values})
    new = new.sort_values("date").drop_duplicates(subset="date", keep="last").reset_index(drop=True)

    if OUT.exists():
        old = pd.read_csv(OUT)
        cols = [c for c in old.columns if c in ("date", "close")]
        combined = pd.concat([old[cols], new]).drop_duplicates(subset="date", keep="last").sort_values("date").reset_index(drop=True)
    else:
        combined = new

    combined.to_csv(OUT, index=False)
    print(f"BTCD: {len(combined)} rows, last={combined.iloc[-1]['date']} BTC=${combined.iloc[-1]['close']:.0f}")


if __name__ == "__main__":
    main()
