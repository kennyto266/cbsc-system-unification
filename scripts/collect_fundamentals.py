"""
collect_fundamentals.py — 用 yfinance 拉真實財報數據

背景:
  ALPHA-40 (資產增長) 原本用「股價 60 日回報」做總資產增長 proxy.
  ALPHA-41 (PEAD) 原本用「單日 > 4% 升幅」做盈利超預期 proxy.
  兩者都係價格 proxy, 而唔係真實財報. 呢個 script 拉真實數據去取代.

yfinance HK 限制:
  - quarterly_balance_sheet 通常只返 1 個 quarter (HK stock 唔支援 quarterly history)
  - 但 annual balance_sheet / income_stmt / cashflow 返 ~4 年 (足夠算年增長率)

輸出: data/fundamentals/{STOCK}_financials.csv
  欄位: date, total_assets, total_debt, stockholders_equity,
        total_revenue, net_income, operating_cash_flow,
        asset_growth, revenue_growth, earnings_growth, roe
  asset_growth = ΔTotal Assets / lag(Total Assets)  ← ALPHA-40 用
  earnings_growth = ΔNet Income / |lag(Net Income)| ← ALPHA-41 用

用法:
  python collect_fundamentals.py            # 拉全部 (data/ohlcv_10yr 入面所有股)
  python collect_fundamentals.py 0700 09988 # 指定股
"""
import sys
import time
import argparse
from pathlib import Path

import pandas as pd
import yfinance as yf

DATA_DIR = Path(__file__).resolve().parent.parent / "data"
OHLCV_DIR = DATA_DIR / "ohlcv_10yr"
OUT_DIR = DATA_DIR / "fundamentals"
OUT_DIR.mkdir(parents=True, exist_ok=True)

# yfinance 用 {code}.HK 格式; 我地內部用 HK.{code} / HK_{code}
# 數據檔名: HK_00700.csv → yf ticker 0700.HK
BALANCE_ROWS = ["Total Assets", "Total Debt", "Stockholders Equity"]
INCOME_ROWS = ["Total Revenue", "Net Income"]
CASHFLOW_ROWS = ["Operating Cash Flow"]


def _yf_ticker_code(padded):
    """5位檔名 code (00700) → 4位 yfinance code (0700).

    yfinance HK ticker 要「正好4位數字」: 0700.HK, 09988.HK, 0005.HK.
    我地 ohlcv 檔名係 5 位 (HK_00700.csv), 所以取尾4位.
    """
    return padded[-4:] if len(padded) >= 4 else padded


def list_stocks():
    """讀 ohlcv_10yr/ 入面所有 HK_XXXX.csv → [('00700','0700'), ...].

    回 (padded檔名碼, yfinance碼). 存檔用 padded (HK_00700) 保持一致,
    拉數據用 yfinance碼 (0700.HK).
    """
    codes = []
    for p in sorted(OHLCV_DIR.glob("HK_*.csv")):
        padded = p.stem.replace("HK_", "")  # '00700'
        yf_code = _yf_ticker_code(padded)   # '0700'
        codes.append((padded, yf_code))
    return codes


def pull_one(code):
    """拉一隻股嘅年度財報, 返回 tidy DataFrame (index=date, sorted ascending).

    yfinance rate-limit 限制: 每個 IP 短時間內太多請求會被 ban.
    所以只拉 balance_sheet + income_stmt (2 個請求, 夠 ALPHA-40/41 用),
    跳過 cashflow (省一個請求). 兩個 statement 之間 sleep 1s.
    """
    tkr = yf.Ticker(f"{code}.HK")
    rows = {}
    try:
        bs = tkr.balance_sheet  # 年度, columns = period end dates
    except Exception:
        bs = None
    time.sleep(1)  # 兩個 statement 之間留 1s, 避免觸發 rate-limit
    try:
        ins = tkr.income_stmt
    except Exception:
        ins = None

    # 合併所有 period dates (column headers)
    dates = set()
    for stmt in (bs, ins):
        if stmt is not None and not stmt.empty:
            dates.update(stmt.columns)
    if not dates:
        return None
    dates = sorted(dates)

    recs = []
    for d in dates:
        rec = {"date": pd.Timestamp(d)}
        # balance sheet
        if bs is not None and d in bs.columns:
            col = bs[d]
            for r in BALANCE_ROWS:
                if r in col.index:
                    rec[r.lower().replace(" ", "_")] = col[r]
        # income
        if ins is not None and d in ins.columns:
            col = ins[d]
            for r in INCOME_ROWS:
                if r in col.index:
                    rec[r.lower().replace(" ", "_")] = col[r]
        recs.append(rec)

    df = pd.DataFrame(recs).set_index("date").sort_index()

    # 計算年增長率 (跟前一個年度比)
    if "total_assets" in df.columns:
        ta = df["total_assets"]
        df["asset_growth"] = (ta - ta.shift(1)) / ta.shift(1).abs()
    if "total_revenue" in df.columns:
        rv = df["total_revenue"]
        df["revenue_growth"] = (rv - rv.shift(1)) / rv.shift(1).abs()
    if "net_income" in df.columns:
        ni = df["net_income"]
        df["earnings_growth"] = (ni - ni.shift(1)) / ni.shift(1).abs()
    if "net_income" in df.columns and "stockholders_equity" in df.columns:
        df["roe"] = df["net_income"] / df["stockholders_equity"].abs()

    return df


def pull_with_retry(code, max_tries=2):
    """帶 backoff 嘅拉取. yfinance 會 rate-limit, 空結果時等耐啲再試.

    只試 2 次: 真正缺數據嘅股 (941/388/762) 唔應該重試浪費時間;
    rate-limit 多數喺 stocks 之間嘅 sleep 已經緩衝.
    """
    delays = [0, 8]  # 第 1 次即時, 第 2 次等 8s
    for attempt in range(max_tries):
        if delays[attempt]:
            time.sleep(delays[attempt])
        df = pull_one(code)
        if df is not None and not df.empty:
            return df
    return None


def _log(msg):
    """即時 flush 輸出 (避免背景模式 buffering 睇唔到進度)."""
    print(msg, flush=True)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("codes", nargs="*", help="股票 code (無指定 = 全部)")
    ap.add_argument("--force", action="store_true", help="強制重拉 (唔跳過已存在)")
    args = ap.parse_args()

    if args.codes:
        # 手動指定: code 可能係 '0700' 或 '00700', 統一轉 yfinance 4位 + padded 存檔
        targets = []
        for c in args.codes:
            yf_code = _yf_ticker_code(c.zfill(5)) if len(c) > 4 else c.zfill(4)
            yf_code = yf_code[-4:]
            padded = c.zfill(5) if len(c) <= 5 else c
            targets.append((padded, yf_code))
    else:
        targets = list_stocks()  # [(padded, yf_code), ...]

    _log(f"[*] 拉取 {len(targets)} 隻股票既年度財報...")
    ok, fail, skip = 0, 0, 0
    for padded, yf_code in targets:
        out = OUT_DIR / f"HK_{padded}_financials.csv"
        if out.exists() and not args.force:
            _log(f"  [=] HK_{padded}: 已存在, 跳過 (用 --force 重拉)")
            skip += 1
            continue
        try:
            df = pull_with_retry(yf_code)
            if df is None or df.empty:
                _log(f"  [!] HK_{padded} ({yf_code}.HK): 無數據")
                fail += 1
                continue
            df.to_csv(out)
            n_years = df["total_assets"].dropna().shape[0] if "total_assets" in df else 0
            _log(f"  [+] HK_{padded} ({yf_code}.HK): {len(df)} 期, TA {n_years} 年 → {out.name}")
            ok += 1
        except Exception as e:
            _log(f"  [x] HK_{padded} ({yf_code}.HK): {e}")
            fail += 1
        time.sleep(4)  # 禮貌限速 (yfinance 會 ban 連續快速請求; 4s 經測試可靠)
    _log(f"\n[完成] 成功 {ok}, 失敗 {fail}, 跳過 {skip}. 輸出目錄: {OUT_DIR}")


if __name__ == "__main__":
    main()
