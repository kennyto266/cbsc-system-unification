#!/usr/bin/env python3
"""launch_chrome_cdp.py — 起/確保 headless Chrome CDP 9333 (爬蟲專用, 2026-08-25).

用戶指示: 爬蟲優先用 Chrome (獨立 profile, 唔掂用戶 browser), 唔得先 fallback Comet 9223.
- 冪等: 9333 已通就唔重開
- 孤立 process 檢測: 9333 唔通 + 有殘留 chrome(9333) → 樹殺重開
- 純 stdlib (urllib), scheduler 友善
"""
import json
import subprocess
import sys
import time
import urllib.request

CDP = "http://127.0.0.1:9333"
CHROME = r"C:\Program Files\Google\Chrome\Application\chrome.exe"
PROFILE = r"C:\Users\Penguin8n\AppData\Local\Temp\agent2h-chrome-profile"


def alive(timeout=4):
    try:
        urllib.request.urlopen(f"{CDP}/json/version", timeout=timeout).read()
        return True
    except Exception:
        return False


def kill_stale():
    # [G51743 10-02] wmic 喺 Win11 26200 已退役 (command not found 實測) —
    # 舊 wmic 路徑被 except 靜默食咗 = 孤立 chrome 樹永遠清唔走 (RAM 洩漏族)。
    # 改 CIM; 唔通照舊 return 0 ( caller 當冇嘢)。
    try:
        r = subprocess.run(
            ["powershell", "-NoProfile", "-Command",
             "Get-CimInstance Win32_Process -Filter \"name='chrome.exe'\" | "
             "Where-Object { $_.CommandLine -match 'remote-debugging-port=9333' } | "
             "Select-Object -ExpandProperty ProcessId | ConvertTo-Json -Compress"],
            capture_output=True, text=True, timeout=30)
        s = (r.stdout or "").strip()
        if not s:
            return 0
        pids = [int(x) for x in (json.loads(s) if s.startswith("[") else [s]) ]
        for pid in pids:
            subprocess.run(["taskkill", "/PID", pid, "/T", "/F"], capture_output=True, timeout=15)
        return len(pids)
    except Exception:
        return 0


def launch():
    subprocess.Popen(
        [CHROME, "--headless=new", f"--remote-debugging-port=9333",
         "--remote-allow-origins=*", f"--user-data-dir={PROFILE}",
         "--no-first-run", "--disable-gpu", "--window-size=1440,900",
         "about:blank"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        creationflags=subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP,
    )
    for _ in range(15):
        time.sleep(1)
        if alive():
            return True
    return False


def main():
    if alive():
        print("CDP 9333 已生 — 冇嘢做")
        return 0
    n = kill_stale()
    if n:
        print(f"清咗 {n} 個殘留 process")
        time.sleep(2)
    if launch():
        print("headless Chrome CDP 9333 已起 ✓")
        return 0
    print("FAIL: Chrome 起唔到 — fallback Comet 9223")
    return 1


if __name__ == "__main__":
    sys.exit(main())
