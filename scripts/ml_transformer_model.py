FACTORS = ["dxy", "usdcnh", "vix", "gold", "copper", "sp500", "us_10y_yield", "hibor"]
STOCKS = ["HK.00700", "HK.09988", "HK.03690", "HK.01810", "HK.01211",
          "HK.00005", "HK.00939", "HK.00388", "HK.00941", "HK.01299",
          "HK.02313", "HK.02018", "HK.06862", "HK.02688", "HK.01093"]
LOOKBACK = 20
FORWARD = 5
TRAIN_END = "2022-12-31"
TEST_START = "2023-01-01"
D_MODEL = 64
N_HEAD = 4
N_LAYERS = 3
DROPOUT = 0.1
BATCH_SIZE = 256
EPOCHS = 100
LR = 1e-4
WEIGHT_DECAY = 1e-4
EARLY_STOP_PATIENCE = 10


def build_features(stock):
    """構建特徵矩陣: 8 factor Z-scores + 6 技術指標 = 14 dims."""
    fname = stock.replace(".", "_")
    p = DATA_10YR / f"{fname}.csv"
    if p.exists():
        df = pd.read_csv(p, parse_dates=["time_key"]).set_index("time_key").sort_index()
        close = df["close"].astype(float)
    else:
        close = load_stock_close(stock)
    if close is None or len(close) < 500:
        return None, None

    features = pd.DataFrame(index=close.index)
    for f_name in FACTORS:
        factor = load_factor_close(f_name)
        if factor is None:
            continue
        factor = factor.reindex(close.index).ffill()
        z = (factor - factor.rolling(120).mean()) / factor.rolling(120).std().replace(0, np.nan)
        features[f"{f_name}_z"] = z

    features["ret_1d"] = close.pct_change(1)
    features["ret_5d"] = close.pct_change(5)
    features["ret_20d"] = close.pct_change(20)
    features["vol_20d"] = close.pct_change().rolling(20).std()
    features["sma_ratio"] = close / close.rolling(50).mean() - 1
    features["high_low_ratio"] = (close.rolling(20).max() - close.rolling(20).min()) / close

    fwd = close.pct_change(FORWARD).shift(-FORWARD)
    label = (fwd > fwd.rolling(252).median()).astype(float)

    valid = features.dropna().index.intersection(label.dropna().index)
    return features.loc[valid], label.loc[valid]


def create_sequences(features, label, lookback=LOOKBACK):
    X, y = [], []
    for i in range(lookback, len(features)):
        X.append(features.iloc[i - lookback:i].values)
        y.append(label.iloc[i])
    return np.array(X, dtype=np.float32), np.array(y, dtype=np.float32)


class PositionalEncoding(nn.Module):
    """Sinusoidal positional encoding for Transformer."""
    def __init__(self, d_model, max_len=500):
        super().__init__()
        pe = torch.zeros(max_len, d_model)
        position = torch.arange(0, max_len, dtype=torch.float).unsqueeze(1)
        div_term = torch.exp(torch.arange(0, d_model, 2).float() * (-math.log(10000.0) / d_model))
        pe[:, 0::2] = torch.sin(position * div_term)
        pe[:, 1::2] = torch.cos(position * div_term)
        self.register_buffer('pe', pe.unsqueeze(0))

    def forward(self, x):
        return x + self.pe[:, :x.size(1)]


class TransformerModel(nn.Module):
    """Transformer Encoder + multi-head self-attention for stock prediction.

    Input: (B, LOOKBACK, 14) → Linear(14→64) + PosEnc → TransformerEncoder → last token → MLP → P(up)
    """
    def __init__(self, input_dim=14, d_model=D_MODEL, nhead=N_HEAD, num_layers=N_LAYERS, dropout=DROPOUT):
        super().__init__()
        self.input_proj = nn.Linear(input_dim, d_model)
        self.pos_enc = PositionalEncoding(d_model, max_len=LOOKBACK + 10)
        encoder_layer = nn.TransformerEncoderLayer(
            d_model=d_model, nhead=nhead, dim_feedforward=d_model * 4,
            dropout=dropout, batch_first=True, activation="gelu",
        )
        self.encoder = nn.TransformerEncoder(encoder_layer, num_layers=num_layers)
        self.head = nn.Sequential(
            nn.Linear(d_model, 32),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(32, 1),
            nn.Sigmoid(),
        )

    def forward(self, x):
        x = self.input_proj(x)
        x = self.pos_enc(x)
        x = self.encoder(x)
        return self.head(x[:, -1, :]).squeeze(-1)


def train_model(X_train, y_train, X_val, y_val):
    """訓練 Transformer with early stopping + cosine LR."""
    model = TransformerModel(X_train.shape[2]).to(DEVICE)
    optimizer = torch.optim.AdamW(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS)
    criterion = nn.BCELoss()

    train_ds = TensorDataset(torch.FloatTensor(X_train), torch.FloatTensor(y_train))
    val_ds = TensorDataset(torch.FloatTensor(X_val), torch.FloatTensor(y_val))
    train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True)
    val_loader = DataLoader(val_ds, batch_size=BATCH_SIZE, shuffle=False)

    best_val_loss = float("inf")
    best_state = None
    patience_counter = 0

    for epoch in range(EPOCHS):
        model.train()
        train_loss = 0
        for xb, yb in train_loader:
            xb, yb = xb.to(DEVICE), yb.to(DEVICE)
            optimizer.zero_grad()
            pred = model(xb)
            loss = criterion(pred, yb)
            loss.backward()
            optimizer.step()
            train_loss += loss.item()
        scheduler.step()

        # Validation
        model.eval()
        val_loss = 0
        with torch.no_grad():
            for xb, yb in val_loader:
                xb, yb = xb.to(DEVICE), yb.to(DEVICE)
                val_loss += criterion(model(xb), yb).item()
        val_loss /= len(val_loader)

        if (epoch + 1) % 10 == 0:
            print(f"  Epoch {epoch+1}/{EPOCHS}: train={train_loss/len(train_loader):.4f} val={val_loss:.4f} lr={scheduler.get_last_lr()[0]:.6f}", flush=True)

        # Early stopping
        if val_loss < best_val_loss:
            best_val_loss = val_loss
            best_state = {k: v.clone() for k, v in model.state_dict().items()}
            patience_counter = 0
        else:
            patience_counter += 1
            if patience_counter >= EARLY_STOP_PATIENCE:
                print(f"  ⏹️ Early stop at epoch {epoch+1} (best val={best_val_loss:.4f})", flush=True)
                break

    if best_state:
        model.load_state_dict(best_state)
    return model


def backtest_predictions(close, predictions, dates):
    entries = pd.Series(predictions > 0.5, index=dates).shift(1).fillna(False)
    exits = pd.Series(predictions < 0.3, index=dates).shift(1).fillna(False)
    if not entries.any():
        return None
    pf = vbt.Portfolio.from_signals(
        close=close, entries=entries, exits=exits,
        fees=TOTAL_COST / 2, slippage=SLIPPAGE,
        freq="1D", init_cash=INIT_CASH_FACTOR)
    return pf


def main():
    print("=" * 70)
    print(f"🧠 Transformer 模型 (d_model={D_MODEL}, nhead={N_HEAD}, layers={N_LAYERS})")
    print(f"   Device: {DEVICE}")
    print(f"   特徵: 8 factors Z-score + 6 technicals = 14 dims")
    print(f"   Lookback: {LOOKBACK}日 | Forward: {FORWARD}日")
    print(f"   Train: ~{TRAIN_END} | Test: {TEST_START}~")
    print(f"   Early stop: patience={EARLY_STOP_PATIENCE}")
    print("=" * 70)

    # 1. 構建特徵
    print("\n1️⃣ 構建特徵矩陣...", flush=True)
    all_X_train, all_y_train = [], []
    all_X_test, all_y_test = [], []
    test_data = {}

    for stock in STOCKS:
        features, label = build_features(stock)
        if features is None:
            continue
        X, y = create_sequences(features, label)
        dates = features.index[LOOKBACK:]
        close = load_stock_close(stock)
        if close is None:
            continue

        dates_arr = dates.values if hasattr(dates, 'values') else np.array(dates)
        train_mask = dates_arr < np.datetime64(TRAIN_END)
        test_mask = dates_arr >= np.datetime64(TEST_START)

        if train_mask.sum() > 100:
            all_X_train.append(X[train_mask])
            all_y_train.append(y[train_mask])
        if test_mask.sum() > 50:
            all_X_test.append(X[test_mask])
            all_y_test.append(y[test_mask])
            test_data[stock] = (close, dates[test_mask])

        print(f"  {stock}: train={train_mask.sum()} test={test_mask.sum()}", flush=True)

    X_train = np.concatenate(all_X_train)
    y_train = np.concatenate(all_y_train)
    X_test = np.concatenate(all_X_test)
    y_test = np.concatenate(all_y_test)

    # 從 train 抽 15% 做 validation (temporal: 最後 15%)
    val_size = int(len(X_train) * 0.15)
    X_val, y_val = X_train[-val_size:], y_train[-val_size:]
    X_train_real, y_train_real = X_train[:-val_size], y_train[:-val_size]

    print(f"\n  訓練: {len(X_train_real)} | 驗證: {len(X_val)} | 測試: {len(X_test)}")
    print(f"  正樣本比例: train={y_train_real.mean():.2f} val={y_val.mean():.2f} test={y_test.mean():.2f}")

    # 2. 訓練
    print(f"\n2️⃣ 訓練 Transformer ({EPOCHS} epochs, early stop={EARLY_STOP_PATIENCE})...", flush=True)
    model = train_model(X_train_real, y_train_real, X_val, y_val)

    # 3. Save model (關鍵! 之前從來冇 save)
    torch.save(model.state_dict(), MODEL_PATH)
    print(f"\n💾 Model saved: {MODEL_PATH}", flush=True)

    # 4. OOS 預測 + 回測
    print(f"\n3️⃣ OOS 預測 + 回測 (2023-2026)...", flush=True)
    model.eval()
    results = []
    with torch.no_grad():
        for stock, (close, dates) in test_data.items():
            features, label = build_features(stock)
            if features is None:
                continue
            X, y = create_sequences(features, label)
            idx = features.index[LOOKBACK:]
            idx_arr = idx.values if hasattr(idx, 'values') else np.array(idx)
            test_mask = idx_arr >= np.datetime64(TEST_START)
            X_test_stock = X[test_mask]
            dates_stock = idx[test_mask]

            if len(X_test_stock) == 0:
                continue

            preds = model(torch.FloatTensor(X_test_stock).to(DEVICE)).cpu().numpy()
            close_test = close.reindex(dates_stock).dropna()
            valid_idx = close_test.index
            preds_aligned = preds[:len(valid_idx)]
            pf = backtest_predictions(close_test, preds_aligned, valid_idx)
            if pf is None:
                continue
            sharpe = float(pf.sharpe_ratio())
            ret = float(pf.total_return())
            n_trades = pf.trades.count()
            print(f"  {stock}: Sharpe={sharpe:.3f} ret={ret*100:.1f}% trades={n_trades}", flush=True)
            results.append({"stock": stock, "sharpe": sharpe, "return": ret, "trades": n_trades})

    # 5. 結果
    print(f"\n{'='*70}")
    print(f"📊 Transformer OOS 結果 (2023-2026)")
    print(f"{'='*70}")
    df = pd.DataFrame(results)
    if len(df) > 0:
        n_pos = (df["sharpe"] > 0).sum()
        n_sr1 = (df["sharpe"] > 1.0).sum()
        print(f"  正 Sharpe: {n_pos}/{len(df)}")
        print(f"  Sharpe > 1.0: {n_sr1}/{len(df)}")
        print(f"  平均 Sharpe: {df['sharpe'].mean():.3f}")
        print(f"  最佳 Sharpe: {df['sharpe'].max():.3f}")
        print(f"  平均回報: {df['return'].mean()*100:.1f}%")
        print()
        print(df.sort_values("sharpe", ascending=False).to_string(index=False))
        csv_path = OUT / "ml_factor_oos.csv"
        df.to_csv(csv_path, index=False)
        print(f"\n報告: {csv_path}")

        if n_pos / len(df) > 0.6:
            print(f"\n✅ Transformer 在 {n_pos}/{len(df)} 股票 OOS 有效")
        else:
            print(f"\n⚠️ Transformer OOS 表現一般")
    else:
        print("⚠️ 無有效結果")


if __name__ == "__main__":
    main()
