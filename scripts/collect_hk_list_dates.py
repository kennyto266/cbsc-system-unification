# -*- coding: utf-8 -*-
"""
agent2-H 2026-08-24: 東財 push2delay clist 拉全港股上市日期 (f26, YYYYMMDD)
→ new_sources/hk_list_dates_em.csv (code,name,list_date)
"""
import json, time, csv, io, sys
import urllib.request

sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
OUT = r"C:\Users\Penguin8n\ZCodeProject\cbsc-system-unification\data\new_sources\hk_list_dates_em.csv"
HDRS = {"User-Agent": "Mozilla/5.0", "Referer": "https://quote.eastmoney.com/"}

rows = []
pn = 1
while True:
    url = ("https://push2delay.eastmoney.com/api/qt/clist/get?"
           f"pn={pn}&pz=100&po=1&np=1&fltt=2&invt=2&fid=f26"
           "&fs=m:116+t:3,m:116+t:4&fields=f12,f13,f14,f26"
           "&ut=fa5fd1943c7b386f172d6893dbfba10b")
    req = urllib.request.Request(url, headers=HDRS)
    d = json.load(urllib.request.urlopen(req, timeout=30))
    data = d.get("data") or {}
    diff = data.get("diff") or []
    if not diff:
        break
    for x in diff:
        rows.append((x.get("f12"), x.get("f14"), x.get("f26")))
    total = data.get("total", 0)
    if pn % 5 == 0:
        print(f"page {pn}/{(total+99)//100} rows={len(rows)}", flush=True)
    if len(rows) >= total:
        break
    pn += 1
    time.sleep(0.25)

with open(OUT, "w", newline="", encoding="utf-8") as f:
    w = csv.writer(f)
    w.writerow(["code", "name", "list_date"])
    w.writerows(rows)
recent = sorted([r for r in rows if r[2] and r[2] >= 20200101], key=lambda r: -r[2])
print(f"DONE total={len(rows)} since2020={len(recent)}")
print("newest5:", recent[:5])
print("oldest3:", sorted([r for r in rows if r[2]], key=lambda r: r[2])[:3])
