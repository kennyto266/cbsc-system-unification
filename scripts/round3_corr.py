def load_factor(csv_name):
    p = FAC / csv_name
    if not p.exists():
        return None
    df = pd.read_csv(p)
    date_col = [c for c in df.columns if 'date' in c.lower() or c.lower() in ['time', 'ds']][0]
    df = df.set_index(pd.to_datetime(df[date_col])).sort_index()
    for c in df.columns:
        if c != date_col and df[c].dtype in [np.float64, np.int64, float, int]:
            return df[c].astype(float)
    return df.iloc[:, 0].astype(float)


factors = {f.replace('.csv', ''): load_factor(f + '.csv') for f in
           ['gold', 'vix', 'fred_t10yie']}
factors = {k: v for k, v in factors.items() if v is not None}


def compute_portfolio(entry_func, hold=5):
    all_rets = {}
    for stock, df in ohlcv_cache.items():
        if len(df) < 400:
            continue
        close = df['close'].astype(float)
        try:
            entries = entry_func(close, df)
            if entries is None:
                continue
            ret1 = close.pct_change()
            pos = pd.Series(0, index=close.index)
            in_pos = False
            dl = 0
            for i in range(len(close)):
                if entries.iloc[i] and not in_pos:
                    in_pos = True
                    dl = hold
                pos.iloc[i] = 1 if in_pos else 0
                if in_pos:
                    dl -= 1
                    if dl <= 0:
                        in_pos = False
            all_rets[stock] = (pos.shift(1) * ret1).dropna()
        except Exception:
            pass
    if not all_rets:
        return None
    return pd.DataFrame(all_rets).mean(axis=1, skipna=True)


# A159
def a159(close, df, hold=3):
    vol = df['volume'].astype(float)
    ema_f = close.ewm(span=12, adjust=False).mean()
    ema_s = close.ewm(span=26, adjust=False).mean()
    macd = ema_f - ema_s
    sig = macd.ewm(span=9, adjust=False).mean()
    hist = macd - sig
    e1 = ((hist > 0) & (hist > hist.shift(1))).shift(1).fillna(False)
    vs = (vol - vol.rolling(20).mean()) / vol.rolling(20).std().replace(0, np.nan)
    e2 = ((vs > 1.5) & (close.pct_change(5) > 0)).shift(1).fillna(False)
    return (e1 & e2).fillna(False)

# A160
def a160(close, df):
    sma = close.rolling(100).mean()
    dev = (close - sma) / sma
    z = (dev - dev.rolling(120).mean()) / dev.rolling(120).std().replace(0, np.nan)
    return (z < -1.5).shift(1).fillna(False)

# A161
def a161(close, df):
    high, low = df['high'].astype(float), df['low'].astype(float)
    tr = pd.concat([(high - low), (high - close.shift()).abs(), (low - close.shift()).abs()], axis=1).max(axis=1)
    atr = tr.rolling(14).mean()
    atr_pct = atr / close
    low_atr = atr_pct.rolling(60).rank(pct=True) < 0.15
    sma = close.rolling(50).mean()
    return (low_atr & (close > sma)).shift(1).fillna(False)

# Candidates
def t10yie_regime(close, df, hold=5):
    fac = factors['fred_t10yie']
    fac_a = fac.reindex(close.index).ffill()
    regime = fac_a > fac_a.rolling(60).mean()
    mom = close.pct_change(5) > 0
    return (regime & mom).shift(1).fillna(False)

def gold_regime(close, df, hold=5):
    fac = factors['gold']
    fac_a = fac.reindex(close.index).ffill()
    regime = fac_a > fac_a.rolling(60).mean()
    mom = close.pct_change(5) > 0
    return (regime & mom).shift(1).fillna(False)

def vix_spike(close, df, hold=5):
    fac = factors['vix']
    fac_a = fac.reindex(close.index).ffill()
    z = (fac_a - fac_a.rolling(60).mean()) / fac_a.rolling(60).std().replace(0, np.nan)
    return (z > 1.5).shift(1).fillna(False)


