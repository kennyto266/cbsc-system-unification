# Test 4-way combos
print('\n=== 4-way Combinations ===')
combos = [
    ('4-equal (1/4 each)', {'A159': 0.25, 'A160': 0.25, 'A161': 0.25, 't10yie': 0.25}),
    ('A159(30)+A160(20)+A161(30)+t10yie(20)', {'A159': 0.3, 'A160': 0.2, 'A161': 0.3, 't10yie': 0.2}),
    ('4-equal with gold', {'A159': 0.25, 'A160': 0.25, 'A161': 0.25, 'gold': 0.25}),
    ('4-equal with vix', {'A159': 0.25, 'A160': 0.25, 'A161': 0.25, 'vix_spike': 0.25}),
]
for name, weights in combos:
    if not all(w in oos.columns for w in weights):
        continue
    combo = sum(oos[c] * w for c, w in weights.items())
    sr = combo.mean() / combo.std() * np.sqrt(252) if combo.std() > 0 else 0
    ret = (1 + combo).cumprod().iloc[-1] - 1
    dd = ((1 + combo).cumprod() / (1 + combo).cumprod().cummax() - 1).min()
    tag = '🏆' if sr > 1.7 else '🟢' if sr > 1.0 else '✨'
    print(f'  {tag} {name}: SR={sr:+.2f} ret={ret:+.1%} DD={dd:.1%}')
