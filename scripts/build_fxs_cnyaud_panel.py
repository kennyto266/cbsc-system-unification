from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

import numpy as np
import pandas as pd

HERE = Path(__file__).resolve().parent
BASE = HERE.parent
BT = BASE.parent / "backtests"

# 後備硬拷貝 — vbt_data.HK_UNIVERSE (52 股) 2026-09-30 快照; 寧願明寫都
# 唔靜靜跌落 sorted(glob) (欄序會變, 黃金樣板欄序 = HK_UNIVERSE 順序)。
_HK_UNIVERSE_FALLBACK = [
    "HK.00005", "HK.00388", "HK.00001", "HK.00002", "HK.00003", "HK.00006",
    "HK.00011", "HK.00012", "HK.00016", "HK.00017", "HK.00027", "HK.00066",
    "HK.00101", "HK.00175", "HK.00241", "HK.00268", "HK.00285", "HK.00291",
    "HK.00386", "HK.00688", "HK.00700", "HK.00762", "HK.00823", "HK.00883",
    "HK.00939", "HK.00941", "HK.01038", "HK.01088", "HK.01109", "HK.01299",
    "HK.01398", "HK.01876", "HK.01928", "HK.02013", "HK.02318", "HK.02388",
    "HK.02628", "HK.03690", "HK.06862", "HK.09618", "HK.09988", "HK.09999",
    "HK.01810", "HK.09992", "HK.01211", "HK.01024", "HK.02899", "HK.09888",
    "HK.00992", "HK.01801", "HK.00020", "HK.02269",
]

BETA_WINDOW = 252
BETA_MIN_PERIODS = 126
MOM_WINDOW = 63
Z_BASELINE = 252


def _load_universe() -> list[str]:
    try:
        sys.path.insert(0, str(BT))
        from vbt_data import HK_UNIVERSE  # noqa: PLC0415
        return list(HK_UNIVERSE)
    except Exception as e:  # noqa: BLE001
        print(f"[fxs-build] vbt_data.HK_UNIVERSE 攞唔到 ({e}) — 用後備硬拷貝", flush=True)
        return list(_HK_UNIVERSE_FALLBACK)


def _load_closes(ohlcv_dir: Path, universe: list[str]) -> pd.DataFrame:
    closes: dict[str, pd.Series] = {}
    skipped = []
    for code in universe:
        fp = ohlcv_dir / f"{code.replace('.', '_')}.csv"
        if not fp.exists():
            skipped.append(code)
            continue
        df = pd.read_csv(fp, parse_dates=["time_key"]).set_index("time_key").sort_index()
        closes[code] = df["close"].astype(float)
    if skipped:
        print(f"[fxs-build] ohlcv 無檔跳過 (照舊出欄以外): {', '.join(skipped)}", flush=True)
    prices = pd.DataFrame(closes).sort_index()
    prices = prices[~prices.index.duplicated(keep="last")]
    prices.index.name = "time_key"
    return prices


def _load_fx(csv_path: Path) -> pd.Series:
    df = pd.read_csv(csv_path, parse_dates=["date"]).set_index("date").sort_index()
    s = df["cnyaud_close"].astype(float)
    s = s[~s.index.duplicated(keep="last")]
    s.name = "cnyaud_close"
    return s


def build_panel(prices: pd.DataFrame, fx: pd.Series) -> pd.DataFrame:
    """fxs_cnyaud = beta_i(252d, mp126) × fx_mom_z(63d vs 252d) — 見 docstring 配方."""
    rets = prices.pct_change(fill_method=None)
    fx_chg = fx.pct_change(fill_method=None).reindex(prices.index)
    cov = rets.rolling(BETA_WINDOW, min_periods=BETA_MIN_PERIODS).cov(fx_chg)
    var = fx_chg.rolling(BETA_WINDOW, min_periods=BETA_MIN_PERIODS).var()
    beta = cov.div(var, axis=0)
    mom = fx.pct_change(MOM_WINDOW, fill_method=None)
    z = (mom - mom.rolling(Z_BASELINE).mean()) / mom.rolling(Z_BASELINE).std()
    panel = beta.mul(z.reindex(prices.index), axis=0)
    panel.index.name = "time_key"
    return panel


def _atomic_parquet(df: pd.DataFrame, path: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    df.to_parquet(tmp)
    os.replace(tmp, path)


def main() -> int:
    ap = argparse.ArgumentParser(description="build fxs_cnyaud panel (fxba 匯率敏感度截面)")
    ap.add_argument("--data-root", type=Path, default=BASE / "data",
                    help="data 根 (預設 HERE/data)")
    ap.add_argument("--out", type=Path, default=None,
                    help="輸出 parquet (預設 <data-root>/factor_store/fxs_cnyaud.parquet)")
    args = ap.parse_args()

    ohlcv_dir = args.data_root / "ohlcv_5y"
    fx_csv = args.data_root / "new_sources" / "cnyaud" / "cnyaud_daily.csv"
    out = args.out or (args.data_root / "factor_store" / "fxs_cnyaud.parquet")

    if not fx_csv.exists():
        print(f"[fxs-build] fx raw 唔在場: {fx_csv} — 唔靜靜寫壞 parquet", flush=True)
        return 1

    universe = _load_universe()
    prices = _load_closes(ohlcv_dir, universe)
    fx = _load_fx(fx_csv)
    panel = build_panel(prices, fx)

    _atomic_parquet(panel, out)
    n_valid = int(panel.notna().sum().sum())
    print(f"[fxs-build] fxs_cnyaud: {panel.shape[0]}d × {panel.shape[1]}stk "
          f"({panel.index[0].date()} → {panel.index[-1].date()}), "
          f"valid cells {n_valid}/{panel.size} → {out}", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
