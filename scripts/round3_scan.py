# D22: Factor trend regime
print('\n--- D22: Factor Trend Regime (factor > SMA60 + stock mom > 0) ---')
for fname in ['gold', 'fred_dgs10', 'vix', 'fred_walcl', 'fred_t10yie']:
    fac = factors.get(fname)
    if fac is None:
        continue

    def entry(close, df, fac=fac, ma_p=60):
        fac_a = fac.reindex(close.index).ffill()
        regime = fac_a > fac_a.rolling(ma_p).mean()
        mom = close.pct_change(5) > 0
        return (regime & mom).shift(1).fillna(False)

    report(f'{fname} trend', compute_portfolio(entry, hold=5))

# D23: Factor z-score extreme reversal
print('\n--- D23: Factor Z-Score Reversal ---')
for fname in ['vix', 'fred_nfci', 'fred_baa10y']:
    fac = factors.get(fname)
    if fac is None:
        continue

    def entry(close, df, fac=fac, z_w=60, z_t=1.5):
        fac_a = fac.reindex(close.index).ffill()
        z = (fac_a - fac_a.rolling(z_w).mean()) / fac_a.rolling(z_w).std().replace(0, np.nan)
        # Risk indicator elevated → contrarian buy
        return (z > z_t).shift(1).fillna(False)

    report(f'{fname} z>1.5 buy', compute_portfolio(entry, hold=5))

# D24: Cross-factor divergence (copper vs gold)
print('\n--- D24: Copper-Gold Divergence ---')
copper = factors.get('copper')
gold = factors.get('gold')
if copper is not None and gold is not None:

    def entry(close, df, cu=copper, au=gold, w=20):
        cu_a = cu.reindex(close.index).ffill()
        au_a = au.reindex(close.index).ffill()
        cu_ret = cu_a.pct_change(w)
        au_ret = au_a.pct_change(w)
        # Copper outperforming gold = risk on
        return (cu_ret > au_ret).shift(1).fillna(False)

    report('Cu>Au divergence', compute_portfolio(entry, hold=5))

