def load_factor(csv_name):
    p = FAC / csv_name
    if not p.exists():
        return None
    df = pd.read_csv(p, parse_dates=True)
    date_col = [c for c in df.columns if 'date' in c.lower() or c.lower() in ['time', 'ds']][0]
    df = df.set_index(pd.to_datetime(df[date_col])).sort_index()
    for c in df.columns:
        if c != date_col and df[c].dtype in [np.float64, np.int64, float, int]:
            return df[c].astype(float)
    return df.iloc[:, 0].astype(float)


factors = {}
for f in ['gold.csv', 'copper.csv', 'vix.csv', 'fred_dgs10.csv', 'fred_dgs2.csv',
           'fred_fedfunds.csv', 'fred_walcl.csv', 'fred_t10yie.csv', 'fred_baa10y.csv',
           'fred_nfci.csv', 'a_shares.csv', 'usdcnh.csv']:
    s = load_factor(f)
    if s is not None:
        factors[f.replace('.csv', '')] = s

print('Loaded factors:', list(factors.keys()))


def compute_portfolio(entry_func, hold=5):
    all_rets = {}
    for stock, df in ohlcv_cache.items():
        if len(df) < 400:
            continue
        close = df['close'].astype(float)
        try:
            entries = entry_func(close, df)
            if entries is None:
                continue
            ret1 = close.pct_change()
            pos = pd.Series(0, index=close.index)
            in_pos = False
            dl = 0
            for i in range(len(close)):
                if entries.iloc[i] and not in_pos:
                    in_pos = True
                    dl = hold
                pos.iloc[i] = 1 if in_pos else 0
                if in_pos:
                    dl -= 1
                    if dl <= 0:
                        in_pos = False
            all_rets[stock] = (pos.shift(1) * ret1).dropna()
        except Exception:
            pass
    if not all_rets:
        return None
    return pd.DataFrame(all_rets).mean(axis=1, skipna=True)


def report(name, result):
    if result is None:
        return
    oos = result[result.index >= SPLIT].dropna()
    is_ = result[result.index < SPLIT].dropna()
    if len(oos) < 20:
        return
    oos_sr = oos.mean() / oos.std() * np.sqrt(252) if oos.std() > 0 else 0
    is_sr = is_.mean() / is_.std() * np.sqrt(252) if is_.std() > 0 else 0
    ret = (1 + oos).cumprod().iloc[-1] - 1
    dd = ((1 + oos).cumprod() / (1 + oos).cumprod().cummax() - 1).min()
    tag = '🟢' if oos_sr > 1.0 else '✨' if oos_sr > 0.7 else '  ' if oos_sr > 0.4 else '❌'
    print(f'  {tag} {name}: IS={is_sr:+.2f} OOS={oos_sr:+.2f} ret={ret:+.1%} DD={dd:.1%}')


