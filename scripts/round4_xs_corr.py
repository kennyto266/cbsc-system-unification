def ts_portfolio(entry_func, hold=5):
    """Time-series portfolio (each stock independent)."""
    all_rets = {}
    for stock, df in ohlcv_cache.items():
        if len(df) < 400: continue
        close = df['close'].astype(float)
        try:
            entries = entry_func(close, df)
            if entries is None: continue
            ret1 = close.pct_change()
            pos = pd.Series(0, index=close.index); in_pos=False; dl=0
            for i in range(len(close)):
                if entries.iloc[i] and not in_pos: in_pos=True; dl=hold
                pos.iloc[i]=1 if in_pos else 0
                if in_pos:
                    dl-=1
                    if dl<=0: in_pos=False
            all_rets[stock] = (pos.shift(1)*ret1).dropna()
        except: pass
    if not all_rets: return None
    return pd.DataFrame(all_rets).mean(axis=1, skipna=True)


def xs_portfolio(xs_signal_panel, hold=5):
    """Cross-sectional portfolio from a panel of bool signals."""
    all_rets = {}
    for stock in close_panel.columns:
        entries = xs_signal_panel[stock].shift(1).fillna(False) if stock in xs_signal_panel.columns else None
        if entries is None: continue
        close = close_panel[stock].dropna()
        entries = entries.reindex(close.index).fillna(False)
        ret1 = close.pct_change()
        pos = pd.Series(0, index=close.index); in_pos=False; dl=0
        for i in range(len(close)):
            if entries.iloc[i] and not in_pos: in_pos=True; dl=hold
            pos.iloc[i]=1 if in_pos else 0
            if in_pos:
                dl-=1
                if dl<=0: in_pos=False
        all_rets[stock] = (pos.shift(1)*ret1).dropna()
    if not all_rets: return None
    return pd.DataFrame(all_rets).mean(axis=1, skipna=True)


# Existing alphas
def a159(c,d):
    vol=d['volume'].astype(float); ef=c.ewm(span=12,adjust=False).mean(); es=c.ewm(span=26,adjust=False).mean()
    m=ef-es; s=m.ewm(span=9,adjust=False).mean(); h=m-s
    e1=((h>0)&(h>h.shift(1))).shift(1).fillna(False)
    vs=(vol-vol.rolling(20).mean())/vol.rolling(20).std().replace(0,np.nan)
    e2=((vs>1.5)&(c.pct_change(5)>0)).shift(1).fillna(False)
    return (e1&e2).fillna(False)
def a160(c,d):
    sma=c.rolling(100).mean(); dev=(c-sma)/sma
    z=(dev-dev.rolling(120).mean())/dev.rolling(120).std().replace(0,np.nan)
    return (z<-1.5).shift(1).fillna(False)
def a161(c,d):
    hi,lo=d['high'].astype(float),d['low'].astype(float)
    tr=pd.concat([(hi-lo),(hi-c.shift()).abs(),(lo-c.shift()).abs()],axis=1).max(axis=1)
    atr=tr.rolling(14).mean(); ap=atr/c
    la=ap.rolling(60).rank(pct=True)<0.15; sma=c.rolling(50).mean()
    return (la&(c>sma)).shift(1).fillna(False)
