def load_factor_col(file, col):
    p = FACT_DIR / file
    if not p.exists(): return None
    try:
        df = pd.read_csv(p)
        dc = next((c for c in df.columns if c.lower() in ("date","end_of_day","datetime","time","time_key")), df.columns[0])
        df[dc] = pd.to_datetime(df[dc], errors="coerce")
        df = df.dropna(subset=[dc, col]).sort_values(dc).drop_duplicates(subset=dc, keep="last")
        return pd.Series(df[col].astype(float).values, index=df[dc].values, name=col)
    except: return None


def load_southbound_netbuy():
    """南向資金每日淨買入 (港股通合計)."""
    df = pd.read_csv(SC_PATH)
    df["date"] = pd.to_datetime(df["date"], errors="coerce")
    # 南向 = type_name 含 '南向'. mutual_type mixed string/int, 用 type_name 篩最穩.
    south = df[df["type_name"].str.contains("南向", na=False)]
    # 合計每日 (滬+深)
    daily = south.groupby("date")["net_buy"].sum().sort_index()
    return daily


def compute_z(series, window=60):
    return (series - series.rolling(window).mean()) / series.rolling(window).std()


def run_backtest(close_stock, factor, entry_cond, exit_cond, holding=7, direction_sign=None):
    """跑 backtest. direction_sign: None=entry 決定方向, +1=固定做多, -1=固定做淡."""
    common = factor.index.intersection(close_stock.index)
    if len(common) < 200: return None, 0
    cl = close_stock.reindex(common)
    ec = entry_cond.reindex(common).fillna(False)
    xc = exit_cond.reindex(common).fillna(False)
    fa = factor.reindex(common)
    n = len(cl)
    orig_bs = kol.backtest_signals
    # 動態決定方向: 用 Series 傳 entries/exits, 如果 direction_sign 係 Series 就分別 long/short
    if direction_sign is not None and hasattr(direction_sign, 'reindex'):
        # direction_sign: True=做多, False=做淡
        ds = direction_sign.reindex(common).fillna(True)
        entries_long = ec & ds
        entries_short = ec & (~ds)
        pf = orig_bs(cl,
                     pd.Series(entries_long.values, index=common),
                     pd.Series(xc.values & ds.reindex(common).fillna(True).values, index=common),
                     pd.Series(entries_short.values, index=common),
                     pd.Series(xc.values & (~ds).reindex(common).fillna(False).values, index=common))
    else:
        sign = direction_sign if direction_sign else 1
        e = pd.Series(ec.values, index=common)
        x = pd.Series(xc.values, index=common)
        if sign == 1:
            pf = orig_bs(cl, e, x, None, None)
        else:
            pf = orig_bs(cl, None, None, e, x)
    if pf is None or pf.trades.count() == 0:
        return None, 0
    try:
        s = pf.sharpe_ratio()
        return float(s) if not np.isnan(s) else 0.0, pf.trades.count()
    except:
        return 0.0, pf.trades.count()


def sharpe_series(r):
    if r is None or len(r) < 30 or r.std() == 0: return 0.0
    return r.mean() / r.std() * np.sqrt(252)


