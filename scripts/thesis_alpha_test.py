# A143: 南向資金反轉
# ============================================================
def test_a143(stocks):
    print(f"\n{'='*65}")
    print("A143: 南向資金反轉 (Thesis: 內地資金收手=頂, 回流=底)")
    print(f"{'='*65}", flush=True)

    nb = load_southbound_netbuy()
    if nb is None or len(nb) < 200:
        print("  ❌ 南向數據不足"); return None
    print(f"  南向數據: {nb.index[0].date()} ~ {nb.index[-1].date()} ({len(nb)} 日)")

    # thesis 修正: IS 顯示反轉方向係負 (-0.33~-0.69), 即南向有 momentum (持續性).
    # 改為順勢: 大額淨流入 → 做多 (跟南向買); 大額流出 → 做淡.
    cum5 = nb.rolling(5).sum()
    z = compute_z(cum5, 60)

    for zth in [1.0, 1.5, 2.0]:
        for hold in [5, 7, 10, 14]:
            # entry: Z 極端; exit: Z 回歸 0
            entry = (z > zth) | (z < -zth)
            exit_c = (z > 0) & (z.shift(1) < 0) | (z < 0) & (z.shift(1) > 0)  # 穿零
            # direction (momentum): Z>+zth 做多 (跟南向買), Z<-zth 做淡
            direction = z > zth  # True=做多 (順勢, 之前反轉方向 IS 負)
            # IS test
            is_shs = []
            for s in stocks[:30]:
                c = load_stock_close(s)
                if c is None or len(c) < 400: continue
                sh, _ = run_backtest(c[c.index < SPLIT], nb, entry, exit_c, hold, direction)
                if sh is not None: is_shs.append(sh)
            if len(is_shs) < 5:
                print(f"    z={zth} hold={hold}: 不足5股有交易", flush=True); continue
            is_mean = np.mean(is_shs)
            if is_mean < 0.2:
                print(f"    z={zth} hold={hold}: IS={is_mean:.2f} 太弱skip", flush=True); continue  # IS 太弱唔值得測 OOS
            # OOS
            oos_shs = []
            for s in stocks[:30]:
                c = load_stock_close(s)
                if c is None or len(c) < 400: continue
                sh, _ = run_backtest(c[c.index >= SPLIT], nb, entry, exit_c, hold, direction)
                if sh is not None: oos_shs.append(sh)
            oos_mean = np.mean(oos_shs) if oos_shs else 0
            oos_pass = (np.array(oos_shs) > 0.3).mean() * 100 if oos_shs else 0
            print(f"  z={zth} hold={hold}: IS={is_mean:.2f} OOS={oos_mean:.2f} pass={oos_pass:.0f}% "
                  f"{'🟢' if oos_mean>0.3 else '🔴'}", flush=True)
            if oos_mean > 0.3:
                return {"zth": zth, "hold": hold, "is": is_mean, "oos": oos_mean, "pass": oos_pass}
    return None


# ============================================================
# A144: 貼現窗-HIBOR 背離
# ============================================================
def test_a144(stocks):
    print(f"\n{'='*65}")
    print("A144: 貼現窗-HIBOR 背離 (Thesis: 銀行暗中缺水=隱性壓力)")
    print(f"{'='*65}", flush=True)

    dw = load_factor_col("discount_window.csv", "discount_window_usage")
    hibor = load_factor_col("hibor.csv", "close")
    if dw is None or hibor is None:
        print("  ❌ 數據不足"); return None

    # 修正: 貼現窗近期=0 (冇人用), 原始 Z 無意義.
    # 改用「貼現窗非零事件」: dw 突然 > 0 (銀行開始借) = 壓力訊號.
    # 同時對比 HIBOR: dw>0 但 hibor 唔升 = 隱性壓力.
    dw_active = dw > 0  # 貼現窗有活動
    hibor_z = compute_z(hibor, 60)
    # 壓力訊號: dw 活動 + HIBOR Z 唔高 (低於中位)
    pressure = dw_active & (hibor_z < 0.5)
    # 壓力解除: dw 冇活動 (回歸 0)
    no_pressure = (~dw_active).rolling(5).sum() >= 5  # 連續5日冇借用

    for hold in [5, 7, 10, 14]:
        entry = pressure
        exit_c = no_pressure
        # direction: 壓力 → 做淡 (固定)
        is_shs = []
        for s in stocks[:30]:
            c = load_stock_close(s)
            if c is None or len(c) < 400: continue
            sh, _ = run_backtest(c[c.index < SPLIT], hibor, entry, exit_c, hold, -1)  # -1=做淡
            if sh is not None: is_shs.append(sh)
        if len(is_shs) < 5:
            print(f"    hold={hold}: 不足5股", flush=True); continue
        is_mean = np.mean(is_shs)
        if is_mean < 0.1:
            print(f"    hold={hold}: IS={is_mean:.2f} 太弱skip", flush=True); continue
        oos_shs = []
        for s in stocks[:30]:
            c = load_stock_close(s)
            if c is None or len(c) < 400: continue
            sh, _ = run_backtest(c[c.index >= SPLIT], hibor, entry, exit_c, hold, -1)
            if sh is not None: oos_shs.append(sh)
        oos_mean = np.mean(oos_shs) if oos_shs else 0
        oos_pass = (np.array(oos_shs) > 0.3).mean() * 100 if oos_shs else 0
        print(f"  hold={hold}: IS={is_mean:.2f} OOS={oos_mean:.2f} pass={oos_pass:.0f}% "
              f"{'🟢' if oos_mean>0.3 else '🔴'}", flush=True)
        if oos_mean > 0.3:
            return {"zth": 0, "hold": hold, "is": is_mean, "oos": oos_mean, "pass": oos_pass}
    return None


def main():
    stocks = sorted(FACTOR_STOCKS)
    print("="*65)
    print("🧠 Thesis-First Alpha OOS 驗證")
    print(f"  IS < {SPLIT}  |  OOS >= {SPLIT}  |  30 股代表性")
