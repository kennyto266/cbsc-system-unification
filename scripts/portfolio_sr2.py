#!/usr/bin/env python3
"""portfolio_sr2.py — 多策略倉位組合 SR 測試.

唔係單一股票嘅投票 SR, 而係多個策略各自喺唔同股票持倉,
組合成一個 portfolio, 計組合層面 Sharpe.

數學: SR_portfolio = SR_avg * sqrt(N) / sqrt(1 + (N-1)*avg_corr)
如果 N=10 持倉, SR_avg=0.8, corr=0.1 → SR = 0.8*3.16/1.34 = 1.89
目標: 搵到低相關 + 高 SR 嘅組合 → SR>=2
"""
import sys
sys.path = [p for p in sys.path if "CODEX" not in p]
sys.path.insert(0, r"C:\Users\Penguin8n\ZCodeProject\backtests")
sys.path.insert(0, r"C:\Users\Penguin8n\ZCodeProject\cbsc-system-unification\scripts")
import numpy as np, pandas as pd
from pathlib import Path
from vbt_data import FACTOR_STOCKS, load_stock_close, TOTAL_COST
from vbt_kol import run_kol
from kol_alpha_strategies import KOL_REGISTRY

ROBUST_IDS = [9,10,15,17,21,26,27,31,36,39,43,45,47,58,59,62,66,69,71,74,88]
TEST_STOCKS = FACTOR_STOCKS[:30]


def get_strategy_returns(close, entries, exits):
    """從 entries/exits 計每日回報 (持倉=close return, 空倉=0)."""
    in_pos = pd.Series(0, index=close.index)
    holding = False
    for i in range(len(close)):
        if entries.iloc[i]:
            holding = True
        if exits.iloc[i]:
            holding = False
        in_pos.iloc[i] = 1 if holding else 0
    daily_ret = close.pct_change().fillna(0) * in_pos
    # 扣交易成本
    trades = entries.sum()
    cost = TOTAL_COST / 2 * trades / len(close)
    return daily_ret - cost


def main():
    print("=" * 65)
    print("📊 多策略倉位組合 SR 測試")
    print("   目標: portfolio SR >= 2.0")
    print("=" * 65)

    # Step 1: 為每個 ROBUST alpha × 每隻股計策略回報
    print("\n1. 計算策略回報矩陣...", flush=True)
    returns_dict = {}  # {(aid, stock): daily_return Series}

    for aid in ROBUST_IDS:
        for stock in TEST_STOCKS:
            try:
                r = run_kol(aid, stock)
                if r is None:
                    continue
                pf, _, close, m = r
                if pf.trades.count() < 3:
                    continue
                # 從 portfolio 重建 entries/exits
                trades_df = pf.trades.records_readable
                entries = pd.Series(False, index=close.index)
                exits = pd.Series(False, index=close.index)
                for _, t in trades_df.iterrows():
                    if t["Entry Timestamp"] in close.index:
                        entries[t["Entry Timestamp"]] = True
                    if t["Exit Timestamp"] in close.index:
                        exits[t["Exit Timestamp"]] = True
                ret = get_strategy_returns(close, entries, exits)
                returns_dict[(aid, stock)] = ret
            except Exception:
                pass
        print(f"  A{aid}: {sum(1 for k in returns_dict if k[0]==aid)} stocks", flush=True)

    print(f"\n  總計: {len(returns_dict)} 個策略-股票組合")

    # Step 2: 計算所有組合嘅 SR + 相關性矩陣
    print("\n2. 計算 SR + 相關性...", flush=True)
    ret_df = pd.DataFrame(returns_dict)
    ret_df = ret_df.fillna(0)

    srs = ret_df.mean() / ret_df.std() * np.sqrt(252)
    srs = srs.dropna()

    # 排序: 高 SR 先
    srs_sorted = srs.sort_values(ascending=False)
    print(f"  Top 10 單策略 SR:")
    for i, ((aid, stock), sr) in enumerate(srs_sorted.head(10).items()):
        name = KOL_REGISTRY[aid][0][:15]
        print(f"    {name} @ {stock}: SR={sr:.2f}")

    # Step 3: 貪婪構建組合 (每次加入同現有組合最低相關嘅高 SR 策略)
    print("\n3. 貪婪組合構建...", flush=True)
    selected = []
    combined_ret = None

    for i in range(min(15, len(srs_sorted))):
        best_candidate = None
        best_portfolio_sr = -999

        for idx in srs_sorted.index:
            if idx in selected:
                continue
            candidate_ret = ret_df[idx]
            if combined_ret is None:
                trial_ret = candidate_ret
            else:
                # 等權加入新策略
                trial_ret = (combined_ret * len(selected) + candidate_ret) / (len(selected) + 1)

            trial_sr = trial_ret.mean() / trial_ret.std() * np.sqrt(252) if trial_ret.std() > 0 else 0
            if trial_sr > best_portfolio_sr:
                best_portfolio_sr = trial_sr
                best_candidate = idx

        if best_candidate is not None:
            selected.append(best_candidate)
            candidate_ret = ret_df[best_candidate]
            if combined_ret is None:
                combined_ret = candidate_ret.copy()
            else:
                combined_ret = (combined_ret * (len(selected)-1) + candidate_ret) / len(selected)

            aid, stock = best_candidate
            name = KOL_REGISTRY[aid][0][:15]
            n = len(selected)
            # 計算組合內平均相關性
            if n > 1:
                sel_rets = ret_df[selected]
                corr_matrix = sel_rets.corr()
                avg_corr = (corr_matrix.values[np.triu_indices(n, k=1)]).mean()
            else:
                avg_corr = 0

            print(f"  +{i+1}: {name} @ {stock} | "
                  f"portfolio SR={best_portfolio_sr:.2f} | "
                  f"N={n} avg_corr={avg_corr:.2f}", flush=True)

            if best_portfolio_sr >= 2.0 and n >= 5:
                print(f"\n  🎉🎉🎉 SR>=2.0 達成! (N={n})")
                break

    # Step 4: 最終組合結果
    print(f"\n{'='*65}")
    print(f"📊 最終組合結果")
    print(f"{'='*65}")
    if combined_ret is not None:
        final_sr = combined_ret.mean() / combined_ret.std() * np.sqrt(252)
        final_ret = (1 + combined_ret).cumprod().iloc[-1] - 1
        # MDD
        cum = (1 + combined_ret).cumprod()
        mdd = (cum / cum.cummax() - 1).min()

        sel_rets = ret_df[selected]
        corr_matrix = sel_rets.corr()
        n = len(selected)
        avg_corr = (corr_matrix.values[np.triu_indices(n, k=1)]).mean() if n > 1 else 0

        print(f"  組合持倉數: {n}")
        print(f"  組合 Sharpe: {final_sr:.2f}")
        print(f"  組合回報: {final_ret*100:.1f}%")
        print(f"  最大回撤: {mdd*100:.1f}%")
        print(f"  平均相關性: {avg_corr:.2f}")
        print(f"\n  組合成員:")
        for aid, stock in selected:
            name = KOL_REGISTRY[aid][0][:18]
            ind_sr = srs[(aid, stock)]
            print(f"    {name} @ {stock}: SR={ind_sr:.2f}")

    # 存結果
    out = Path(r"C:\Users\Penguin8n\ZCodeProject\cbsc-system-unification\data\vbt_factor_reports\portfolio_sr2.csv")
    sel_df = pd.DataFrame([(KOL_REGISTRY[aid][0], stock, srs[(aid,stock)]) for aid, stock in selected],
                          columns=["strategy", "stock", "individual_sr"])
    sel_df.to_csv(out, index=False)
    print(f"\n💾 {out}")


if __name__ == "__main__":
    main()
