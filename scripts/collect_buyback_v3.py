"""collect_buyback_v3.py — 修復版 HKEX NDD share buyback collector (cs_bkfx).

v2 bug: parse_pdf 要求 'Repurchase report' 字眼, 但 HKEX FF304 表格實際係
'A. Purchase report' → 2021-2023 年 PDF 全部被跳過 (只剩 14 股/2024-06 起).

v3:
  1) titleSearchServlet title='Next Day Disclosure' 逐年 (2021..2026)
  2) SHORT_TEXT 過濾 'Share Buyback' 類別 (唔使 download Others-only 文件)
  3) PDF parse: 'A. Purchase report' 表 (Trading date / shares / On the Exchange
     HKD high HKD low HKD total) — 攞 trading_date + shares + total consideration
  4) news_id 去重, checkpoint resume-safe
輸出: data/new_sources/buyback_ndd_full.csv
"""
import csv
import json
import re
import time
import urllib.request
from datetime import datetime
from pathlib import Path

BASE = Path(__file__).resolve().parent.parent
OUT_DIR = BASE / "data" / "new_sources"
RAW = OUT_DIR / "buyback_ndd_full.csv"
CKPT = OUT_DIR / "buyback_v3_ckpt.json"

CODES = ['00001','00002','00003','00005','00006','00012','00016','00017','00020','00027',
'00066','00101','00175','00241','00268','00285','00291','00386','00388','00688','00700','00762',
'00823','00883','00939','00941','00992','01024','01038','01088','01109','01211','01299','01398',
'01801','01810','01876','01928','02013','02269','02318','02388','02628','02899','03690','06862',
'09618','09888','09988','09992','09999']

YEARS = ["2021", "2022", "2023", "2024", "2025", "2026"]
SEARCH = ("https://www1.hkexnews.hk/search/titleSearchServlet.do?sortDir=0&sortByOptions=DateTime"
          "&category=0&market=SEHK&stockId={sid}&documentType=-1&fromDate={f}&toDate={t}"
          "&title=Next%20Day%20Disclosure&searchType=1&t1code=-2&t2Gcode=-2&t2code=-2"
          "&rowRange=1000&lang=en")

HDRS = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
        "Referer": "https://www1.hkexnews.hk/", "Connection": "close"}

log = lambda *a: print(datetime.now().strftime("%H:%M:%S"), *a, flush=True)


def fetch(url, binary=False, tries=3):
    for i in range(tries):
        try:
            req = urllib.request.Request(url, headers=HDRS)
            with urllib.request.urlopen(req, timeout=30) as r:
                b = r.read()
            return b if binary else b.decode("utf-8", "replace")
        except Exception:
            if i == tries - 1:
                raise
            time.sleep(3)


def get_stock_id(code):
    txt = fetch(f"https://www1.hkexnews.hk/search/prefix.do?callback=cb&lang=ZH&type=A&name={code}&market=SEHK")
    m = re.search(r'"stockId":(\d+),"code":"' + code + '"', txt)
    return int(m.group(1)) if m else None


# "1). 23 December 2022 1,090,000 On the Exchange HKD 325.8 HKD 318 HKD 350,821,078"
ROW_RE = re.compile(
    r"(\d{1,2} (?:January|February|March|April|May|June|July|August|September|October|November|December) \d{4})"
    r"\s+([\d,]+)\s+On the Exchange HKD ([\d,.]+) HKD ([\d,.]+) HKD ([\d,.]+)")


def parse_pdf(pdf_bytes):
    from pypdf import PdfReader
    import io
    r = PdfReader(io.BytesIO(pdf_bytes))
    text = "\n".join(p.extract_text() for p in r.pages)
    rows = []
    for m in ROW_RE.finditer(text):
        rows.append({
            "trading_date": m.group(1),
            "shares_bought_back": int(m.group(2).replace(",", "")),
            "price_low": float(m.group(3).replace(",", "")),
            "price_high": float(m.group(4).replace(",", "")),
            "total_consideration": float(m.group(5).replace(",", "")),
        })
    return rows


def load_ckpt():
    if CKPT.exists():
        d = json.loads(CKPT.read_text())
        d["news_seen"] = set(d["news_seen"])
        return d
    return {"done_codes": {}, "news_seen": set()}


def save_ckpt(ck):
    CKPT.write_text(json.dumps({"done_codes": ck["done_codes"],
                                "news_seen": sorted(ck["news_seen"])}))


def append_rows(fp, rows):
    new = not fp.exists()
    with open(fp, "a", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=["doc_date", "stock_code", "news_id", "pdf_url",
                                          "trading_date", "shares_bought_back",
                                          "price_low", "price_high", "total_consideration"])
        if new:
            w.writeheader()
        for r in rows:
            w.writerow(r)


def main():
    ck = load_ckpt()
    buf = []
    cur_year = str(datetime.now().year)
    for code in CODES:
        done = code in ck["done_codes"]
        # [09-28 agent2-H] 凍結醫法: done 股重掃當年 (news_seen 去重兜底),
        # 唔係 done 即跳 — 否則 done_codes 永久 no-op, CSV 凍結喺最後一次
        # 全量掃描日 (09-28 實錄: 51/51 done 但數據斷 08-21)
        years = [cur_year] if done else YEARS
        sid = ck["done_codes"].get(code) or get_stock_id(code)
        if sid is None:
            log("no stockId", code)
            continue
        n_docs = 0
        for year in years:
            try:
                j = json.loads(fetch(SEARCH.format(sid=sid, f=year + "0101", t=year + "1231")))
                rows = json.loads(j["result"])
            except Exception as e:
                log("search fail", code, year, e)
                time.sleep(5)
                continue
            for r in rows:
                if "Share Buyback" not in (r.get("SHORT_TEXT") or ""):
                    continue
                nid = r["NEWS_ID"]
                if nid in ck["news_seen"]:
                    continue
                link = r["FILE_LINK"]
                if "_c." in link:
                    link = link.replace("_c.", ".")
                if not link:
                    continue
                try:
                    pdf = fetch("https://www1.hkexnews.hk" + link, binary=True)
                    for pr in parse_pdf(pdf):
                        buf.append({
                            "doc_date": r["DATE_TIME"], "stock_code": code, "news_id": nid,
                            "pdf_url": link, "trading_date": pr["trading_date"],
                            "shares_bought_back": pr["shares_bought_back"],
                            "price_low": pr["price_low"], "price_high": pr["price_high"],
                            "total_consideration": pr["total_consideration"],
                        })
                    n_docs += 1
                    ck["news_seen"].add(nid)
                except Exception as e:
                    log("pdf fail", code, nid, e)
                time.sleep(0.3)
        append_rows(RAW, buf)
        buf = []
        ck["done_codes"][code] = sid
        save_ckpt(ck)
        log(f"done {code}: bb_docs={n_docs} seen={len(ck['news_seen'])}")
    log("ALL DONE")


if __name__ == "__main__":
    main()
