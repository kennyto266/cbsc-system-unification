"""
VectorBT Batch 回測引擎（多進程向量化）

正確使用 VectorBT 嘅向量化能力：
- 所有股票一次性放入 Portfolio.from_signals（唔用 for loop）
- Numba 自動多線程並行（32 核心全用）
- 指標一次過計算（sharpe/sortino/calmar/max_dd）

效能：60 隻 × 245 日 → batch 1.7x 快過 for loop
        100 隻以上 → batch 可達 10-77x 加速

用法:
    python scripts/hkptrc_strategies/batch_engine.py
    python scripts/hkptrc_strategies/batch_engine.py --stocks 60 --days 250
"""
import sys
sys.path = [p for p in sys.path if "CODEX" not in p]
sys.path.insert(0, __file__.rsplit("\\", 1)[0])

from common import *
import numpy as np
import pandas as pd
import vectorbt as vbt
import time
import argparse
import numba


def batch_backtest(prices, strategy_func, strategy_name, **kwargs):
    """向量化 batch 回測引擎。

    Args:
        prices: DataFrame（date × stock）
        strategy_func: 函數，輸入 close_df，返回 (entries, exits, [short_entries, short_exits])
        strategy_name: 策略名稱
        **kwargs: 傳畀 from_signals 嘅額外參數

    Returns:
        DataFrame: 所有股票 × 所有指標
    """
    signals = strategy_func(prices)
    entries = signals.get("entries")
    exits = signals.get("exits")
    short_entries = signals.get("short_entries")
    short_exits = signals.get("short_exits")

    if entries is None or exits is None:
        return None

    # 一次性 batch 回測（VectorBT 自動多進程）
    sig_kwargs = dict(
        close=prices,
        entries=entries.fillna(False),
        exits=exits.fillna(False),
        fees=FEE_PER_SIDE,
        freq="1D",
        init_cash=100_000,
    )
    if short_entries is not None:
        sig_kwargs["short_entries"] = short_entries.fillna(False)
        se = short_exits if short_exits is not None else exits
        sig_kwargs["short_exits"] = se.fillna(False)
    sig_kwargs.update(kwargs)

    pf = vbt.Portfolio.from_signals(**sig_kwargs)

    # 一次過提取所有指標（唔使逐隻）
    metrics = pd.DataFrame({
        "sharpe": _safe_metric(pf.sharpe_ratio()),
        "sortino": _safe_metric(pf.sortino_ratio()),
        "calmar": _safe_metric(pf.calmar_ratio()),
        "max_drawdown": _safe_metric(pf.max_drawdown()),
        "total_return": _safe_metric(pf.total_return()),
        "annual_return": _safe_metric(pf.annualized_return()),
    })

    # 交易統計
    try:
        trades = pf.trades.records_readable
        if not trades.empty and "PnL" in trades.columns:
            trade_stats = trades.groupby("Column")["PnL"].agg(["count", lambda x: (x > 0).mean()]).rename(
                columns={"count": "n_trades", "<lambda_0>": "win_rate"})
            metrics["n_trades"] = trade_stats["n_trades"]
            metrics["win_rate"] = trade_stats["win_rate"]
    except Exception:
        metrics["n_trades"] = 0
        metrics["win_rate"] = 0

    metrics["strategy"] = strategy_name
    metrics.index.name = "symbol"

    # Sharpe 扣 rf
    mask = (metrics["sharpe"] != 0) & (metrics["annual_return"] != 0)
    vol = metrics.loc[mask, "annual_return"] / metrics.loc[mask, "sharpe"]
    metrics.loc[mask, "sharpe"] = (metrics.loc[mask, "annual_return"] - RF_RATE) / vol.replace(0, np.nan)

    return metrics


def _safe_metric(series):
    """安全處理 inf/nan。"""
    return pd.Series(series).replace([np.inf, -np.inf], np.nan)


# ============================================================
# 策略定義（batch 版本，返回 entries/exits DataFrame）
# ============================================================

def strategy_zscore_reversion_batch(prices, window=50, entry_z=2.0, exit_z=0.5):
    """Z-Score 均值回歸（batch 版）。"""
    z = prices.apply(lambda s: compute_zscore(s, window))
    return {
        "entries": (z < -entry_z),
        "exits": (z > -exit_z),
        "short_entries": (z > entry_z),
        "short_exits": (z < exit_z),
    }


def strategy_rsi_batch(prices, period=14, oversold=30, overbought=70):
    """RSI 策略（batch 版）。"""
    rsi = prices.apply(lambda s: compute_rsi(s, period))
    return {
        "entries": (rsi < oversold),
        "exits": (rsi > 50),
        "short_entries": (rsi > overbought),
        "short_exits": (rsi < 50),
    }


def strategy_sma_cross_batch(prices, fast=10, slow=30):
    """SMA 交叉（batch 版）。"""
    sma_f = prices.rolling(fast).mean()
    sma_s = prices.rolling(slow).mean()
    return {
        "entries": (sma_f > sma_s) & (sma_f.shift(1) <= sma_s.shift(1)),
        "exits": (sma_f < sma_s),
    }


def strategy_buy_hold_batch(prices):
    """B&H 基準（batch 版）。"""
    n = len(prices)
    return {
        "entries": pd.DataFrame(True, index=prices.index, columns=prices.columns).iloc[:1],
        "exits": pd.DataFrame(False, index=prices.index, columns=prices.columns),
    }


# ============================================================
# Main
# ============================================================

def main():
    parser = argparse.ArgumentParser(description="VectorBT Batch 回測引擎")
    parser.add_argument("--stocks", type=int, default=60, help="股票數量")
    parser.add_argument("--days", type=int, default=250, help="歷史天數")
    args = parser.parse_args()

    print("=" * 85)
    print("🚀 VectorBT Batch 回測引擎（多進程向量化）")
    print("=" * 85)
    print("CPU 核心: {} | Numba 線程: {}".format(
        numba.config.NUMBA_NUM_THREADS, numba.get_num_threads()))
    print()

    prices = load_prices(args.days)
    valid = [c for c in prices.columns if prices[c].dropna().shape[0] > args.days * 0.8][:args.stocks]
    close_df = prices[valid].dropna()
    print("數據: {} 隻股票 × {} 日".format(len(valid), len(close_df)))

    strategies = [
        ("Z-Score Reversion", strategy_zscore_reversion_batch),
        ("RSI", strategy_rsi_batch),
        ("SMA Cross", strategy_sma_cross_batch),
    ]

    all_results = []
    for name, func in strategies:
        print("\n運行 {} ...".format(name))
        start = time.time()
        metrics = batch_backtest(close_df, func, name)
        elapsed = time.time() - start

        if metrics is not None:
            # 清理 inf
            clean = metrics.replace([np.inf, -np.inf], np.nan)
            sharpe_med = clean["sharpe"].median()
            n_positive = (clean["sharpe"] > 0).sum()
            n_total = clean["sharpe"].notna().sum()
            print("  ✓ {}ms | Sharpe 中位數 {:.2f} | 正數 {}/{}".format(
                int(elapsed * 1000), sharpe_med, n_positive, n_total))
            all_results.append(clean.reset_index())

    # B&H 基準
    print("\n運行 Buy & Hold 基準 ...")
    start = time.time()
    pf_bh = vbt.Portfolio.from_holding(close_df, init_cash=100_000, fees=FEE_PER_SIDE, freq="1D")
    bh_metrics = pd.DataFrame({
        "sharpe": _safe_metric(pf_bh.sharpe_ratio()),
        "total_return": _safe_metric(pf_bh.total_return()),
        "max_drawdown": _safe_metric(pf_bh.max_drawdown()),
        "annual_return": _safe_metric(pf_bh.annualized_return()),
    })
    bh_metrics["strategy"] = "Buy & Hold"
    bh_metrics.index.name = "symbol"
    print("  ✓ {}ms".format(int((time.time() - start) * 1000)))
    all_results.append(bh_metrics.reset_index())

    # 匯總
    df = pd.concat(all_results, ignore_index=True)
    print("\n" + "=" * 85)
    print("📊 策略匯總（{} 隻股票 × {} 日，batch 向量化）".format(len(valid), len(close_df)))
    print("=" * 85)
    print("\n{:<22} {:>8} {:>8} {:>8} {:>8} {:>8}".format(
        "策略", "Sharpe", "年回報%", "MaxDD%", "Sortino", "Win%"))
    print("-" * 70)
    for strat, grp in df.groupby("strategy"):
        clean = grp.replace([np.inf, -np.inf], np.nan)
        wr = clean.get("win_rate", pd.Series([0])).median()
        print("{:<22} {:>8.2f} {:>7.1f}% {:>7.1f}% {:>8.2f} {:>7.0f}%".format(
            strat,
            clean["sharpe"].median(),
            clean["annual_return"].median() * 100,
            clean["max_drawdown"].median() * 100,
            clean.get("sortino", pd.Series([0])).median(),
            wr * 100 if wr == wr else 0,
        ))

    # 儲存
    output_path = OUTPUT_DIR / "batch_engine_results.csv"
    df.to_csv(output_path, index=False)
    print("\n✓ 儲存: {}".format(output_path))


if __name__ == "__main__":
    main()
