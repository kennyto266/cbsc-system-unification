def opend_alive(host: str = "127.0.0.1", port: int = 11111) -> bool:
    """Quick TCP check if OpenD is accepting connections."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(4)
    try:
        sock.connect((host, port))
        sock.close()
        return True
    except Exception:
        return False


# ============================================================================
# Rate limiter — sliding window (thread-safe)
# ============================================================================

class RateLimiter:
    """Sliding-window rate limiter for Futu API calls.

    Futu limit: 60 requests per 30 seconds per OpenD session.
    Self-limited to ``max_calls`` (default 50) for safety margin.
    """

    def __init__(self, max_calls: int = 50, window_sec: float = 30.0):
        self._max = max_calls
        self._window = window_sec
        self._calls: collections.deque = collections.deque()
        self._lock = threading.Lock()

    def acquire(self) -> None:
        """Block until a request slot is available."""
        with self._lock:
            now = time.monotonic()
            # Evict expired timestamps
            while self._calls and now - self._calls[0] >= self._window:
                self._calls.popleft()
            if len(self._calls) >= self._max:
                wait = self._window - (now - self._calls[0]) + 0.1
                if wait > 0:
                    time.sleep(wait)
                now = time.monotonic()
                while self._calls and now - self._calls[0] >= self._window:
                    self._calls.popleft()
            self._calls.append(now)


# ============================================================================
# Thread-local OpenQuoteContext management
# ============================================================================

_tls = threading.local()


def get_quote_ctx(host: str, port: int):
    """Get or lazily create a thread-local OpenQuoteContext.

    Each worker thread gets its own connection to OpenD. The ``futu`` module
    reference is also stored on thread-local for RET_OK access.
    """
    ctx = getattr(_tls, "ctx", None)
    if ctx is None:
        import futu
        _tls.futu = futu
        ctx = futu.OpenQuoteContext(host=host, port=port)
        _tls.ctx = ctx
    return ctx, getattr(_tls, "futu", None)


def close_thread_ctx() -> None:
    """Close the current thread's OpenQuoteContext if open."""
    ctx = getattr(_tls, "ctx", None)
    if ctx is not None:
        try:
            ctx.close()
        except Exception:
            pass
        _tls.ctx = None


