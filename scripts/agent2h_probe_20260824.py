#!/usr/bin/env python3
"""agent2-H 2026-08-24 probe: Futu short volume + EM blocktrade/fund-hold/warrant APIs."""
import json, urllib.request

def em_get(report, filt='', cols='', ps=5):
    url = (f"https://datacenter.eastmoney.com/securities/api/data/v1/get?"
           f"reportName={report}&columns={cols or 'ALL'}&pageSize={ps}&pageNumber=1"
           f"&source=F10&client=PC{'&filter=' + filt if filt else ''}")
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            d = json.loads(r.read())
        res = d.get('result') or {}
        rows = res.get('data') or []
        print(f"\n== {report} filt={filt} -> code={d.get('code')} msg={d.get('message')} n={len(rows)}")
        if rows: print(json.dumps(rows[0], ensure_ascii=False)[:600])
        return rows
    except Exception as e:
        print(f"\n== {report} filt={filt} -> ERR {e}")
        return []

# 1) block trade candidates
em_get("RPT_HKF10_BLKTRADE", "(SECUCODE=\"00700.HK\")")
em_get("RPT_HK_BLOCKTRADE", "(SECUCODE=\"00700.HK\")")
