    def sharpe_pf(close, entries, exits, dir_sign=1):
        """簡化 backtest. dir_sign: +1=做多 entry, -1=做淡 entry.
        backtest_signals(close, long_entries, long_exits, short_entries, short_exits)."""
        common = close.index.intersection(entries.dropna().index)
        if len(common) < 100: return None
        cl = close.reindex(common)
        e = pd.Series(entries.reindex(common).fillna(False).values, index=common)
        x = pd.Series(exits.reindex(common).fillna(False).values, index=common)
        empty = pd.Series(False, index=common)
        try:
            if dir_sign == 1:
                pf = kol.backtest_signals(cl, e, x)  # long
            else:
                pf = kol.backtest_signals(cl, empty, empty, e, x)  # short
            if pf is None or pf.trades.count() == 0: return None
            s = pf.sharpe_ratio()
            return float(s) if not np.isnan(s) else 0.0
        except Exception as ex:
            return None

    def build_entries_exits(signal_raw, hsif_idx, hold):
        """signal_raw: 原始 boolean (可能低頻). ffill 到 HSIF 日度, rising-edge entry, 固定持倉期 exit."""
        # ffill 訊號 (月度 factor: 訊號持續到下次更新)
        sig_ff = signal_raw.reindex(hsif_idx).ffill().fillna(False).astype(bool)
        # rising edge = entry (False→True 轉換)
        entries = sig_ff & (~sig_ff.shift(1).fillna(False))
        # exit = entry 後 hold 日
        exits = entries.shift(hold).fillna(False)
        return entries, exits

    results = []
    for name, factor, signal, thesis, edir in passed:
        print(f"\n{'─'*50}\n  {name}: {thesis}")
        best = None
        for hold in [7, 10, 14]:
            is_mask = hsif.index < SPLIT_DT
            oos_mask = ~is_mask
            entries, exits = build_entries_exits(signal, hsif.index, hold)
            is_sh = sharpe_pf(hsif[is_mask], entries[is_mask], exits[is_mask], edir)
            oos_sh = sharpe_pf(hsif[oos_mask], entries[oos_mask], exits[oos_mask], edir)
            if is_sh is None: continue
            oos_val = oos_sh if oos_sh is not None else 0.0
            tag = "🟢" if oos_val > 0.3 else "🔴"
            oos_str = f"{oos_sh:+.2f}" if oos_sh is not None else "  N/A"
            print(f"    hold={hold}: IS={is_sh:+.2f} OOS={oos_str} {tag}")
            if best is None or oos_val > (best[1] or 0):
                best = (hold, oos_sh, is_sh)
        if best:
            results.append((name, best[0], best[2], best[1]))

    print(f"\n\n{'='*65}")
    print(f"🏁 OOS 結果匯總")
    print(f"{'='*65}")
    print(f"  {'Thesis':<22} {'hold':>4} {'IS':>6} {'OOS':>6}")
    for name, hold, ish, osh in results:
        osh_val = osh if osh is not None else 0.0
        osh_str = f"{osh:>+6.2f}" if osh is not None else "   N/A"
        ish_str = f"{ish:>+6.2f}" if ish is not None else "   N/A"
        tag = "🟢" if osh_val > 0.3 else "🔴"
        print(f"  {name:<22} {hold:>4} {ish_str} {osh_str} {tag}")
    wins = sum(1 for _,_,_,o in results if (o or 0) > 0.3)
    print(f"\n  → {wins}/{len(results)} thesis OOS Sharpe > 0.3")



