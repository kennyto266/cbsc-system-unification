def load_col(file, col):
    p = FACT_DIR / file
    if not p.exists(): return None
    df = pd.read_csv(p)
    dc = next((c for c in df.columns if c.lower() in ("date","end_of_day","datetime","time","time_key")), df.columns[0])
    df[dc] = pd.to_datetime(df[dc], errors="coerce")
    if col not in df.columns:
        # 取第一個數值欄
        for c in df.columns:
            if c == dc: continue
            try:
                df[c].astype(float); col = c; break
            except: continue
    df = df.dropna(subset=[dc, col]).sort_values(dc).drop_duplicates(subset=dc, keep="last")
    s = pd.Series(df[col].astype(float).values, index=pd.to_datetime(df[dc].values), name=col)
    if getattr(s.index, 'tz', None) is not None: s.index = s.index.tz_localize(None)
    return s


def load_hsif():
    df = pd.read_csv(HSIF_PATH)
    df["Date"] = pd.to_datetime(df["Date"])
    df = df.sort_values("Date").drop_duplicates(subset="Date", keep="last").set_index("Date")
    return df["HSIF_close"]


def fwd_ret(price, h=5):
    """h 日前瞻回報."""
    return price.shift(-h) / price - 1


def precheck_full(name, factor, target_fwd, signal, thesis, expected_dir):
    """完整 4 關預檢, G4 用對 target_fwd (目標資產前瞻回報).
    自動將低頻 factor ffill 對齊到 target_fwd 日度 index."""
    print(f"\n{'='*65}")
    print(f"🔍 {name}: {thesis}")
    print(f"{'='*65}")
    # 將 factor + signal 對齊到 target_fwd (HSIF 日度), ffill 低頻數據
    fa = factor.reindex(target_fwd.index).ffill().dropna()
    sig = signal.reindex(target_fwd.index).ffill().fillna(False).astype(bool)
    common = fa.index.intersection(target_fwd.dropna().index)
    fa = fa.reindex(common)
    sig = sig.reindex(common).fillna(False)
    res = []
    res.append(("G1 數據生命力", g1_data_vitality(fa, name)))
    res.append(("G2 訊號活動", g2_signal_activity(sig, name)))
    if expected_dir != 0:
        res.append(("G3 符號合理性", g3_sign_sanity(fa, target_fwd.reindex(common), expected_dir, name)))
    res.append(("G4 子期穩定(vs目標)", g4_subperiod_stability(fa, target_fwd.reindex(common), name=name)))
    n_fail = sum(1 for _,(s,_) in res if s=="FAIL")
    n_warn = sum(1 for _,(s,_) in res if s=="WARN")
    for g,(s,m) in res:
        print(f"  {'✅' if s=='PASS' else '⚠️ ' if s=='WARN' else '❌'} {g}: {m}")
    verdict = "PASS" if n_fail==0 else "FAIL"
    print(f"  → {verdict} ({n_fail} FAIL, {n_warn} WARN)")
    return verdict, n_fail, n_warn


