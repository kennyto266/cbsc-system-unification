def vwap_revert(close, df, vwap_p=10, z_w=60, z_t=1.5):
    typical = (df['high'].astype(float) + df['low'].astype(float) + close) / 3
    vol = df['volume'].astype(float)
    vwap = (typical * vol).rolling(vwap_p).sum() / vol.rolling(vwap_p).sum().replace(0, np.nan)
    div = (close - vwap) / vwap
    z = (div - div.rolling(z_w).mean()) / div.rolling(z_w).std().replace(0, np.nan)
    return (z < -z_t).shift(1).fillna(False)

