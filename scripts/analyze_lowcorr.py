def capture_alpha_returns(close_full, alpha_id, stock):
    """攔截 portfolio daily returns for correlation 計算."""
    prices = pd.DataFrame({stock: close_full})
    func = KOL_REGISTRY[alpha_id][2]
    orig_bs = kol.backtest_signals
    cap = {"pf": None}
    def spy(close, entries, exits, se=None, sx=None):
        pf = orig_bs(close, entries, exits, se, sx)
        if pf is not None: cap["pf"] = pf
        return pf
    try:
        import common as _cm; _cm_o = _cm.backtest_signals; _cm.backtest_signals = spy
    except: _cm_o = None
    kol.backtest_signals = spy
    try: m = func(prices, stock)
    except: m = None
    finally:
        kol.backtest_signals = orig_bs
        if _cm_o is not None: _cm.backtest_signals = _cm_o
    if m is None or cap["pf"] is None: return None
    try:
        r = cap["pf"].returns()
        r = r.iloc[:,0] if isinstance(r, pd.DataFrame) else r
        if getattr(r.index, 'tz', None) is not None: r.index = r.index.tz_localize(None)
        return r.rename(stock)
    except: return None

def capture_crossasset_returns(close_full, file, col, logic, sma, z_win, th, holding, stock):
    """跑 cross-asset factor signal, 攔截 returns."""
    factor = _load_factor_series(file, col)
    if factor is None: return None
    common = factor.index.intersection(close_full.index)
    if len(common) < 200: return None
    fc = factor.reindex(common).ffill()
    cl = close_full.reindex(common)
    params = {"sma": sma} if logic in ("regime","trend") else {"z_win": z_win, "th": th}
    sig = make_signals(fc, logic, **params)
    if sig is None: return None
    # build entries/exits inline + run backtest capturing pf
    entry, exit_c = sig
    ec = entry.reindex(common).fillna(False).values
    xc = exit_c.reindex(common).fillna(False).values
    n = len(fc); entries = np.zeros(n, dtype=bool); exits = np.zeros(n, dtype=bool)
    for i in range(n-1):
        if ec[i]:
            ei = min(i+1+holding, n-1)
            for j in range(i+2, ei):
                if j<n and xc[j]: ei=j; break
            entries[i+1]=True; exits[ei]=True
    if not entries.any(): return None
    pf = kol.backtest_signals(cl, pd.Series(entries,index=common), pd.Series(exits,index=common), None, None)
    if pf is None or pf.trades.count()==0: return None
    try:
        r = pf.returns()
        r = r.iloc[:,0] if isinstance(r, pd.DataFrame) else r
        if getattr(r.index,'tz',None) is not None: r.index = r.index.tz_localize(None)
        return r.rename(stock)
    except: return None

def main():
    stocks = sorted(FACTOR_STOCKS)[:30]
    print("="*70)
