    REAL = [27, 74, 131, 132, 136, 137, 139, 140]
    existing_rets = {}  # alpha_id -> combined return (avg across stocks)
    for aid in REAL:
        rets = []
        for s in stocks:
            c = load_stock_close(s)
            if c is None or len(c)<400: continue
            r = capture_alpha_returns(c, aid, s)
            if r is not None and len(r)>=30: rets.append(r)
        if rets:
            existing_rets[aid] = pd.concat(rets, axis=1).mean(axis=1)
            print(f"   A{aid}: {len(rets)} 股", flush=True)

    # 2. 收集 cross-asset candidate returns (用 scan 最佳 config)
    print("\n2️⃣ 收集 cross-asset candidate returns...", flush=True)
    ca_rets = {}
    for file, col, tag, logic in CROSS_ASSET:
        rets = []
        sma = 70 if logic in ("regime","trend") else 60
        for s in stocks:
            c = load_stock_close(s)
            if c is None or len(c)<400: continue
            r = capture_crossasset_returns(c, file, col, logic, sma, 60, 1.5, 10, s)
            if r is not None and len(r)>=30: rets.append(r)
        if rets:
            ca_rets[tag] = pd.concat(rets, axis=1).mean(axis=1)
            print(f"   {tag}: {len(rets)} 股", flush=True)

    # 3. Correlation matrix (existing + cross-asset)
    print("\n3️⃣ Full correlation matrix...", flush=True)
    all_rets = {}
    for aid in REAL: all_rets[f"A{aid}"] = existing_rets.get(aid)
    for tag in ca_rets: all_rets[tag] = ca_rets[tag]
    df = pd.DataFrame(all_rets)
    corr = df.corr()
    print(corr.round(2).to_string())
    # 現有 8 之間 avg corr
    real_cols = [f"A{a}" for a in REAL if f"A{a}" in corr.columns]
    existing_avg = corr.loc[real_cols, real_cols].where(~np.eye(len(real_cols),dtype=bool)).stack().mean()
    print(f"\n現有 8 alpha 之間 avg corr: {existing_avg:.2f}")
    # cross-asset vs existing avg
    print(f"\nCross-asset vs 現有 alpha avg corr:")
    for tag in ca_rets:
        if tag in corr.columns:
            v = corr.loc[tag, real_cols].mean()
            verdict = "🟢低相關(加入有益)" if v < 0.4 else ("🟡中" if v < 0.6 else "🔴高(同質)")
            print(f"  {tag:12s}: {v:.2f} → {verdict}")

    corr.to_csv(OUT / "full_alpha_correlation_matrix.csv")
    print(f"\nCorrelation: {OUT / 'full_alpha_correlation_matrix.csv'}")

if __name__ == "__main__":
    main()
