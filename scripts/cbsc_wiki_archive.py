def _fm(extra: dict) -> str:
    d = {**extra}
    lines = ["---"]
    for k, v in d.items():
        if isinstance(v, list):
            lines.append(f"{k}: [{', '.join(str(x) for x in v)}]")
        elif isinstance(v, str) and (" " in v or '"' in v):
            lines.append(f'{k}: "{v}"')
        else:
            lines.append(f"{k}: {v}")
    lines.append("---")
    return "\n".join(lines)


def write(path: Path, fm: dict, body: str):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(_fm(fm) + "\n\n" + body.strip() + "\n", encoding="utf-8")


