def skills_pages():
    """掃三個來源嘅 SKILL.md → wiki/skills/."""
    n = 0
    sources = [
        ("zcode-agents", ROOT / ".agents" / "skills"),
        ("claude-user", Path(r"C:/Users/Penguin8n/.claude/skills")),
    ]
    # hermes CBSC 相關 skills
    hermes = Path(r"C:/Users/Penguin8n/AppData/Local/hermes/skills")
    cbsc_names = ["alpha-discovery-loop", "alpha-thesis-thinker", "futu-data-backfill",
                  "hk-stock-data-scraping", "multi-agent-alpha-graph", "quant-alpha-validation",
                  "alpha-discovery-looper", "futuapi", "install-futu-opend", "quant-trading",
                  "research"]
    seen = set()
    for src_name, base in sources:
        if not base.exists():
            continue
        for d in sorted(base.iterdir()):
            sk = d / "SKILL.md"
            if not sk.exists() or d.name in seen:
                continue
            seen.add(d.name)
            raw = sk.read_text(encoding="utf-8", errors="replace")[:4000]
            m = re.search(r"description:\s*>?-\s*\n?\s*([^#]{10,300})", raw)
            desc = (m.group(1).strip() if m else "")[:280]
            body = f"# skill: {d.name}\n\n**來源**: {src_name}\n\n**描述**: {desc}\n\n**用途場合**: 睇 SKILL.md 原檔\n\n<details><summary>SKILL.md 原文 (頭 3500 字)</summary>\n\n```markdown\n{raw[:3500]}\n```\n\n</details>\n\n← [[index]]"
            write(WIKI / "skills" / f"{d.name}.md",
                  {**FM_SKILL, 'title': d.name, 'tags': ["skill", src_name], 'source': src_name}, body)
            n += 1
    # hermes cbsc skills
    for nm in cbsc_names:
        hit = None
        for sub in hermes.rglob(nm):
            if (sub / "SKILL.md").exists():
                hit = sub / "SKILL.md"
                break
        if hit and nm not in seen:
            seen.add(nm)
            raw = hit.read_text(encoding="utf-8", errors="replace")[:4000]
            m = re.search(r"description:\s*>?-\s*\n?\s*([^#]{10,300})", raw)
            desc = (m.group(1).strip() if m else "")[:280]
            body = f"# skill: {nm}\n\n**來源**: hermes (CBSC 專用)\n\n**描述**: {desc}\n\n<details><summary>SKILL.md 原文 (頭 3500 字)</summary>\n\n```markdown\n{raw[:3500]}\n```\n\n</details>\n\n← [[index]]"
            write(WIKI / "skills" / f"{nm}.md",
                  {**FM_SKILL, 'title': nm, 'tags': ["skill", "hermes-cbsc"], 'source': "hermes"}, body)
            n += 1
    return n


