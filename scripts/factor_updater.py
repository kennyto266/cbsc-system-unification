def _hkma_get_with_retry(endpoint, params, max_retries=3, timeout=45):
    """對 HKMA API 做 GET，針對暫時性錯誤（timeout / 5xx）做指數退避重試。

    HKMA API 間中會 502 Bad Gateway 或 ReadTimeout（server 端問題），
    等幾秒再試通常就恢復。4xx（參數錯）唔重試。
    回傳 (response, error_msg)；成功時 error_msg=None。
    """
    wait = 1.0
    for attempt in range(max_retries + 1):
        try:
            r = requests.get(endpoint, params=params, timeout=timeout)
            # 5xx = server 端問題，值得重試
            if 500 <= r.status_code < 600:
                if attempt < max_retries:
                    print(f"      ↻ HKMA HTTP {r.status_code}, {wait:.0f}s 後重試 ({attempt+1}/{max_retries})")
                    time.sleep(wait)
                    wait *= 2
                    continue
                return None, f"HTTP {r.status_code}（重試 {max_retries} 次後仍失敗）"
            return r, None
        except requests.exceptions.Timeout:
            if attempt < max_retries:
                print(f"      ↜ HKMA timeout, {wait:.0f}s 後重試 ({attempt+1}/{max_retries})")
                time.sleep(wait)
                wait *= 2
                continue
            return None, f"timeout（重試 {max_retries} 次後仍超時）"
        except requests.exceptions.RequestException as e:
            return None, str(e)
    return None, "未知錯誤"


def update_hkma(name, endpoint, filepath, date_col, rename):
    """用 HKMA API 更新 factor. 增量 fetch + 合併（含重試）."""
    try:
        # 讀現有最後日期
        last_date = None
        if filepath.exists():
            old = pd.read_csv(filepath, nrows=5)
            dc = next((c for c in old.columns if c.lower() in ("date", "end_of_day", "datetime")), old.columns[0])
            full = pd.read_csv(filepath, usecols=[dc])
            dates = pd.to_datetime(full[dc], errors="coerce").dropna()
            if len(dates) > 0:
                last_date = dates.max()

        # fetch from last_date (增量)
        from_date = last_date.strftime("%Y-%m-%d") if last_date else "2002-01-01"
        all_records = []
        offset = 0
        while True:
            # HKMA API: choose 要配 from+till, 唔用 choose 就用 from+pagesize
            params = {"pagesize": 1000, "offset": offset,
                      "from": from_date}
            r, err = _hkma_get_with_retry(endpoint, params, max_retries=3, timeout=45)
            if err is not None:
                print(f"  ❌ {name}: {err}")
                return False
            if r.status_code != 200:
                print(f"  ❌ {name}: HTTP {r.status_code} {r.text[:80]}")
                return False
            result = r.json().get("result", {})
            records = result.get("records", [])
            if not records:
                break
            all_records.extend(records)
            if len(records) < 1000:
                break
            offset += 1000
            time.sleep(0.3)  # rate limit

        if not all_records:
            print(f"  ⚠️ {name}: HKMA API 冇新數據")
            return False

        new_df = pd.DataFrame(all_records)
        # rename date column
        if rename:
            new_df = new_df.rename(columns=rename)

        # 合併舊數據
        if filepath.exists():
            old_df = pd.read_csv(filepath)
            # 對齊欄位: 只保留舊 CSV 有嘅欄位 + 新數據
            common_cols = [c for c in old_df.columns if c in new_df.columns]
            if common_cols:
                combined = pd.concat([old_df, new_df[common_cols]], ignore_index=True)
            else:
                combined = pd.concat([old_df, new_df], ignore_index=True)
            dc = next((c for c in combined.columns if c.lower() in ("date", "end_of_day")), combined.columns[0])
            combined[dc] = pd.to_datetime(combined[dc], errors="coerce")
            combined = combined.drop_duplicates(subset=dc, keep="last").sort_values(dc)
        else:
            dc = next((c for c in new_df.columns if c.lower() in ("date", "end_of_day")), new_df.columns[0])
            new_df[dc] = pd.to_datetime(new_df[dc], errors="coerce")
            combined = new_df.drop_duplicates(subset=dc).sort_values(dc)

        # 格式化日期欄
        combined[dc] = combined[dc].dt.strftime("%Y-%m-%d")
        combined.to_csv(filepath, index=False)
        latest = combined[dc].iloc[-1]
        print(f"  ✅ {name}: {len(combined)} 行, 最新={latest}")
        return True
    except Exception as e:
        print(f"  ❌ {name}: {e}")
        return False


