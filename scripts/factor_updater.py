def update_yfinance(name, ticker, filepath):
    """用 yfinance 更新 cross-asset factor. 格式: date,close,return."""
    import yfinance as yf
    try:
        # 讀現有最後日期
        last_date = None
        if filepath.exists():
            old = pd.read_csv(filepath, usecols=[0])
            old_dates = pd.to_datetime(old.iloc[:, 0], errors="coerce").dropna()
            if len(old_dates) > 0:
                last_date = old_dates.max()

        # fetch (由最後日期起, 冇就 5 年)
        start = (last_date + timedelta(days=1)) if last_date else (datetime.now() - timedelta(days=365*5))
        # guard: 如果 start 已經係未來 (即已經係最新), skip
        if start.date() > datetime.now().date():
            print(f"  ✅ {name}: 已係最新 ({last_date.date()})")
            return True
        t = yf.Ticker(ticker)
        hist = t.history(start=start.strftime("%Y-%m-%d"))
        if hist is None or len(hist) == 0:
            print(f"  ⚠️ {name}: yfinance 冇新數據")
            return False

        # 格式化: date,close,return
        new_df = pd.DataFrame({
            "date": hist.index.strftime("%Y-%m-%d"),
            "close": hist["Close"].values,
            "return": hist["Close"].pct_change().values,
        })
        new_df["date"] = pd.to_datetime(new_df["date"])

        # 合併舊數據 (去重)
        if filepath.exists():
            old_df = pd.read_csv(filepath)
            old_df["date"] = pd.to_datetime(old_df["date"], errors="coerce")
            combined = pd.concat([old_df, new_df], ignore_index=True)
            combined = combined.drop_duplicates(subset="date", keep="last").sort_values("date")
        else:
            combined = new_df.sort_values("date")

        # Outlier guard: 拒絕單日 >30% 變動 (yfinance 數據污染防護)
        combined_sorted = combined.sort_values("date")
        combined_close = pd.to_numeric(combined_sorted["close"], errors="coerce")
        day_chg = combined_close.pct_change().abs()
        bad_mask = day_chg > 0.30
        if bad_mask.any():
            n_bad = bad_mask.sum()
            bad_dates = combined_sorted.loc[bad_mask[bad_mask].index, "date"].tolist()
            print(f"  ⚠️ {name}: 拒絕 {n_bad} 個異常值 (>30% 單日變動), 日期: {bad_dates}")
            combined = combined_sorted.loc[~bad_mask.values].copy()
        else:
            combined = combined_sorted

        # 重新計算 return (確保連續性)
        combined["close"] = pd.to_numeric(combined["close"], errors="coerce")
        combined["return"] = combined["close"].pct_change()

        combined["date"] = pd.to_datetime(combined["date"]).dt.strftime("%Y-%m-%d")
        combined.to_csv(filepath, index=False)
        latest = combined["date"].iloc[-1]
        print(f"  ✅ {name}: {len(combined)} 行, 最新={latest}")
        return True
    except Exception as e:
        print(f"  ❌ {name}: {e}")
        return False


