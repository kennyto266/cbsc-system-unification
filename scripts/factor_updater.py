def update_hsif():
    """Update hsif_combined.csv from Futu OpenD (HSI futures main contract).

    Requires Futu OpenD running on localhost:11111.
    Falls back gracefully if OpenD not available.
    """
    try:
        from futu import OpenQuoteContext
        qctx = OpenQuoteContext(host='127.0.0.1', port=11111)
        try:
            # Fetch last 30 days of HSI futures main contract
            from datetime import datetime as _dt
            start = (_dt.now() - timedelta(days=30)).strftime("%Y-%m-%d")
            end = _dt.now().strftime("%Y-%m-%d")
            ret, df, _ = qctx.request_history_kline('HK.HSImain',
                                                     start=start, end=end, max_count=100)
        finally:
            qctx.close()
        if ret != 0 or df is None or len(df) == 0:
            print("  ⚠️ hsif: Futu returned no data (OpenD running?)")
            return False
        out = FACT_DIR / "hsif_combined.csv"
        new = df[['time_key', 'close']].copy()
        new['time_key'] = pd.to_datetime(new['time_key'])
        new = new.set_index('time_key')
        new.index.name = 'date'
        if out.exists():
            existing = pd.read_csv(out, index_col='date', parse_dates=True)
            combined = pd.concat([existing, new[~new.index.isin(existing.index)]])
            combined = combined[~combined.index.duplicated(keep='last')].sort_index()
        else:
            combined = new.sort_index()
        combined.to_csv(out)
        print(f"  ✅ hsif_combined: {len(combined)} rows, last={combined.index[-1].date()} close={combined.iloc[-1]['close']:.0f}")
        return True
    except ImportError:
        print("  ⚠️ hsif: futu package not installed, skip")
        return False
    except Exception as e:
        print(f"  ❌ hsif: {e}")
        return False


