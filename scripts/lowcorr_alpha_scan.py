def _load_factor_series(file, col):
    df = pd.read_csv(FACT_DIR / file)
    dc = next((c for c in df.columns if c.lower() in ("date","end_of_day","datetime","time","time_key")), df.columns[0])
    df[dc] = pd.to_datetime(df[dc], errors="coerce")
    df = df.dropna(subset=[dc, col]).sort_values(dc).drop_duplicates(subset=dc, keep="last")
    s = pd.Series(df[col].astype(float).values, index=df[dc].values, name=col)
    if getattr(s.index, 'tz', None) is not None:
        s.index = s.index.tz_localize(None)
    return s


def _load_ohlcv_col(stock, col):
    """讀 ohlcv_5y 既指定 column (volume/turnover/pe_ratio)."""
    code = stock.replace(".", "_")
    p = FACT_DIR.parent / "ohlcv_5y" / f"{code}.csv"
    if not p.exists():
        return None
    try:
        df = pd.read_csv(p, parse_dates=["time_key"]).set_index("time_key").sort_index()
        if col not in df.columns:
            return None
        s = df[col].astype(float)
        if getattr(s.index, 'tz', None) is not None:
            s.index = s.index.tz_localize(None)
        return s
    except Exception:
        return None


def _run_signal(close_stock, factor, entry, exit_c, holding=7):
    common = factor.index.intersection(close_stock.index)
    if len(common) < 200:
        return None
    fc = factor.reindex(common).ffill().fillna(0)
    cl = close_stock.reindex(common)
    ec = entry.reindex(common).fillna(False).values
    xc = exit_c.reindex(common).fillna(False).values
    n = len(fc)
    entries = np.zeros(n, dtype=bool)
    exits = np.zeros(n, dtype=bool)
    for i in range(n - 1):
        if ec[i]:
            ei = min(i + 1 + holding, n - 1)
            for j in range(i + 2, ei):
                if j < n and xc[j]: ei = j; break
            entries[i + 1] = True; exits[ei] = True
    if not entries.any():
        return None
    pf = kol.backtest_signals(cl, pd.Series(entries, index=common),
                              pd.Series(exits, index=common), None, None)
    if pf is None or pf.trades.count() == 0:
        return None
    try:
        s = pf.sharpe_ratio()
        return float(s) if not np.isnan(s) else 0.0
    except Exception:
        return 0.0


def make_signals(factor, logic, **kw):
    f = factor.dropna()
    if len(f) < 200: return None
    if logic == "regime":
        sma = kw.get("sma", 70)
        fa = f.rolling(sma).mean()
        return f > fa, f < fa
    elif logic == "trend":
        sma = kw.get("sma", 50)
        fa = f.rolling(sma).mean()
        return ((f > fa) & (f.shift(1) <= fa.shift(1)),
                (f < fa) & (f.shift(1) >= fa.shift(1)))
    elif logic == "z_reversal":
        z_win = kw.get("z_win", 60)
        z = (f - f.rolling(z_win).mean()) / f.rolling(z_win).std()
        return z > kw.get("th", 2.0), z < 0
    elif logic == "z_follow":  # z-score 順勢 (不同於 reversal)
        z_win = kw.get("z_win", 60)
        z = (f - f.rolling(z_win).mean()) / f.rolling(z_win).std()
        return z < -kw.get("th", 1.5), z > 0  # factor 極低 → 做多 (順勢)
    return None


# 異質 factor 候選 (非 currency regime): cross-asset + ohlcv valuation/liquidity
def get_candidates():
    cands = []
    # A) cross-asset commodity/index (不同 asset class)
    for f, col, meaning in [
        ("gold.csv", "close", "Gold price"),
        ("copper.csv", "close", "Copper price"),
        ("vix.csv", "close", "VIX"),
        ("sp500.csv", "close", "SP500"),
        ("btcd.csv", "close", "BTCDominance"),
        ("usdcnh.csv", "close", "USDCNH"),
        ("a_shares.csv", "close", "A-shares index"),
        ("mstr_btc.csv", "close", "MSTR/BTC"),
    ]:
        cands.append(("factor", f, col, meaning))
    # B) ohlcv valuation/liquidity (per-stock, 非 macro)
    for col, meaning in [("pe_ratio", "PE ratio"), ("volume", "Volume"), ("turnover", "Turnover")]:
        cands.append(("ohlcv", col, col, meaning))
    return cands


CONFIGS = [
    ("regime", {"sma": 70}, 10),
    ("regime", {"sma": 120}, 14),
    ("z_reversal", {"z_win": 60, "th": 1.5}, 7),
    ("z_follow", {"z_win": 60, "th": 1.5}, 7),
    ("trend", {"sma": 50}, 7),
]


def main():
    stocks = sorted(FACTOR_STOCKS)[:40]
    cands = get_candidates()
    print("=" * 70)
    print("🔬 低相關 Alpha 掃描 (異質數據源)")
    print(f"  候選: {len(cands)} (cross-asset + ohlcv valuation/liquidity)")
    print(f"  股票: {len(stocks)} 隻  IS<{SPLIT}  OOS>={SPLIT}")
    print(f"  目標: OOS>0.3 + corr<0.4 vs 現有 alpha")
    print("=" * 70, flush=True)

    stock_data = {}
    for s in stocks:
        c = load_stock_close(s)
        if c is None or len(c) < 400: continue
        stock_data[s] = {"is": c[c.index < SPLIT], "oos": c[c.index >= SPLIT]}
    print(f"有數據: {len(stock_data)} 隻\n", flush=True)

    all_rows = []
    for ci, (ctype, file_or_col, col, meaning) in enumerate(cands):
        # load factor (global for factor type, per-stock for ohlcv)
        cnt = 0
        for s, parts in stock_data.items():
            if ctype == "factor":
                try:
                    factor = _load_factor_series(file_or_col, col)
                except Exception:
                    continue
                if factor is None or len(factor) < 200: continue
            else:  # ohlcv per-stock
                factor = _load_ohlcv_col(s, col)
                if factor is None or len(factor) < 200: continue
            factor_is = factor[factor.index < SPLIT]
            factor_oos = factor[factor.index >= SPLIT]
            # IS: 試 configs 揀 best
            best = None
            for logic, params, holding in CONFIGS:
                sig = make_signals(factor_is, logic, **params)
                if sig is None: continue
                sh = _run_signal(parts["is"], factor_is, sig[0], sig[1], holding=holding)
                if sh is not None and (best is None or sh > best["sh"]):
                    best = {"logic": logic, "params": params, "holding": holding, "sh": sh}
            if best is None or best["sh"] < 0.3: continue
            # OOS frozen
            sig_oos = make_signals(factor_oos, best["logic"], **best["params"])
            sh_oos = _run_signal(parts["oos"], factor_oos, sig_oos[0], sig_oos[1], holding=best["holding"])
            sh_oos = sh_oos if sh_oos is not None else -99.0
            all_rows.append({"factor": col, "type": ctype, "meaning": meaning, "stock": s,
                             "logic": best["logic"], "params": str(best["params"]),
                             "is_sharpe": best["sh"], "oos_sharpe": sh_oos})
            if sh_oos > 0.3: cnt += 1
        print(f"  [{ci+1}/{len(cands)}] {col} ({meaning}): {cnt} 股 OOS>0.3", flush=True)

    df = pd.DataFrame(all_rows)
    if len(df) == 0:
        print("\n❌ 無結果"); return
    OUT.mkdir(parents=True, exist_ok=True)
    df.to_csv(OUT / "lowcorr_alpha_scan.csv", index=False)

    print(f"\n{'='*70}\n📊 低相關 Alpha 掃描結果\n{'='*70}")
    passed = df[df["oos_sharpe"] > 0.3].sort_values("oos_sharpe", ascending=False)
    print(f"\n✅ OOS 通過 (>0.3): {len(passed)}")
    if len(passed) > 0:
        print(passed[["factor","stock","logic","is_sharpe","oos_sharpe"]].head(20).to_string(index=False))
    print(f"\n=== Per-factor 勝率 + OOS median ===")
    for fcol in df["factor"].unique():
        sub = df[df["factor"]==fcol]
        wr = (sub["oos_sharpe"]>0.3).mean()*100
        print(f"  {fcol:14s}: {wr:5.1f}% pass  OOS med={sub['oos_sharpe'].median():.2f}  (n={len(sub)})")
    print(f"\n報告: {OUT / 'lowcorr_alpha_scan.csv'}")


if __name__ == "__main__":
    main()
