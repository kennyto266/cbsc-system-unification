REM  確保 cp950 排程環境也能正確輸出 emoji / Unicode。
REM ============================================================

set PYTHONUTF8=1
set PYTHONIOENCODING=utf-8

"C:\Python313\pythonw.exe" "C:\Users\Penguin8n\ZCodeProject\cbsc-system-unification\scripts\daily_scheduler.py" --run-now
