def to_yf_code(code: str) -> str:
    """HK.00001 -> 0001.HK (yfinance 4位格式)."""
    n = int(code.replace("HK.", ""))
    return f"{n:04d}.HK"


def fetch_yfin(code: str, start: str = "2021-06-20", end: str = "2026-06-20"):
    """yfinance 拉日 K. 回標準 DataFrame 或 None."""
    import yfinance as yf
    yc = to_yf_code(code)
    try:
        df = yf.download(yc, start=start, end=end, auto_adjust=True,
                         multi_level_index=False, progress=False)
        if df is None or len(df) == 0:
            return None
        df.columns = [c.lower() for c in df.columns]
        df = df[["open", "high", "low", "close", "volume"]].astype(float)
        df.index.name = "time_key"
        return df.reset_index()
    except Exception:
        return None


def fetch_futu(code: str, start: str = "2021-06-20", end: str = "2026-06-20", timeout_sec=30):
    """Futu fallback (子進程 + 硬 timeout)."""
    import socket, subprocess
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(4)
    try:
        sock.connect(("127.0.0.1", 11111)); sock.close()
    except Exception:
        return None
    script = (
        "import sys,pandas as pd\n"
        "from futu import OpenQuoteContext\n"
        "q=OpenQuoteContext(host='127.0.0.1',port=11111)\n"
        "try:\n"
        f"    ret,df,_=q.request_history_kline({code!r},start={start!r},end={end!r},"
        f"ktype='KL_DAY',autype='AUTYPE_FORWARD',max_count=100000)\n"
        "    if ret!=0 or df is None or len(df)==0: sys.exit(1)\n"
        "    out=df[['time_key','open','high','low','close','volume']].astype(float)\n"
        "    out['turnover']=float('nan'); out['pe_ratio']=float('nan')  # T6DF262: NaN=冇採集, 唔扮 0.0\n"
        "    out.to_csv(sys.stdout,index=False)\n"
        "finally:\n"
        "    q.close()\n"
    )
    try:
        proc = subprocess.run([sys.executable, "-c", script],
                              capture_output=True, text=True, timeout=timeout_sec)
        if proc.returncode != 0 or not proc.stdout.strip():
            return None
        return pd.read_csv(StringIO(proc.stdout))
    except Exception:
        return None


def save_stock(code: str, name: str, start: str, end: str, verbose=True):
    """拉一隻 + 存 CSV. 回 (rows, src)."""
    # 先試 yfinance
    df = fetch_yfin(code, start, end)
    src = "yfinance"
    if df is None or len(df) == 0:
        df = fetch_futu(code, start, end)
        src = "futu"
    if df is None or len(df) == 0:
        if verbose:
            print(f"  ❌ {code} {name}: 拎唔到")
        return 0, "fail"

    # 補齊欄位 (yfinance 冇 turnover/pe_ratio) — T6DF262: NaN=冇採集 單一語義
    if "turnover" not in df.columns:
        df["turnover"] = float("nan")
    if "pe_ratio" not in df.columns:
        df["pe_ratio"] = float("nan")

    # [09-14 T2A807E G69048] basis provenance 欄 — 「實際復權方案」由口講變機讀:
    # 呢行用邊條取數路, basis 就係邊個常數; 以後混源/換源即刻現形, audit 對住驗
    df["basis"] = BASIS_YF if src == "yfinance" else BASIS_FUTU

    # [09-14 T6DF262 G69048] OHLC 一致性閘 — O/C 越出 [low,high] 或 high<low 嘅行唔入 store
    # (futu AUTYPE_FORWARD 喺無成交日帶另一復權基準嘅 O/C, 334/393 檔實錘; NaN 比較=False 唔誤殺;
    #  1e-9 相對容差 — yf 源頭有 close==high 差 1e-13 級浮點噪聲, 唔係真越區)
    _eps = 1e-9
    bad = ((df["close"] < df["low"] * (1 - _eps)) | (df["close"] > df["high"] * (1 + _eps))
           | (df["open"] < df["low"] * (1 - _eps)) | (df["open"] > df["high"] * (1 + _eps))
           | (df["high"] < df["low"] * (1 - _eps)))
    n_bad = int(bad.sum())
    if n_bad:
        df = df[~bad]
        print(f"  ⚠️ {code} dropped {n_bad} 行越區")

    # [09-30 G31135] blocklist 壞行剔除 — str[:10] 正常化 datetime/str 兩款
    # time_key (yf reset_index 出 datetime64, futu 路 str)
    drop_dates = OHLCV_DROP_ROWS.get(code)
    if drop_dates:
        m = df["time_key"].astype(str).str[:10].isin(drop_dates)
        n_glitch = int(m.sum())
        if n_glitch:
            df = df[~m]
            print(f"  🧹 {code} dropped {n_glitch} 行 G31135 blocklist 壞行")

    out_path = OHLCV_DIR / f"{code.replace('.', '_')}.csv"
    df.to_csv(out_path, index=False)
    if verbose:
        rng = f"{pd.to_datetime(df['time_key']).min().date()} ~ {pd.to_datetime(df['time_key']).max().date()}"
        print(f"  ✅ {code} {name}: {len(df)} 行 ({src}) [{rng}]")
    return len(df), src


