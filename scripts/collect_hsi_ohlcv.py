    parser.add_argument("--stocks", help="指定股票 (逗號分隔, e.g. HK.01299,HK.02318)")
    args = parser.parse_args()

    print("=" * 70)
    print("📥 收集恆生指數成份股 5年 OHLCV")
    print(f"   期間: {args.start} ~ {args.end}")
    print("=" * 70)

    # 決定目標股票
    if args.stocks:
        codes = [c.strip() for c in args.stocks.split(",")]
        targets = {c: HSI_CONSTITUENTS.get(c, c) for c in codes}
    elif args.update_only:
        existing = [f.stem.replace("HK_", "HK.") for f in OHLCV_DIR.glob("HK_*.csv")]
        targets = {c: HSI_CONSTITUENTS.get(c, c) for c in existing}
        print(f"🔄 只更新現有 {len(targets)} 隻\n")
    else:
        targets = HSI_CONSTITUENTS
        print(f"📊 收集全部 {len(targets)} 隻成份股\n")

    ok, fail, total_rows = 0, 0, 0
    src_count = {}
    for i, (code, name) in enumerate(sorted(targets.items()), 1):
        print(f"[{i}/{len(targets)}] {code} {name}")
        rows, src = save_stock(code, name, args.start, args.end)
        if rows > 0:
            ok += 1; total_rows += rows
            src_count[src] = src_count.get(src, 0) + 1
        else:
            fail += 1
        time.sleep(0.3)  # 避免 yfinance rate limit

    print("\n" + "=" * 70)
    print(f"✅ 完成: 成功 {ok} 隻, 失敗 {fail} 隻, 總 {total_rows:,} 行")
    print(f"   數據源: {src_count}")
    print(f"   輸出: {OHLCV_DIR}/")
    print("=" * 70)


