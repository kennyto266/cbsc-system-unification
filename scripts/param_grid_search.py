def _eval_combo(args):
    """Worker: 評估一個 (alpha_id, param_dict) 組合喺所有股票嘅平均 SR."""
    aid, params = args
    name, kol_name, func, dtype = KOL_REGISTRY.get(aid, ("?", "?", None, "?"))
    if func is None:
        return None
    srs = []
    for stock in FACTOR_STOCKS[:30]:  # 用頭 30 股快速評估
        try:
            close = load_stock_close(stock)
            if close is None:
                continue
            prices = pd.DataFrame({stock: close})
            m = func(prices, stock, **params) if params else func(prices, stock)
            if m and m.get("sharpe") is not None:
                srs.append(m["sharpe"])
        except Exception:
            pass
    if not srs:
        return {"aid": aid, "params": params, "mean_sr": -99, "n_positive": 0, "n_total": 0}
    mean_sr = float(np.mean(srs))
    n_pos = sum(1 for s in srs if s > 0)
    return {"aid": aid, "params": params, "mean_sr": round(mean_sr, 3),
            "n_positive": n_pos, "n_total": len(srs),
            "pos_pct": round(n_pos / len(srs), 2)}


def main():
    print("=" * 65)
    print("🔧 參數網格搜索 (28 alpha × 多組合)")
    print("=" * 65)

    # 構建所有測試組合
    all_combos = []
    for aid, cfg in GRID_CONFIG.items():
        if cfg["param"]:
            # threshold × holding 組合
            for t in cfg["grid"]:
                for h in cfg["holding_grid"]:
                    all_combos.append((aid, {cfg["param"]: t, "holding": h}))
        else:
            # 只變 holding
            for h in cfg["holding_grid"]:
                all_combos.append((aid, {"holding": h}))

    print(f"總共 {len(all_combos)} 個參數組合 × 30 股 = {len(all_combos)*30} backtests")
    print(f"用 {min(cpu_count(), 32)} workers 並行...\n")

    results = []
    with Pool(min(cpu_count(), 32)) as pool:
        for i, r in enumerate(pool.imap_unordered(_eval_combo, all_combos, chunksize=4)):
            if r:
                results.append(r)
            if (i + 1) % 20 == 0:
                print(f"  [{i+1}/{len(all_combos)}]", flush=True)

    # 按 alpha 分組,搵最佳參數
    df = pd.DataFrame(results)
    print(f"\n{'='*65}")
    print("📊 網格搜索結果 (每個 alpha 嘅最佳參數)")
    print(f"{'='*65}")
    print(f"{'ID':<5} {'name':<22} {'best SR':>8} {'pos%':>6} {'n':>4} {'best params'}")
    print("-" * 80)

    best_params = {}
    for aid, cfg in GRID_CONFIG.items():
        grp = df[df["aid"] == aid]
        if grp.empty:
            continue
        name = KOL_REGISTRY[aid][0][:22]
        # 揾最高 SR 且 pos_pct > 0.25
        valid = grp[grp["pos_pct"] >= 0.25]
        if valid.empty:
            valid = grp  # fallback: 用最高 SR
        best = valid.loc[valid["mean_sr"].idxmax()]
        best_params[aid] = best["params"]
        p_str = str(best["params"])
        print(f"{aid:<5} {name:<22} {best['mean_sr']:>8.2f} {best['pos_pct']:>6.0%} "
              f"{best['n_total']:>4} {p_str[:40]}")

    # 存結果
    out = Path(r"C:\Users\Penguin8n\ZCodeProject\cbsc-system-unification\data\vbt_factor_reports\param_grid_results.csv")
    df.to_csv(out, index=False)
    print(f"\n💾 結果存到: {out}")

    # 輸出最佳參數 (俾下一個步驟用)
    print(f"\n{'='*65}")
    print("🔧 最佳參數 (用於更新 kol_alpha_strategies.py)")
    print(f"{'='*65}")
    for aid, params in sorted(best_params.items()):
        print(f"  A{aid}: {params}")


if __name__ == "__main__":
    main()
