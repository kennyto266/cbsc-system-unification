def _noop_metrics(stock):
    """返回空 metrics (數據唔夠長時)."""
    return {"strategy": "noop", "stock": stock, "sharpe": 0, "n_trades": 0}


# ============================================================
# S1: Dispersion Regime (vol regime switch) — OOS SR 2.22
# 邏輯: 高波動 regime (20d vol > 252d median × 1.3) → 買跌 (mean revert)
#       低波動 regime → 買升 (momentum continue)
# ============================================================
def final10_s1(prices, stock):
    """FINAL10-S1 Dispersion Regime — OOS SR 2.22.

    高波動環境用均值回歸 (跌深買入), 低波動環境用動量 (升勢追入).
    Entry: (high_vol & mz < -1) | (~high_vol & mz > 1)
    Exit:  (high_vol & mz > 0) | (~high_vol & mz < 0)
    """
    close = prices[stock]
    if len(close) < 352:
        return _noop_metrics(stock)

    ret = close.pct_change()
    vol = ret.rolling(20).std()
    vol_med = vol.rolling(252).median()
    high_vol = vol > vol_med * 1.3

    mom = close.pct_change(20)
    mz = (mom - mom.rolling(252).mean()) / mom.rolling(252).std()

    entries = ((high_vol & (mz < -1)) | (~high_vol & (mz > 1))).shift(1).fillna(False)
    exits = ((high_vol & (mz > 0)) | (~high_vol & (mz < 0))).shift(1).fillna(False)

    pf = backtest_signals(close, entries, exits, fees=USER_FEE, init_cash=100000)
    return extract_metrics(pf, "FINAL10-S1 Dispersion Regime", stock) if pf else None


# ============================================================
# S2: A-Shares Dip → HK Bounce (cross-market) — OOS SR 2.21
# 邏輯: A股 120d z-score < -2.0 (深度跌) → 買入港股 (A股跌港股跟 → 反彈先於A股)
# ============================================================

# 預加載 A-shares factor (一次性, 唔使每次 scan 都 load)
_ASHARES_FACTOR = None
_ASHARES_LOADED_AT = 0.0  # timestamp of last load
_ASHARES_TTL = 21600.0       # 6 hours (seconds) — 24/7 runtime refresh


def _load_ashares():
    """懶加載 A-shares factor data (TTL 6小時自動刷新)."""
    global _ASHARES_FACTOR, _ASHARES_LOADED_AT
    import time as _time
    now = _time.time()
    if _ASHARES_FACTOR is not None and (now - _ASHARES_LOADED_AT) < _ASHARES_TTL:
        return _ASHARES_FACTOR
    try:
        from vbt_data import load_factor_close
        _ASHARES_FACTOR = load_factor_close("a_shares")
        _ASHARES_LOADED_AT = now
    except Exception:
        _ASHARES_FACTOR = False  # 標記加載失敗
    return _ASHARES_FACTOR


def final10_s2(prices, stock):
    """FINAL10-S2 A-Shares Dip — OOS SR 2.21.

    A股 120d z-score < -2.0 (深度調整) → 買入港股.
    A股反彈至 z > -0.5 → 平倉.
    Cross-market lead-lag: A股跌港股跟, 但港股反彈先於A股.
    """
    factor = _load_ashares()
    if factor is None or factor is False:
        return _noop_metrics(stock)

    close = prices[stock]
    if len(close) < 220:
        return _noop_metrics(stock)

    f = factor.reindex(close.index).ffill().dropna()
    if len(f) < 170:
        return _noop_metrics(stock)

    fz = (f - f.rolling(120).mean()) / f.rolling(120).std()

    # [f10s2align 10-22] fz 由 factor reindex+dropna 而嚟, 長度可以短過 close
    # (A股假期頭段 ffill 無源 + factor 尾日 lag) — 唔 reindex 返 close.index 就
    # vbt broadcast 炸 shape mismatch, 被 backtest_signals 吞例外靜靜返 None。
    entries = (fz < -2.5).shift(1).reindex(close.index).fillna(False)
    exits = (fz > -0.1).shift(1).reindex(close.index).fillna(False)

    pf = backtest_signals(close, entries, exits, fees=USER_FEE, init_cash=100000)
    return extract_metrics(pf, "FINAL10-S2 A-Shares Dip", stock) if pf else None


# ============================================================
# S7: Crash Bounce 60d (reversal) — OOS SR 1.24
# 邏輯: 5日回報 60d z-score < -3.0 (極端暴跌) → 買入 (恐慌拋售超賣反彈)
# ============================================================
def final10_s7(prices, stock):
    """FINAL10-S7 Crash Bounce 60d — OOS SR 1.24.

    5日回報喺過去60日出現極端暴跌 (z < -3.0) → 恐慌超賣反彈.
    z 回升至 > -0.5 → 恐慌消散, 平倉.
    """
    close = prices[stock]
    if len(close) < 160:
        return _noop_metrics(stock)

    r5 = close.pct_change(5)
    z = (r5 - r5.rolling(60).mean()) / r5.rolling(60).std()

    entries = (z < -3.0).shift(1).fillna(False)
    exits = (z > -0.5).shift(1).fillna(False)

    pf = backtest_signals(close, entries, exits, fees=USER_FEE, init_cash=100000)
    return extract_metrics(pf, "FINAL10-S7 Crash Bounce", stock) if pf else None


# ============================================================
# S8: DD Bounce (drawdown bounce reversal) — OOS SR 1.09
# 邏輯: 120d 最大回撤 < -25% 且 3日動量 > 0 (開始反彈) → 買入
# ============================================================
def final10_s8(prices, stock):
    """FINAL10-S8 DD Bounce — OOS SR 1.09.

    120日最大回撤 < -35% + 3日動量轉正 → 深跌反彈訊號.
    回撤回升至 > -5% → 平倉.
    """
    close = prices[stock]
    if len(close) < 220:
        return _noop_metrics(stock)

    cm = close.rolling(120, min_periods=20).max()
    dd = (close - cm) / cm
    m3 = close.pct_change(3)

    entries = ((dd < -0.35) & (m3 > 0)).shift(1).fillna(False)
    exits = (dd > -0.05).shift(1).fillna(False)

    pf = backtest_signals(close, entries, exits, fees=USER_FEE, init_cash=100000)
    return extract_metrics(pf, "FINAL10-S8 DD Bounce", stock) if pf else None


# ============================================================
# S9: Range Expansion (volatility reversal)
# 邏輯: 5日波動率 > 10日均值 × 2.5 且 5日回報 < 0 (恐慌擴張) → 買入
# FIX 2026-07: 出場改用固定持倉期 20 日 (原本 rp<ar 波動率回歸出場太早,
#   forward-return 分析顯示 5-20 日後 reversal 先完全實現; 原出場 OOS SR=-0.54,
#   改 hold-20 後 OOS SR=+0.65 across 3 split dates). BEAR regime gate 經測試
#   無效 (OOS 期本身處牛市, gate 只加摩擦), 不採用.
# ============================================================
def final10_s9(prices, stock, multiplier=2.5, hold_days=20):
    """FINAL10-S9 Range Expansion.

    5日波動率突然擴大 (> 10日均值 × multiplier) + 5日回報為負 → 恐慌性拋售,
    持倉 hold_days 日後平倉 (不再用 rp<ar 波動率回歸出場).
    """
    close = prices[stock]
    if len(close) < 110:
        return _noop_metrics(stock)

    ret = close.pct_change()
    rp = ret.rolling(5).std()
    ar = rp.rolling(10).mean()
    exp = rp > ar * multiplier

    m = close.pct_change(5)

    raw_entries = (exp & (m < 0)).shift(1).fillna(False)

    # 固定持倉期出場: 由 entry 往後數 hold_days 日
    n = len(close)
    pos = np.zeros(n, dtype=bool)
    holding = False
    days_in = 0
    e = raw_entries.values
    for i in range(n):
        if not holding and e[i]:
            holding = True
            days_in = 0
            pos[i] = True
        elif holding:
            days_in += 1
            if days_in >= hold_days:
                holding = False
            else:
                pos[i] = True
    pos_s = pd.Series(pos, index=close.index)
    entries = pos_s & ~pos_s.shift(1).fillna(False)
    exits = ~pos_s & pos_s.shift(1).fillna(False)

    pf = backtest_signals(close, entries, exits, fees=USER_FEE, init_cash=100000)
    return extract_metrics(pf, "FINAL10-S9 Range Expansion", stock) if pf else None


# ============================================================
# S10: Turn-of-Month (calendar effect) — OOS SR 0.21 (弱但低相關)
# 邏輯: 月初前3日 / 月末後3日 → 持倉, 其餘時間空倉
# ============================================================
def final10_s10(prices, stock):
    """FINAL10-S10 Turn-of-Month — OOS SR 0.21.

    月初效應: day <= 3 或 day >= 27 持倉, day 4-26 空倉.
    SR 低但同其他策略相關性極低 (多維分散價值).
    """
    close = prices[stock]
    if len(close) < 60:
        return _noop_metrics(stock)

    idx = close.index
    dom = idx.day
    sig = pd.Series((dom <= 3) | (dom >= 27), index=idx)

    entries = sig.shift(1).fillna(False)
    exits = (~sig).shift(1).fillna(False)

    pf = backtest_signals(close, entries, exits, fees=USER_FEE, init_cash=100000)
    return extract_metrics(pf, "FINAL10-S10 Turn-of-Month", stock) if pf else None


