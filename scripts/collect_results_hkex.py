"""collect_results_hkex.py — T-pead: HKEX 業績公布日 collector (公告 metadata, 唔使 PDF).

數據源: 披露易 titleSearchServlet (同 buyback collector 同一路徑, 已驗證)
  title="RESULTS" + stockId 過濾 → 業績公告 DATE_TIME = 公布日
  (年度/中期/季度業績全包; 冇 PDF 下載, 快好多)

輸出: data/new_sources/results_calendar_raw.csv
  (doc_date, stock_code, news_id, title, pdf_url)
"""
import csv
import json
import re
import time
import urllib.request
from datetime import datetime
from pathlib import Path

BASE = Path(__file__).resolve().parent.parent
OUT_DIR = BASE / "data" / "new_sources"
OUT_DIR.mkdir(parents=True, exist_ok=True)
RAW = OUT_DIR / "results_calendar_raw.csv"
CKPT = OUT_DIR / "results_calendar_ckpt.json"

CODES = ['00001','00002','00003','00005','00006','00012','00016','00017','00020','00027',
'00066','00101','00175','00241','00268','00285','00291','00386','00388','00688','00700','00762',
'00823','00883','00939','00941','00992','01024','01038','01088','01109','01211','01299','01398',
'01801','01810','01876','01928','02013','02269','02318','02388','02628','02899','03690','06862',
'09618','09888','09988','09992','09999']

YEARS = ["2021", "2022", "2023", "2024", "2025", "2026"]
SEARCH = ("https://www1.hkexnews.hk/search/titleSearchServlet.do?sortDir=0&sortByOptions=DateTime"
          "&category=0&market=SEHK&stockId={sid}&documentType=-1&fromDate={f}&toDate={t}"
          "&title=Results&searchType=1&t1code=-2&t2Gcode=-2&t2code=-2"
          "&rowRange=1000&lang=en")

HDRS = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)", "Referer": "https://www1.hkexnews.hk/",
        "Connection": "close"}

log = lambda *a: print(datetime.now().strftime("%H:%M:%S"), *a, flush=True)


def fetch(url, binary=False, tries=3):
    for i in range(tries):
        try:
            req = urllib.request.Request(url, headers=HDRS)
            with urllib.request.urlopen(req, timeout=30) as r:
                b = r.read()
            return b if binary else b.decode("utf-8", "replace")
        except Exception:
            if i == tries - 1:
                raise
            time.sleep(3)


def get_stock_id(code):
    txt = fetch(f"https://www1.hkexnews.hk/search/prefix.do?callback=cb&lang=ZH&type=A&name={code}&market=SEHK")
    m = re.search(r'"stockId":(\d+),"code":"' + code + '"', txt)
    return int(m.group(1)) if m else None


# 業績公告 pattern — 揀真業績, 排除 "results of EGM", "poll results" 等
RESULTS_RE = re.compile(
    r"(ANNUAL RESULTS|INTERIM RESULTS|RESULTS ANNOUNCEMENT|QUARTERLY RESULTS|"
    r"RESULTS OF OPERATIONS|ANNUAL REPORT|INTERIM REPORT|"
    r"UNAUDITED RESULTS|RESULTS FOR THE (?:SIX MONTHS|YEAR|THIRD YEAR|NINE MONTHS)|"
    r"FINAL RESULTS|RESULTS OF THE (?:GROUP|COMPANY))", re.I)
EXCLUDE_RE = re.compile(r"(EGM|GENERAL MEETING|POLL|SCRUTINEER|BUY-BACK.*RESULT|"
                        r"RESULTS OF THE (?:RESOLUTION|MEETING)|PLACING|ENTITLEMENT|ALLOTMENT)", re.I)


def is_results_ann(title: str) -> bool:
    t = (title or "").upper()
    return bool(RESULTS_RE.search(t)) and not EXCLUDE_RE.search(t)


def load_ckpt():
    if CKPT.exists():
        d = json.loads(CKPT.read_text())
        d["news_seen"] = set(d.get("news_seen", []))
        return d
    return {"done_codes": {}, "news_seen": set()}


def save_ckpt(ck):
    CKPT.write_text(json.dumps({"done_codes": ck["done_codes"], "news_seen": sorted(ck["news_seen"])}))


def append_rows(fp, rows):
    new = not fp.exists()
    with open(fp, "a", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=["doc_date", "stock_code", "news_id", "title", "pdf_url"])
        if new:
            w.writeheader()
        for r in rows:
            w.writerow(r)


def main():
    ck = load_ckpt()
    buf = []
    # [09-25 小升級] done code 唔係永久跳過 — 重掃尾窗兩年追新公告
    # (業績季: 年度2-3月/中期7-8月/季度10-11月, 跨年重掃前一年冇窿);
    # news_seen 去重所以重掃冇成本, sid 由 ckpt 讀慳一個 prefix 查詢。
    # 未 done 嘅 code 照舊行全史 YEARS (首跑 backfill 語義不變)。
    trailing = [str(datetime.now().year - 1), str(datetime.now().year)]
    for code in CODES:
        if code in ck["done_codes"]:
            sid = ck["done_codes"][code]
            years = trailing
        else:
            sid = get_stock_id(code)
            if sid is None:
                log("no stockId", code)
                continue
            years = YEARS
        n = 0
        for year in years:
            try:
                j = json.loads(fetch(SEARCH.format(sid=sid, f=year + "0101", t=year + "1231")))
                rows = json.loads(j["result"])
            except Exception as e:
                log("search fail", code, year, e)
                time.sleep(5)
                continue
            for r in rows:
                nid = r["NEWS_ID"]
                if nid in ck["news_seen"]:
                    continue
                title = (r.get("TITLE") or "").replace("\n", " ")
                if not is_results_ann(title):
                    ck["news_seen"].add(nid)
                    continue
                buf.append({
                    "doc_date": r["DATE_TIME"], "stock_code": code, "news_id": nid,
                    "title": title[:180], "pdf_url": r.get("FILE_LINK", ""),
                })
                ck["news_seen"].add(nid)
                n += 1
            time.sleep(0.5)
        append_rows(RAW, buf)
        buf = []
        ck["done_codes"][code] = sid
        save_ckpt(ck)
        log(f"done {code}: results={n} seen={len(ck['news_seen'])}")
    log("ALL DONE")


if __name__ == "__main__":
    main()
