    ret = (1 + combo).cumprod().iloc[-1] - 1
    dd = ((1 + combo).cumprod() / (1 + combo).cumprod().cummax() - 1).min()
    tag = '🏆' if sr > 1.7 else '🟢' if sr > 1.0 else '✨'
    print(f'  {tag} {name}: SR={sr:+.2f} ret={ret:+.1%} DD={dd:.1%}')

# Walk-forward for equal 4-way
print('\n=== Walk-Forward (equal 4-way) ===')
combo_all = sum(df_all[c] * 0.25 for c in df_all.columns)
for year in range(2019, 2027):
    yr = combo_all[combo_all.index.year == year].dropna()
    if len(yr) < 20:
        continue
    sr = yr.mean() / yr.std() * np.sqrt(252) if yr.std() > 0 else 0
    ret = (1 + yr).cumprod().iloc[-1] - 1
    tag = '✅' if sr > 0.5 else '⚠️' if sr > 0 else '❌'
    print(f'  {year}: SR={sr:+.2f} ret={ret:+.1%} {tag}')
