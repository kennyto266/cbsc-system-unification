def a162(close, df):
    vix_a = vix.reindex(close.index).ffill()
    z = (vix_a - vix_a.rolling(90).mean()) / vix_a.rolling(90).std().replace(0, np.nan)
    return (z > 2.0).shift(1).fillna(False)


