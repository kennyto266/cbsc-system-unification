@router.get("/catalog")
async def data_catalog():
    """數據目錄 — 顯示 Parquet 存儲中已有嘅數據。"""
    catalog = {}
    for category in ["market_data", "alternative_data", "fundamental"]:
        for freq in ["daily", "1min", "5min", "15min", "30min", "60min"]:
            symbols = store.list_symbols(category, freq)
            if symbols:
                key = f"{category}/{freq}"
                catalog[key] = {
                    "symbols": symbols,
                    "count": len(symbols),
                }

    return {
        "success": True,
        "data": catalog,
        "total_datasets": sum(v["count"] for v in catalog.values()),
        "timestamp": datetime.now().isoformat(),
    }


@router.get("/info/{symbol}")
async def data_info(symbol: str, freq: str = Query("daily")):
    """取得某 symbol 嘅數據資訊（範圍、行數、欄位）。"""
    code = _normalize_code(symbol)
    freq_map = {"daily": "daily", "1min": "1min", "5min": "5min",
                "15min": "15min", "30min": "30min", "60min": "60min"}
    store_freq = freq_map.get(freq, freq)

    info = store.get_info("market_data", code, store_freq)
    return {
        "success": True,
        "data": info,
        "timestamp": datetime.now().isoformat(),
    }


# ============================================================
# 批次抓取（背景任務）
# ============================================================

@router.post("/fetch/batch")
async def fetch_batch(
    background_tasks: BackgroundTasks,
    index: str = Query("HSI", description="HSI/HSCEI"),
    days: int = Query(250, ge=1, le=1000),
    limit: int = Query(20, ge=1, le=100, description="最多幾多隻"),
):
    """批次抓取成分股 OHLCV 並存入 Parquet（背景任務）。"""
    try:
        futu = _get_futu()
        stocks = futu.get_constituents(index)[:limit]
        codes = [s["code"] for s in stocks]

        # 背景執行
        background_tasks.add_task(_batch_fetch_task, codes, days)

        return {
            "success": True,
            "message": f"開始批次抓取 {len(codes)} 隻股票",
            "symbols": codes,
            "status": "running_in_background",
            "timestamp": datetime.now().isoformat(),
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"批次抓取啟動失敗: {e}")


def _batch_fetch_task(codes: List[str], days: int):
    """背景任務：批次抓取 + 存儲。"""
    logger.info("開始批次抓取 {} 隻股票".format(len(codes)))
    try:
        futu = _get_futu()
        results = futu.fetch_and_store_batch(codes, days=days)
        success = sum(1 for r in results.values() if r.get("success"))
        logger.info("批次抓取完成: {}/{} 成功".format(success, len(codes)))
    except Exception as e:
        logger.error("批次抓取失敗: {}".format(e))


