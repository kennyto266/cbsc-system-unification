from pathlib import Path
from typing import List, Optional

from fastapi import APIRouter, HTTPException, Query, BackgroundTasks

logger = logging.getLogger(__name__)
router = APIRouter(tags=["統一數據層"])

# 確保可以 import unified 模組
ROOT = Path(__file__).parent.parent.parent  # cbsc-system-unification/
sys.path.insert(0, str(ROOT / "src"))
sys.path = [p for p in sys.path if "CODEX" not in p]

from data.unified import (
    FutuAdapter, CCASSFetcher, IntradayFetcher, store, IncrementalUpdater
)

# 全域 adapter 實例（延遲初始化）
_futu_adapter = None
_ccass_fetcher = None
_intraday_fetcher = None


def _get_futu():
    global _futu_adapter
    if _futu_adapter is None:
        _futu_adapter = FutuAdapter()
    return _futu_adapter


def _get_ccass():
    global _ccass_fetcher
    if _ccass_fetcher is None:
        _ccass_fetcher = CCASSFetcher()
    return _ccass_fetcher


def _get_intraday():
    global _intraday_fetcher
    if _intraday_fetcher is None:
        _intraday_fetcher = IntradayFetcher()
    return _intraday_fetcher


def _normalize_code(symbol: str) -> str:
    """正規化股票代碼為 HK.XXXXX 格式。"""
    s = symbol.strip().upper()
    if s.startswith("HK."):
        return s
    if s.endswith(".HK"):
        s = s[:-3]
    try:
        num = int(s)
        return f"HK.{num:05d}"
    except ValueError:
        return s if "." in s else f"HK.{s}"


