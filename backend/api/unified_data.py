# ============================================================
# OHLCV（完整歷史數據）
# ============================================================

@router.get("/ohlcv/{symbol}")
async def get_ohlcv(
    symbol: str,
    days: int = Query(250, ge=1, le=1000),
    freq: str = Query("1d", description="1d/5m/15m/30m/60m/1m"),
):
    """取得完整 OHLCV 歷史數據（含 volume/turnover/pe_ratio）。

    解決之前只有 close 嘅問題。
    先查 Parquet cache，冇就從富途攞。
    """
    code = _normalize_code(symbol)
    freq_map = {"1d": "daily", "1m": "1min", "5m": "5min",
                "15m": "15min", "30m": "30m", "60m": "60min"}
    store_freq = freq_map.get(freq, "daily")

    # 先查 Parquet cache
    cached = store.load("market_data", code, store_freq)
    if cached is not None and not cached.empty:
        # 檢查是否最新
        last_date = cached["date"].max()
        days_old = (datetime.now() - last_date.to_pydatetime()).days
        if days_old <= 3:  # 3 日內視為最新
            return {
                "success": True,
                "source": "parquet_cache",
                "data": cached.tail(days).to_dict("records"),
                "count": len(cached.tail(days)),
                "last_update": str(last_date.date()),
                "timestamp": datetime.now().isoformat(),
            }

    # 從富途攞
    try:
        futu = _get_futu()
        df = futu.get_ohlcv(code, days=days, freq=freq)
        if df.empty:
            raise HTTPException(status_code=404, detail=f"無法取得 {code} 嘅 OHLCV 數據")

        # 存入 Parquet
        futu.fetch_and_store(code, days=days, freq=freq)

        records = df.to_dict("records")
        # 清理 NaN
        for r in records:
            for k, v in r.items():
                if hasattr(v, "isoformat"):
                    r[k] = v.isoformat()
                elif v != v:  # NaN
                    r[k] = None

        return {
            "success": True,
            "source": "futu_api",
            "data": records,
            "count": len(records),
            "columns": list(df.columns),
            "timestamp": datetime.now().isoformat(),
        }
    except HTTPException:
        raise
    except Exception as e:
        logger.exception("get_ohlcv error")
        raise HTTPException(status_code=500, detail=f"OHLCV 查詢失敗: {e}")


