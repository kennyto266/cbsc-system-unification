"""
策略 + 分析 + 監控 API Router

提供 dashboard 其他頁面需要嘅數據：
- /api/strategies/list — hkptrc 19 個策略回測結果
- /api/analytics/correlation — 恆指相關性矩陣 + pair trade 排名
- /api/monitoring/risk — 動態相關性 + 系統性風險警報
"""
import os
import csv
import json
import logging
from datetime import datetime
from pathlib import Path

import pandas as pd
from fastapi import APIRouter, HTTPException, Query

logger = logging.getLogger(__name__)
router = APIRouter(tags=["策略分析監控"])

ROOT = Path(__file__).parent.parent.parent  # cbsc-system-unification/
HKPTRC_DIR = ROOT / "data" / "hkptrc_backtests"
PAIR_DIR = ROOT / "data" / "pair_trade_vbt"


@router.get("/strategies/list")
async def list_strategies():
    """hkptrc 19 個策略回測結果。"""
    path = HKPTRC_DIR / "all_strategies_complete.csv"
    if not path.exists():
        raise HTTPException(status_code=404, detail="無策略回測數據。請先運行 hkptrc_strategies")

    df = pd.read_csv(path)
    df = df.replace([float("inf"), float("-inf")], float("nan"))

    # 按策略匯總
    summary = []
    for strat, grp in df.groupby("strategy"):
        clean = grp.dropna(subset=["sharpe"])
        if clean.empty:
            continue
        summary.append({
            "strategy": strat,
            "sharpe_median": round(float(clean["sharpe"].median()), 3),
            "ann_return_median": round(float(clean["annual_return_pct"].median()), 1),
            "max_dd_mean": round(float(clean["max_drawdown_pct"].mean()), 1),
            "n_stocks": len(clean),
            "n_positive": int((clean["sharpe"] > 0).sum()),
            "best_stock": str(clean.loc[clean["sharpe"].idxmax(), "stock"]) if not clean.empty else "",
            "best_sharpe": round(float(clean["sharpe"].max()), 3),
        })

    summary.sort(key=lambda x: x["sharpe_median"], reverse=True)

    return {
        "success": True,
        "data": {
            "strategies": summary,
            "total": len(summary),
        },
        "timestamp": datetime.now().isoformat(),
    }


@router.get("/analytics/correlation")
async def correlation_analysis(
    limit: int = Query(20, ge=5, le=100, description="Top N pairs"),
):
    """恆指相關性矩陣 + pair trade 排名。"""
    # Pair trade 排名
    pairs_path = PAIR_DIR / "vbt_pair_trade_results.csv"
    pairs = []
    if pairs_path.exists():
        df = pd.read_csv(pairs_path)
        df = df.replace([float("inf"), float("-inf")], float("nan"))
        df = df.dropna(subset=["sharpe"])
        for _, row in df.head(limit).iterrows():
            pairs.append({
                "pair": f"{row.get('code_a','')} - {row.get('code_b','')}",
                "correlation": round(float(row.get("correlation", 0)), 3),
                "sharpe": round(float(row.get("sharpe", 0)), 3),
                "annual_return": round(float(row.get("annual_return_pct", 0)), 1),
                "max_drawdown": round(float(row.get("max_drawdown_pct", 0)), 1),
                "win_rate": round(float(row.get("win_rate_pct", 0)), 0),
                "beat_bh": bool(row.get("beat_bh", False)),
            })

    # 相關性矩陣概覽
    matrix_path = PAIR_DIR / "correlation_all_pairs.csv"
    matrix_stats = {"total_pairs": 0, "high_corr": 0, "avg_corr": 0}
    if matrix_path.exists():
        mdf = pd.read_csv(matrix_path)
        matrix_stats["total_pairs"] = len(mdf)
        matrix_stats["high_corr"] = int((mdf["correlation"] >= 0.6).sum())
        matrix_stats["avg_corr"] = round(float(mdf["correlation"].mean()), 3)

    return {
        "success": True,
        "data": {
            "top_pairs": pairs,
            "matrix_stats": matrix_stats,
        },
        "timestamp": datetime.now().isoformat(),
    }


@router.get("/monitoring/risk")
async def risk_monitoring():
    """動態相關性 + 系統性風險警報。"""
    # 動態相關性信號
    dyn_path = PAIR_DIR / "dynamic_correlation.json"
    risk_data = {
        "systemic_risk": {"level": "NORMAL", "market_corr": 0},
        "signals": [],
        "alerts": [],
    }

    if dyn_path.exists():
        with open(dyn_path, "r", encoding="utf-8") as f:
            dyn = json.load(f)

        sr = dyn.get("systemic_risk", {})
        risk_data["systemic_risk"] = {
            "level": sr.get("risk_level", "NORMAL"),
            "market_corr": sr.get("market_corr_latest", 0),
            "market_corr_median": sr.get("market_corr_median", 0),
            "interpretation": sr.get("interpretation", ""),
        }

        # 信號
        for sig in dyn.get("signals", [])[:10]:
            risk_data["signals"].append({
                "pair": f"{sig.get('code_a','')} - {sig.get('code_b','')}",
                "z_score": sig.get("z_score"),
                "rolling_corr": sig.get("rolling_corr_now"),
                "risk_level": sig.get("risk_level"),
            })

        # 警報
        for sig in dyn.get("signals", []):
            if sig.get("risk_level") in ("DANGER", "WARNING", "SIGNAL"):
                risk_data["alerts"].append({
                    "pair": f"{sig.get('code_a','')} - {sig.get('code_b','')}",
                    "level": sig.get("risk_level"),
                    "z_score": sig.get("z_score"),
                })

    return {
        "success": True,
        "data": risk_data,
        "timestamp": datetime.now().isoformat(),
    }
