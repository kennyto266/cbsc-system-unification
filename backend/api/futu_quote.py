# API 路由
# ============================================================

@router.get("/health")
async def futu_health():
    """檢查富途 OpenD 連線狀態。"""
    ctx = _get_quote_ctx()
    return {
        "success": True,
        "data": {
            "connected": ctx is not None,
            "host": FUTU_HOST,
            "port": FUTU_PORT,
        },
        "timestamp": datetime.now().isoformat(),
    }


@router.get("/quote/{symbol}")
async def get_realtime_quote(symbol: str):
    """取得個股實時報價快照（無需訂閱，即查即有）。

    富途 LV2 實時數據，比 yfinance 延遲數據更準確。
    """
    import futu
    ctx = _require_ctx()
    code = _normalize_code(symbol)
    try:
        ret, data = ctx.get_market_snapshot([code])
        if ret != futu.RET_OK:
            raise HTTPException(status_code=502, detail=f"富途查詢失敗: {data}")
        if data is None or data.empty:
            raise HTTPException(status_code=404, detail=f"找不到股票 {code}")

        row = data.iloc[0]
        last_price = _safe(row.get("last_price"))
        prev_close = _safe(row.get("prev_close_price"))
        change = (last_price - prev_close) if (last_price and prev_close) else None
        change_pct = (change / prev_close * 100) if (change is not None and prev_close) else None

        quote = {
            "symbol": symbol,
            "code": code,
            "name": row.get("name", ""),
            "last_price": last_price,
            "open_price": _safe(row.get("open_price")),
            "high_price": _safe(row.get("high_price")),
            "low_price": _safe(row.get("low_price")),
            "prev_close": prev_close,
            "change": change,
            "change_percent": change_pct,
            "volume": _safe(row.get("volume"), 0),
            "turnover": _safe(row.get("turnover"), 0),
            "amplitude": _safe(row.get("amplitude")),
            "suspension": bool(row.get("suspension", False)),
            "update_time": str(row.get("update_time", "")),
            "currency": "HKD",
            "lot_size": int(_safe(row.get("lot_size"), 0) or 0),
            "market_cap": _safe(row.get("total_market_val")),
            "pe_ratio": _safe(row.get("pe_ratio")),
            "pe_ttm": _safe(row.get("pe_ttm_ratio")),
            "pb_ratio": _safe(row.get("pb_ratio")),
            "dividend_yield": _safe(row.get("dividend_ratio_ttm")),
            "avg_price": _safe(row.get("avg_price")),
            "bid_ask_ratio": _safe(row.get("bid_ask_ratio")),
            "volume_ratio": _safe(row.get("volume_ratio")),
            "data_source": "futu_opend",
            "fetched_at": datetime.now().isoformat(),
        }
        return {"success": True, "data": quote, "timestamp": datetime.now().isoformat()}
    except HTTPException:
        raise
    except Exception as e:
        logger.exception("get_realtime_quote error")
        raise HTTPException(status_code=500, detail=f"行情查詢失敗: {e}")


@router.get("/quotes")
async def get_batch_quotes(
    symbols: str = Query(..., description="逗號分隔的股票代碼，如 00700,09988,01810"),
):
    """批次取得多隻股票實時報價（富途限制單次最多 400 隻）。"""
    import futu
    ctx = _require_ctx()
    sym_list = [s.strip() for s in symbols.split(",") if s.strip()]
    if not sym_list:
        raise HTTPException(status_code=400, detail="請提供至少一個股票代碼")
    if len(sym_list) > 400:
        raise HTTPException(status_code=400, detail="單次最多 400 隻股票")

    codes = [_normalize_code(s) for s in sym_list]
    try:
        ret, data = ctx.get_market_snapshot(codes)
        if ret != futu.RET_OK:
            raise HTTPException(status_code=502, detail=f"富途批次查詢失敗: {data}")

        quotes = []
        if data is not None and not data.empty:
            for _, row in data.iterrows():
                last_price = _safe(row.get("last_price"))
                prev_close = _safe(row.get("prev_close_price"))
                change = (last_price - prev_close) if (last_price and prev_close) else None
                change_pct = (change / prev_close * 100) if (change is not None and prev_close) else None
                quotes.append({
                    "code": row.get("code", ""),
                    "name": row.get("name", ""),
                    "last_price": last_price,
                    "change": change,
                    "change_percent": change_pct,
                    "volume": _safe(row.get("volume"), 0),
                    "turnover": _safe(row.get("turnover"), 0),
                    "high_price": _safe(row.get("high_price")),
                    "low_price": _safe(row.get("low_price")),
                    "open_price": _safe(row.get("open_price")),
                    "pe_ratio": _safe(row.get("pe_ratio")),
                })
        return {
            "success": True,
            "data": quotes,
            "count": len(quotes),
            "timestamp": datetime.now().isoformat(),
        }
    except HTTPException:
        raise
    except Exception as e:
        logger.exception("get_batch_quotes error")
        raise HTTPException(status_code=500, detail=f"批次行情查詢失敗: {e}")


@router.get("/kline/{symbol}")
async def get_kline(
    symbol: str,
    ktype: str = Query("1d", description="K線類型: 1m,5m,15m,30m,60m,1d,1w,1M"),
    num: int = Query(100, ge=1, le=1000, description="K線數量"),
):
    """取得歷史 K 線數據。"""
    import futu
    ctx = _require_ctx()
    code = _normalize_code(symbol)

    ktype_map = {
        "1m": futu.KLType.K_1M,
        "3m": futu.KLType.K_3M,
        "5m": futu.KLType.K_5M,
        "15m": futu.KLType.K_15M,
        "30m": futu.KLType.K_30M,
        "60m": futu.KLType.K_60M,
        "1d": futu.KLType.K_DAY,
        "1w": futu.KLType.K_WEEK,
        "1M": futu.KLType.K_MON,
    }
    kl = ktype_map.get(ktype)
    if kl is None:
        raise HTTPException(status_code=400, detail=f"不支援的 K 線類型: {ktype}")

    try:
        # request_history_kline 在 SDK 10.7 返回 (ret_code, DataFrame, page_key)
        result = ctx.request_history_kline(code, start=None, end=None, ktype=kl, autype=None, max_count=num)
        if len(result) == 3:
            ret, data, _page_key = result
        else:
            ret, data = result
        if ret != futu.RET_OK:
            # 部分情況用 get_cur_kline
            ret, data = ctx.get_cur_kline(code, num=num, ktype=kl)
            if ret != futu.RET_OK:
                raise HTTPException(status_code=502, detail=f"富途 K 線查詢失敗: {data}")

        klines = []
        if data is not None and not data.empty:
            for _, row in data.iterrows():
                klines.append({
                    "time": str(row.get("time_key", "")),
                    "open": _safe(row.get("open")),
                    "close": _safe(row.get("close")),
                    "high": _safe(row.get("high")),
                    "low": _safe(row.get("low")),
                    "volume": _safe(row.get("volume"), 0),
                    "turnover": _safe(row.get("turnover"), 0),
                    "change_rate": _safe(row.get("change_rate")),
                })
        return {
            "success": True,
            "data": {
                "symbol": symbol,
                "code": code,
                "ktype": ktype,
                "klines": klines,
            },
            "count": len(klines),
            "timestamp": datetime.now().isoformat(),
        }
    except HTTPException:
        raise
    except Exception as e:
        logger.exception("get_kline error")
        raise HTTPException(status_code=500, detail=f"K 線查詢失敗: {e}")


@router.get("/orderbook/{symbol}")
async def get_orderbook(
    symbol: str,
    depth: int = Query(10, ge=1, le=10, description="檔位數 1-10"),
):
    """取得實時買賣盤（擺盤）數據。"""
    import futu
    ctx = _require_ctx()
    code = _normalize_code(symbol)
    try:
        ret, data = ctx.get_order_book(code, num=depth)
        if ret != futu.RET_OK:
            raise HTTPException(status_code=502, detail=f"富途擺盤查詢失敗: {data}")

        # 富途返回格式：Ask/Bid 是 list of [price, volume, order_count]
        asks_raw = data.get("Ask", []) if hasattr(data, "get") else []
        bids_raw = data.get("Bid", []) if hasattr(data, "get") else []

        asks = [{"price": _safe(a[0]), "volume": _safe(a[1], 0), "orders": _safe(a[2], 0)} for a in asks_raw if a]
        bids = [{"price": _safe(b[0]), "volume": _safe(b[1], 0), "orders": _safe(b[2], 0)} for b in bids_raw if b]

        return {
            "success": True,
            "data": {
                "symbol": symbol,
                "code": code,
                "asks": asks,  # 賣盤（高→低）
                "bids": bids,  # 買盤（高→低）
            },
            "timestamp": datetime.now().isoformat(),
        }
    except HTTPException:
        raise
    except Exception as e:
        logger.exception("get_orderbook error")
        raise HTTPException(status_code=500, detail=f"擺盤查詢失敗: {e}")


