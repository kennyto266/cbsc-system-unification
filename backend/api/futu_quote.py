"""
富途 OpenAPI 行情服務 - 提供實時港股報價、K 線、買賣盤

基於 Futu OpenD (port 1130)，行情 API 不受交易加密限制。
個人本地使用，無需認證。

數據來源：富途 OpenD 行情接口（實時、官方、免費 LV2）
替代 yfinance 的港股延遲數據。

Author: CBSC Quantitative Platform
Date: 2026-06-20
"""

import os
import logging
from datetime import datetime
from typing import List, Optional, Dict, Any

from fastapi import APIRouter, HTTPException, Query

logger = logging.getLogger(__name__)
router = APIRouter(tags=["富途實時行情"])

# ============================================================
# Futu SDK 連線（延遲初始化，避免 OpenD 未啟動時整個後端崩潰）
# ============================================================

FUTU_HOST = os.getenv("FUTU_OPEND_HOST", "127.0.0.1")
FUTU_PORT = int(os.getenv("FUTU_OPEND_PORT", "1130"))  # GUI OpenD 預設 API port

_quote_ctx = None
_futu_available = None  # None=未檢測, True/False=檢測結果


def _get_quote_ctx():
    """延遲初始化富途行情上下文，單例。OpenD 未啟動時返回 None。"""
    global _quote_ctx, _futu_available
    if _quote_ctx is not None:
        return _quote_ctx
    if _futu_available is False:
        return None
    try:
        import futu
        _quote_ctx = futu.OpenQuoteContext(host=FUTU_HOST, port=FUTU_PORT)
        _futu_available = True
        logger.info(f"富途行情連線成功 {FUTU_HOST}:{FUTU_PORT} (SDK {futu.__version__})")
        return _quote_ctx
    except Exception as e:
        _futu_available = False
        logger.warning(f"富途行情連線失敗 (OpenD 是否啟動?): {e}")
        return None


def _require_ctx():
    """取得上下文，失敗時拋 503。"""
    ctx = _get_quote_ctx()
    if ctx is None:
        raise HTTPException(
            status_code=503,
            detail="富途 OpenD 未連線。請啟動 FutuOpenD 並確認監聽 127.0.0.1:1130。",
        )
    return ctx


def _normalize_code(symbol: str) -> str:
    """將各種格式統一為富途格式 HK.00700。

    支援輸入：00700, 0700, 700.HK, 00700.HK, HK.00700
    """
    s = symbol.strip().upper()
    if s.startswith("HK."):
        return s
    # 去除 .HK 後綴
    if s.endswith(".HK"):
        s = s[:-3]
    # 補零至 5 位
    try:
        num = int(s)
        return f"HK.{num:05d}"
    except ValueError:
        # 已是 HK.xxxxx 或無法解析，原樣返回
        return s if "." in s else f"HK.{s}"


def _safe(val, default=None):
    """處理富途返回的 NaN/None。"""
    if val is None:
        return default
    try:
        import math
        f = float(val)
        if math.isnan(f) or math.isinf(f):
            return default
        return f
    except (ValueError, TypeError):
        return default


