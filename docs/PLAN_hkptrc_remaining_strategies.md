def strategy_19_mta(intraday_1min, stock):
    # 每小時計算
    intraday['hour'] = intraday.index.hour
    intraday['pct_change'] = intraday['close'].pct_change()
    intraday['abs_change'] = intraday['pct_change'].abs()
    intraday['up_change'] = intraday['pct_change'].where(intraday['pct_change'] > 0, 0)
    
    # Volume Weighted Absolute Up Ratio
    hourly = intraday.groupby('hour').apply(lambda g: 
        (g['up_change'] * g['volume']).sum() / (g['abs_change'] * g['volume']).sum()
    )
    
    # Z-Score, threshold = 2
    hourly_z = compute_zscore(hourly, 250)
    
    # 大 timeframe（1小時）落盤
    if hourly_z[-1] > 2:
        open_long(take_profit=entry + 5*atr, holding_days=2)
```

