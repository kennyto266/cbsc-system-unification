#!/usr/bin/env python3
"""data_guard.py — 中央數據新鮮度把關. Block 過期策略 + 報警支援.

Fail-open 原則: DataGuard 自己出錯唔停交易系統. 只有明確 check 到過期先 block.
"""
import warnings
warnings.filterwarnings("ignore")
import pandas as pd
from pathlib import Path
from datetime import datetime, timedelta

DATA_ROOT = Path(r"C:\Users\Penguin8n\ZCodeProject\cbsc-system-unification\data")
MAX_AGE_DAILY = 3  # 日度 factor 容許最多 3 日 (週末 + 1 日 buffer)


class DataGuard:
    """中央數據新鮮度把關. 檢查 factor CSV 新鮮度, 回報 blocked 策略."""

    # 股票策略 alpha_id → [(相對 DATA_ROOT 嘅路徑, max_age_days)]
    DEPENDENCIES = {
        27:  [],
        74:  [],
        131: [("factors/discount_window.csv", MAX_AGE_DAILY)],
        132: [("factors/er-eeri-daily.csv", MAX_AGE_DAILY)],
        136: [("factors/er-eeri-daily.csv", MAX_AGE_DAILY)],
        137: [("factors/er-eeri-daily.csv", MAX_AGE_DAILY)],
        139: [("factors/er-eeri-daily.csv", MAX_AGE_DAILY)],
        140: [("factors/discount_window.csv", MAX_AGE_DAILY)],
        141: [("factors/copper.csv", MAX_AGE_DAILY)],
        142: [("factors/mstr_btc.csv", MAX_AGE_DAILY)],
        144: [("stock_connect/sc_full.csv", MAX_AGE_DAILY)],
        145: [("factors/gold.csv", MAX_AGE_DAILY)],
        146: [("factors/hkd-fer-daily.csv", MAX_AGE_DAILY)],
    }

    # 期貨訊號 id → 依賴
    FUT_DEPENDENCIES = {
        200: [("factors/a_shares.csv", MAX_AGE_DAILY)],
        201: [],
        202: [("factors/discount_window.csv", MAX_AGE_DAILY)],
    }

    def _get_last_date(self, rel_path):
        """讀 CSV 最後一行日期. 返 date 或 None."""
        p = DATA_ROOT / rel_path
        if not p.exists():
            return None
        try:
            df = pd.read_csv(p, nrows=5)
            dc = None
            for c in df.columns:
                if c.lower() in ("date", "end_of_day", "datetime", "time", "time_key"):
                    dc = c
                    break
            if dc is None:
                dc = df.columns[0]
            # 只讀最後一行 (用 skiprow 慳 memory)
            full = pd.read_csv(p, usecols=[dc])
            last_val = full[dc].iloc[-1]
            return pd.to_datetime(last_val, errors="coerce").date()
        except Exception:
            return None

    def is_fresh(self, alpha_id):
        """檢查某股票策略所有 factor 是否新鮮. 返 True/False.
        Fail-open: 出異常返 True (唔 block)."""
        deps = self.DEPENDENCIES.get(alpha_id, [])
        if not deps:
            return True  # 冇依賴 = 純 ohlcv, 股價層已有 guard
        try:
            for rel_path, max_age in deps:
                last = self._get_last_date(rel_path)
                if last is None:
                    return False  # 文件缺失/讀唔到 = 過期
                age = (datetime.now().date() - last).days
                if age > max_age:
                    return False
            return True
        except Exception:
            return True  # fail-open

    def is_fresh_fut(self, fut_id):
        """檢查某期貨訊號所有 factor 是否新鮮."""
        deps = self.FUT_DEPENDENCIES.get(fut_id, [])
        if not deps:
            return True
        try:
            for rel_path, max_age in deps:
                last = self._get_last_date(rel_path)
                if last is None:
                    return False
                age = (datetime.now().date() - last).days
                if age > max_age:
                    return False
            return True
        except Exception:
            return True

    def blocked_alphas(self):
        """返目前被 block 嘅股票策略 ID set."""
        return {aid for aid in self.DEPENDENCIES if not self.is_fresh(aid)}

    def blocked_futs(self):
        """返目前被 block 嘅期貨訊號 ID set."""
        return {fid for fid in self.FUT_DEPENDENCIES if not self.is_fresh_fut(fid)}

    def preflight(self):
        """開盤前一次性 check 全部. 返 [{id, type, status, detail}] 報告."""
        report = []
        for aid in sorted(self.DEPENDENCIES):
            deps = self.DEPENDENCIES[aid]
            if not deps:
                report.append({"id": aid, "type": "stock", "status": "ok", "detail": "純 ohlcv"})
                continue
            details = []
            fresh = True
            for rel_path, max_age in deps:
                last = self._get_last_date(rel_path)
                if last is None:
                    details.append(f"{Path(rel_path).name} 缺失")
                    fresh = False
                else:
                    age = (datetime.now().date() - last).days
                    if age > max_age:
                        details.append(f"{Path(rel_path).name} 過期 {age}日 (上限{max_age})")
                        fresh = False
                    else:
                        details.append(f"{Path(rel_path).name} {age}日前 OK")
            report.append({
                "id": aid, "type": "stock",
                "status": "ok" if fresh else "blocked",
                "detail": "; ".join(details),
            })
        for fid in sorted(self.FUT_DEPENDENCIES):
            deps = self.FUT_DEPENDENCIES[fid]
            if not deps:
                report.append({"id": fid, "type": "fut", "status": "ok", "detail": "日曆訊號"})
                continue
            details = []
            fresh = True
            for rel_path, max_age in deps:
                last = self._get_last_date(rel_path)
                if last is None:
                    details.append(f"{Path(rel_path).name} 缺失")
                    fresh = False
                else:
                    age = (datetime.now().date() - last).days
                    if age > max_age:
                        details.append(f"{Path(rel_path).name} 過期 {age}日")
                        fresh = False
                    else:
                        details.append(f"{Path(rel_path).name} {age}日前 OK")
            report.append({
                "id": fid, "type": "fut",
                "status": "ok" if fresh else "blocked",
                "detail": "; ".join(details),
            })
        return report


if __name__ == "__main__":
    dg = DataGuard()
    print("=" * 55)
    print("📊 DataGuard 新鮮度自檢")
