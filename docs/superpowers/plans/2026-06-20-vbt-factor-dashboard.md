def build_ema_chart(df, entries, exits, ema_fast, ema_slow, pf, pf_bench, fast, slow, label):
    """EMA tab 圖 — candlestick + EMA + 買賣三角 + 淨值 + 回撤, 3 panel."""
    close = df["close"]
    fig = make_subplots(
        rows=3, cols=1, shared_xaxes=True,
        row_heights=[0.5, 0.3, 0.2], vertical_spacing=0.06,
        subplot_titles=(f"{label} 價格 + EMA{fast}/{slow} + 訊號",
                        "資金曲線 (策略 vs Buy&Hold)", "回撤"),
    )
    fig.add_trace(go.Candlestick(
        x=close.index, open=df["open"], high=df["high"], low=df["low"], close=close,
        name="價格", increasing_line_color="#26a69a", decreasing_line_color="#ef5350",
    ), row=1, col=1)
    fig.add_trace(go.Scatter(x=ema_fast.index, y=ema_fast, name=f"EMA{fast}",
                             line=dict(color="#42a5f5", width=1.2)), row=1, col=1)
