def build_native_dashboard(pf, close, title):
    """vectorbt 官方格式 — pf.plot() 6 subplot (cum_returns/underwater/orders/trade_pnl/cash/gross_exposure)."""
    pf.benchmark_close = close
    fig = pf.plot(
        subplots=[
            "cum_returns",
            "underwater",
            "orders",
            "trade_pnl",
            "cash",
            "gross_exposure",
        ],
        template="plotly_dark",
    )
    fig.update_layout(title=title, title_font_size=15, height=1400, width=1300)
    return fig
