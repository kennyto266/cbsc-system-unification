def fetch_futu(code, start, end, aut="forward", timeout_sec=10):
    """futu-api 取日 K. 子進程 + 硬 timeout, 避免 handshake hang."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(4)
    try:
        sock.connect(("127.0.0.1", 11111))
        sock.close()
    except Exception:
        return None
    script = (
        "import sys,pandas as pd\n"
        "from futu import OpenQuoteContext\n"
        "qctx=OpenQuoteContext(host='127.0.0.1',port=11111)\n"
        "try:\n"
        f"    ret,df,_=qctx.request_history_kline({code!r},start={start!r},end={end!r},"
        f"ktype='KL_DAY',autype={'AUTYPE_FORWARD' if aut=='forward' else 'AUTYPE_NONE'},max_count=100000)\n"
        "    if ret!=0 or df is None or len(df)==0: sys.exit(1)\n"
        "    df['date']=pd.to_datetime(df['time_key'])\n"
        "    df[['date','open','high','low','close','volume']].astype(float).to_csv(sys.stdout,index=False)\n"
        "finally:\n"
        "    qctx.close()\n"
    )
    try:
        proc = subprocess.run([sys.executable, "-c", script],
                              capture_output=True, text=True, timeout=timeout_sec)
        if proc.returncode != 0 or not proc.stdout.strip():
            return None
        df = pd.read_csv(StringIO(proc.stdout))
        df["date"] = pd.to_datetime(df["date"])
        df = df.set_index("date").sort_index()
        return df[["open", "high", "low", "close", "volume"]].astype(float)
    except Exception:
        return None


def fetch_yfin(code, start, end):
    try:
        import yfinance as yf
        df = yf.download(code, start=start, end=end, auto_adjust=True,
                         multi_level_index=False, progress=False)
        if df is None or len(df) == 0:
            return None
        df.columns = [c.lower() for c in df.columns]
        return df[["open", "high", "low", "close", "volume"]].astype(float)
    except Exception:
        return None


def get_stock_ohlcv(futu_code, yfin_code, start, end):
    """futu 優先, fallback yfinance. 帶快取. 回 (df, src) 或 (None, None)."""
    key = (futu_code, start, end)
    if key in CACHE:
        return CACHE[key]
    df = fetch_futu(futu_code, start, end)
    src = "futu"
    if df is None or len(df) == 0:
        df = fetch_yfin(yfin_code, start, end)
        src = "yfinance"
    if df is None or len(df) == 0:
        return None, None
    if df.index.tz is not None:
        df.index = df.index.tz_convert(None)
    CACHE[key] = (df, src)
    return df, src
```

