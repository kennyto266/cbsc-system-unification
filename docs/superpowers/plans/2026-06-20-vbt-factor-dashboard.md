def walk_forward(factor_name, stock_code, params, split=0.7):
    """70% in-sample / 30% out-of-sample. 按時間切, 唔 shuffle."""
    factor = load_factor_close(factor_name)
    stock = load_stock_close(stock_code)
    if factor is None or stock is None:
        return None
    n_days, threshold, holding, direction = (
        params["n_days"], params["threshold"], params["holding"], params.get("direction", "contrarian"))

    common = factor.index.intersection(stock.index)
    cut = int(len(common) * split)
    is_idx, oos_idx = common[:cut], common[cut:]
    if len(is_idx) < n_days + holding + 20 or len(oos_idx) < n_days + holding + 20:
        return None

    def _run(idx):
        sub_factor = factor.reindex(idx)
        sub_stock = stock.reindex(idx)
        e, x, se, sx, close = compute_signals(sub_factor, sub_stock, n_days, threshold, holding, direction)
        if e is None or (not e.any() and not se.any()):
            return None
        pf = vbt.Portfolio.from_signals(
            close=close, entries=e, exits=x, short_entries=se, short_exits=sx,
            fees=TOTAL_COST / 2, slippage=SLIPPAGE, freq="1D", init_cash=INIT_CASH_FACTOR)
        return pf

    is_pf, oos_pf = _run(is_idx), _run(oos_idx)
    if is_pf is None or oos_pf is None:
        return None

    fig = make_subplots(rows=2, cols=1, shared_xaxes=False, vertical_spacing=0.12,
                        subplot_titles=(f"In-Sample (前{int(split*100)}%)", f"Out-of-Sample (後{int((1-split)*100)}%)"))
    for pf, label, color in [(is_pf, "IS 策略", "#00d4ff"), (oos_pf, "OOS 策略", "#00ff88")]:
        v = pf.value()
        fig.add_trace(go.Scatter(x=v.index, y=v.values, name=label,
                                 line=dict(color=color, width=2)), row=1 if pf is is_pf else 2, col=1)
    fig.update_layout(title=f"🔬 Walk-Forward — {factor_name.upper()} → {stock_code}",
                      template="plotly_dark", height=700, width=1200,
                      showlegend=True, legend=dict(orientation="h", y=1.06))

    try:
        is_sharpe = float(is_pf.sharpe_ratio())
        oos_sharpe = float(oos_pf.sharpe_ratio())
    except Exception:
        is_sharpe = oos_sharpe = float("nan")
    return {
        "is_sharpe": is_sharpe, "oos_sharpe": oos_sharpe,
        "is_return": float(is_pf.total_return()) * 100,
        "oos_return": float(oos_pf.total_return()) * 100,
        "is_trades": is_pf.trades.count(), "oos_trades": oos_pf.trades.count(),
        "figure": fig,
    }
```

