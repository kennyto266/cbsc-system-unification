def calc_metrics(pf, pf_bench, close, init_cash=None):
    """計策略 vs B&H 指標. 回 dict {指標: (策略值, B&H值)}."""
    if init_cash is None:
        init_cash = INIT_CASH
    years = (close.index[-1] - close.index[0]).days / 365.25
    try:
        sharpe = pf.sharpe_ratio()
        bench_sharpe = pf_bench.sharpe_ratio()
    except Exception:
        sharpe = bench_sharpe = float("nan")
    try:
        mdd = pf.max_drawdown() * 100
        bench_mdd = pf_bench.max_drawdown() * 100
    except Exception:
        mdd = bench_mdd = float("nan")
    try:
        win_rate = pf.trades.win_rate() * 100
    except Exception:
        win_rate = float("nan")
    try:
        profit_factor = pf.trades.profit_factor()
    except Exception:
        profit_factor = float("nan")
    cagr = ((pf.value().iloc[-1] / init_cash) ** (1.0 / years) - 1) * 100 if years > 0 else 0.0
    bench_cagr = ((pf_bench.value().iloc[-1] / init_cash) ** (1.0 / years) - 1) * 100 if years > 0 else 0.0
    return {
        "總回報 %":     (f"{pf.total_return()*100:+.2f}%",   f"{pf_bench.total_return()*100:+.2f}%"),
        "CAGR %":       (f"{cagr:+.2f}%",                    f"{bench_cagr:+.2f}%"),
        "Sharpe":       (f"{sharpe:.2f}",                    f"{bench_sharpe:.2f}"),
        "最大回撤 %":   (f"{mdd:.2f}%",                      f"{bench_mdd:.2f}%"),
        "交易次數":     (f"{pf.trades.count()}",             "Buy&Hold"),
        "勝率 %":       (f"{win_rate:.1f}%",                 "-"),
        "盈虧比":       (f"{profit_factor:.2f}",             "-"),
        "最終資金 HK$": (f"{pf.value().iloc[-1]:,.0f}",      f"{pf_bench.value().iloc[-1]:,.0f}"),
    }
