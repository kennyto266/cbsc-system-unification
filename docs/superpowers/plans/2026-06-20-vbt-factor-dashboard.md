     Input("ema-slow", "value"), Input("ema-start", "value"), Input("ema-end", "value")])
def update_ema(symbol, fast, slow, start, end):
    if not all([symbol, fast, slow, start, end]):
        return empty_fig("請填齊參數"), "⚠️ 參數不全", "", ""
    if fast >= slow:
        return empty_fig("快線必須細過慢線", "#ef5350"), "⚠️ 快線必須細過慢線", "", ""
    futu_code, yfin_code = SYMBOLS[symbol]
    df, src = get_stock_ohlcv(futu_code, yfin_code, start, end)
    if df is None or len(df) < slow + 5:
        return empty_fig("拎唔到數據 / 數據太少", "#ef5350"), "❌ 拎唔到數據 (試過 futu + yfinance)", "", ""
    pf, pf_bench, entries, exits, ema_fast, ema_slow = run_ema_strategy(df, fast, slow)
    fig = build_ema_chart(df, entries, exits, ema_fast, ema_slow, pf, pf_bench, fast, slow, symbol)
    metrics = calc_metrics(pf, pf_bench, df["close"])
    status = (f"✅ {symbol} EMA{fast}/{slow} | 數據源: {src} | {len(df)} 條日 K "
              f"({df.index[0].date()} ~ {df.index[-1].date()}) | HK${INIT_CASH:,.0f}")
    return fig, status, build_metrics_table(metrics), build_trades_table(pf)
