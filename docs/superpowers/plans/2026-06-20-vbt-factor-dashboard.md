def run_ema_strategy(df, fast, slow):
    """EMA 交叉回測. 回 (pf, pf_bench, entries, exits, ema_fast, ema_slow)."""
    import talib
    close = df["close"].copy()
    ema_fast = pd.Series(talib.EMA(close.values, timeperiod=fast), index=close.index)
    ema_slow = pd.Series(talib.EMA(close.values, timeperiod=slow), index=close.index)
    entries = ema_fast.vbt.crossed_above(ema_slow)
    exits = ema_fast.vbt.crossed_below(ema_slow)

    pf = vbt.Portfolio.from_signals(
        close=close, entries=entries, exits=exits,
        init_cash=INIT_CASH, fees=HK_FEES, slippage=HK_SLIPPAGE,
        size=0.95, size_type="percent", direction="longonly", freq=FREQ,
        min_size=100, size_granularity=100, accumulate=False,
    )
    pf_bench = vbt.Portfolio.from_holding(close, init_cash=INIT_CASH, fees=HK_FEES, freq=FREQ)
    return pf, pf_bench, entries, exits, ema_fast, ema_slow


def run_factor_strategy(factor_name, stock_code, n_days, threshold, holding, direction="contrarian", init_cash=None):
    """因子策略回測. 回 (pf, pf_bench, close) 或 None."""
    if init_cash is None:
        init_cash = INIT_CASH_FACTOR
    factor = load_factor_close(factor_name)
    stock = load_stock_close(stock_code)
    if factor is None or stock is None:
        return None
    e, x, se, sx, close = compute_signals(factor, stock, n_days, threshold, holding, direction)
    if e is None or (not e.any() and not se.any()):
        return None
    pf = vbt.Portfolio.from_signals(
        close=close, entries=e, exits=x,
        short_entries=se, short_exits=sx,
        fees=TOTAL_COST / 2, slippage=SLIPPAGE,
        freq="1D", init_cash=init_cash,
    )
    pf_bench = vbt.Portfolio.from_holding(close, init_cash=init_cash, fees=TOTAL_COST / 2, freq="1D")
    return pf, pf_bench, close
```

