def multi_stock_compare(factor_name, stock_codes, params):
    """同一因子+N+th+holding 跑多隻股票, 淨值歸一化疊圖 + 對比表."""
    n_days, threshold, holding, direction = (
        params["n_days"], params["threshold"], params["holding"], params.get("direction", "contrarian"))
    factor = load_factor_close(factor_name)
    if factor is None:
        return None

    fig = go.Figure()
    rows = []
    for code in stock_codes:
        stock = load_stock_close(code)
        if stock is None:
            continue
        e, x, se, sx, close = compute_signals(factor, stock, n_days, threshold, holding, direction)
        if e is None or (not e.any() and not se.any()):
            continue
        try:
            pf = vbt.Portfolio.from_signals(
                close=close, entries=e, exits=x, short_entries=se, short_exits=sx,
                fees=TOTAL_COST / 2, slippage=SLIPPAGE, freq="1D", init_cash=INIT_CASH_FACTOR)
        except Exception:
            continue
        v = pf.value()
        nv = v / v.iloc[0]
        fig.add_trace(go.Scatter(x=nv.index, y=nv.values, name=code,
                                 mode="lines", line=dict(width=1.8)))
        try:
            rows.append({"股票": code, "Sharpe": round(float(pf.sharpe_ratio()), 2),
                         "回報%": round(float(pf.total_return()) * 100, 1),
                         "MaxDD%": round(float(pf.max_drawdown()) * 100, 1),
                         "交易數": pf.trades.count()})
        except Exception:
            pass

    if not fig.data:
        return None
    fig.update_layout(title=f"📈 多股對比 — {factor_name.upper()}（N={n_days} th={threshold*100:.1f}% h={holding} {direction}）",
                      template="plotly_dark", height=550, width=1200,
                      yaxis_title="歸一化淨值", showlegend=True,
                      legend=dict(orientation="h", y=1.06))
    return fig, pd.DataFrame(rows)
