def load_stock_close(code: str):
    """讀 ohlcv_5y/{code}.csv 回 close Series. code 格式 'HK.00016'."""
    path = OHLCV_DIR / f"{code.replace('.', '_')}.csv"
    if not path.exists():
        return None
    df = pd.read_csv(path, parse_dates=["time_key"]).set_index("time_key").sort_index()
    return df["close"].astype(float)


def load_factor_close(name: str):
    """讀 factors/{name}.csv 回 close Series."""
    path = FACTORS_DIR / f"{name}.csv"
    if not path.exists():
        return None
    df = pd.read_csv(path, index_col="date", parse_dates=True)
    return df["close"].sort_index().astype(float)


def load_leaderboard(min_sharpe: float = 1.0):
    """讀 param_sweep_all_results.csv, filter Sharpe>min_sharpe, 按降序."""
    if not SWEEP_CSV.exists():
        return pd.DataFrame()
    df = pd.read_csv(SWEEP_CSV)
    df = df.replace([float("inf"), -float("inf")], pd.NA).dropna(subset=["sharpe"])
    return df[df["sharpe"] > min_sharpe].sort_values("sharpe", ascending=False).reset_index(drop=True)
```

